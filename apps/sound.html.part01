<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>우리의 소리를 찾아서</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jua&display=swap">
<style>
  :root { --font: 'Jua', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; --navy: #1e3a8a; --ink: #334155; --sub: #64748b; --cream: #fbf3e4; --line: #fde68a; }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { background: var(--cream); }
  html, body { margin: 0; min-height: 100%; background: var(--cream); background-image: linear-gradient(#efe3cc66 1px, transparent 1px), linear-gradient(90deg, #efe3cc66 1px, transparent 1px); background-size: 28px 28px; font-family: var(--font); color: var(--ink); }
  button, input, select { font-family: var(--font); }
  button { cursor: pointer; border: none; }
  .topbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 10px 16px; background: #fbf3e4ee; backdrop-filter: blur(4px); border-bottom: 3px dashed #f5d9a8; }
  .btn2 { background: #fff; color: #57534e; font-size: 20px; padding: 8px 14px; border-radius: 16px; box-shadow: 0 4px 0 #d6d3d1; border: 2px solid #e7e5e4; display: inline-flex; align-items: center; gap: 6px; }
  .btn2 img { width: 30px; height: 30px; object-fit: contain; }
  .btn2:active, .bigbtn:active, .play:active { transform: translateY(2px); }
  .grow { flex: 1; }
  .who-chip { background: #fff; border: 3px solid #7dd3fc; border-radius: 99px; padding: 4px 6px 4px 14px; font-size: 19px; color: #0c4a6e; display: inline-flex; align-items: center; gap: 6px; }
  .who-chip select { font-size: 19px; border: none; background: #e0f2fe; border-radius: 99px; padding: 4px 10px; color: #0c4a6e; }
  .kcs { background: #fff; border-radius: 99px; padding: 4px 12px; font-size: 15px; color: #1e3a8a; box-shadow: 0 2px 6px #0001; }
  .kcs b { color: #ef4444; }
  main { max-width: 1180px; margin: 0 auto; padding: 14px 18px 90px; }
  .title { font-size: 40px; color: var(--navy); text-shadow: 0 3px 0 #fde047; line-height: 1.15; margin: 6px 0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .title img { width: 64px; height: 64px; object-fit: contain; }
  .title small { font-size: 21px; color: #78716c; text-shadow: none; }
  .crumb { font-size: 19px; color: var(--sub); margin: 4px 0 6px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .crumb a { color: #2563eb; text-decoration: none; cursor: pointer; }
  /* 캐릭터 안내 */
  .guide { display: flex; align-items: flex-end; gap: 6px; margin: 4px 0 16px; }
  .guide img { width: 78px; height: 78px; object-fit: contain; filter: drop-shadow(0 3px 2px #0002); animation: bob 2.6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-5px); } }
  .bub { position: relative; background: #fff; border: 3px solid #fde68a; border-radius: 20px; padding: 10px 16px; font-size: 21px; line-height: 1.45; box-shadow: 0 4px 0 #fcd34d66; }
  .bub::before { content: ''; position: absolute; left: -12px; bottom: 16px; border: 9px solid transparent; border-right-color: #fde68a; }
  .bub b { margin-right: 6px; }
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .grid.big { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .card { background: #fff; border: 4px solid var(--c2, #fde68a); border-radius: 26px; padding: 14px; display: flex; flex-direction: column; gap: 10px; position: relative; box-shadow: 0 7px 0 var(--c3, #fcd34d88); transition: transform .12s; }
  .card.nav { cursor: pointer; }
  .card.nav:hover { transform: translateY(-3px) rotate(-.4deg); }
  .card .ph { height: 160px; border-radius: 20px; background: var(--tint, #fff7e6) center/contain no-repeat; background-origin: content-box; padding: 8px; }
  .card .ph.cover { background-size: cover; padding: 0; }
  .card h3 { margin: 0; font-size: 28px; color: var(--navy); font-weight: 400; }
  .card h3 small { font-size: 18px; color: #a8a29e; }
  .card .d { font-size: 18px; color: var(--sub); line-height: 1.45; min-height: 2.9em; }
  .card .d b { color: #57534e; font-weight: 400; }
  .tag { position: absolute; top: 12px; right: 12px; background: #fb7185; color: #fff; border-radius: 99px; padding: 3px 12px; font-size: 16px; box-shadow: 0 3px 0 #e11d48; }
  .tag.in { position: static; display: inline-block; margin-bottom: 6px; }
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .play { background: var(--c, #f59e0b); color: #fff; border-radius: 18px; padding: 8px 16px 8px 8px; font-size: 22px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 5px 0 #0003; text-shadow: 0 1px 0 #0003; }
  .play img { width: 40px; height: 40px; object-fit: contain; background: #fff; border-radius: 50%; padding: 3px; }
  .play.on { animation: pulse .7s infinite alternate; }
  @keyframes pulse { to { filter: brightness(1.15); transform: scale(1.05); } }
  .rate { display: flex; gap: 6px; flex-wrap: wrap; }
  .rate button { border: 3px solid #f1e6d2; background: #fffdf8; border-radius: 18px; width: 80px; height: 80px; padding: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; box-shadow: 0 4px 0 #ebe0cc; }
  .rate button img { width: 48px; height: 48px; object-fit: contain; filter: grayscale(.55) opacity(.75); transition: .15s; }
  .rate button span { font-size: 15px; color: var(--sub); white-space: nowrap; }
  .rate button.sel img { filter: none; transform: scale(1.15); }
  .rate button.sel[data-v="2"] { border-color: #f472b6; background: #fdf2f8; box-shadow: 0 4px 0 #f9a8d4; }
  .rate button.sel[data-v="1"] { border-color: #facc15; background: #fefce8; box-shadow: 0 4px 0 #fde047; }
  .rate button.sel[data-v="0"] { border-color: #38bdf8; background: #f0f9ff; box-shadow: 0 4px 0 #7dd3fc; }
  .rate button.sel span { color: #1e3a8a; }
  .rate button.sel[data-v="1"] span::after { content: ''; }
  .beh { display: none; flex-wrap: wrap; gap: 6px; margin-top: 8px; width: 100%; }
  .beh.show { display: flex; }
  .rate .beh button { width: auto; height: auto; border: 2px solid #e9d5ff; background: #fff; border-radius: 999px; padding: 6px 14px; font-size: 17px; color: #475569; box-shadow: none; display: inline-block; }
  .rate .beh button.on { background: #7c3aed; border-color: #7c3aed; color: #fff; }
  .loud { display: inline-block; background: #fef3c7; color: #92400e; border: 2px solid #fcd34d; border-radius: 999px; padding: 2px 10px; font-size: 15px; margin: 0 0 6px 4px; }
  .card .loud { position: absolute; top: 48px; right: 12px; margin: 0; font-size: 14px; }
  .howto { background: #fff; border: 3px dashed #fcd34d; border-radius: 22px; padding: 12px 18px; margin: 0 0 16px; font-size: 18px; color: #334155; }
  .howto summary { cursor: pointer; font-size: 21px; color: #1e3a8a; }
  .howto ol { margin: 8px 0 0; padding-left: 26px; line-height: 1.7; }
  .vol { display: inline-flex; gap: 2px; align-items: center; background: #fff; border: 3px solid #f5d9a8; border-radius: 999px; padding: 2px 6px; font-size: 16px; }
  .vol button { border: 0; background: none; border-radius: 999px; padding: 4px 10px; font-size: 16px; color: #64748b; }
  .vol button.on { background: #f97316; color: #fff; }
  .again { background: #7c3aed !important; }
  #big { position: fixed; inset: 0; z-index: 70; background: radial-gradient(circle at 50% 40%, #fff7e6, #fde68a); display: none; align-items: center; justify-content: center; flex-direction: column; user-select: none; cursor: pointer; }
  #big.show { display: flex; }
  #big .bp { width: min(62vw, 62vh); height: min(62vw, 62vh); border-radius: 50%; background: #fff center/70% no-repeat; border: 14px solid #f97316; box-shadow: 0 14px 0 #ea580c; transition: transform .12s; }
  #big.hit .bp { transform: scale(.94); box-shadow: 0 6px 0 #ea580c; }
  #big .bn { font-size: 40px; color: #1e3a8a; margin-top: 26px; }
  #big .bc { font-size: 24px; color: #92400e; margin-top: 6px; }
  #big .bx { position: absolute; top: 14px; right: 14px; font-size: 20px; border: 3px solid #cbd5e1; background: #fff; border-radius: 999px; padding: 8px 18px; color: #334155; cursor: pointer; }
  .pl { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .pl .pc { background: #fff; border: 4px solid #fde68a; border-radius: 26px; padding: 14px; text-align: center; }
  .pl .pc .ph { height: 120px; background: center/contain no-repeat; }
  .pl .pc h4 { margin: 8px 0 4px; font-size: 24px; font-weight: 400; color: var(--navy); }
  .pl .pc .rk { display: inline-block; background: #f97316; color: #fff; border-radius: 999px; padding: 2px 12px; font-size: 18px; }
  .pl .pc select { font-size: 17px; padding: 6px 10px; border-radius: 12px; border: 3px solid #e9d5ff; margin-top: 8px; }
  table.days { border-collapse: collapse; font-size: 17px; width: 100%; background: #fff; }
  table.days th, table.days td { border: 2px solid #f1e6d2; padding: 6px 8px; text-align: center; }
  table.days td.l { text-align: left; }
  .rate.small button { width: 68px; height: 66px; } .rate.small button img { width: 38px; height: 38px; } .rate.small button span { font-size: 13px; }
  .go { margin-left: auto; background: #eef2ff; color: #3730a3; border-radius: 16px; padding: 8px 14px; font-size: 19px; box-shadow: 0 4px 0 #c7d2fe; }
  .sec { margin: 28px 0 12px; font-size: 30px; color: var(--navy); font-weight: 400; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sec small { font-size: 18px; color: var(--sub); }
  .sec img { width: 46px; height: 46px; object-fit: contain; }
  .item { background: #fff; border: 3px solid #f5e6c8; border-radius: 22px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; box-shadow: 0 5px 0 #f1e3c4; }
  .item .nm { font-size: 24px; color: var(--navy); }
  .item .ex { font-size: 17px; color: var(--sub); width: 100%; margin-top: -2px; }
  .list { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
  .hero { display: grid; grid-template-columns: 320px 1fr; gap: 22px; align-items: center; background: #fff; border: 4px solid var(--c2, #fde68a); border-radius: 30px; padding: 18px; box-shadow: 0 8px 0 var(--c3, #fcd34d88); }
  .hero .ph { height: 290px; border-radius: 22px; background: var(--tint, #fff7e6) center/contain no-repeat; background-origin: content-box; padding: 12px; position: relative; }
  .hero h2 { margin: 0 0 6px; font-size: 46px; color: var(--navy); font-weight: 400; text-shadow: 0 3px 0 #fde047; }
  .hero p { font-size: 22px; line-height: 1.55; margin: 0 0 14px; }
  .photo { position: absolute; right: -10px; bottom: -10px; width: 96px; height: 96px; border-radius: 16px; border: 4px solid #fff; background: #fff center/cover no-repeat; box-shadow: 0 4px 10px #0003; transform: rotate(4deg); cursor: zoom-in; }
  .photo::after { content: '진짜 사진'; position: absolute; left: 0; right: 0; bottom: -24px; text-align: center; font-size: 13px; color: #78716c; }
  .yt { display: inline-flex; align-items: center; gap: 8px; background: #fff1f2; color: #be123c; border: 3px solid #fecdd3; border-radius: 16px; padding: 8px 14px; font-size: 19px; text-decoration: none; box-shadow: 0 4px 0 #fecdd3; }
  .note { font-size: 16px; color: var(--sub); }
  .tool { display: flex; gap: 10px; flex-wrap: wrap; margin: 4px 0 18px; }
  .tool button { background: #fff; border: 3px solid #c4b5fd; color: #5b21b6; border-radius: 18px; padding: 6px 16px 6px 8px; font-size: 21px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 5px 0 #ddd6fe; }
  .tool button img { width: 44px; height: 44px; object-fit: contain; }
  /* 표지 */
  #cover { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center; background: var(--cream); background-image: linear-gradient(#efe3cc66 1px, transparent 1px), linear-gradient(90deg, #efe3cc66 1px, transparent 1px); background-size: 28px 28px; }
  #cover.hide { display: none; }
  .poster { position: relative; height: min(96vh, 140vw); aspect-ratio: 765/1024; background: center/cover no-repeat; border-radius: 26px; box-shadow: 0 12px 40px #0002; }
  .poster .pt { position: absolute; top: 5%; left: 0; right: 0; text-align: center; }
  .poster .ribbon { display: inline-block; background: #fb923c; color: #fff; font-size: min(3.2vh, 4.6vw); padding: 6px 22px; border-radius: 10px; box-shadow: 0 4px 0 #c2410c; transform: rotate(-2deg); }
  .poster h1 { margin: 10px 0 0; font-size: min(7.6vh, 10.5vw); font-weight: 400; color: #f59e0b; -webkit-text-stroke: 3px #7c2d12; paint-order: stroke fill; text-shadow: 0 6px 0 #fb7185; letter-spacing: 1px; line-height: 1.05; }
  .poster .pb { position: absolute; bottom: 5%; left: 0; right: 0; text-align: center; }
  .bigbtn { background: #86efac; color: #14532d; font-size: min(4.6vh, 7vw); padding: 8px 36px; border-radius: 26px; box-shadow: 0 7px 0 #16a34a; border: 4px solid #fff; }
  /* 둘 중에 골라요 */
  #duel { position: fixed; inset: 0; background: #1e1b4bcc; z-index: 50; display: none; align-items: center; justify-content: center; padding: 16px; }
  #duel.show { display: flex; }
  .dbox { background: var(--cream); border: 5px solid #fde68a; border-radius: 30px; padding: 20px; width: min(920px, 100%); text-align: center; }
  .dbox h2 { margin: 0 0 4px; font-size: 34px; color: var(--navy); font-weight: 400; text-shadow: 0 3px 0 #fde047; }
  .dpair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0; }
  .dopt { background: #fff; border: 4px solid #f5e6c8; border-radius: 24px; padding: 12px; display: flex; flex-direction: column; gap: 10px; align-items: center; box-shadow: 0 6px 0 #f1e3c4; }
  .dopt .ph { width: 100%; height: 190px; border-radius: 18px; background: #fff7e6 center/contain no-repeat; background-origin: content-box; padding: 8px; }
  .dopt .lbl { font-size: 26px; color: var(--navy); }
  .dopt.hl { border-color: #a78bfa; background: #f5f3ff; }
  .dopt .pick { background: #f472b6; color: #fff; border-radius: 18px; font-size: 24px; padding: 10px 18px; width: 100%; box-shadow: 0 5px 0 #db2777; }
  .dbar { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .dbar button { border-radius: 16px; padding: 8px 16px; font-size: 19px; background: #fff; color: #57534e; box-shadow: 0 4px 0 #d6d3d1; border: 2px solid #e7e5e4; }
  .dprog { font-size: 19px; color: var(--sub); }
  /* 결과 */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 3px solid #f5e6c8; border-radius: 999px; padding: 4px 14px 4px 4px; font-size: 19px; }
  .chip i { width: 40px; height: 40px; border-radius: 50%; background: #fff7e6 center/contain no-repeat; }
  .bars { display: grid; gap: 10px; background: #fff; border: 3px solid #f5e6c8; border-radius: 22px; padding: 14px; }
  .bar { display: grid; grid-template-columns: 190px 1fr 70px; gap: 8px; align-items: center; font-size: 19px; }
  .bar .tr { height: 26px; background: #f5f0e6; border-radius: 999px; overflow: hidden; display: flex; }
  .bar .tr b { display: block; height: 100%; }
  .empty { color: var(--sub); font-size: 19px; }
  footer { text-align: center; color: var(--sub); font-size: 15px; padding: 20px; }
  footer b { color: #ef4444; }
  footer a { color: #2563eb; }
  #toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); background: #1e3a8a; color: #fff; padding: 10px 22px; border-radius: 999px; font-size: 21px; opacity: 0; transition: .3s; z-index: 80; pointer-events: none; box-shadow: 0 4px 0 #172554; }
  #toast.show { opacity: .96; }
  #nowp { position: fixed; right: 16px; bottom: 16px; z-index: 40; display: none; }
  #nowp.show { display: block; }
  #nowp button { background: #fff; color: #be123c; border: 3px solid #fecdd3; border-radius: 999px; padding: 10px 18px; font-size: 20px; box-shadow: 0 5px 0 #fecdd3; }
  #zoom { position: fixed; inset: 0; background: #000a; z-index: 90; display: none; align-items: center; justify-content: center; }
  #zoom.show { display: flex; } #zoom img { max-width: 90vw; max-height: 86vh; border-radius: 18px; border: 6px solid #fff; }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; } .hero .ph { height: 220px; } .title { font-size: 30px; } .dpair { grid-template-columns: 1fr; } .dopt .ph { height: 120px; } .bar { grid-template-columns: 110px 1fr 56px; } }
  @media print { .topbar, .tool, footer, #nowp, .noprint, .guide { display: none !important; } body, html { background: #fff; } main { padding: 0; } }
</style>
</head>
<body>
<div id="cover"><div class="poster" id="poster"><div class="pt"><span class="ribbon">좋아하는 소리, 싫어하는 소리를 찾아요!</span><h1>우리의 소리를<br>찾아서</h1></div><div class="pb"><button class="bigbtn" onclick="startApp()">시작하기</button></div></div></div>
<div class="topbar">
  <button class="btn2" onclick="back()">◀ 이전</button>
  <button class="btn2" onclick="go('home')"><img src="" data-ico="home" alt="">처음</button>
  <span class="grow"></span>
  <span class="who-chip">이름 <select id="who" onchange="setWho(this.value)" aria-label="이름"></select></span>
  <button class="btn2" onclick="addWho()">＋ 이름</button>
  <span class="vol noprint" id="vol" aria-label="소리 크기"></span>
  <button class="btn2" onclick="go('pl')">⭐ 좋아하는 소리 목록</button>
  <button class="btn2" onclick="go('res')"><img src="" data-ico="chart" alt="">관찰 결과</button>
  <span class="kcs">Creator <b>KCS</b> · 2026.11.13 14:20</span>
</div>
<main id="main"></main>
<div id="duel"><div class="dbox" id="dbox"></div></div>
<div id="big" onpointerdown="bigHit(event)"><button class="bx" onpointerdown="event.stopPropagation()" onclick="bigEnd()">그만하기 (선생님)</button><div class="bp" id="bigp"></div><div class="bn" id="bign"></div><div class="bc" id="bigc"></div></div>
<div id="nowp"><button onclick="stopAll()">■ 소리 멈추기</button></div>
<div id="toast"></div>
<div id="zoom" onclick="this.classList.remove('show')"><img id="zoomi" alt=""></div>
<footer>그림: 월이·아리·대롱이와 악기 그림(제미나이로 그림) · 서양 악기 소리: FluidR3 GM 사운드폰트(MIT) · 국악 소리: 공유마당 음원(한국저작권위원회 CC BY, (재)전주정보문화산업진흥원 공공누리 1유형)과 앱에서 만든 소리 (<a href="#" onclick="go('cred');return false">소리 출처</a>) · 진짜 사진: 위키미디어 공용 (<a href="#" onclick="go('cred');return false">사진 출처</a>)<br>Creator <b>KCS</b></footer>
<script>
// ===== 소리 찾기 데이터 =====
// cat: 대분류, sub: 소분류. gm: 사운드폰트 이름, syn: 합성 소리 이름.
// lo/hi: 미디 음높이 범위. tech: 주법 [이름, 설명, 연주법]. fam: 대표곡 [곡 이름, 유튜브 검색어]. tune: 앱에서 들려줄 가락.
const CATS = [
  { id: 'perc', name: '두드리는 악기', sub2: '타악기', col: '#f97316', emo: '🥁', desc: '치거나 두드려서 소리를 내요.' },
  { id: 'str', name: '줄이 있는 악기', sub2: '현악기', col: '#e11d48', emo: '🎻', desc: '줄을 켜거나 뜯어서 소리를 내요.' },
  { id: 'wind', name: '불어서 내는 악기', sub2: '관악기', col: '#0ea5e9', emo: '🎺', desc: '입으로 바람을 불어서 소리를 내요.' },
  { id: 'key', name: '건반 악기', sub2: '건반악기', col: '#8b5cf6', emo: '🎹', desc: '건반을 눌러서 소리를 내요.' },
  { id: 'real', name: '실제 연주 듣기', sub2: '국악 연주', col: '#0f766e', emo: '🎶', desc: '공유마당에 공개된 진짜 국악 연주를 들어요.' },
  { id: 'voice', name: '목소리와 전자 소리', sub2: '목소리·전자악기', col: '#10b981', emo: '🎤', desc: '사람 목소리와 컴퓨터로 만든 소리예요.' },
];
const SUBS = [
