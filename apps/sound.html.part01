  // ---- 활로 켜는
  { id: 'violin', name: '바이올린', sub: 'str_bow', gm: 'violin', lo: 55, hi: 96, desc: '턱에 끼우고 활로 켜요. 높고 고운 소리예요.', tech: [T.long, T.vib, T.short, ['뜯기(피치카토)', '활 대신 손가락으로 줄을 뜯어요.', { gm: 'pizzicato_strings', dur: .5, rep: [.4, 4] }], ['떨며 켜기(트레몰로)', '활을 아주 빠르게 움직여요.', { gm: 'tremolo_strings', dur: 2 }]], tune: 'spring', fam: [['비발디 「사계」 중 봄', '비발디 사계 봄 바이올린'], ['파가니니 「카프리스 24번」', '파가니니 카프리스 24번']] },
  { id: 'viola', name: '비올라', sub: 'str_bow', gm: 'viola', lo: 48, hi: 84, desc: '바이올린보다 조금 크고, 소리가 조금 낮아요.', tech: [T.long, T.vib, T.short, ['뜯기(피치카토)', '손가락으로 줄을 뜯어요.', { gm: 'pizzicato_strings', dur: .5, rep: [.4, 4] }]], tune: 'minuet', fam: [['텔레만 「비올라 협주곡」', '텔레만 비올라 협주곡']] },
  { id: 'cello', name: '첼로', sub: 'str_bow', gm: 'cello', lo: 36, hi: 72, desc: '앉아서 다리 사이에 세우고 켜요. 낮고 따뜻해요.', tech: [T.long, T.vib, T.short, ['뜯기(피치카토)', '손가락으로 줄을 뜯어요.', { gm: 'pizzicato_strings', dur: .6, rep: [.45, 4] }], ['떨며 켜기(트레몰로)', '활을 아주 빠르게 움직여요.', { gm: 'tremolo_strings', dur: 2 }]], tune: 'lullaby', fam: [['생상스 「백조」', '생상스 백조 첼로'], ['바흐 「무반주 첼로 모음곡 1번」', '바흐 무반주 첼로 모음곡 1번 프렐류드']] },
  { id: 'contrabass', name: '콘트라베이스', sub: 'str_bow', gm: 'contrabass', lo: 28, hi: 60, desc: '사람보다 큰 현악기예요. 아주 낮고 굵은 소리!', tech: [T.long, T.short, ['뜯기(피치카토)', '손가락으로 줄을 뜯어요. 재즈에서 많이 써요.', { gm: 'acoustic_bass', dur: .7, rep: [.5, 4] }]], tune: 'saints', fam: [['생상스 「동물의 사육제」 코끼리', '동물의 사육제 코끼리 콘트라베이스']] },
  { id: 'fiddle', name: '피들', sub: 'str_bow', gm: 'fiddle', lo: 55, hi: 88, desc: '바이올린과 같은 악기로, 신나는 민요를 켜요.', tech: [T.long, T.short, T.vib], tune: 'saints', fam: [['아일랜드 피들 음악', '아이리시 피들 연주']] },
  { id: 'strings', name: '현악 합주', sub: 'str_bow', gm: 'string_ensemble_1', lo: 36, hi: 84, desc: '여러 현악기가 함께 켜는 소리예요.', tech: [T.long, T.chord, ['떨며 켜기(트레몰로)', '모두 활을 빠르게 움직여요.', { gm: 'tremolo_strings', dur: 2, chord: [0, 7, 12] }], ['다 함께 뜯기', '모두 손가락으로 뜯어요.', { gm: 'pizzicato_strings', chord: [0, 4, 7], dur: .6, rep: [.5, 3] }]], tune: 'canon', fam: [['파헬벨 「캐논」', '파헬벨 캐논 현악'], ['차이콥스키 「현을 위한 세레나데」', '차이콥스키 현을 위한 세레나데']] },
  // ---- 손으로 뜯는
  { id: 'guitar_nylon', name: '클래식 기타', sub: 'str_pluck', gm: 'acoustic_guitar_nylon', lo: 40, hi: 76, desc: '나일론 줄을 손가락으로 뜯어요. 부드러워요.', tech: [T.short, T.arp, ['줄 긁기', '여러 줄을 한 번에 쓸어내려요.', { strum: [0, 7, 12, 16, 19, 24], dur: 2 }], ['하모닉스', '줄을 살짝 대고 뜯으면 종소리처럼 나요.', { gm: 'guitar_harmonics', dur: 1.5 }]], tune: 'greensleeves', fam: [['타레가 「알함브라 궁전의 추억」', '알함브라 궁전의 추억 기타']] },
  { id: 'guitar_steel', name: '통기타', sub: 'str_pluck', gm: 'acoustic_guitar_steel', lo: 40, hi: 76, desc: '쇠줄을 써서 밝고 찰랑거리는 소리가 나요.', tech: [T.short, T.arp, ['줄 긁기', '쓸어내려 노래 반주를 해요.', { strum: [0, 7, 12, 16, 19, 24], dur: 2, rep: [.5, 3] }]], tune: 'amazing', fam: [['통기타 연주곡', '통기타 핑거스타일 연주']] },
  { id: 'harp', name: '하프', sub: 'str_pluck', gm: 'orchestral_harp', lo: 36, hi: 96, desc: '47개의 줄을 양손으로 뜯어요. 꿈꾸는 듯한 소리!', tech: [T.short, T.arp, T.gliss], tune: 'twinkle', fam: [['드뷔시 「신성한 춤과 세속적인 춤」', '드뷔시 신성한 춤과 세속적인 춤 하프'], ['차이콥스키 「꽃의 왈츠」', '꽃의 왈츠 하프']] },
  { id: 'banjo', name: '밴조', sub: 'str_pluck', gm: 'banjo', lo: 48, hi: 76, desc: '둥근 북 몸통의 미국 악기예요. 통통 튀는 소리!', tech: [T.short, T.arp, ['빠르게 뜯기', '여러 손가락으로 빠르게 뜯어요.', { arp: [0, 7, 12, 7, 0, 7, 12, 16], dur: .3 }]], tune: 'saints', fam: [['블루그래스 밴조', '블루그래스 밴조 연주']] },
  { id: 'sitar', name: '시타르', sub: 'str_pluck', gm: 'sitar', lo: 48, hi: 76, desc: '인도의 악기예요. 지잉~ 울리는 줄이 많아요.', tech: [T.long, T.short, ['미끄러뜨리기', '줄을 옆으로 당겨 음을 바꿔요.', { bend: 2, dur: 2 }]], tune: 'raga', fam: [['라비 샹카르의 시타르', '라비 샹카르 시타르']] },
  { id: 'koto', name: '고토', sub: 'str_pluck', gm: 'koto', lo: 48, hi: 84, desc: '일본의 긴 현악기예요. 가야금과 닮았어요.', tech: [T.short, T.arp, ['음 밀어 올리기', '줄을 눌러 음을 올려요.', { bend: 2, dur: 1.8 }]], tune: 'sakura', fam: [['일본 민요 「사쿠라」 고토', '사쿠라 고토 연주']] },
  { id: 'shamisen', name: '샤미센', sub: 'str_pluck', gm: 'shamisen', lo: 48, hi: 80, desc: '줄이 3개인 일본 악기예요. 큰 채로 튕겨요.', tech: [T.short, T.long, ['빠르게 튕기기', '채로 빠르게 쳐요.', { rep: [.15, 8], dur: .2 }]], tune: 'sakura', fam: [['츠가루 샤미센', '츠가루 샤미센 연주']] },
  // ---- 국악 현악기 (합성)
  { id: 'gayageum', real: ['g_gaya25','g_gaya18','g_jindo'], name: '가야금', sub: 'str_kor', syn: 'gayageum', lo: 50, hi: 79, gugak: 1, desc: '오동나무 위의 명주실 12줄을 손가락으로 뜯어요.', tech: [['뜯기', '손가락으로 줄을 뜯어요.', { dur: 1.6 }], ['농현 (떠는 소리)', '왼손으로 줄을 눌렀다 놓았다 하며 소리를 떨어요.', { dur: 2.2, vib: [5, .6], vibDelay: .35 }], ['밀어 올리기 (전성)', '줄을 꾹 눌러 음을 올려요.', { dur: 1.8, bend: 2, bendAt: .25 }], ['흘러내리기 (퇴성)', '누른 줄을 놓으며 음이 내려가요.', { dur: 1.8, bend: -2, bendAt: .3 }], ['연튕김', '두 음을 빠르게 이어 튕겨요.', { arp: [0, 2, 4, 7, 9, 12], dur: .35 }]], tune: 'arirang', fam: [['황병기 「침향무」', '황병기 침향무'], ['가야금 산조', '가야금 산조']] },
  { id: 'geomungo', real: ['g_geomungo','g_sangryeong'], name: '거문고', sub: 'str_kor', syn: 'geomungo', lo: 36, hi: 62, gugak: 1, desc: '술대라는 막대로 줄을 내리쳐요. 낮고 깊은 소리예요.', tech: [['내려치기 (대점)', '술대로 세게 내리쳐요. 딱 하는 소리도 나요.', { dur: 2, vel: 1 }], ['가볍게 뜯기', '살짝 쳐요.', { dur: 1.6, vel: .45 }], ['농현 (떠는 소리)', '괘를 짚은 손으로 줄을 흔들어요.', { dur: 2.4, vib: [4.5, .7], vibDelay: .4 }], ['밀어 올리기', '줄을 밀어 음을 올려요.', { dur: 2, bend: 2, bendAt: .3 }]], tune: 'arirang', fam: [['거문고 산조', '거문고 산조'], ['정악 「영산회상」', '영산회상 거문고']] },
  { id: 'haegeum', real: ['g_orch_arirang','g_orch_doraji'], name: '해금', sub: 'str_kor', syn: 'haegeum', lo: 57, hi: 88, gugak: 1, desc: '줄 2개 사이에 활을 끼워 켜요. 코맹맹이 같은 소리!', tech: [['길게 켜기', '활로 길게 켜요.', { dur: 2.2 }], ['농현 (떠는 소리)', '줄을 잡은 손으로 소리를 떨어요.', { dur: 2.4, vib: [5.5, .8], vibDelay: .3 }], ['미끄러지기', '손을 미끄러뜨려 음을 올려요.', { dur: 2, bend: 3, bendAt: .2 }], ['짧게 끊어서', '활을 톡톡 끊어요.', { dur: .25, rep: [.33, 4] }]], tune: 'arirang', fam: [['해금 「추상」', '해금 독주'], ['해금 산조', '해금 산조']] },
  { id: 'ajaeng', real: ['g_ajaeng'], name: '아쟁', sub: 'str_kor', syn: 'ajaeng', lo: 40, hi: 70, gugak: 1, desc: '나무 막대 활로 줄을 문질러요. 낮고 거친 소리예요.', tech: [['길게 켜기', '활대로 길게 문질러요.', { dur: 2.4 }], ['농현 (떠는 소리)', '줄을 흔들어 슬픈 소리를 내요.', { dur: 2.6, vib: [4.5, .9], vibDelay: .35 }], ['흘러내리기', '음을 아래로 끌어 내려요.', { dur: 2.2, bend: -3, bendAt: .5 }]], tune: 'arirang', fam: [['아쟁 산조', '아쟁 산조']] },
  // ---- 전기 기타
  { id: 'eguitar', name: '전기 기타', sub: 'str_elec', gm: 'electric_guitar_clean', lo: 40, hi: 80, desc: '앰프로 소리를 키우는 기타예요.', tech: [['맑은 소리', '찌그러짐 없이 깨끗하게', { dur: 1.6 }], ['손바닥 막기 (뮤트)', '손바닥으로 줄을 살짝 막아요. 툭툭!', { gm: 'electric_guitar_muted', dur: .3, rep: [.25, 6] }], ['찌그러진 소리', '크고 거칠게 찌그러뜨려요. 록 음악!', { gm: 'distortion_guitar', chord: [0, 7, 12], dur: 1.8 }], ['조금 찌그러진 소리', '살짝 거칠게', { gm: 'overdriven_guitar', dur: 1.6 }]], tune: 'ode', fam: [['록 기타 연주', '록 기타 솔로']] },
  { id: 'ebass', name: '전기 베이스', sub: 'str_elec', gm: 'electric_bass_finger', lo: 28, hi: 55, desc: '낮은 소리로 음악의 바닥을 받쳐 줘요.', tech: [['손가락으로', '부드럽게 뜯어요.', { dur: 1, rep: [.5, 4] }], ['피크로', '피크로 또렷하게 쳐요.', { gm: 'electric_bass_pick', dur: 1, rep: [.5, 4] }], ['슬랩', '엄지로 줄을 때려요. 퉁퉁!', { gm: 'slap_bass_1', dur: .4, rep: [.3, 6] }]], tune: 'bassline', fam: [['펑크 베이스', '슬랩 베이스 연주']] },
  // ---- 목관
  { id: 'flute', name: '플루트', sub: 'wind_wood', gm: 'flute', lo: 60, hi: 96, desc: '옆으로 들고 불어요. 맑고 부드러운 새소리 같아요.', tech: [T.long, T.vib, T.short, T.trill], tune: 'elise', fam: [['드뷔시 「목신의 오후 전주곡」', '목신의 오후 전주곡 플루트'], ['비제 「아를르의 여인」 미뉴에트', '아를르의 여인 미뉴에트 플루트']] },
  { id: 'piccolo', name: '피콜로', sub: 'wind_wood', gm: 'piccolo', lo: 74, hi: 102, desc: '작은 플루트예요. 아주 높고 날카로운 소리!', tech: [T.long, T.short, T.trill], tune: 'twinkle', fam: [['수자 「성조기여 영원하라」', '성조기여 영원하라 피콜로']] },
  { id: 'recorder', name: '리코더', sub: 'wind_wood', gm: 'recorder', lo: 60, hi: 90, desc: '학교에서 배우는 그 악기예요.', tech: [T.long, T.short, T.soft], tune: 'twinkle', fam: [['리코더 합주', '리코더 합주']] },
  { id: 'clarinet', name: '클라리넷', sub: 'wind_wood', gm: 'clarinet', lo: 50, hi: 88, desc: '나무판(리드)을 떨어서 소리 내요. 동글동글한 소리.', tech: [T.long, T.short, T.trill, T.soft], tune: 'ode', fam: [['모차르트 「클라리넷 협주곡」', '모차르트 클라리넷 협주곡 2악장'], ['거슈윈 「랩소디 인 블루」', '랩소디 인 블루 클라리넷']] },
  { id: 'oboe', name: '오보에', sub: 'wind_wood', gm: 'oboe', lo: 58, hi: 88, desc: '리드 두 장을 떨어요. 콧소리 같은 고운 소리예요.', tech: [T.long, T.vib, T.short], tune: 'minuet', fam: [['차이콥스키 「백조의 호수」', '백조의 호수 오보에'], ['프로코피예프 「피터와 늑대」 오리', '피터와 늑대 오리 오보에']] },
  { id: 'english_horn', name: '잉글리시 호른', sub: 'wind_wood', gm: 'english_horn', lo: 52, hi: 80, desc: '오보에보다 크고 낮은 소리예요.', tech: [T.long, T.vib, T.soft], tune: 'goinghome', fam: [['드보르자크 「신세계 교향곡」 2악장', '신세계 교향곡 2악장 잉글리시호른']] },
  { id: 'bassoon', name: '바순', sub: 'wind_wood', gm: 'bassoon', lo: 34, hi: 72, desc: '길쭉한 나무 관이에요. 낮고 익살스러운 소리!', tech: [T.long, T.short, T.soft], tune: 'march', fam: [['뒤카 「마법사의 제자」', '마법사의 제자 바순'], ['프로코피예프 「피터와 늑대」 할아버지', '피터와 늑대 할아버지 바순']] },
  { id: 'sax', name: '색소폰', sub: 'wind_wood', gm: 'alto_sax', lo: 49, hi: 80, desc: '쇠로 만들었지만 리드를 써서 목관악기예요. 재즈!', tech: [T.long, T.vib, T.short, ['낮은 테너 색소폰', '더 크고 낮은 색소폰', { gm: 'tenor_sax', dur: 1.8, shift: -5 }], ['높은 소프라노 색소폰', '곧은 모양의 높은 색소폰', { gm: 'soprano_sax', dur: 1.8, shift: 7 }]], tune: 'saints', fam: [['재즈 색소폰', '재즈 색소폰 연주']] },
  // ---- 금관
  { id: 'trumpet', name: '트럼펫', sub: 'wind_brass', gm: 'trumpet', lo: 54, hi: 84, desc: '밸브 3개를 눌러요. 빛나고 힘찬 소리!', tech: [T.long, T.short, ['약음기 끼우기', '나팔 끝을 막아 작고 뾰족한 소리를 내요.', { gm: 'muted_trumpet', dur: 1.8 }], ['팡파르', '따따따 따~', { fan: 1 }]], tune: 'fanfare', fam: [['하이든 「트럼펫 협주곡」', '하이든 트럼펫 협주곡'], ['클라크 「트럼펫 볼런터리」', '트럼펫 볼런터리']] },
  { id: 'trombone', name: '트롬본', sub: 'wind_brass', gm: 'trombone', lo: 40, hi: 72, desc: '긴 관을 밀고 당겨 음을 바꿔요.', tech: [T.long, T.short, ['미끄러지기 (글리산도)', '관을 쭉 밀어 음을 미끄러뜨려요.', { bend: 5, dur: 1.8, bendAt: .1 }]], tune: 'saints', fam: [['라벨 「볼레로」 트롬본', '볼레로 트롬본 솔로']] },
  { id: 'horn', name: '호른', sub: 'wind_brass', gm: 'french_horn', lo: 41, hi: 77, desc: '달팽이처럼 말린 관이에요. 넓고 부드러운 소리.', tech: [T.long, T.soft, T.loud], tune: 'goinghome', fam: [['모차르트 「호른 협주곡 4번」', '모차르트 호른 협주곡 4번'], ['차이콥스키 「교향곡 5번」 2악장', '차이콥스키 교향곡 5번 2악장 호른']] },
  { id: 'tuba', name: '튜바', sub: 'wind_brass', gm: 'tuba', lo: 28, hi: 58, desc: '금관악기 중 가장 커요. 뿌우~ 낮은 소리!', tech: [T.long, T.short, T.soft], tune: 'march', fam: [['본 윌리엄스 「튜바 협주곡」', '본윌리엄스 튜바 협주곡']] },
  { id: 'brass', name: '금관 합주', sub: 'wind_brass', gm: 'brass_section', lo: 40, hi: 80, desc: '여러 금관악기가 함께 불어요.', tech: [T.long, T.chord, ['팡파르', '따따따 따~', { fan: 1, chord: [0, 4, 7] }]], tune: 'fanfare', fam: [['코플랜드 「보통 사람을 위한 팡파르」', '보통 사람을 위한 팡파르']] },
  // ---- 국악 관악기 (합성)
  { id: 'daegeum', real: ['g_daegeum','g_yeomin'], name: '대금', sub: 'wind_kor', syn: 'daegeum', lo: 62, hi: 91, gugak: 1, desc: '옆으로 부는 큰 대나무 피리예요. 갈대 속껍질 청이 떨려 맑게 울려요.', reg: [['저취 (낮은 소리)', 64, '숨을 약하게 불어 낮고 부드러운 소리'], ['평취 (가운데 소리)', 74, '보통 세기로 부는 소리'], ['역취 (높은 소리)', 86, '세게 불어 높고 시원한 소리']], tech: [['길게 불기', '숨을 길게 불어요.', { dur: 2.4 }], ['청 울림 크게', '청이 지잉 떨리는 소리를 크게 내요.', { dur: 2.4, buzz: 1 }], ['농음 (떠는 소리)', '숨을 흔들어 소리를 떨어요.', { dur: 2.6, vib: [4.5, .5], vibDelay: .5 }], ['꺾기', '음을 살짝 꺾어 내려요.', { dur: 2, bend: -1, bendAt: .6 }]], tune: 'arirang', fam: [['대금 독주곡 「청성곡」', '대금 청성곡'], ['대금 산조', '대금 산조']] },
  { id: 'danso', real: ['g_danso'], name: '단소', sub: 'wind_kor', syn: 'danso', lo: 72, hi: 96, gugak: 1, desc: '세로로 부는 짧은 대나무 피리예요. 학교에서도 배워요.', tech: [['길게 불기', '맑게 길게 불어요.', { dur: 2.2 }], ['농음 (떠는 소리)', '숨을 흔들어요.', { dur: 2.4, vib: [5, .45], vibDelay: .45 }], ['짧게 끊어서', '혀로 끊어 불어요.', { dur: .25, rep: [.35, 4] }]], tune: 'arirang', fam: [['단소 「청성곡」', '단소 청성곡']] },
  { id: 'piri', real: ['g_piri','g_yeombul'], name: '피리', sub: 'wind_kor', syn: 'piri', lo: 60, hi: 84, gugak: 1, desc: '작은 대나무 관에 큰 서(리드)를 꽂아 불어요. 크고 또렷해요.', tech: [['길게 불기', '서를 물고 길게 불어요.', { dur: 2.2 }], ['꺾기 (시김새)', '음을 아래에서 위로 꺾어 올려요.', { dur: 2, bend: 2, bendAt: .1, bendFrom: 1 }], ['떠는 소리', '소리를 크게 흔들어요.', { dur: 2.4, vib: [5, .7], vibDelay: .4 }]], tune: 'arirang', fam: [['피리 「상령산」', '피리 상령산'], ['피리 정악 「수제천」', '수제천']] },
  { id: 'taepyeongso', real: ['g_tps','g_gunak'], name: '태평소', sub: 'wind_kor', syn: 'taepyeongso', lo: 67, hi: 91, gugak: 1, desc: '끝에 나팔이 달렸어요. 풍물놀이에서 가장 크고 높게 울려요.', tech: [['길게 불기', '힘차게 길게 불어요.', { dur: 2.2 }], ['꺾기', '음을 꺾어 흥을 내요.', { dur: 2, bend: -2, bendAt: .5 }], ['떠는 소리', '소리를 흔들어요.', { dur: 2.2, vib: [6, .6], vibDelay: .3 }]], tune: 'arirang', fam: [['태평소 시나위', '태평소 시나위'], ['종묘제례악 태평소', '종묘제례악']] },
  { id: 'saenghwang', real: ['g_saenghwang'], name: '생황', sub: 'wind_kor', syn: 'saenghwang', lo: 62, hi: 84, gugak: 1, desc: '대나무 관 17개를 꽂은 악기예요. 화음을 낼 수 있어요.', tech: [['한 음', '한 관만 불어요.', { dur: 2.2 }], ['화음', '여러 관을 함께 불어요.', { dur: 2.4, chord: [0, 7, 12] }], ['떠는 소리', '숨을 흔들어요.', { dur: 2.2, vib: [5, .3] }]], tune: 'arirang', fam: [['생황과 단소 「수룡음」', '생황 단소 병주 수룡음']] },
  // ---- 세계 관악기
  { id: 'pan_flute', name: '팬플루트', sub: 'wind_world', gm: 'pan_flute', lo: 60, hi: 90, desc: '길이가 다른 대나무 관을 나란히 묶었어요. 남미 안데스!', tech: [T.long, T.vib, T.short], tune: 'condor', fam: [['「엘 콘도르 파사」', '엘 콘도르 파사 팬플루트']] },
  { id: 'ocarina', name: '오카리나', sub: 'wind_world', gm: 'ocarina', lo: 60, hi: 90, desc: '흙으로 구운 동그란 피리예요. 동글동글한 소리.', tech: [T.long, T.short, T.vib], tune: 'twinkle', fam: [['오카리나 연주', '오카리나 연주']] },
  { id: 'shakuhachi', name: '샤쿠하치', sub: 'wind_world', gm: 'shakuhachi', lo: 60, hi: 88, desc: '일본의 세로 대나무 피리예요. 바람 소리가 섞여요.', tech: [T.long, T.vib, ['숨소리 섞기', '바람 소리를 크게 섞어요.', { dur: 2.2, vel: .9 }]], tune: 'sakura', fam: [['샤쿠하치 명곡', '샤쿠하치 연주']] },
  { id: 'bagpipe', name: '백파이프', sub: 'wind_world', gm: 'bagpipe', lo: 60, hi: 80, desc: '바람 주머니를 눌러 소리 내는 스코틀랜드 악기예요.', tech: [T.long, T.short], tune: 'amazing', fam: [['「어메이징 그레이스」 백파이프', '어메이징 그레이스 백파이프']] },
  { id: 'harmonica', name: '하모니카', sub: 'wind_world', gm: 'harmonica', lo: 60, hi: 90, desc: '작은 칸에 입김을 불고 들이마셔요.', tech: [T.long, T.short, T.chord], tune: 'saints', fam: [['블루스 하모니카', '블루스 하모니카 연주']] },
  { id: 'accordion', name: '아코디언', sub: 'wind_world', gm: 'accordion', lo: 48, hi: 84, desc: '주름 상자를 밀고 당기며 건반을 눌러요.', tech: [T.long, T.chord, T.short], tune: 'cancan', fam: [['프랑스 뮈제트 아코디언', '아코디언 뮈제트']] },
  // ---- 피아노
  { id: 'piano', name: '피아노', sub: 'key_piano', gm: 'acoustic_grand_piano', lo: 33, hi: 100, desc: '건반을 누르면 안에서 망치가 줄을 쳐요.', tech: [T.soft, T.loud, T.short, T.chord, T.arp, T.gliss], tune: 'elise', fam: [['베토벤 「엘리제를 위하여」', '엘리제를 위하여 피아노'], ['쇼팽 「강아지 왈츠」', '쇼팽 강아지 왈츠'], ['드뷔시 「달빛」', '드뷔시 달빛 피아노']] },
  { id: 'epiano', name: '전자 피아노', sub: 'key_piano', gm: 'electric_piano_1', lo: 36, hi: 90, desc: '전기로 소리를 만드는 피아노예요. 몽글몽글해요.', tech: [T.soft, T.chord, T.arp], tune: 'lullaby', fam: [['전자 피아노 재즈', '로즈 피아노 연주']] },
  { id: 'harpsichord', name: '하프시코드', sub: 'key_piano', gm: 'harpsichord', lo: 36, hi: 90, desc: '피아노의 할아버지예요. 줄을 뜯어서 찰랑찰랑!', tech: [T.short, T.chord, T.arp], tune: 'minuet', fam: [['바흐 「골드베르크 변주곡」', '골드베르크 변주곡 하프시코드']] },
  { id: 'honkytonk', name: '낡은 피아노', sub: 'key_piano', gm: 'honkytonk_piano', lo: 36, hi: 90, desc: '조율이 살짝 틀어진 옛날 술집 피아노 소리예요.', tech: [T.short, T.chord], tune: 'cancan', fam: [['스콧 조플린 「엔터테이너」', '엔터테이너 스콧 조플린']] },
  // ---- 오르간·반짝이
  { id: 'organ', name: '파이프 오르간', sub: 'key_organ', gm: 'church_organ', lo: 36, hi: 90, desc: '수많은 파이프에 바람을 넣어요. 성당을 가득 채워요.', tech: [T.long, T.chord, T.short], tune: 'toccata', fam: [['바흐 「토카타와 푸가 라단조」', '토카타와 푸가 라단조']] },
  { id: 'eorgan', name: '전자 오르간', sub: 'key_organ', gm: 'drawbar_organ', lo: 36, hi: 84, desc: '전기로 바람 소리를 흉내 낸 오르간이에요.', tech: [T.long, T.chord, T.short], tune: 'saints', fam: [['해먼드 오르간 재즈', '해먼드 오르간 연주']] },
  { id: 'celesta', name: '첼레스타', sub: 'key_organ', gm: 'celesta', lo: 60, hi: 96, desc: '건반으로 쇠막대를 쳐요. 요정 같은 소리!', tech: [T.short, T.arp, T.chord], tune: 'sugarplum', fam: [['차이콥스키 「사탕 요정의 춤」', '사탕요정의 춤 첼레스타']] },
  { id: 'music_box', name: '오르골', sub: 'key_organ', gm: 'music_box', lo: 60, hi: 96, desc: '태엽을 감으면 저절로 연주해요.', tech: [T.short, T.arp, T.soft], tune: 'twinkle', fam: [['오르골 자장가', '오르골 자장가']] },
  // ---- 목소리
  { id: 'choir', name: '합창 (아~)', sub: 'voice_human', gm: 'choir_aahs', lo: 48, hi: 79, desc: '여러 사람이 아~ 하고 함께 불러요.', tech: [T.long, T.chord, T.soft], tune: 'amazing', fam: [['헨델 「할렐루야」', '헨델 할렐루야 합창']] },
  { id: 'oohs', name: '허밍 (우~)', sub: 'voice_human', gm: 'voice_oohs', lo: 48, hi: 79, desc: '입을 오므리고 우~ 하고 불러요.', tech: [T.long, T.chord, T.soft], tune: 'lullaby', fam: [['브람스 「자장가」', '브람스 자장가']] },
  { id: 'whistle', name: '휘파람', sub: 'voice_human', gm: 'whistle', lo: 72, hi: 96, desc: '입술을 모아 휘익 불어요.', tech: [T.long, T.short, T.vib], tune: 'twinkle', fam: [['휘파람 연주', '휘파람 연주']] },
  // ---- 전자
  { id: 'synth_lead', name: '전자 멜로디 소리', sub: 'voice_synth', gm: 'lead_1_square', lo: 48, hi: 90, desc: '옛날 게임기에서 나던 삐삐 소리예요.', tech: [T.long, T.short, T.vib], tune: 'ode', fam: [['8비트 게임 음악', '8비트 게임 음악']] },
  { id: 'synth_pad', name: '포근한 전자 소리', sub: 'voice_synth', gm: 'pad_2_warm', lo: 36, hi: 84, desc: '구름처럼 넓게 퍼지는 소리예요.', tech: [T.long, T.chord], tune: 'lullaby', fam: [['앰비언트 음악', '앰비언트 음악']] },
  { id: 'synth_bass', name: '전자 베이스', sub: 'voice_synth', gm: 'synth_bass_1', lo: 28, hi: 60, desc: '둥둥 울리는 낮은 전자 소리예요.', tech: [T.long, T.short], tune: 'bassline', fam: [['일렉트로닉 베이스', '신스 베이스']] },
  { id: 'synth_strings', name: '전자 현악', sub: 'voice_synth', gm: 'synth_strings_1', lo: 36, hi: 84, desc: '컴퓨터로 흉내 낸 현악 합주 소리예요.', tech: [T.long, T.chord], tune: 'canon', fam: [['신시사이저 연주', '신시사이저 연주']] },
