</script>

<script>
/* 오래된 웹 엔진(크롬 84 이전, 전자칠판 앱 등)은 flex 칸 사이 간격(gap)을 모름 → 여백으로 대신 채움 */
(function(){try{
 var t=document.createElement('div');t.style.cssText='display:flex;flex-direction:column;row-gap:1px;position:absolute;visibility:hidden';
 t.appendChild(document.createElement('div'));t.appendChild(document.createElement('div'));
 document.documentElement.appendChild(t);var ok=t.scrollHeight===1;t.remove();if(ok)return;
 function fix(){var all=document.body.getElementsByTagName('*');
  for(var i=0;i<all.length;i++){var el=all[i],cs=getComputedStyle(el);
   if(cs.display.indexOf('flex')<0)continue;
   var cg=parseFloat(cs.columnGap)||0,rg=parseFloat(cs.rowGap)||0;if(!cg&&!rg)continue;
   var col=cs.flexDirection.indexOf('column')===0,wrap=cs.flexWrap!=='nowrap',kids=el.children,first=true;
   for(var k=0;k<kids.length;k++){var c=kids[k];if(c.__g)continue;var ks=getComputedStyle(c);
    if(ks.display==='none'||ks.position==='absolute'||ks.position==='fixed')continue;c.__g=1;
    if(col){if(!first)c.style.marginTop=(parseFloat(ks.marginTop)||0)+rg+'px'}
    else{c.style.marginLeft=(parseFloat(ks.marginLeft)||0)+cg/2+'px';c.style.marginRight=(parseFloat(ks.marginRight)||0)+cg/2+'px';if(wrap){c.style.marginTop=(parseFloat(ks.marginTop)||0)+rg/2+'px';c.style.marginBottom=(parseFloat(ks.marginBottom)||0)+rg/2+'px'}}
    first=false}}}
 var tm=0;function later(){clearTimeout(tm);tm=setTimeout(fix,60)}
 addEventListener('load',fix);new MutationObserver(later).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class','style']});later();
}catch(e){}})();
</script>
<script>
// 초승달 전과로 돌아가는 단추 (늘 보여요): ◀ 이전 = 이 앱의 소개 화면, 🏠 홈 = 앱 고르기 화면
(function () {
  const go = h => { if (window.parent !== window) { try { window.parent.postMessage({ hub: 'close', h }, '*'); } catch (e) {} return; } location.href = encodeURI('혜광전과초등.html') + h; };
  const box = document.createElement('div'); box.id = 'hub-nav';
  box.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:20000;display:flex;gap:5px";
  const mk = (t, h) => { const b = document.createElement('button'); b.textContent = t; b.onclick = () => go(h);
    b.style.cssText = "background:#fff;border:2px solid #4a3428;border-radius:99px;padding:3px 11px;font:15px 'Jua','Malgun Gothic',sans-serif;color:#4a3428;cursor:pointer;box-shadow:0 2px 0 #f6c85f"; return b; };
  box.appendChild(mk('◀ 이전', '#app=goat')); box.appendChild(mk('🏠 홈', '#apps'));
  // 초승달 전과 초등에서 단원 칸을 눌러 들어오면 그 활동으로 바로 가요
  const H = window.__HUB_START;
  if (H && H.app === 'goat' && H.d != null) addEventListener('load', () => setTimeout(() => { try { const d = +H.d; const hc = document.getElementById('helpClose'); if (hc && hc.offsetParent) hc.click(); const b = document.querySelector('[data-go="' + ['bocce','move','helper'][d] + '"]'); if (b) b.click(); } catch (e) {} }, 700), { once: true });
  (document.body ? Promise.resolve() : new Promise(r => document.addEventListener('DOMContentLoaded', r))).then(() => document.body.appendChild(box));
})();
</script>
<script>
/* 이모지를 그림으로 보여 줌 — 칠판(안드로이드)마다 이모지 글꼴이 달라 빈칸이 생기지 않게. 글자는 그대로 두고 그 위에 그림을 보여 줌.
   그림: Noto Emoji (Google, Apache License 2.0) */
(function(){
const EB=["", "", ""];
const EK=["\u25b6", "\u25c0", "\ud83c\udfe0"];
const css=EK.map((k,i)=>'.emi.e'+i+'{background-image:url(data:image/webp;base64,'+EB[i]+')}').join('');
const IDX={};EK.forEach((k,i)=>IDX[k]=i);
const keys=EK.slice().sort((a,b)=>b.length-a.length);
const esc=s=>[...s].map(c=>c.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\uFE0F?').join('');
const RE=new RegExp('(?:'+keys.map(esc).join('|')+')','gu');
const SKIP={SCRIPT:1,STYLE:1,TEXTAREA:1,INPUT:1,TITLE:1,OPTION:1};
function fix(node){
  if(node.nodeType===3){const t=node.nodeValue;if(!t)return;RE.lastIndex=0;if(!RE.test(t))return;RE.lastIndex=0;
    const p=node.parentNode;if(!p||SKIP[p.nodeName]||(p.classList&&p.classList.contains('emi'))||(p.closest&&p.closest('svg')))return;
    const f=document.createDocumentFragment();let last=0,m;
    while((m=RE.exec(t))){if(m.index>last)f.appendChild(document.createTextNode(t.slice(last,m.index)));
      const sp=document.createElement('span');sp.className='emi e'+IDX[m[0].replace(/\uFE0F/g,'')];sp.textContent=m[0];f.appendChild(sp);last=m.index+m[0].length}
    if(last<t.length)f.appendChild(document.createTextNode(t.slice(last)));p.replaceChild(f,node);return}
  if(node.nodeType===1){if(SKIP[node.nodeName]||node.nodeName==='svg'||(node.classList&&node.classList.contains('emi')))return;for(const c of [...node.childNodes])fix(c)}}
const st=document.createElement('style');st.textContent='.emi{display:inline-block;width:1.15em;height:1.15em;line-height:1.15em;vertical-align:-0.2em;background:center/contain no-repeat;color:transparent!important;-webkit-text-fill-color:transparent!important;text-shadow:none!important;overflow:hidden;text-align:center;white-space:nowrap}'+css;
(document.head||document.documentElement).appendChild(st);
const IM={};window.__EMI=e=>{const k=(e||'').replace(/\uFE0F/g,'');const i=IDX[k];if(i===undefined)return null;if(!IM[k]){IM[k]=new Image();IM[k].src='data:image/webp;base64,'+EB[i]}return IM[k]};
const mo=new MutationObserver(ms=>{for(const m of ms){if(m.type==='characterData')fix(m.target);else for(const n of m.addedNodes)fix(n)}});
function go(){fix(document.body);mo.observe(document.body,{childList:true,subtree:true,characterData:true})}
if(document.body)go();else document.addEventListener('DOMContentLoaded',go);
})();
</script>
</body>
</html>
