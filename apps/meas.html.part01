/* ICONKIT: Gemini 그림 아이콘 + 특징 애니메이션 (build.py가 ICONS 데이터와 함께 넣음) */
(function () {
  if (window.GI) return;
  const css = `
.gi{display:inline-block;position:relative;vertical-align:middle;line-height:0;border-radius:14%;overflow:hidden;flex:none}
.gi img{width:100%;height:100%;object-fit:cover;display:block;-webkit-user-drag:none;user-select:none;pointer-events:none}
.gi.round{border-radius:50%}
.gi.fit img{object-fit:contain}
.gi .f2{position:absolute;inset:0;opacity:0}
.gi.two .f1{animation:giA 0.9s steps(1) infinite}
.gi.two .f2{animation:giB 0.9s steps(1) infinite}
@keyframes giA{0%{opacity:1}50%{opacity:0}}
@keyframes giB{0%{opacity:0}50%{opacity:1}}
.gi-in{display:block;width:100%;height:100%;transform-origin:50% 80%}
.gi.a-fly>.gi-in{animation:giFly 2.2s ease-in-out infinite}
.gi.a-hop>.gi-in{animation:giHop 1.1s ease-in-out infinite}
.gi.a-swim>.gi-in{animation:giSwim 2s ease-in-out infinite}
.gi.a-wiggle>.gi-in{animation:giWig 1.4s ease-in-out infinite}
.gi.a-sway>.gi-in{animation:giSway 2.6s ease-in-out infinite;transform-origin:50% 100%}
.gi.a-spin>.gi-in{animation:giSpin 2.4s linear infinite;transform-origin:50% 50%}
.gi.a-bounce>.gi-in{animation:giHop .8s cubic-bezier(.5,0,.5,1) infinite}
.gi.a-roll>.gi-in{animation:giRoll 2.4s ease-in-out infinite;transform-origin:50% 50%}
.gi.a-drive>.gi-in{animation:giDrive 1.8s ease-in-out infinite}
.gi.a-pulse>.gi-in,.gi.a-shine>.gi-in{animation:giPulse 1.6s ease-in-out infinite;transform-origin:50% 50%}
.gi.a-shine>.gi-in{filter:drop-shadow(0 0 0 #fff6a0);animation:giShine 1.6s ease-in-out infinite}
.gi.a-flicker>.gi-in{animation:giFlick .5s steps(2) infinite}
.gi.a-shiver>.gi-in{animation:giShiv .25s linear infinite}
.gi.a-ring>.gi-in{animation:giRing 1.2s ease-in-out infinite;transform-origin:50% 10%}
.gi.a-grow>.gi-in{animation:giGrow 2.2s ease-in-out infinite;transform-origin:50% 100%}
.gi.a-melt>.gi-in{animation:giMelt 2.6s ease-in-out infinite;transform-origin:50% 100%}
.gi.a-pour>.gi-in{animation:giPour 2.4s ease-in-out infinite;transform-origin:30% 80%}
.gi.a-stick>.gi-in{animation:giStick 1.6s cubic-bezier(.7,0,.3,1.4) infinite}
.gi.a-steam::after,.gi.a-drip::after,.gi.a-splash::after,.gi.a-rain::after,.gi.a-snow::after{content:"";position:absolute;left:0;right:0;top:0;bottom:0;pointer-events:none}
.gi.a-steam::after{background:radial-gradient(circle at 40% 70%,rgba(255,255,255,.85) 0 6%,transparent 7%),radial-gradient(circle at 58% 70%,rgba(255,255,255,.75) 0 5%,transparent 6%);animation:giSteam 1.8s linear infinite}
.gi.a-drip::after,.gi.a-splash::after{background:radial-gradient(circle at 50% 20%,rgba(90,170,255,.9) 0 5%,transparent 6%);animation:giDrip 1.4s ease-in infinite}
.gi.a-rain::after{background:repeating-linear-gradient(105deg,transparent 0 9px,rgba(80,150,255,.55) 9px 11px);animation:giRain .6s linear infinite}
.gi.a-snow::after{background:radial-gradient(circle,#fff 0 2px,transparent 3px) 0 0/22px 22px;animation:giSnow 2.4s linear infinite}
@keyframes giFly{0%,100%{transform:translateY(0)}50%{transform:translateY(-9%)}}
@keyframes giHop{0%,100%{transform:translateY(0) scaleY(1)}35%{transform:translateY(-14%) scaleY(1.03)}55%{transform:translateY(0) scaleY(.94)}}
@keyframes giSwim{0%,100%{transform:translateX(-4%) rotate(-3deg)}50%{transform:translateX(4%) rotate(3deg)}}
@keyframes giWig{0%,100%{transform:rotate(0)}25%{transform:rotate(-5deg)}75%{transform:rotate(5deg)}}
@keyframes giSway{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}
@keyframes giSpin{to{transform:rotate(360deg)}}
@keyframes giRoll{0%,100%{transform:translateX(-6%) rotate(-20deg)}50%{transform:translateX(6%) rotate(20deg)}}
@keyframes giDrive{0%,100%{transform:translateX(-5%)}50%{transform:translateX(5%) translateY(-1%)}}
@keyframes giPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
@keyframes giShine{0%,100%{filter:brightness(1)}50%{filter:brightness(1.25) saturate(1.2)}}
@keyframes giFlick{0%{filter:brightness(1)}50%{filter:brightness(1.18)}}
@keyframes giShiv{0%,100%{transform:translateX(0)}25%{transform:translateX(-1.5%)}75%{transform:translateX(1.5%)}}
@keyframes giRing{0%,100%{transform:rotate(0)}20%{transform:rotate(10deg)}40%{transform:rotate(-10deg)}60%{transform:rotate(6deg)}80%{transform:rotate(-4deg)}}
@keyframes giGrow{0%{transform:scale(.85)}60%,100%{transform:scale(1)}}
@keyframes giMelt{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.92) scaleX(1.04)}}
@keyframes giPour{0%,100%{transform:rotate(0)}50%{transform:rotate(-12deg)}}
@keyframes giStick{0%,100%{transform:translateX(0)}40%{transform:translateX(6%)}55%{transform:translateX(3%)}}
@keyframes giSteam{0%{transform:translateY(0);opacity:.9}100%{transform:translateY(-40%);opacity:0}}
@keyframes giDrip{0%{transform:translateY(0);opacity:1}100%{transform:translateY(60%);opacity:0}}
@keyframes giRain{to{background-position:0 22px}}
@keyframes giSnow{to{background-position:0 44px}}
@media (prefers-reduced-motion:reduce){.gi .gi-in,.gi img,.gi::after{animation:none!important}}
`;
  const st = document.createElement('style'); st.textContent = css;
  (document.head || document.documentElement).appendChild(st);
  // anim: 2장 애니메이션 이름은 그림 바꾸기로, 나머지는 CSS 움직임으로
  const TWO = new Set(['flap', 'walk', 'run', 'wave', 'chew', 'open', 'push', 'pull']);
  const A = window.ICON_ANIM || {};
  window.GI = {
    has: id => !!(window.ICONS && window.ICONS[id]),
    /* GI.html(id, sizeCSS, extraClass, fallbackText) → HTML 문자열. 그림이 없으면 fallbackText(이모지)를 그대로 돌려줌 */
    html(id, size, cls, fb) {
      const v = window.ICONS && window.ICONS[id];
      if (!v) return fb == null ? '' : fb;
      const an = A[id] || 'none';
      const two = v.length > 1;
      const s = size ? `width:${size};height:${typeof size === 'string' && size.endsWith('em') ? (parseFloat(size) * 0.75) + 'em' : 'calc(' + size + ' * 0.75)'}` : '';
      const motion = (!two || !TWO.has(an)) && an !== 'none' ? ' a-' + an : '';
      return `<span class="gi${two ? ' two' : ''}${motion}${cls ? ' ' + cls : ''}" style="${s}"><span class="gi-in" style="position:relative;display:block">` +
        `<img class="f1" src="${v[0]}" alt="">` + (two ? `<img class="f2" src="${v[1]}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">` : '') +
        `</span></span>`;
    },
    /* 이미 있는 요소 el 안의 내용을 그림으로 바꿈 */
    put(el, id, size, cls) { if (el && this.has(id)) el.innerHTML = this.html(id, size, cls); },
  };
})();

const CHARS = {
  wol:  { name:'월이', color:'#0369a1', img:'data:image/webp;base64,' },
  ari:  { name:'아리', color:'#9333ea', img:'data:image/webp;base64,' },
  hami: { name:'대롱이', color:'#db2777', img:'data:image/webp;base64,' }
};
document.querySelectorAll('img[data-char]').forEach(el => el.src = CHARS[el.dataset.char].img);
const $ = id => document.getElementById(id);
const stage = $('stage');
let SC = 1;
function fit() {
  const vv = window.visualViewport, W = vv ? vv.width : innerWidth, H = vv ? vv.height : innerHeight;
  SC = Math.min(W / 1280, H / 720);
  stage.style.transform = `scale(${SC})`;
  $('wrap').style.width = 1280 * SC + 'px'; $('wrap').style.height = 720 * SC + 'px';
  $('wrap').style.top = (H > W ? 0 : Math.max(0, (H - 720 * SC) / 2)) + 'px';
}
addEventListener('resize', fit); addEventListener('orientationchange', () => setTimeout(fit, 300)); if (window.visualViewport) visualViewport.addEventListener('resize', fit); fit();
const pick = a => a[Math.floor(Math.random() * a.length)];

// ===================== 소리 =====================
let soundOn = true, AC = null;
function ac() { try { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); if (AC.state === 'suspended') AC.resume(); } catch (e) {} return AC; }
function tone(f, t, dur, type = 'sine', vol = .2, f2) {
  const a = ac(); if (!a) return;
  const o = a.createOscillator(), g = a.createGain();
  o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dur);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + .01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
  o.connect(g).connect(a.destination); o.start(t); o.stop(t + dur + .02);
}
function toggleSound() { soundOn = !soundOn; $('snd-home').innerText = soundOn ? '🔊 소리 켜짐' : '🔇 소리 꺼짐'; $('snd-play').innerText = soundOn ? '🔊' : '🔇'; if (!soundOn) stopVoice(true); }
const VOICE_KEY = 'meas-voice';
// ===================== 음성 (최소 대사 방식) =====================
// 화면 말풍선은 문장 그대로, 소리는 짧은 대사 조각만 읽어요.
// VOICE_SPRITES 의 clips 에 [시작초, 끝초]가 있으면 녹음을 틀고, 없으면 기기 목소리로 읽어요.
// 공통 녹음(모든 앱이 같이 씀) + 앱 녹음, 여러 개를 함께 쓸 수 있어요.
const VOICE_SPRITES = [{"name": "클로바더빙 녹음", "src": "data:audio/mpeg;base64,