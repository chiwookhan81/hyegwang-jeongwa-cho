    h:'발자국 하나가 한 걸음이에요. 하나씩 세어 봐요.', e:'밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요.' },
  { q:'꽃밭의 길이는 몇 걸음일까요?', v:{k:'units', objs:[{shape:'field', n:4, u:110, x:210, y:150, unit:'step', lab:'꽃밭', deco:'🌷', col:'#fbcfe8'}]}, o:['3걸음','4걸음','8걸음'], a:1,
