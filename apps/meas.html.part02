  { q:'두 밭 중 어느 밭이 더 길까요?', v:{k:'units', objs:[{shape:'field', n:7, u:95, x:110, y:60, unit:'step', lab:'가 밭', th:76},{shape:'field', n:5, u:95, x:110, y:250, unit:'step', lab:'나 밭', th:76, col:'#fde68a'}]}, o:['가 밭','나 밭'], a:0,
