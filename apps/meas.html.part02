  { q:'나무 판자는 몇 뼘일까요?', v:{k:'units', objs:[{shape:'plank', n:6, u:105, x:140, y:220, unit:'span', lab:'판자'}]}, o:['5뼘','6뼘','7뼘'], a:1,
    h:'왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요.', e:'판자 길이를 알면 무엇을 만들지 정할 수 있어요.' },
  { q:'의자의 높이는 몇 뼘일까요?', v:{k:'units', objs:[{shape:'chair', dir:'v', n:3, u:90, x:380, y:360, w:150, unit:'span', lab:'의자'}]}, o:['2뼘','3뼘','4뼘'], a:1,
    h:'바닥부터 위로 손 모양을 세어 봐요.', e:'의자 높이가 알맞아야 편하게 앉을 수 있어요.' },
]},
{ id:'step', tier:0, icon:'👣', name:'걸음으로 재기', job:'🧑‍🌾 농부', what:'밭의 길이', sc:{bg:'#dcfce7', main:'🧑‍🌾', tools:['🌱','🥬','🚜','🌻']},
