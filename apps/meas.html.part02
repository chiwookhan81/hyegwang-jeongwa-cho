// ===================== 그림 그리기 =====================
const R = {};
function sceneSVG(S) {
  const c = S.sc;
  if (typeof SCIMG !== 'undefined' && SCIMG[S.id]) return `<image href="${SCIMG[S.id]}" x="0" y="0" width="400" height="300" preserveAspectRatio="xMidYMid slice"/>`;
  return `<rect width="400" height="300" fill="${c.bg}"/><circle cx="330" cy="55" r="70" fill="#fff" opacity=".4"/><circle cx="60" cy="40" r="40" fill="#fff" opacity=".3"/><rect y="222" width="400" height="78" fill="#fff" opacity=".5"/>` +
    em(200, 150, 140, c.main) + c.tools.map((t, i) => em([72, 328, 78, 322][i], [84, 92, 248, 244][i], 66, t)).join('');
}
// 비교: 바지·목도리·키
R.cmp = (v, st) => {
  let s = ''; const it = v.items;
  if (v.dir === 'v') {
    const base = 360, gap = 860 / (it.length + 1);
    s += `<rect x="30" y="${base}" width="800" height="12" rx="6" fill="#d6d3d1"/>`;
    it.forEach((o, i) => {
      const x = gap * (i + 1), h = o.len, c = o.col || PAL[i];
      if (o.shape === 'char') s += `<image href="${CHARS[o.ch].img}" x="${x - h / 2}" y="${base - h}" width="${h}" height="${h}" preserveAspectRatio="xMidYMax meet"/>`;
      else if (o.shape === 'pants') s += `<path d="M${x - 48},${base - h} h96 l10,${h} h-44 l-14,-${h * .62} l-14,${h * .62} h-44 z" fill="${c}" stroke="#57534e" stroke-width="3" stroke-linejoin="round"/><rect x="${x - 48}" y="${base - h}" width="96" height="16" fill="#fff" opacity=".5"/>`;
      else s += `<rect x="${x - 35}" y="${base - h}" width="70" height="${h}" rx="10" fill="${c}" stroke="#57534e" stroke-width="3"/>`;
      if (st.hint) s += `<line x1="30" y1="${base - h}" x2="830" y2="${base - h}" stroke="#2563eb" stroke-dasharray="10 8" stroke-width="3" opacity=".7"/>`;
      s += tx(x, base + 26, 26, o.lab, '#0c4a6e');
      if (st.done && o.ok) s += star(x, base - h - 26);
    });
    return s;
  }
  const n = it.length, gap = 340 / n, al = st.hint || st.done, xc = Math.min(...it.map(o => o.x0 ?? 140));
  it.forEach((o, i) => {
    const y = 40 + gap * i + gap / 2, x0 = al ? xc : (o.x0 ?? 140), c = o.col || PAL[i];
    s += tx(75, y, 26, o.lab, o.ref ? '#78716c' : '#0c4a6e');
    if (o.shape === 'scarf') {
      s += `<rect x="${x0}" y="${y - 22}" width="${o.len}" height="44" rx="8" fill="${c}" stroke="#57534e" stroke-width="3"/>`;
      for (let k = x0 + 30; k < x0 + o.len - 10; k += 40) s += `<line x1="${k}" y1="${y - 20}" x2="${k}" y2="${y + 20}" stroke="#fff" stroke-width="6" opacity=".55"/>`;
      for (let k = -16; k <= 16; k += 8) s += `<line x1="${x0}" y1="${y + k}" x2="${x0 - 12}" y2="${y + k}" stroke="${c}" stroke-width="4"/><line x1="${x0 + o.len}" y1="${y + k}" x2="${x0 + o.len + 12}" y2="${y + k}" stroke="${c}" stroke-width="4"/>`;
    } else s += `<rect x="${x0}" y="${y - 18}" width="${o.len}" height="36" rx="18" fill="${c}" stroke="${o.ref ? '#a8a29e' : '#57534e'}" stroke-width="3" ${o.ref ? 'stroke-dasharray="8 6"' : ''}/>`;
    if (st.hint) s += `<line x1="${x0 + o.len}" y1="30" x2="${x0 + o.len}" y2="390" stroke="${o.ref ? '#78716c' : '#2563eb'}" stroke-dasharray="8 7" stroke-width="3" opacity=".6"/>`;
    if (st.done && o.ok) s += star(x0 + o.len + 34, y);
  });
  if (al) s += `<line x1="${xc}" y1="30" x2="${xc}" y2="390" stroke="#16a34a" stroke-width="4" stroke-dasharray="10 6"/>`;
  if (st.hint && v.mis) s += pill(560, 380, '왼쪽 끝을 똑같이 맞췄어요', '#2563eb', 20);
  return s;
};
// 임의 단위: 뼘·걸음·블록·클립
function vaseD(cx, by, h, w, kind) {
  if (kind === 'cup') return `M${cx - w * .42},${by - h} L${cx + w * .42},${by - h} L${cx + w * .32},${by} L${cx - w * .32},${by} Z`;
  if (kind === 'jar') return `M${cx - w * .3},${by} Q${cx - w * .62},${by - h * .5} ${cx - w * .3},${by - h * .9} L${cx - w * .32},${by - h} L${cx + w * .32},${by - h} L${cx + w * .3},${by - h * .9} Q${cx + w * .62},${by - h * .5} ${cx + w * .3},${by} Z`;
  return `M${cx - w * .25},${by} L${cx - w * .35},${by - h * .35} Q${cx - w * .55},${by - h * .62} ${cx - w * .16},${by - h * .85} L${cx - w * .22},${by - h} L${cx + w * .22},${by - h} L${cx + w * .16},${by - h * .85} Q${cx + w * .55},${by - h * .62} ${cx + w * .35},${by - h * .35} L${cx + w * .25},${by} Z`;
}
R.units = (v, st) => {
  let s = '', num = 0;
  v.objs.forEach((o, oi) => {
    num = 0;
    const nf = Math.floor(o.n + 1e-9), u = o.u;
    if (o.dir === 'v') {
      const h = o.n * u, w = o.w || 140, cx = o.x, by = o.y;
      s += `<rect x="${cx - 260}" y="${by}" width="520" height="10" rx="5" fill="#d6d3d1"/>`;
      if (o.shape === 'chair') s += `<rect x="${cx - w / 2}" y="${by - h}" width="${w}" height="20" rx="6" fill="#d6a76c" stroke="#78350f" stroke-width="3"/><rect x="${cx - w / 2 + 8}" y="${by - h + 20}" width="16" height="${h - 20}" fill="#b45309"/><rect x="${cx + w / 2 - 24}" y="${by - h + 20}" width="16" height="${h - 20}" fill="#b45309"/><rect x="${cx - w / 2 + 8}" y="${by - h - 120}" width="16" height="120" fill="#b45309" opacity=".5"/>`;
      else if (o.shape === 'rect') s += `<rect x="${cx - w / 2}" y="${by - h}" width="${w}" height="${h}" rx="8" fill="${o.col || '#d6a76c'}" stroke="#57534e" stroke-width="3"/>`;
      else s += `<path d="${vaseD(cx, by, h, w, o.shape)}" fill="${o.col || '#93c5fd'}" stroke="#57534e" stroke-width="3" stroke-linejoin="round"/><path d="M${cx - w * .12},${by - h * .7} q${w * .1},${-h * .08} ${w * .2},0" stroke="#fff" stroke-width="5" fill="none" opacity=".6"/>`;
      s += tx(cx, by + 28, 24, o.lab, '#0c4a6e');
      const xr = cx + w / 2 + 14;
      for (let i = 0; i < nf; i++) {
        const y2 = by - i * u, y1 = y2 - u, c = PAL[(i % 2) ? 1 : 0];
        if (o.unit === 'block') { s += `<rect x="${xr}" y="${y1 + 2}" width="${u - 4}" height="${u - 4}" rx="6" fill="${PAL[i % 4 + 2]}" stroke="#57534e" stroke-width="2.5"/>`; if (st.hint) s += badge(xr + u + 18, (y1 + y2) / 2, ++num); }
        else { s += `<path d="M${xr - 8},${y2 - 3} Q${xr + 66},${(y1 + y2) / 2} ${xr - 8},${y1 + 3}" fill="none" stroke="${c}" stroke-width="6" stroke-linecap="round"/>` + gem(xr + 44, (y1 + y2) / 2, Math.min(44, u * .8), MI(50), '✋', 30); if (st.hint) s += badge(xr + 92, (y1 + y2) / 2, ++num); }
      }
      return;
    }
    const w = o.n * u, x = o.x, y = o.y, th = o.th || (o.shape === 'field' ? 90 : 40);
    if (o.shape === 'table') s += `<rect x="${x}" y="${y}" width="${w}" height="26" rx="6" fill="${o.col || '#d6a76c'}" stroke="#78350f" stroke-width="3"/><rect x="${x + 14}" y="${y + 26}" width="18" height="64" fill="#b45309"/><rect x="${x + w - 32}" y="${y + 26}" width="18" height="64" fill="#b45309"/>`;
    else if (o.shape === 'field') { s += `<rect x="${x}" y="${y}" width="${w}" height="${th}" rx="10" fill="${o.col || '#86efac'}" stroke="#15803d" stroke-width="3"/>`; if (o.deco) for (let k = x + 30; k < x + w - 20; k += 70) s += gem(k, y - 18, 34, GI_DECO[o.deco], o.deco, 26); }
    else if (o.shape === 'fence') { s += `<rect x="${x}" y="${y + 10}" width="${w}" height="12" fill="#b45309"/><rect x="${x}" y="${y + 40}" width="${w}" height="12" fill="#b45309"/>`; for (let k = x; k <= x + w + 1; k += 40) s += `<rect x="${Math.min(k, x + w - 14)}" y="${y - 10}" width="14" height="80" rx="4" fill="#d97706" stroke="#78350f" stroke-width="2"/>`; }
    else if (o.shape === 'brush') s += `<rect x="${x}" y="${y}" width="${w * .78}" height="24" rx="12" fill="#ef4444" stroke="#7f1d1d" stroke-width="3"/><rect x="${x + w * .78}" y="${y + 2}" width="${w * .06}" height="20" fill="#a8a29e"/><path d="M${x + w * .84},${y} q${w * .12},6 ${w * .16},12 q-${w * .04},6 -${w * .16},12 z" fill="#1c1917"/>`;
    else if (o.shape === 'plate') s += `<ellipse cx="${x + w / 2}" cy="${y + 20}" rx="${w / 2}" ry="26" fill="#f8fafc" stroke="#64748b" stroke-width="3"/><ellipse cx="${x + w / 2}" cy="${y + 20}" rx="${w / 2 - 40}" ry="14" fill="none" stroke="#93c5fd" stroke-width="4"/>`;
    else { s += `<rect x="${x}" y="${y}" width="${w}" height="${th}" rx="6" fill="${o.col || '#d6a76c'}" stroke="#78350f" stroke-width="3"/>`; for (let k = 0; k < 3; k++) s += `<path d="M${x + 10},${y + 10 + k * 10} q${w / 3},-6 ${w - 20},0" stroke="#78350f" stroke-width="1.5" fill="none" opacity=".35"/>`; }
    s += o.unit === 'step' && o.shape === 'field' ? tx(x + w / 2, y + th + 24, 24, o.lab, '#0c4a6e') : tx(x - 52 > 20 ? x - 52 : x + w / 2, x - 52 > 20 ? y + th / 2 : y + th + 70, 22, o.lab, '#0c4a6e');
    for (let i = 0; i < nf; i++) {
      const x1 = x + i * u, x2 = x1 + u, mx = (x1 + x2) / 2, c = PAL[(i % 2) ? 1 : 0];
      if (o.unit === 'span') { const hh = o.small ? 46 : 64; s += `<path d="M${x1 + 3},${y - 4} Q${mx},${y - hh * 1.3} ${x2 - 3},${y - 4}" fill="none" stroke="${c}" stroke-width="6" stroke-linecap="round"/>` + gem(mx, y - hh * .62, Math.min(o.small ? 34 : 44, u * .8), MI(50), '✋', o.small ? 24 : 30); if (st.hint) s += badge(mx, y - hh * .62 - 34, ++num); }
      else if (o.unit === 'step') { const yy = o.shape === 'field' ? y + th / 2 : y + th + 46; s += gem(mx, yy, Math.min(54, u * .62), MI(51), '👣', Math.min(46, u * .55)); if (i) s += `<line x1="${x1}" y1="${yy - 26}" x2="${x1}" y2="${yy + 26}" stroke="#15803d" stroke-dasharray="5 5" stroke-width="2"/>`; if (st.hint) s += badge(mx, yy - 40, ++num); }
      else if (o.unit === 'clip') { const yy = y + (o.shape === 'plate' ? 80 : th + 40); s += `<rect x="${x1 + 4}" y="${yy - 14}" width="${u - 8}" height="28" rx="14" fill="none" stroke="${['#64748b', '#0ea5e9', '#e11d48', '#16a34a'][i % 4]}" stroke-width="5"/><rect x="${x1 + 14}" y="${yy - 6}" width="${u - 30}" height="12" rx="6" fill="none" stroke="${['#64748b', '#0ea5e9', '#e11d48', '#16a34a'][i % 4]}" stroke-width="4"/>`; if (st.hint) s += badge(mx, yy + 36, ++num); }
    }
    if (o.n - nf > .05 && st.hint) s += pill(x + w - (o.n - nf) * u / 2, y + th + 40, '조금', '#f97316', 18);
  });
  return s;
};
// 컵으로 붓기
function cupSVG(cx, cy, k, fill, ghost) {
  const a = 28 * k, b = 21 * k, h = 32 * k;
  if (ghost) return `<path d="M${cx - a},${cy - h} L${cx + a},${cy - h} L${cx + b},${cy + h} L${cx - b},${cy + h} Z" fill="#fff" stroke="#94a3b8" stroke-width="3" stroke-dasharray="7 5"/>` + tx(cx, cy + 2, 30 * k, '?', '#94a3b8');
  return `<path d="M${cx - a},${cy - h} L${cx + a},${cy - h} L${cx + b},${cy + h} L${cx - b},${cy + h} Z" fill="#f8fafc" stroke="#475569" stroke-width="3"/><path d="M${cx - a * .9},${cy - h * .55} L${cx + a * .9},${cy - h * .55} L${cx + b - 2},${cy + h - 2} L${cx - b + 2},${cy + h - 2} Z" fill="${fill}"/>` +
    (fill === '#fef9c3' ? [...Array(6)].map((_, i) => `<ellipse cx="${cx - 12 * k + (i % 3) * 12 * k}" cy="${cy - 4 * k + Math.floor(i / 3) * 14 * k}" rx="4" ry="2.5" fill="#d6d3d1"/>`).join('') : '');
}
R.cups = (v, st) => {
  let s = '', num = 0; const G = v.groups, rowH = Math.min(170, 380 / G.length), top0 = (400 - rowH * G.length) / 2;
  G.forEach((g, gi) => {
    if (!v.cont) num = 0;
    const tot = (g.n || 0) + (g.ghost || 0), x00 = 180 + (g.from ? 110 : 0), avail = 860 - x00 - (g.target ? 110 : 20);
    let k = (G.length === 1 ? 1.5 : 1) * (g.big ? 1.45 : 1); k = Math.min(k, avail / tot / 92);
    const cy = top0 + rowH * gi + rowH / 2, step = 92 * k;
    s += pill(80, cy, g.lab, '#0369a1', 22);
    let x = 180 + (g.big ? 20 : 0);
    if (g.from) { s += gem(x, cy, 78, GI_CUPS[g.from], g.from, 64) + tx(x + 52, cy, 34, '→', '#64748b'); x += 110; }
    for (let i = 0; i < tot; i++) {
      const cx = x + i * step, gh = i >= (g.n || 0), out = g.out && !gh && i >= g.n - g.out;
      s += out ? `<g opacity=".3">${cupSVG(cx, cy, k, '#93c5fd')}</g><path d="M${cx - 22 * k},${cy - 22 * k} L${cx + 22 * k},${cy + 22 * k} M${cx + 22 * k},${cy - 22 * k} L${cx - 22 * k},${cy + 22 * k}" stroke="#ef4444" stroke-width="6" stroke-linecap="round"/>` : cupSVG(cx, cy, k, g.rice ? '#fef9c3' : '#93c5fd', gh);
      if (st.hint && !out) s += badge(cx, cy - 34 * k - 18, ++num, gh ? '#f97316' : '#ef4444', 14);
    }
    if (g.target) s += tx(x + tot * step - 20, cy, 34, '→', '#64748b') + gem(x + tot * step + 50, cy, 92, GI_CUPS[g.target], g.target, 70);
  });
  return s;
};
// 컵 크기 비교
R.glasses = (v, st) => {
  let s = `<rect x="30" y="360" width="800" height="10" rx="5" fill="#d6d3d1"/>`; const n = v.items.length, gap = 860 / (n + 1);
  v.items.forEach((o, i) => {
    const x = gap * (i + 1), w = o.w, h = o.h, lv = h * o.lvl;
    s += `<rect x="${x - w / 2}" y="${360 - lv}" width="${w}" height="${lv}" fill="${o.col || '#93c5fd'}" opacity=".85"/><path d="M${x - w / 2},${360 - h} L${x - w / 2},360 L${x + w / 2},360 L${x + w / 2},${360 - h}" fill="none" stroke="#475569" stroke-width="5" stroke-linejoin="round"/>`;
    if (st.hint) s += `<line x1="30" y1="${360 - lv}" x2="830" y2="${360 - lv}" stroke="#2563eb" stroke-dasharray="10 8" stroke-width="3" opacity=".6"/>`;
    s += tx(x, 388, 26, o.lab, '#0c4a6e');
    if (st.done && o.ok) s += star(x, 360 - h - 26);
  });
  return s;
};
// 양팔저울
function stones(cx, cy, n, hint) { let s = ''; for (let i = 0; i < n; i++) { const r = Math.floor(i / 4), c = i % 4, per = Math.min(4, n - r * 4), x = cx + (c - (per - 1) / 2) * 30, y = cy - 14 - r * 26; s += `<circle cx="${x}" cy="${y}" r="13" fill="#1f2937"/><circle cx="${x - 4}" cy="${y - 4}" r="4" fill="#fff" opacity=".35"/>`; if (hint) s += tx(x, y + 1, 15, i + 1, '#fde047'); } return s; }
R.balance = (v, st) => {
  let s = ''; const B = v.bals, two = B.length > 1;
  B.forEach((b, i) => {
    const k = two ? .78 : 1, cx = two ? 215 + i * 430 : 430;
    s += `<g transform="translate(${cx},0) scale(${k}) translate(${-cx},${two ? 60 : 0})">`;
    const py = 130, d = b.t === 'L' ? 34 : b.t === 'R' ? -34 : 0, Ly = py + d, Ry = py - d, L = 170;
    s += `<path d="M${cx - 70},372 L${cx + 70},372 L${cx + 40},350 L${cx - 40},350 Z" fill="#a16207"/><rect x="${cx - 9}" y="${py}" width="18" height="${222}" fill="#ca8a04"/>`;
    s += `<line x1="${cx - L}" y1="${Ly}" x2="${cx + L}" y2="${Ry}" stroke="#92400e" stroke-width="12" stroke-linecap="round"/><circle cx="${cx}" cy="${py}" r="13" fill="#fde047" stroke="#92400e" stroke-width="4"/>`;
    for (const [side, ex, ey] of [['L', cx - L, Ly], ['R', cx + L, Ry]]) {
      const pyy = ey + 110;
      s += `<line x1="${ex}" y1="${ey}" x2="${ex - 60}" y2="${pyy}" stroke="#78716c" stroke-width="3"/><line x1="${ex}" y1="${ey}" x2="${ex + 60}" y2="${pyy}" stroke="#78716c" stroke-width="3"/><path d="M${ex - 74},${pyy} Q${ex},${pyy + 34} ${ex + 74},${pyy} Z" fill="#e7e5e4" stroke="#78716c" stroke-width="3"/>`;
      const items = b[side];
      if (typeof items[0] === 'string' && items[0][0] === 's' && /^s\d+$/.test(items[0])) s += stones(ex, pyy, +items[0].slice(1), st.hint);
      else { const many = items.length > 1, gw = many ? 54 : 70, gs = many ? 64 : 56; items.forEach((e, j) => { const id = GI_OBJ[e]; s += hasG(id) ? gem(ex + (j - (items.length - 1) / 2) * gs, pyy - gw * .375 - 4, gw, id, e, 56) : em(ex + (j - (items.length - 1) / 2) * 56, pyy - 30, 56, e); }); }
    }
    if (st.hint && b.t !== '=') s += pill(b.t === 'L' ? cx - L : cx + L, 40, '내려간 쪽', '#2563eb', 20);
    if (st.hint && b.t === '=') s += pill(cx, 40, '평평해요', '#16a34a', 20);
    s += `</g>`;
  });
  return s;
};
// 자 (cm)
R.ruler = (v, st) => {
  const x0 = 50, k = 760 / v.max, X = c => x0 + c * k, ry = 230; let s = '';
  s += `<rect x="${x0 - 22}" y="${ry}" width="${v.max * k + 44}" height="92" rx="8" fill="#fef08a" stroke="#ca8a04" stroke-width="3"/>`;
  for (let t = 0; t <= v.max * 10; t++) { const x = X(t / 10), l = t % 10 === 0 ? 34 : t % 5 === 0 ? 22 : 12; s += `<line x1="${x}" y1="${ry}" x2="${x}" y2="${ry + l}" stroke="#713f12" stroke-width="${t % 10 ? 1.4 : 2.6}"/>`; if (t % 10 === 0) s += tx(x, ry + 54, 22, t / 10, '#713f12'); }
  s += tx(X(v.max) + 4, ry + 80, 16, 'cm', '#a16207');
  const a = X(v.s), b = X(v.s + v.L), oy = 182, col = v.col || '#f472b6';
  if (v.obj === 'pencil') s += `<rect x="${a + 22}" y="${oy - 16}" width="${b - a - 70}" height="32" fill="#facc15" stroke="#a16207" stroke-width="3"/><rect x="${a}" y="${oy - 16}" width="24" height="32" rx="4" fill="#fda4af" stroke="#a16207" stroke-width="3"/><path d="M${b - 48},${oy - 16} L${b},${oy} L${b - 48},${oy + 16} Z" fill="#fde68a" stroke="#a16207" stroke-width="3"/><path d="M${b - 14},${oy - 5} L${b},${oy} L${b - 14},${oy + 5} Z" fill="#334155"/>`;
  else if (v.obj === 'nail') s += `<rect x="${a}" y="${oy - 18}" width="10" height="36" rx="3" fill="#64748b"/><path d="M${a + 10},${oy - 6} L${b - 16},${oy - 6} L${b},${oy} L${b - 16},${oy + 6} L${a + 10},${oy + 6} Z" fill="#94a3b8" stroke="#475569" stroke-width="2"/>`;
  else if (v.obj === 'eraser') s += `<rect x="${a}" y="${oy - 22}" width="${b - a}" height="44" rx="6" fill="#fff" stroke="#475569" stroke-width="3"/><rect x="${a + (b - a) * .3}" y="${oy - 22}" width="${(b - a) * .7}" height="44" fill="#60a5fa" stroke="#475569" stroke-width="3"/>`;
  else if (v.obj === 'thread') s += `<path d="M${a},${oy} ${[...Array(12)].map((_, i) => `Q${a + (b - a) * (i + .5) / 12},${oy + (i % 2 ? 8 : -8)} ${a + (b - a) * (i + 1) / 12},${oy}`).join(' ')}" fill="none" stroke="#e11d48" stroke-width="5"/>`;
  else if (v.obj === 'button') { s += `<line x1="${a}" y1="${oy}" x2="${b}" y2="${oy}" stroke="#78716c" stroke-width="4"/>`; for (let i = 0; i < 5; i++) { const cx = a + (b - a) * (i + .5) / 5; s += `<circle cx="${cx}" cy="${oy}" r="18" fill="${PAL[i % 5]}" stroke="#57534e" stroke-width="3"/><circle cx="${cx - 5}" cy="${oy}" r="3" fill="#57534e"/><circle cx="${cx + 5}" cy="${oy}" r="3" fill="#57534e"/>`; } }
  else if (v.obj === 'stick') s += `<rect x="${a}" y="${oy - 18}" width="${b - a}" height="36" rx="5" fill="#d6a76c" stroke="#78350f" stroke-width="3"/><path d="M${a + 10},${oy - 6} q${(b - a) / 2},-6 ${b - a - 20},0 M${a + 10},${oy + 6} q${(b - a) / 2},6 ${b - a - 20},0" stroke="#78350f" stroke-width="1.5" fill="none" opacity=".5"/>`;
  else s += `<path d="M${a},${oy - 18} L${b},${oy - 18} L${b - 10},${oy} L${b},${oy + 18} L${a},${oy + 18} L${a + 10},${oy} Z" fill="${col}" stroke="#9d174d" stroke-width="3" stroke-linejoin="round"/>`;
  s += `<line x1="${a}" y1="${oy + 22}" x2="${a}" y2="${ry}" stroke="#2563eb" stroke-width="2.5" stroke-dasharray="6 5"/><line x1="${b}" y1="${oy + 22}" x2="${b}" y2="${ry}" stroke="#2563eb" stroke-width="2.5" stroke-dasharray="6 5"/>`;
  if (st.hint) {
    s += `<circle cx="${a}" cy="${ry + 54}" r="20" fill="none" stroke="#16a34a" stroke-width="4"/><circle cx="${b}" cy="${ry + 54}" r="20" fill="none" stroke="#ef4444" stroke-width="4"/>`;
    for (let i = 0; i < v.L; i++) { const p = X(v.s + i), q = X(v.s + i + 1); s += `<path d="M${p + 3},${ry + 96} Q${(p + q) / 2},${ry + 130} ${q - 3},${ry + 96}" fill="none" stroke="#ef4444" stroke-width="3"/>` + badge((p + q) / 2, ry + 136, i + 1, '#ef4444', 12); }
  }
  if (st.done) s += pill((a + b) / 2, 120, `${v.L} cm`, '#16a34a', 28);
  return s;
};
// 1m 막대
R.meter = (v, st) => {
  let s = ''; const x0 = 80, w = 700;
  for (let i = 0; i < 10; i++) { s += `<rect x="${x0 + i * 70}" y="200" width="70" height="60" fill="${i % 2 ? '#fde68a' : '#fca5a5'}" stroke="#57534e" stroke-width="2"/>` + tx(x0 + i * 70 + 35, 230, 18, '10cm'); if (st.hint) s += badge(x0 + i * 70 + 35, 296, (i + 1) * 10, '#ef4444', 18); }
  s += `<path d="M${x0},180 q0,-26 30,-26 L${x0 + w / 2 - 20},154 q20,0 20,-24 q0,24 20,24 L${x0 + w - 30},154 q30,0 30,26" fill="none" stroke="#0369a1" stroke-width="4"/>` + pill(x0 + w / 2, 104, '1m', '#0369a1', 28);
  if (st.done) s += pill(x0 + w / 2, 350, '1m = 100cm', '#16a34a', 28);
  return s;
};
// 그림 카드 (단위 고르기)
R.card = (v, st, q) => {
  let s = `<rect x="130" y="24" width="600" height="352" rx="30" fill="#f0f9ff" stroke="#bae6fd" stroke-width="4"/>` + gem(430, 150, 220, GI_CARD[v.emo], v.emo, 150);
  const a = st.done ? `<tspan fill="#16a34a">${ansText(q)}</tspan>` : (v.blank === false ? '' : '<tspan fill="#94a3b8">( ? )</tspan>');
  s += `<text x="430" y="320" font-size="34" text-anchor="middle" fill="#0c4a6e">${v.t} ${v.blank === false ? '' : a}</text>`;
  return s;
};
// 키재기
R.vscale = (v, st) => {
  const top = 30, bot = 370, P = t => bot - (t - v.min) / (v.max - v.min) * (bot - top); let s = '';
  s += `<rect x="452" y="${top - 10}" width="120" height="${bot - top + 20}" rx="10" fill="#fef3c7" stroke="#a16207" stroke-width="3"/><rect x="200" y="${bot}" width="420" height="14" rx="6" fill="#d6d3d1"/>`;
  for (let t = v.min; t <= v.max; t++) { const y = P(t), l = t % 10 === 0 ? 38 : t % 5 === 0 ? 26 : 14; s += `<line x1="452" y1="${y}" x2="${452 + l}" y2="${y}" stroke="#713f12" stroke-width="${t % 5 ? 1.5 : 2.6}"/>`; if (t % 5 === 0) s += tx(528, y, t % 10 ? 18 : 24, t, t % 10 ? '#a16207' : '#713f12'); }
  s += tx(512, top - 22, 18, 'cm', '#a16207');
  v.marks.forEach(m => {
    const y = P(m.val);
    if (m.ch) s += `<image href="${CHARS[m.ch].img}" x="${300 - (bot - y) * .5}" y="${y}" width="${bot - y}" height="${bot - y}" preserveAspectRatio="xMidYMin meet"/>`;
    s += `<line x1="${m.ch ? 250 : 380}" y1="${y}" x2="452" y2="${y}" stroke="${m.ch ? '#ef4444' : '#2563eb'}" stroke-width="5" ${m.ch ? '' : 'stroke-dasharray="10 6"'}/>`;
    if (m.lab) s += pill(700, y, m.lab, '#2563eb', 18);
    if (st.done) s += pill(m.ch ? 690 : 800, y, `${m.val} cm`, m.ch ? '#16a34a' : '#2563eb', 22);
  });
  if (st.hint) { const [f, t] = v.cnt || [Math.floor(v.marks[0].val / 10) * 10, v.marks[0].val]; s += `<circle cx="528" cy="${P(f)}" r="20" fill="none" stroke="#16a34a" stroke-width="4"/>`; for (let i = f + 1; i <= t; i++) s += badge(590 + ((i - f) % 2) * 22, P(i), i - f, '#ef4444', 9); }
  return s;
};
// 바늘 저울
R.dial = (v, st) => {
  const cx = 430, cy = 255, r = 128, ang = t => (-225 + 270 * t / v.max) * Math.PI / 180, pt = (rr, t) => [cx + rr * Math.cos(ang(t)), cy + rr * Math.sin(ang(t))]; let s = '';
  s += `<rect x="${cx - 175}" y="78" width="350" height="16" rx="8" fill="#94a3b8"/><rect x="${cx - 20}" y="94" width="40" height="34" fill="#cbd5e1"/>` + em(cx, 44, 66, v.item);
  s += `<circle cx="${cx}" cy="${cy}" r="${r + 16}" fill="${v.body || '#e0f2fe'}" stroke="#0369a1" stroke-width="5"/><circle cx="${cx}" cy="${cy}" r="${r}" fill="#fff"/>`;
  for (let t = 0; t <= v.max + 1e-9; t += v.tick) { const big = Math.abs(t / v.lab - Math.round(t / v.lab)) < 1e-6, [x1, y1] = pt(r - 2, t), [x2, y2] = pt(r - (big ? 22 : 11), t); s += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#334155" stroke-width="${big ? 3 : 1.5}"/>`; if (big) { const [lx, ly] = pt(r - 42, t); s += tx(lx, ly, v.max >= 1000 ? 17 : 20, Math.round(t), '#0c4a6e'); } }
  s += tx(cx, cy + 52, 26, v.unit, '#0369a1');
  if (st.hint) { const [f, t] = v.cnt || [Math.floor(v.val / v.lab) * v.lab, v.val], [lx, ly] = pt(r - 42, f); s += `<circle cx="${lx}" cy="${ly}" r="20" fill="none" stroke="#16a34a" stroke-width="4"/>`; let n = 0; for (let u = f + v.tick; u <= t + 1e-9; u += v.tick) { const [x1, y1] = pt(r + 2, u), [x2, y2] = pt(r - 24, u); s += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#ef4444" stroke-width="5" stroke-linecap="round"/>`; n++; } if (n) s += pill(cx - 250, cy, `${f}에서 ${n}칸 더`, '#ef4444', 22); }
  const [nx, ny] = pt(r - 14, v.val); s += `<line x1="${cx}" y1="${cy}" x2="${nx}" y2="${ny}" stroke="#ef4444" stroke-width="6" stroke-linecap="round"/><circle cx="${cx}" cy="${cy}" r="12" fill="#ef4444"/>`;
  if (st.done) s += pill(cx + 250, cy, `${v.val} ${v.unit}`, '#16a34a', 28);
  return s;
};
// 숫자 저울·체온계
R.digital = (v, st) => {
  let s = ''; const n = v.list.length, gap = 860 / (n + 1);
  v.list.forEach((d, i) => {
    const x = gap * (i + 1);
    s += `<rect x="${x - 150}" y="150" width="300" height="190" rx="26" fill="#e2e8f0" stroke="#64748b" stroke-width="4"/><rect x="${x - 170}" y="128" width="340" height="24" rx="12" fill="#94a3b8"/>` + em(x, 82, 76, d.item);
    s += `<rect x="${x - 115}" y="190" width="230" height="90" rx="12" fill="#14532d"/>` + tx(x, 237, 54, `${d.val}<tspan font-size="30"> ${d.unit}</tspan>`, '#bbf7d0', 'style="font-family:monospace;font-weight:bold"');
    if (d.lab) s += pill(x, 372, d.lab, '#0369a1', 20);
  });
  return s;
};
// 계량컵·물통
R.mcup = (v, st) => {
  let s = ''; const n = v.cups.length, gap = 860 / (n + 1), W = v.w || 160, top = 70, bot = 360, P = t => bot - t / v.max * (bot - top - 20);
  if (v.deco) s += '';
  v.cups.forEach((c, i) => {
    const x = gap * (i + 1), L = x - W / 2, Rr = x + W / 2;
    s += `<rect x="${L}" y="${P(c.val)}" width="${W}" height="${bot - P(c.val)}" fill="${c.col || '#93c5fd'}" opacity=".85"/>`;
    if (v.deco) s += em(x + W * .2, (P(c.val) + bot) / 2, 46, v.deco);
    s += `<path d="M${L},${top} L${L},${bot} Q${L},${bot + 12} ${L + 12},${bot + 12} L${Rr - 12},${bot + 12} Q${Rr},${bot + 12} ${Rr},${bot} L${Rr},${top}" fill="none" stroke="#475569" stroke-width="5"/>`;
    if (!v.w) s += `<path d="M${Rr},${top + 40} q50,10 50,70 q0,60 -50,70" fill="none" stroke="#475569" stroke-width="8"/>`;
    for (let t = v.tick; t <= v.max + 1e-9; t += v.tick) { const y = P(t), big = Math.abs(t / v.lab - Math.round(t / v.lab)) < 1e-6; s += `<line x1="${L}" y1="${y}" x2="${L + (big ? 30 : 16)}" y2="${y}" stroke="#1e3a8a" stroke-width="${big ? 3 : 2}"/>`; if (big) s += `<text x="${L + 36}" y="${y + 7}" font-size="20" fill="#1e3a8a">${t}</text>`; }
    s += tx(x, top - 22, 20, v.unit, '#1e3a8a');
    if (v.target) s += `<line x1="${L - 20}" y1="${P(v.target)}" x2="${Rr + 20}" y2="${P(v.target)}" stroke="#ef4444" stroke-width="4" stroke-dasharray="10 6"/>` + pill(Rr + (v.w ? 60 : 100), P(v.target), `${v.target}${v.unit}까지`, '#ef4444', 18);
    if (c.lab) s += tx(x, 388, 26, c.lab, '#0c4a6e');
    if (st.hint && !v.nohint) { const f = v.cnt ? v.cnt[0] : Math.floor(c.val / v.lab + 1e-9) * v.lab; if (f > 0) s += `<circle cx="${L + 50}" cy="${P(f) + 0}" r="22" fill="none" stroke="#16a34a" stroke-width="4"/>`; let k = 0; for (let u = f + v.tick; u <= c.val + 1e-9; u += v.tick) s += badge(L - 20, P(u), ++k, '#ef4444', 11); }
    if (st.done && !v.nodone) s += pill(x, top - 24 - 30, `${c.val} ${v.unit}`, c.ok || n === 1 ? '#16a34a' : '#64748b', 22);
    if (st.done && c.ok) s += star(x + W / 2 + 10, top - 50);
  });
  return s;
};
// 온도계
R.thermo = (v, st) => {
  const x = 470, top = 50, bot = 300, P = t => bot - (t - v.min) / (v.max - v.min) * (bot - top); let s = '';
  s += em(240, 200, 120, v.item);
  s += `<rect x="${x - 18}" y="${top - 26}" width="36" height="${bot - top + 60}" rx="18" fill="#fff" stroke="#475569" stroke-width="4"/><circle cx="${x}" cy="${bot + 52}" r="32" fill="#ef4444" stroke="#475569" stroke-width="4"/><rect x="${x - 8}" y="${P(v.val)}" width="16" height="${bot + 30 - P(v.val)}" fill="#ef4444"/>`;
  for (let t = v.min; t <= v.max; t += v.tick) { const y = P(t), big = t % v.lab === 0; s += `<line x1="${x + 22}" y1="${y}" x2="${x + 22 + (big ? 28 : 14)}" y2="${y}" stroke="#334155" stroke-width="${big ? 3 : 1.5}"/>`; if (big) s += tx(x + 80, y, 22, t, '#334155'); }
  s += tx(x + 80, top - 30, 22, '℃', '#ef4444');
  if (st.hint) { const f = Math.floor(v.val / v.lab) * v.lab; s += `<circle cx="${x + 80}" cy="${P(f)}" r="20" fill="none" stroke="#16a34a" stroke-width="4"/>`; let k = 0; for (let u = f + v.tick; u <= v.val; u += v.tick) s += badge(x - 44 - (k % 2) * 22, P(u), ++k, '#ef4444', 9); }
  if (st.done) s += pill(x + 220, P(v.val), `${v.val}도`, '#16a34a', 28);
  return s;
};
// 막대 모델 (계산)
R.bars = (v, st, q) => {
  let s = ''; const k = 640 / v.max, x0 = 170, n = v.rows.length, gap = 380 / n;
  v.rows.forEach((r, ri) => {
    const y = 20 + gap * ri + gap / 2 + (r.brace ? 24 : 0), h = 70; let x = x0, tot = 0;
    if (r.t) s += tx(85, y, 24, r.t, '#0c4a6e');
    const segs = r.segs; let i = 0, piece = 0;
    while (i < segs.length) {
      const g = segs[i];
      if (g.hide && !(st.hint || st.done)) { let w = 0; while (i < segs.length && segs[i].hide) { w += segs[i].v; i++; } s += `<rect x="${x}" y="${y - h / 2}" width="${w * k}" height="${h}" fill="#f8fafc" stroke="#94a3b8" stroke-width="3" stroke-dasharray="8 6"/>` + tx(x + w * k / 2, y, 24, '?', '#94a3b8'); x += w * k; tot += w; continue; }
      const w = g.v * k, col = g.cut ? '#fecaca' : g.empty ? '#fff' : (g.col || PAL[(i + ri) % 6]);
      s += `<rect x="${x}" y="${y - h / 2}" width="${w}" height="${h}" fill="${col}" stroke="${g.cut ? '#ef4444' : '#475569'}" stroke-width="3" ${g.cut || g.empty ? 'stroke-dasharray="8 5"' : ''}/>`;
      const lab = g.q && st.done ? ansText(q) : (g.lab ?? '');
      s += tx(x + w / 2, y, w < 70 ? 18 : 24, lab, g.q ? (st.done ? '#16a34a' : '#ef4444') : '#1e293b');
      if (g.cut) s += em(x + (segs[i - 1] ? 0 : w), y - h / 2 - 18, 28, '✂️');
      if (r.count && (st.hint || st.done)) s += badge(x + w / 2, y + h / 2 + 22, ++piece, '#ef4444', 13);
      x += w; tot += g.v; i++;
    }
    if (r.brace) { const bx2 = x0 + tot * k, by = y - h / 2 - 12; s += `<path d="M${x0},${by} q0,-16 16,-16 L${(x0 + bx2) / 2 - 12},${by - 16} q12,0 12,-14 q0,14 12,14 L${bx2 - 16},${by - 16} q16,0 16,16" fill="none" stroke="#0369a1" stroke-width="3"/>`; const bl = r.brace.includes('?') && st.done ? ansText(q) : r.brace; s += pill((x0 + bx2) / 2, by - 44, bl, r.brace.includes('?') ? (st.done ? '#16a34a' : '#ef4444') : '#0369a1', 20); }
  });
  return s;
};
// 그림 + 식
R.items = (v, st, q) => {
  const seq = v.seq, W = seq.map(t => t.op ? 70 : 170), tot = W.reduce((a, b) => a + b, 0), z = Math.min(1, 840 / tot); let x = 430 - tot / 2, s = `<g transform="translate(430,200) scale(${z}) translate(-430,-200)">`;
  seq.forEach((t, i) => {
    const cx = x + W[i] / 2;
    if (t.op) s += tx(cx, 200, 60, t.op, '#0369a1');
    else { const isQ = String(t.l).includes('?'); s += `<rect x="${cx - 78}" y="90" width="156" height="210" rx="22" fill="#f0f9ff" stroke="#bae6fd" stroke-width="3"/>` + em(cx, 165, 84, t.e) + pill(cx, 262, isQ && st.done ? ansText(q) : t.l, isQ ? (st.done ? '#16a34a' : '#ef4444') : '#0369a1', 24); }
    x += W[i];
  });
  return s + '</g>';
};

// 크기·물건 견주기 (이모지 크기)
R.pair = (v, st) => {
  let s = `<rect x="30" y="330" width="800" height="10" rx="5" fill="#d6d3d1"/>`; const n = v.items.length, gap = 860 / (n + 1);
  v.items.forEach((o, i) => {
    const x = gap * (i + 1), fs = o.s || 150, id = GI_OBJ[o.e], gw = Math.min(fs * 1.15, gap * .92), top = hasG(id) ? 326 - gw * .75 : 330 - fs * 1.08;
    s += hasG(id) ? gem(x, 326 - gw * .375, gw, id, o.e, fs) : em(x, 330 - fs * .55, fs, o.e);
    if (st.hint && v.size) s += `<line x1="30" y1="${top}" x2="830" y2="${top}" stroke="#2563eb" stroke-dasharray="10 8" stroke-width="3" opacity=".6"/>`;
    s += tx(x, 370, 26, o.lab, '#0c4a6e');
    if (st.done && o.ok) s += star(x, Math.max(26, top - 24));
  });
  return s;
};
// 개수 세기·더하기·빼기·나누기 (9 이하)
R.count = (v, st) => {
  let s = '', num = 0; const G = v.rows, rowH = Math.min(150, 380 / G.length), top0 = (400 - rowH * G.length) / 2;
  G.forEach((g, gi) => {
    if (!v.cont) num = 0;
    const cy = top0 + rowH * gi + rowH / 2 + 8, step = Math.min(74, 600 / g.n), fs = Math.min(58, step * .86, rowH * .5);
    if (g.lab) s += pill(90, cy, g.lab, '#0369a1', 22);
    for (let i = 0; i < g.n; i++) {
      const cx = 200 + step * i + step / 2, out = g.out && i >= g.n - g.out;
      s += gem(cx, cy, Math.min(fs * 1.1, step * .84), GI_OBJ[g.e], g.e, fs, out ? 'opacity=".3"' : '');
      if (out) s += `<path d="M${cx - 20},${cy - 20} L${cx + 20},${cy + 20} M${cx + 20},${cy - 20} L${cx - 20},${cy + 20}" stroke="#ef4444" stroke-width="6" stroke-linecap="round"/>`;
      if (st.hint && !out) s += v.split ? badge(cx, cy - fs * .5 - 16, i % 2 ? '나' : '가', i % 2 ? '#2563eb' : '#ef4444', 15) : badge(cx, cy - fs * .5 - 16, ++num, '#ef4444', 14);
    }
    if (st.done && g.ok) s += star(200 + step * g.n + 34, cy);
  });
  return s;
};
// 아침·점심·저녁 그림
const SKY = { m: ['#fde68a', '#fdba74'], n: ['#38bdf8', '#bae6fd'], e: ['#1e3a8a', '#312e81'] }, WHEN = { m: '해가 떠요', n: '해가 높아요', e: '달이 떠요' };
R.day = (v, st, q) => {
  const P = v.panels, n = P.length, W = n === 1 ? 460 : n === 2 ? 340 : 250, H = n === 1 ? 300 : 280, gap = (860 - W * n) / (n + 1); let s = '';
  P.forEach((p, i) => {
    const x = gap + i * (W + gap), y = 22, c = SKY[p.when], id = 'sky' + i, gy = y + H - 64;
    s += `<defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${c[0]}"/><stop offset="1" stop-color="${c[1]}"/></linearGradient><clipPath id="c${id}"><rect x="${x}" y="${y}" width="${W}" height="${H}" rx="24"/></clipPath></defs><g clip-path="url(#c${id})">`;
    s += `<rect x="${x}" y="${y}" width="${W}" height="${H}" fill="url(#${id})"/>`;
    if (p.when === 'm') s += `<circle cx="${x + W * .22}" cy="${gy - 6}" r="40" fill="#f97316"/><circle cx="${x + W * .22}" cy="${gy - 6}" r="54" fill="#fb923c" opacity=".3"/>`;
    if (p.when === 'n') s += `<circle cx="${x + W / 2}" cy="${y + 50}" r="36" fill="#facc15"/><circle cx="${x + W / 2}" cy="${y + 50}" r="50" fill="#fde047" opacity=".35"/>`;
    if (p.when === 'e') s += gem(x + W * .8, y + 56, 60, MI(101), '🌙', 54) + [[.15, .2], [.35, .12], [.55, .28], [.25, .4]].map(([a, b]) => `<circle cx="${x + W * a}" cy="${y + H * b}" r="3.5" fill="#fef9c3"/>`).join('');
    s += `<rect x="${x}" y="${gy}" width="${W}" height="70" fill="${p.when === 'e' ? '#166534' : '#86efac'}"/></g>`;
    s += `<rect x="${x}" y="${y}" width="${W}" height="${H}" rx="24" fill="none" stroke="#475569" stroke-width="4"/>`;
    s += gem(x + W / 2, y + H * .52, n === 1 ? 160 : Math.min(116, W * .5), GI_DAY[p.act], p.act, n === 1 ? 120 : 84);
    if (st.hint) s += pill(x + W / 2, gy + 34, WHEN[p.when], '#0369a1', 18);
    if (p.lab) s += tx(x + W / 2, y + H + 34, 30, p.lab, '#0c4a6e');
    if (st.done && p.ok) s += star(x + W - 26, y + H - 26);
  });
  if (st.done && n === 1) s += pill(430, 22 + 300 + 40, ansText(q), '#16a34a', 26);
  return s;
};
// 칸으로 길이 잇기·자르기
R.blocks = (v, st, q) => {
  let s = ''; const G = v.rows, rowH = 380 / G.length;
  G.forEach((r, ri) => {
    const tot = r.segs.reduce((a, g) => a + g.n, 0), u = Math.min(72, 600 / tot), y = 10 + rowH * ri + rowH / 2; let x = 200, num = 0;
    if (r.t) s += tx(100, y, 28, r.t, '#0c4a6e');
    r.segs.forEach((g, gi) => {
      const x0 = x;
      for (let i = 0; i < g.n; i++) {
        s += `<rect x="${x + 2}" y="${y - u / 2}" width="${u - 4}" height="${u}" rx="8" fill="${g.cut ? '#fecaca' : (g.col || PAL[gi % 6])}" stroke="${g.cut ? '#ef4444' : '#475569'}" stroke-width="3" ${g.cut ? 'stroke-dasharray="7 5" opacity=".7"' : ''}/>`;
        if (st.hint && !g.cut) s += badge(x + u / 2, y + u / 2 + 22, ++num, '#ef4444', 13);
        x += u;
      }
      if (g.cut) s += em((x0 + x) / 2, y, 34, '✂️');
      const lab = g.q ? (st.done ? ansText(q) : '?') : `${g.n}칸`;
      s += pill((x0 + x) / 2, y - u / 2 - 28, lab, g.q ? (st.done ? '#16a34a' : '#ef4444') : (g.cut ? '#ef4444' : '#0369a1'), 22);
    });
    if (r.sum) s += pill((200 + x) / 2, y + u / 2 + 74, `모두 ${st.done ? ansText(q) : '? 칸'}`, st.done ? '#16a34a' : '#ef4444', 24);
  });
  return s;
};

// ===================== 진도 =====================
let STARS = {}; try { STARS = JSON.parse(localStorage.getItem('meas-stars') || '{}'); } catch (e) {}
const save = () => { try { localStorage.setItem('meas-stars', JSON.stringify(STARS)); } catch (e) {} };
const TIERS = [{ n: '1부 🌱 세어서 견줘요', c: '#22c55e' }, { n: '2부 🔎 직접 견줘요', c: '#0ea5e9' }, { n: '3부 🧮 하루와 셈하기', c: '#f97316' }];
let TIER = 0; try { TIER = +(sessionStorage.getItem('meas-tier') || 0); } catch (e) {}

// ===================== 처음 화면 =====================
function setTier(t) { TIER = t; try { sessionStorage.setItem('meas-tier', t); } catch (e) {} sfx('tap'); goHome(); }
function goHome() {
  stopVoice(); ['play', 'clear', 'intro'].forEach(id => $(id).classList.add('hidden')); $('home').classList.remove('hidden');
  $('rec-credit').innerText = VOICE_SPRITES.length ? '· 음성: 네이버 클로바더빙' : '';
  $('tiers').innerHTML = TIERS.map((t, i) => { const L = STAGES.filter(S => S.tier === i), d = L.filter(S => STARS[S.id]).length; return `<button class="tier ${i === TIER ? 'on' : ''}" style="${i === TIER ? 'background:' + t.c : ''}" onclick="setTier(${i})">${tierH(i, '1.6em')} <span style="font-size:17px;opacity:.85">${d}/${L.length}</span></button>`; }).join('');
  const L = STAGES.map((S, i) => [S, i]).filter(([S]) => S.tier === TIER);
  $('cards').innerHTML = L.map(([S, i], j) => {
    const col = j % 3, row = Math.floor(j / 3), st = STARS[S.id] || 0;
    return `<button class="card ${st ? 'done' : ''}" style="left:${24 + col * 412}px;top:${152 + row * 176}px" onclick="openStage(${i})"><div class="th" style="background:${S.sc.bg}"><svg viewBox="40 0 320 300" preserveAspectRatio="xMidYMid slice">${sceneSVG(S)}</svg></div><div class="tx"><div class="nm">${i + 1}. ${S.name}</div><div class="jb">${jobH(S.job, S.job.includes(' · ') ? '1.2em' : '1.6em')}</div><div class="st">${st ? '★'.repeat(st) + '☆'.repeat(3 - st) : '<span style="color:#cbd5e1">☆☆☆</span>'}</div></div></button>`;
  }).join('');
  const n = Object.keys(STARS).length;
  $('tot').innerHTML = `${n} / ${STAGES.length} 단계 완성 ${n === STAGES.length ? '🎉' : ''}`;
}
let RESET_ARMED = 0;
function resetAll() { if (Date.now() - RESET_ARMED > 3000) { RESET_ARMED = Date.now(); $('tot').innerHTML += ' <span style="color:#dc2626">한 번 더 누르면 지워요</span>'; return; } STARS = {}; save(); goHome(); }

// ===================== 직업 장면 =====================
let CUR = 0, QI = 0, ERR = 0, MISS = 0, HLV = 0, DONE = false, ORDER = [], KEY = [], KB = 0;
function openStage(i) {
  stopVoice(); CUR = i; const S = STAGES[i];
  ['home', 'play', 'clear'].forEach(id => $(id).classList.add('hidden')); $('intro').classList.remove('hidden');
  $('in-svg').innerHTML = sceneSVG(S);
  $('in-tier').innerHTML = tierH(S.tier, '1.5em'); $('in-tier').style.background = TIERS[S.tier].c;
  $('in-title').innerText = `${i + 1}. ${S.name}`; $('in-job').innerHTML = jobH(S.job, '1.5em');
  $('in-text').innerText = S.intro; $('in-what').innerText = `🔎 이번에 알아볼 것: ${S.what}`;
  playLines([S.intro]);
}
function startQs() { const S = STAGES[CUR]; QI = 0; MISS = 0; $('intro').classList.add('hidden'); $('play').classList.remove('hidden'); $('p-title').innerHTML = `${stIcon(S, '1.6em')} ${S.name}`; $('jobc').innerHTML = `<div style="font-size:54px;font-family:var(--emo);line-height:0">${GI.html(GI_MAIN[S.id], '76px', '', S.sc.main)}</div><div><div style="font-size:24px;color:#0c4a6e">${jobH(S.job, '', true)}</div><div style="font-size:17px;color:#64748b">${S.what}</div></div>`; showQ(); }

// ===================== 문제 =====================
const curQ = () => STAGES[CUR].qs[QI];
const isKey = q => Array.isArray(q.a);
function ansText(q) { return isKey(q) ? q.a.map((n, i) => `${n}${q.u[i]}`).join(' ') : q.o[q.a]; }
function draw(st) { const q = curQ(); $('vis').innerHTML = R[q.v.k](q.v, st, q); }
function showQ() {
  const S = STAGES[CUR], q = curQ(); ERR = 0; HLV = 0; DONE = false;
  $('p-num').innerText = `문제 ${QI + 1} / ${S.qs.length}`;
  $('qtext').innerHTML = qH(q.q); draw({});
  $('fb').innerHTML = `<span style="color:#64748b">${isKey(q) ? '숫자를 눌러 답을 쓰고 ✔를 눌러요.' : '알맞은 답을 골라 눌러요.'} 어려우면 💡를 눌러요.</span>`;
  $('nextb').classList.add('hidden');
  if (isKey(q)) { if (BADW) { clearTimeout(BADW.t); BADW = null; } KEY = q.a.map(() => ''); KB = 0; drawKeys(); }
  else {
    // 숫자 보기(5걸음·6걸음·7걸음 …)는 크기순으로 두면 정답이 늘 가운데라서 순서를 섞어요. 맞고 틀림은 보기 번호(값)로 판정해요.
    // 가·나·다, 아침·점심·저녁처럼 차례가 있는 보기는 그대로 둬요.
    ORDER = q.o.map((t, i) => i);
    if (q.o.every(t => /^(약 )?\d/.test(t))) { for (let i = ORDER.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [ORDER[i], ORDER[j]] = [ORDER[j], ORDER[i]]; } }
    $('ans').innerHTML = ORDER.map(i => `<button class="opt ${q.o.some(t => t.length > 9) ? 'sm' : ''}" id="op${i}" onclick="choose(${i})">${optH(q.o[i])}</button>`).join('');
  }
  say(q.q, 'wol', [q.q]);
}
function choose(i) {
  if (DONE) return; const q = curQ();
  if (i === q.a) return correct();
  sfx('wrong'); const b = $('op' + i); b.classList.add('shake', 'no'); wrong();
}
function drawKeys() {
  const q = curQ();
  const bl = KEY.map((v, i) => `<span class="blank ${i === KB && !DONE ? 'on' : ''}" onclick="KB=${i};drawKeys()">${v || (HLV >= 4 ? `<span class="ph">${q.a[i]}</span>` : '')}</span><span style="font-size:30px;color:#0c4a6e;margin:0 8px 0 6px">${q.u[i]}</span>`).join('');
  $('ans').innerHTML = `<div id="blanks" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px;min-height:90px;margin-bottom:14px">${bl}</div>
  <div style="display:grid;grid-template-columns:repeat(3,104px);gap:12px;justify-content:center">${[1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => `<button class="key" onclick="press('${n}')">${n}</button>`).join('')}<button class="key" onclick="press('back')" style="font-size:26px">⌫</button><button class="key" onclick="press('0')">0</button><button class="key" onclick="press('ok')" style="background:#22c55e;color:#fff;border-color:#16a34a;box-shadow:0 4px 0 #15803d">✔</button></div>`;
}
let BADW = null;   // 틀린 칸을 잠깐 보여 주는 중 (바로 다시 누르면 그 칸부터 지우고 이어 써요)
function clearBad() { if (!BADW) return; clearTimeout(BADW.t); const bad = BADW.bad; BADW = null; KEY = KEY.map((v, i) => bad[i] ? '' : v); }
function press(k) {
  if (DONE) return; const q = curQ(); sfx('tap'); clearBad();
  if (k === 'back') KEY[KB] = KEY[KB].slice(0, -1);
  else if (k === 'ok') {
    const e = KEY.findIndex(v => v === ''); if (e >= 0) { KB = e; drawKeys(); say('빈칸에 숫자를 써요.', 'ari', ['빈칸에 숫자를 써요']); return; }
    if (KEY.every((v, i) => +v === q.a[i])) return correct();
    // 틀리면 맞게 쓴 칸은 그대로 두고, 틀린 칸만 잠깐 빨갛게 보여 준 뒤 그 칸만 지워요.
    sfx('wrong'); const bad = KEY.map((v, i) => +v !== q.a[i]); KB = bad.indexOf(true);
    drawKeys(); const bs = $('blanks').querySelectorAll('.blank'); bad.forEach((b, i) => b && bs[i] && bs[i].classList.add('bad')); $('blanks').classList.add('shake'); wrong();
    const qi = QI; BADW = { bad, t: setTimeout(() => { if (DONE || QI !== qi) return; clearBad(); drawKeys(); }, 900) }; return;
  } else if (KEY[KB].length < 5) { KEY[KB] = (KEY[KB] === '0' ? '' : KEY[KB]) + k; if (KEY[KB].length >= String(q.a[KB]).length && KB < KEY.length - 1) KB++; }
  drawKeys();
}
function wrong() { ERR++; MISS++; hint(ERR); }
function hint(lv) {
  const q = curQ(); HLV = Math.max(HLV, lv);
  if (lv <= 1) { say('다시 생각해 봐요.', 'ari', ['다시 생각해 봐요']); return; }
  if (lv === 2) { say(`💡 ${q.h}`, 'ari', [q.h]); $('fb').innerHTML = `💡 ${q.h}`; return; }
  draw({ hint: true });
  $('fb').innerHTML = `🔎 그림에 표시했어요. ${q.h}${q.x ? ` <b style="font-size:23px;color:#0369a1;margin-left:6px;white-space:nowrap">식: ${q.x}</b>` : ''}`;
  if (lv === 3) { say(`🔎 그림을 보세요. ${q.h}`, 'ari', ['색깔과 그림을 잘 봐요', q.h]); return; }
  if (isKey(q)) { drawKeys(); say(`정답은 <b>${ansText(q)}</b>이에요. 숫자를 눌러 봐요.`, 'ari', ['흐린 숫자를 따라 눌러 봐요']); }
  else { $('op' + q.a).classList.add('glowb'); say('반짝이는 답을 눌러 봐요.', 'ari', ['반짝이는 곳을 봐요']); }
}
function hintMore() { if (DONE || $('play').classList.contains('hidden')) return; MISS++; hint(Math.max(2, HLV + 1)); }
function correct() {
  const q = curQ(), S = STAGES[CUR]; DONE = true; sfx('good');
  draw({ done: true });
  if (isKey(q)) { KEY = q.a.map(String); drawKeys(); $('blanks').style.filter = 'hue-rotate(-80deg)'; }
  else { document.querySelectorAll('.opt').forEach(b => b.classList.add('no')); const b = $('op' + q.a); b.classList.remove('no', 'glowb'); b.classList.add('ok'); }
  $('fb').innerHTML = `<b style="color:#16a34a">✅ ${optH(ansText(q), '1.5em')}</b>${q.x ? ` <span style="color:#0369a1;margin-left:8px">${q.x.replace('?', ansText(q))}</span>` : ''}<div>${q.e}</div>`;
  $('nextb').classList.remove('hidden'); $('nextb').innerText = QI < S.qs.length - 1 ? '다음 ▶' : '완료 ▶';
  say(`맞아요! ${q.e}`, pick(['wol', 'hami']), ['맞아요', q.e]);
}
function nextQ() { const S = STAGES[CUR]; if (QI < S.qs.length - 1) { QI++; showQ(); } else stageClear(); }
function stageClear() {
  const S = STAGES[CUR], n = S.qs.length, st = MISS <= Math.ceil(n / 2) ? 3 : MISS <= n * 2 ? 2 : 1;
  STARS[S.id] = Math.max(STARS[S.id] || 0, st); save(); sfx('clear');
  $('cl-stars').innerText = '★'.repeat(st) + '☆'.repeat(3 - st);
  $('cl-title').innerHTML = `${stIcon(S, '1.4em')} ${S.name} 완료!`;
  $('cl-text').innerHTML = `${S.done}<div style="margin-top:12px;font-size:21px;color:#64748b">${jobH(S.job, '1.5em')} · ${S.what}</div>`;
  $('cl-next').classList.toggle('hidden', CUR >= STAGES.length - 1);
  $('clear').classList.remove('hidden');
  playLines(['참 잘했어요']);
}
function nextStage() { if (CUR < STAGES.length - 1) { TIER = STAGES[CUR + 1].tier; try { sessionStorage.setItem('meas-tier', TIER); } catch (e) {} openStage(CUR + 1); } else goHome(); }

// ===================== 녹음 대본 =====================
function appLines() {
  const out = new Set(['다시 생각해 봐요', '색깔과 그림을 잘 봐요', '반짝이는 곳을 봐요', '흐린 숫자를 따라 눌러 봐요', '빈칸에 숫자를 써요', '맞아요', '참 잘했어요']);
  STAGES.forEach(S => { out.add(S.intro); S.qs.forEach(q => { out.add(q.q); out.add(q.h); out.add(q.e); }); });
  return [...out];
}
GI.put($('ttl-ic'), 'meas_001', '1.3em');
goHome();
// 혜광전과(허브)에서 고른 부(d)·단계(r, 그 부 안에서 0부터)로 바로 열어요. r 이 없으면 그 부의 단계 목록 화면.
(function () {
  const H = window.__HUB_START; if (!H || H.app !== 'meas') return;
  const t = Math.floor(+H.d); if (!(t >= 0 && t < TIERS.length)) return;
  TIER = t; try { sessionStorage.setItem('meas-tier', t); } catch (e) {}
  const L = STAGES.map((S, i) => [S, i]).filter(([S]) => S.tier === t), it = H.r == null ? null : L[Math.floor(+H.r)];
  setTimeout(() => { try { ac(); } catch (e) {} if (it) openStage(it[1]); else goHome(); }, 0);
})();
</script>

<script>
// 혜광전과로 돌아가는 단추 (늘 보여요): ◀ 이전 = 이 앱의 단계 화면, 🏠 홈 = 앱 고르기 화면
(function () {
  const go = h => { if (window.parent !== window) { try { window.parent.postMessage({ hub: 'close', h }, '*'); } catch (e) {} return; } location.href = encodeURI('혜광전과.html') + h; };
  const box = document.createElement('div'); box.id = 'hub-nav';
  box.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:20000;display:flex;gap:5px";
  const mk = (t, h) => { const b = document.createElement('button'); b.textContent = t; b.onclick = () => go(h);
    b.style.cssText = "background:#fff;border:2px solid #4a3428;border-radius:99px;padding:3px 11px;font:15px 'Jua','Malgun Gothic',sans-serif;color:#4a3428;cursor:pointer;box-shadow:0 2px 0 #f6c85f"; return b; };
  // 이름 표시(👤) 바로 오른쪽에 나란히 놓아요
  const place = () => { const c = document.getElementById('sy-chip'); box.style.left = (c ? Math.round(c.getBoundingClientRect().right + 6) : 8) + 'px'; };
  setInterval(place, 800);
  box.appendChild(mk('◀ 이전', '#app=meas')); box.appendChild(mk('🏠 홈', '#apps'));
  (document.body ? Promise.resolve() : new Promise(r => document.addEventListener('DOMContentLoaded', r))).then(() => document.body.appendChild(box));
})();
</script>
</body>
</html>
