]},
{ id:'block', tier:0, icon:'🧱', name:'블록·클립으로 재기', job:'🧑‍🎨 도예가', what:'그릇과 꽃병의 크기', sc:{bg:'#ffedd5', main:'🧑‍🎨', tools:['🏺','🍶','🥣','🔥']},
