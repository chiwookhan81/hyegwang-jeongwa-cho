let STARS = {}; try { STARS = JSON.parse(localStorage.getItem('tower-stars') || '{}'); } catch (e) {}
let BANK = 0; try { BANK = +(localStorage.getItem('tower-bank') || 0); } catch (e) {}
let BANKGOT = {}; try { BANKGOT = JSON.parse(localStorage.getItem('tower-bankgot') || '{}'); } catch (e) {}
const save = () => { try { localStorage.setItem('tower-stars', JSON.stringify(STARS)); localStorage.setItem('tower-bank', BANK); localStorage.setItem('tower-bankgot', JSON.stringify(BANKGOT)); } catch (e) {} };
let BAND = 0; try { BAND = +(sessionStorage.getItem('tower-band') || 0); } catch (e) {}
let TEACH = false; try { sessionStorage.removeItem('tower-teach'); } catch (e) {}
let CUR = 0, SI = 0, ERR = 0, MISS = 0, INV = [];
const KIND = F => F.boss ? ['👑', '최종 도전'] : F.surprise ? ['🎲', '돌발 스테이지'] : F.open ? ['🧠', '해결방'] : F.goalr ? ['🎯', '목표방'] : F.est ? ['👀', '어림방'] : F.gen ? ['⚡', '도전방'] : F.esc ? ['🔐', '탈출방'] : ['🔧', '연습방'];
const zoneStars = z => FLOORS.slice(z * 10, z * 10 + 10).reduce((a, f) => a + (STARS[f.id] || 0), 0), zoneMax = z => FLOORS.slice(z * 10, z * 10 + 10).length * 3;
const zoneMastered = z => zoneStars(z) >= zoneMax(z);
const isOpen = i => TEACH || i === 0 || !!STARS[FLOORS[i].id] || (i % 10 === 0 ? zoneMastered(i / 10 - 1) : !!STARS[FLOORS[i - 1].id]);
const lockMsg = i => i % 10 === 0 && !!STARS[FLOORS[i - 1].id] ? `🔒 ${i - 9}~${i}층 구역의 모든 층에서 별 3개를 받아야 다음 구역이 열려요. (지금 ⭐${zoneStars(i / 10 - 1)}/${zoneMax(i / 10 - 1)})` : `🔒 ${i}층을 먼저 탈출해야 열려요.`;
// 명예의 전당: floors.js 의 HALL 목록에 선생님이 이름을 적어 새 버전으로 배포해요 (기기에만 저장)
const hallNames = () => HALL;
const loadHall_once = () => {};
function showHall() { loadHall_once(); const HALL = hallNames(); $('hall').classList.remove('hidden'); $('hall-list').innerHTML = HALL.length ? HALL.map((n, i) => `<div style="display:inline-block;margin:8px 12px;padding:10px 22px;background:#f5f5f4;border:3px solid #a8a29e;border-radius:10px;font-size:30px;color:#292524;box-shadow:inset 0 2px 4px rgba(0,0,0,.25)">${i + 1}. ${n}</div>`).join('') : '<div style="font-size:28px;color:#57534e;margin-top:40px">아직 새겨진 이름이 없어요.<br>월궁탑 꼭대기에 오르면 첫 번째 주인공이 돼요!</div>'; }

function goHome() {
  stopVoice(); BUSY = false; ['play', 'clear', 'intro'].forEach(id => $(id).classList.add('hidden')); $('home').classList.remove('hidden');
  $('rec-credit').innerText = VOICE_SPRITES.length ? '· 음성: 네이버 클로바더빙' : '';
  const nB = Math.ceil(FLOORS.length / 10);
  $('zones').innerHTML = [...Array(nB)].map((_, b) => { const L = FLOORS.slice(b * 10, b * 10 + 10), d = L.filter(f => STARS[f.id]).length; return `<button class="zone ${b === BAND ? 'on' : ''}" style="${b === BAND ? 'background:' + (b === nB - 1 ? '#7c3aed' : '#a855f7') : ''}" onclick="setBand(${b})">${b * 10 + 1}~${Math.min(FLOORS.length, b * 10 + 10)}층 <span style="font-size:14px;opacity:.85">${zoneMastered(b) ? '👑' : b && !zoneMastered(b - 1) && !TEACH ? '🔒' : '⭐' + zoneStars(b) + '/' + zoneMax(b)}</span></button>`; }).join('');
  const nextI = FLOORS.findIndex(f => !STARS[f.id]);
  $('floors').innerHTML = FLOORS.slice(BAND * 10, BAND * 10 + 10).map((f, j) => { const i = BAND * 10 + j, c = j % 4, r = Math.floor(j / 4), st = STARS[f.id] || 0, op = isOpen(i), K = KIND(f);
    return `<button class="fl ${st ? 'done' : ''} ${i === nextI ? 'next' : ''}" style="left:${24 + c * 310}px;top:${160 + r * 168}px;${op ? '' : 'filter:grayscale(1);opacity:.55'}" onclick="openFloor(${i})"><div class="ic" style="${f.surprise ? 'background:#fef9c3' : f.boss ? 'background:#fde68a' : ''}"><svg viewBox="-110 -110 220 220">${f.icon()}</svg></div><div class="tx"><div class="fn">${i + 1}층 ${K[0]} ${K[1]}</div><div class="nm">${op ? f.name : '🔒 ' + f.name}</div><div class="st">${f.cat ? `<span style="font-size:14px;color:#64748b">${f.cat}</span> ` : ''}${st ? '★'.repeat(st) + '☆'.repeat(3 - st) : '<span style="color:#cbd5e1">☆☆☆</span>'}</div></div></button>`; }).join('');
  const n = Object.keys(STARS).length; $('tot').innerHTML = `${n} / ${FLOORS.length}층 탈출 ${n === FLOORS.length ? '🎉 꼭대기 정복!' : ''}`;
  $('bank-home').innerHTML = `💳 월궁통장 <b>${BANK}</b>개`;
}
function setBand(b) { BAND = b; try { sessionStorage.setItem('tower-band', b); } catch (e) {} sfx('tap'); goHome(); }
let RESET_ARMED = 0;
function resetAll() { if (Date.now() - RESET_ARMED > 3000) { RESET_ARMED = Date.now(); $('tot').innerHTML += ' <span style="color:#dc2626">한 번 더 누르면 지워요</span>'; return; } STARS = {}; BANK = 0; BANKGOT = {}; save(); goHome(); }
function openFloor(i) {
  if (!isOpen(i)) { sfx('wrong'); $('tot').innerHTML = lockMsg(i); return; }
  stopVoice(); BUSY = false; CUR = i; const F = FLOORS[i], K = KIND(F);
  ['home', 'play', 'clear'].forEach(id => $(id).classList.add('hidden')); $('intro').classList.remove('hidden');
  $('in-zone').innerText = `${i + 1}층 · ${F.zlab || K[0] + ' ' + K[1]}${F.cat ? ' · ' + F.cat : ''}`;
  $('in-title').innerText = F.name; $('in-text').innerText = F.intro; $('in-safe').innerHTML = F.surprise ? '🎁 다 맞히면 <b>월궁통장</b>을 받아요!' : F.boss ? '👑 마지막 층이에요. 💡 도움은 말로만 나오고, 월궁통장을 쓸 수 없어요.' : `⚠️ ${F.safe}`;
  $('in-svg').innerHTML = F.surprise ? `<rect width="560" height="470" fill="#fef9c3"/>${em(280, 200, 200, '🎲')}${em(120, 90, 70, '⚡')}${em(450, 380, 70, '❓')}` : `<rect width="560" height="470" fill="#f5f3ff"/><rect y="360" width="560" height="110" fill="#ddd6fe"/><rect x="380" y="90" width="140" height="270" rx="10" fill="#7c2d12"/><rect x="392" y="102" width="116" height="258" rx="6" fill="#a16207"/><circle cx="490" cy="240" r="9" fill="#fde047"/>${em(450, 200, 46, '🔒')}<g transform="translate(200,240) scale(1.25)">${F.icon()}</g>`;
  playLines([F.intro]);
}
// 다시 풀 때마다 선택 문제 보기 순서를 섞어요 (①②③ 번호 보기와 '똑같아요'가 있는 문제는 그대로)
function shuffleOpts(F) { F.steps.forEach(s => { if (s.sndPick) { const q = s.sndPick[Math.floor(Math.random() * s.sndPick.length)], T0 = ['높은 토크로 5cm 나사를 박아요', '토크가 낮아 나사가 헛돌아요', '드릴로 구멍을 뚫어요']; s.snd = q[0]; s.ok = q[2]; s.a = s.opts.findIndex(o => o.t === T0[q[1]]); } if (s.type !== 'choice' || s.fixed || !s.opts || s.opts.length < 2 || s.opts.some(o => /[①-⑳]|똑같/.test(o.t || ''))) return;
  const idx = s.opts.map((_, i) => i); for (let i = idx.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [idx[i], idx[j]] = [idx[j], idx[i]]; }
  s.opts = idx.map(i => s.opts[i]); s.a = idx.indexOf(s.a); if (s.elim !== undefined) { const e = idx.indexOf(s.elim); s.elim = e >= 0 && e !== s.a ? e : (s.a + 1) % s.opts.length; } }); }
function startFloor() { shuffleOpts(FLOORS[CUR]); SI = 0; MISS = 0; INV = []; $('intro').classList.add('hidden'); $('play').classList.remove('hidden'); const F = FLOORS[CUR]; $('p-title').innerText = `${CUR + 1}층 ${F.name}`;
  $('toolc').innerHTML = `<svg viewBox="-110 -110 220 220" style="width:84px;height:84px;background:#f5f3ff;border-radius:16px">${F.icon()}</svg><div><div style="font-size:24px;color:#4c1d95">${F.tool}</div><div style="font-size:16px;color:#64748b;line-height:1.3">${F.use}</div></div>`;
  $('inv').innerHTML = ''; showStep(); }
function addInv(k) { INV.push(k); $('inv').innerHTML = INV.map(x => /^\d$/.test(x) ? `<span style="display:inline-flex;width:44px;height:44px;border-radius:10px;background:#fef9c3;border:3px solid #facc15;align-items:center;justify-content:center;font-size:26px;color:#713f12">${x}</span>` : `<svg viewBox="-110 -110 220 220" style="width:44px;height:44px;background:#ede9fe;border-radius:10px">${tool(x, 0, 0, .8)}</svg>`).join(''); }
function drawSteps() { const F = FLOORS[CUR]; $('steps').innerHTML = F.steps.map((s, i) => `<div class="stp ${i < SI || (i === SI && DONE) ? 'ok' : i === SI ? 'on' : ''}"><b>${i < SI || (i === SI && DONE) ? '✓' : i + 1}</b><span>${s.title}</span></div>`).join(''); $('p-num').innerText = `${Math.min(SI + 1, F.steps.length)} / ${F.steps.length} 단계`;
  const can = BANK > 0 && !F.boss && !F.surprise && !DONE; $('bankb').innerHTML = `💳 ${BANK}`; $('bankb').style.opacity = can ? 1 : .4; }
function showStep() {
  const F = FLOORS[CUR]; S = F.steps[SI]; G = 0; ERR = 0; DONE = false; V = P[S.type].init(S);
  $('qtext').innerHTML = ''; { const sp = document.createElement('span'); sp.textContent = S.q; $('qtext').appendChild(sp); } $('fb').innerHTML = `<span style="color:#64748b">${S.tip || '어려우면 💡를 눌러요.'}</span>`; $('nextb').classList.add('hidden');
  drawSteps(); redraw(); say(S.q, 'wol', [S.q]); sndStop(); if (S.snd) sndLoad(S.snd); if (S.snd) setTimeout(() => { if (S && S.snd) playSnd(S.snd); }, 1800);
}
function redraw() { if (!S) return; let o = P[S.type].draw(S, V, G); if (S.img && S.type !== 'choice' && IMG[S.img]) o += `<g style="pointer-events:none"><rect x="14" y="14" width="156" height="156" rx="16" fill="#fff" stroke="#c4b5fd" stroke-width="4"/><image href="${IMG[S.img]}" x="20" y="20" width="144" height="144" preserveAspectRatio="xMidYMid slice"/></g>`; $('vis').innerHTML = o; }
function showFail(msg) { hint(ERR, msg); }
function hint(lv, msg) {
  if (FLOORS[CUR].boss) lv = Math.min(lv, 2);
  if (S && S.hintFrom && lv < S.hintFrom) lv = S.hintFrom;
  G = Math.max(G, lv); const t = msg || '다시 해 봐요.';
  if (lv <= 1) { $('fb').innerHTML = `❗ ${t}`; say(t, 'ari', [t]); return; }
  if (lv === 2) { $('fb').innerHTML = `❗ ${t}<br>💡 ${S.h}`; say(`💡 ${S.h}`, 'ari', [t, S.h]); return; }
  if (lv === 3) { $('fb').innerHTML = `🔎 그림에 표시했어요. ${S.h}`; say(`🔎 그림에 표시했어요. ${S.h}`, 'ari', ['그림에 표시했어요', S.h]); redraw(); return; }
  if (S.read4) { $('fb').innerHTML = `🗣️ ${S.read4}`; say(S.read4, 'wol', [S.read4]); redraw(); return; }
  $('fb').innerHTML = `🙌 화살표와 반짝이는 곳을 따라 해요. ${S.h}`; say('🙌 화살표와 반짝이는 곳을 따라 해요.', 'ari', ['화살표와 반짝이는 곳을 따라 해요']); redraw();
}
function hintMore() { if (DONE || $('play').classList.contains('hidden')) return; MISS++; ERR = Math.max(ERR, 1); hint(Math.max(2, G + 1)); }
// 월궁통장: 단계 하나를 바로 통과
function useBank() {
  const F = FLOORS[CUR]; if (DONE) return;
  if (F.boss || F.surprise) { say(F.boss ? '99층에서는 월궁통장을 쓸 수 없어요. 내 힘으로 도전해요!' : '돌발 스테이지에서는 월궁통장을 쓸 수 없어요.', 'hami'); return; }
  if (BANK <= 0) { say('월궁통장이 없어요. 10층마다 나오는 돌발 스테이지를 풀면 받을 수 있어요.', 'hami'); return; }
  $('bankq').classList.remove('hidden'); $('bankq-n').innerText = BANK;
}
function bankYes() { $('bankq').classList.add('hidden'); if (DONE || BANK <= 0) return; BANK--; save(); if (S.give) {} pass('💳 월궁통장을 써서 이 단계를 통과했어요.'); drawSteps(); }
function bankNo() { $('bankq').classList.add('hidden'); }
function stepDone(msg) {
  const m = msg || S.ok; drawSteps();
  if (S.give) addInv(S.give);
  $('fb').innerHTML = `<b style="color:#16a34a">✅ 잘했어요!</b> ${m}`;
  $('nextb').classList.remove('hidden'); $('nextb').innerText = SI < FLOORS[CUR].steps.length - 1 ? '다음 ▶' : '🚪 문 열기';
  say(`잘했어요! ${m}`, pick(['wol', 'hami']), ['잘했어요', m]);
  // 층의 마지막 단계(문 열기)가 아니면, 칭찬을 듣고 저절로 다음 단계로 넘어가요 (1.1.0)
  if (SI < FLOORS[CUR].steps.length - 1) { const c0 = CUR, s0 = SI, d = Math.min(4500, 1600 + String(m).length * 80); setTimeout(() => { if (CUR === c0 && SI === s0 && DONE && !$('play').classList.contains('hidden')) nextStep(); }, d); }
}
function nextStep() { const F = FLOORS[CUR]; if (SI < F.steps.length - 1) { SI++; showStep(); } else floorClear(); }
function floorClear() {
  const F = FLOORS[CUR], n = F.starN || F.steps.length, st = MISS <= Math.ceil(n / 2) ? 3 : MISS <= n * 2 ? 2 : 1;
