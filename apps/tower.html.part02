    B.cutLine({ title: '동그라미 자르기', q: '동그라미 선을 따라 열쇠 그림을 오려 내요.', path: B.circle(430, 260, 120), tol: 22, h: '종이를 돌린다고 생각하며 동그라미를 따라 천천히 돌아가요.', done: () => em(430, 260, 110, '🗝️'), ok: '열쇠 그림을 오려 냈어요!' }),
    { type: 'choice', title: '건네주기', q: '친구에게 가위를 건넬 때는 어떻게 할까요?', bg: 'desk', opts: [{ k: 'scissors', r: 90, o: { open: 40 }, t: '가위를 벌린 채 날 끝을 친구 쪽으로 내밀어요' }, { e: '🤾', t: '던져서 줘요' }, { img: 'c_hand', t: '날을 닫아 주먹으로 감싸 쥐고 손잡이를 내밀어요' }], a: 2, elim: 1, no: '친구가 날에 다칠 수 있어요.', h: '친구가 날에 다치지 않게 손잡이를 줘요.', ok: '안전하게 건넸어요.' },
  ] },
{ id: 'ruler', z: 0, name: '자와 연필의 방', tool: '자·연필', use: '길이를 재고 곧은 선을 그어요.', icon: ic('ruler', .8, -20),
  intro: '3층 비밀 상자에 "길이를 재고 12cm 선을 그어라"라고 쓰여 있어요. 자와 연필로 해결해요.',
