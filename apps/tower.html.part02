// ===================== 꼭대기 화면 =====================
const GOD_LINES = [
  ['허허허, 장하구나!', '장하구나…', 0],
  ['아흔아홉 층을 다 올랐구나.', '올랐구나…', 1],
  ['백 층은 선생님 앞에 있느니라.', '있느니라…', 2],
  ['강천석 선생님을 만나러 가거라.', '가거라…', 3],
  ['축하해요! 우리 같이 선생님께 가 봐요!', '가 봐요…', 'kids'],
];
const GODV = ["data:audio/mpeg;base64,", "data:audio/mpeg;base64,", "data:audio/mpeg;base64,", "data:audio/mpeg;base64,"];
let GODI = 0, GODAMB = null;
function showGod() {
  GODI = 0; $('god').classList.remove('hidden');
  $('god-tower').innerHTML = `<g transform="translate(170,${545 + 98 * FH})">${towerSVG(95, 99).replace(/<rect x="[^"]*" y="[^"]*" width="92"[^>]*\/><text[^<]*<\/text>/g, '')}</g>`;
  $('god-cl').innerHTML = [...Array(9)].map((_, i) => `<div class="gcloud" style="top:${60 + (i * 67) % 520}px;width:${220 + (i % 3) * 120}px;height:${90 + (i % 3) * 40}px;animation-duration:${26 + i * 5}s;animation-delay:-${i * 6}s;opacity:${.35 + (i % 3) * .2}"></div>`).join('');
  $('god-sp').innerHTML = [...Array(26)].map((_, i) => `<div class="gspk" style="left:${260 + (i * 97) % 760}px;top:${150 + (i * 53) % 330}px;animation-delay:${(i * .37) % 3.2}s"></div>`).join('');
  godAmb(true); godShow();
}
function godShow() {
  const L = GOD_LINES[GODI];
  $('god-t').innerHTML = `${L[0]}<span class="ec">${L[1]}  ${L[1].replace(/^.*?(\S{2,3}…)$/, '$1')}</span>`;
  $('god-next').innerText = GODI < GOD_LINES.length - 1 ? '다음 ▶' : '📸 인증 화면 보기';
  godSay();
}
function godNext() { if (GODI < GOD_LINES.length - 1) { GODI++; godShow(); } else { stopVoice(); godAmb(false); $('god').classList.add('hidden'); showCert(); } }
// 메아리 소리: 녹음이 있으면 녹음에 메아리를, 없으면 낮고 느린 기계 목소리 + 끝말 메아리
let GODVERB = null, GODREC = null;
function godVerb() { const a = ac(); if (!a) return null; if (GODVERB && GODVERB.ctx === a) return GODVERB.in;
  const inp = a.createGain(), dry = a.createGain(), wet = a.createGain(), d1 = a.createDelay(2), fb = a.createGain(), lp = a.createBiquadFilter(), cv = a.createConvolver();
  const len = a.sampleRate * 3.2, ir = a.createBuffer(2, len, a.sampleRate); for (let c = 0; c < 2; c++) { const ch = ir.getChannelData(c); for (let i = 0; i < len; i++) ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.4); }
  cv.buffer = ir; d1.delayTime.value = .34; fb.gain.value = .55; lp.type = 'lowpass'; lp.frequency.value = 2600; dry.gain.value = 1; wet.gain.value = .75;
  inp.connect(dry).connect(a.destination); inp.connect(d1); d1.connect(lp).connect(fb).connect(d1); lp.connect(wet); inp.connect(cv).connect(wet); wet.connect(a.destination);
  GODVERB = { ctx: a, in: inp }; return inp; }
async function godSay() {
  const L = GOD_LINES[GODI]; stopVoice(); LAST_AUDIO = [L[0]]; if (!soundOn) return; const tok0 = playToken;
  if (typeof L[2] === 'number') { try { const a = ac(), n = L[2]; GODREC = GODREC || {}; if (!GODREC[n]) GODREC[n] = await a.decodeAudioData(await fetch(GODV[n]).then(r => r.arrayBuffer())); if (tok0 !== playToken) return; const src = a.createBufferSource(); src.buffer = GODREC[n]; const g = a.createGain(); g.gain.value = 1.6; src.connect(g).connect(a.destination); curSrc = src; src.start(); } catch (e) {} return; }
  await loadSprite(); const tok = playToken, c = findClip(L[0]);
  if (c) { try { const a = ac(), src = a.createBufferSource(); src.buffer = c[0]; if (L[2] !== 'kids') src.playbackRate.value = .94; src.connect(godVerb()); curSrc = src; src.start(0, c[1][0], c[1][1] - c[1][0]); } catch (e) {} return; }
  const sp = (t, vol, pitch, rate) => new Promise(res => { try { const u = new SpeechSynthesisUtterance(cleanSay(t)); u.lang = 'ko-KR'; if (VOICE) u.voice = VOICE; u.volume = vol; u.pitch = pitch; u.rate = rate; let d = false; const f = () => { if (!d) { d = true; res(); } }; u.onend = f; u.onerror = f; setTimeout(f, 1200 + t.length * 300); speechSynthesis.speak(u); } catch (e) { res(); } });
  const kid = L[2] === 'kids', echo = L[1].replace('…', '');
  await sp(L[0], 1, kid ? 1.25 : .55, kid ? 1 : .82); if (tok !== playToken || kid) return;
  await sp(echo, .45, .5, .8); if (tok !== playToken) return; await sp(echo.slice(-3), .2, .45, .78);
}
function godAmb(on) {
  const a = ac(); if (!a) return; if (GODAMB) { try { GODAMB.forEach(o => o.stop()); } catch (e) {} GODAMB = null; } if (!on || !soundOn) return;
  const v = godVerb(), g = a.createGain(); g.gain.value = .035; g.connect(v);
  GODAMB = [261.6, 329.6, 392, 523.2].map((f, i) => { const o = a.createOscillator(), lg = a.createGain(), lfo = a.createOscillator(); o.type = 'sine'; o.frequency.value = f; lfo.frequency.value = .08 + i * .03; lfo.connect(lg.gain); lg.gain.value = .5; const og = a.createGain(); og.gain.value = .6; lfo.connect(og.gain); o.connect(og).connect(g); o.start(); lfo.start(); return o; });
}
function showCert() {
  const d = new Date(), ds = `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 ${d.getHours()}시 ${String(d.getMinutes()).padStart(2, '0')}분`, nm = (() => { try { return localStorage.getItem('tower-name') || ''; } catch (e) { return ''; } })();
  $('cert-date').innerText = ds; $('cert-name').value = nm;
  $('clear').classList.add('hidden'); $('cert').classList.remove('hidden'); sfx('clear');
  playLines(['구십구 층 정복', '인증샷을 찍고 강천석 선생님을 찾아가세요', '백 단계에 도전합니다']);
}
function nextFloor() { if (CUR < FLOORS.length - 1 && !isOpen(CUR + 1)) { BAND = Math.floor(CUR / 10); goHome(); $('tot').innerHTML = lockMsg(CUR + 1); return; } if (CUR < FLOORS.length - 1) { BAND = Math.floor((CUR + 1) / 10); try { sessionStorage.setItem('tower-band', BAND); } catch (e) {} liftGo(CUR, CUR + 1); } else goHome(); }
// 공중부양 엘리베이터: 탑 바깥에서 월이·아리·대롱이가 원판을 타고 올라가요
let LIFT = null;
const FH = 168;
const STONE_DEFS = `<defs><filter id="gran" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency=".55" numOctaves="3" seed="7" result="n"/><feColorMatrix in="n" type="matrix" values="0 0 0 0 .18  0 0 0 0 .17  0 0 0 0 .15  0 0 0 1.1 -.42" result="d"/><feComposite in="d" in2="SourceGraphic" operator="in" result="t"/><feMerge><feMergeNode in="SourceGraphic"/><feMergeNode in="t"/></feMerge></filter>
<linearGradient id="stB" x1="0" x2="1"><stop offset="0" stop-color="#9b968c"/><stop offset=".35" stop-color="#bdb8ad"/><stop offset=".7" stop-color="#aaa59a"/><stop offset="1" stop-color="#7f7a71"/></linearGradient>
<linearGradient id="stR" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c9c4b9"/><stop offset="1" stop-color="#9a958b"/></linearGradient>
<linearGradient id="stC" x1="0" x2="1"><stop offset="0" stop-color="#d9c27a"/><stop offset=".5" stop-color="#f5e3a3"/><stop offset="1" stop-color="#c9a95a"/></linearGradient>
<filter id="lfog"><feGaussianBlur stdDeviation="5"/></filter><linearGradient id="lmist" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#ede9fe" stop-opacity="0"/><stop offset="1" stop-color="#ede9fe" stop-opacity=".9"/></linearGradient></defs>`;
function stoneTier(n, cur, plain) {
  // 감은사지 석탑: 우주·탱주가 새겨진 몸돌, 5단 옥개받침, 넓고 두꺼운 지붕돌(끝이 살짝 들림)
  const cx = 470, base = -(n - 1) * FH, W = 236 - Math.min(n, 99) * .45, bh = 74, by = base - bh, ln = '#5b574f';
  let o = `<g filter="url(#gran)">`;
  o += `<rect x="${cx - W / 2}" y="${by}" width="${W}" height="${bh}" fill="${cur ? 'url(#stC)' : 'url(#stB)'}" stroke="${ln}" stroke-width="2"/>`;
  o += `<rect x="${cx - W / 2}" y="${by}" width="16" height="${bh}" fill="rgba(255,255,255,.12)" stroke="${ln}" stroke-width="1.2"/><rect x="${cx + W / 2 - 16}" y="${by}" width="16" height="${bh}" fill="rgba(0,0,0,.12)" stroke="${ln}" stroke-width="1.2"/>`;
  o += `<rect x="${cx - 7}" y="${by}" width="14" height="${bh}" fill="rgba(0,0,0,.05)" stroke="${ln}" stroke-width="1.2"/><rect x="${cx - W / 2}" y="${by}" width="${W}" height="12" fill="rgba(0,0,0,.28)"/>`;
  // 옥개받침 5단
  for (let k = 0; k < 5; k++) { const w = W + 12 + k * 16, yy = by - (k + 1) * 7; o += `<rect x="${cx - w / 2}" y="${yy}" width="${w}" height="7" fill="${k % 2 ? '#a7a296' : '#b6b1a6'}" stroke="${ln}" stroke-width="1.2"/>`; }
  const ub = by - 35, RW = W * 2.02, th = 26, lift = 10, top = ub - th - 26, TW = W * .98;
  o += `<path d="M${cx - RW / 2},${ub - lift} Q${cx - RW / 2 + 40},${ub} ${cx - RW / 2 + 90},${ub} L${cx + RW / 2 - 90},${ub} Q${cx + RW / 2 - 40},${ub} ${cx + RW / 2},${ub - lift} L${cx + RW / 2 + 2},${ub - lift - th} Q${cx + RW / 2 - 50},${ub - th - 4} ${cx + TW / 2},${top} L${cx - TW / 2},${top} Q${cx - RW / 2 + 50},${ub - th - 4} ${cx - RW / 2 - 2},${ub - lift - th} Z" fill="url(#stR)" stroke="${ln}" stroke-width="2.2" stroke-linejoin="round"/>`;
  o += `<path d="M${cx - RW / 2 + 4},${ub - lift - 3} Q${cx - RW / 2 + 60},${ub - 4} ${cx},${ub - 4} Q${cx + RW / 2 - 60},${ub - 4} ${cx + RW / 2 - 4},${ub - lift - 3}" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="3"/>`;
  o += `<rect x="${cx - TW / 2}" y="${top - 6}" width="${TW}" height="6" fill="#aca79b" stroke="${ln}" stroke-width="1.2"/></g>`;
  if (plain) return o;
  const done = typeof STARS !== 'undefined' && FLOORS[n - 1] && STARS[FLOORS[n - 1].id];
  o += `<rect x="${cx - 46}" y="${by + 18}" width="92" height="36" rx="6" fill="${cur ? '#fde047' : 'rgba(41,37,36,.55)'}" stroke="${cur ? '#a16207' : 'rgba(255,255,255,.35)'}" stroke-width="2"/><text x="${cx}" y="${by + 44}" text-anchor="middle" font-size="24" font-weight="bold" fill="${cur ? '#3b0764' : '#fef9c3'}">${n}층${done && !cur ? '★' : ''}</text>`;
  return o;
}
function towerSVG(a, b) {
  const lo = Math.max(1, a - 4), hi = b + 5; let o = STONE_DEFS;
  if (lo === 1) { const cx = 470, ln = '#5b574f';
    // 이중 기단: 위층 기단(우주·탱주) + 갑석, 아래층 기단 + 넓은 갑석, 바닥 돌
    o += `<g filter="url(#gran)"><rect x="${cx - 230}" y="0" width="460" height="16" fill="#b6b1a6" stroke="${ln}" stroke-width="2"/><rect x="${cx - 210}" y="16" width="420" height="80" fill="url(#stB)" stroke="${ln}" stroke-width="2"/>` + [-210, -140, -70, 0, 70, 140, 194].map(x => `<rect x="${cx + x}" y="16" width="16" height="80" fill="rgba(0,0,0,.08)" stroke="${ln}" stroke-width="1.2"/>`).join('')
      + `<path d="M${cx - 330},120 L${cx - 300},96 L${cx + 300},96 L${cx + 330},120 Z" fill="url(#stR)" stroke="${ln}" stroke-width="2"/><rect x="${cx - 310}" y="120" width="620" height="70" fill="url(#stB)" stroke="${ln}" stroke-width="2"/>` + [-310, -210, -105, 0, 105, 210, 294].map(x => `<rect x="${cx + x}" y="120" width="16" height="70" fill="rgba(0,0,0,.08)" stroke="${ln}" stroke-width="1.2"/>`).join('')
      + `<rect x="${cx - 360}" y="190" width="720" height="22" fill="#a39e93" stroke="${ln}" stroke-width="2"/></g>` + `<text x="${cx}" y="66" text-anchor="middle" font-size="22" font-weight="bold" fill="#3f3a33" opacity=".85">월궁탑 명예의 전당</text>` + hallNames().slice(0, 12).map((nm, k) => `<text x="${cx - 255 + (k % 6) * 102}" y="${150 + Math.floor(k / 6) * 26}" text-anchor="middle" font-size="18" font-weight="bold" fill="#3f3a33" opacity=".8">${nm}</text>`).join('') + `<rect x="0" y="212" width="1280" height="400" fill="#3f6212"/><ellipse cx="${cx}" cy="216" rx="420" ry="12" fill="rgba(0,0,0,.25)"/>`; }
  for (let n = lo; n <= hi; n++) o += n <= 99 ? stoneTier(n, n === b) : `<g filter="url(#lfog)" opacity="${Math.max(.15, .7 - (n - 100) * .15)}">${stoneTier(n, false, 1)}</g>`;
  if (hi > 99) o += `<rect x="-600" y="${-hi * FH}" width="2500" height="${(hi - 99) * FH + 40}" fill="url(#lmist)"/>`;
  return o;
}
function liftGo(a, b) {
  $('clear').classList.add('hidden'); const L = $('lift'), sv = $('lift-svg'), pf = $('lift-pf'), F = FLOORS[b], K = KIND(F), A = a + 1, Bn = b + 1;
  $('lift-a').innerText = `${A}층`; $('lift-b').innerText = `${Bn}층`; $('lift-k').innerText = `${K[0]} ${K[1]} · ${F.name}`;
  const h = Bn / 99, sky = `<defs><linearGradient id="lsky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${h > .6 ? '#1e1b4b' : '#4c1d95'}"/><stop offset="1" stop-color="${h > .6 ? '#4c1d95' : h > .3 ? '#a855f7' : '#f9a8d4'}"/></linearGradient></defs><rect width="1280" height="720" fill="url(#lsky)"/>`
    + (h > .3 ? [...Array(40)].map((_, i) => `<circle cx="${(i * 331) % 1280}" cy="${(i * 197) % 700}" r="${1 + i % 3}" fill="#fff" opacity="${.3 + h * .6}"/>`).join('') : '') + (h > .6 ? em(1120, 110, 70, '🌙') : '');
  const camY = n => 430 + (n - 1) * FH + 40;
  sv.innerHTML = sky + `<g id="lift-cld"></g><g id="lift-tw">${towerSVG(A, Bn)}</g>`;
  $('lift-cl').innerHTML = [...Array(6)].map((_, i) => `<div class="lcl" style="left:${80 + (i * 223) % 1100}px;top:${-140 - i * 70}px;font-size:${60 + (i % 3) * 30}px;animation-delay:${i * .2}s">☁️</div>`).join('') + [...Array(10)].map((_, i) => `<div class="lsp" style="left:${830 + (i * 37) % 260}px;top:${490 + (i * 23) % 60}px;animation-delay:${i * .17}s">✨</div>`).join('');
  L.classList.remove('hidden'); sfx('good');
  const tw = $('lift-tw'), t0 = performance.now(), D = 2400; if (LIFT) { cancelAnimationFrame(LIFT.r); clearTimeout(LIFT.r); }
  LIFT = { b };
  const tick = t => { const k = Math.min(1, (t - t0) / D), e = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2, y = camY(A) + (camY(Bn) - camY(A)) * e;
    tw.setAttribute('transform', `translate(0,${y})`); pf.style.top = `${250 + Math.sin(t / 260) * 8 - Math.sin(k * Math.PI) * 30}px`;
    if (k < 1) LIFT.r = requestAnimationFrame(tick); else LIFT.r = setTimeout(liftEnd, 700); };
  LIFT.r = requestAnimationFrame(tick);
  if (typeof playLines === 'function') playLines([`${Bn}층으로 올라가요`]);
}
function liftEnd() { if (!LIFT) return; const b = LIFT.b; cancelAnimationFrame(LIFT.r); clearTimeout(LIFT.r); LIFT = null; $('lift').classList.add('hidden'); openFloor(b); }

// ===================== 손가락 입력 =====================
const vis = $('vis');
function svgPt(e) { const pt = vis.createSVGPoint(); pt.x = e.clientX; pt.y = e.clientY; const r = pt.matrixTransform(vis.getScreenCTM().inverse()); return [r.x, r.y]; }
vis.addEventListener('pointerdown', e => {
  if (!S || DONE) return; const p = svgPt(e), t = e.target.closest('[data-act]');
  try { vis.setPointerCapture(e.pointerId); } catch (er) {}
  if (t) { P[S.type].act && P[S.type].act(t.dataset.act); if (DONE || !P[S.type].down || t.dataset.act === 'miss' || t.dataset.act.startsWith('find') || t.dataset.act.startsWith('fx:')) return; }
  P[S.type].down && P[S.type].down(p);
});
vis.addEventListener('pointermove', e => { if (!S || DONE || !P[S.type].move) return; P[S.type].move(svgPt(e)); });
const upH = e => { if (!S || DONE || !P[S.type].up) return; P[S.type].up(svgPt(e)); };
vis.addEventListener('pointerup', upH); vis.addEventListener('pointercancel', upH);
let LT = performance.now();
(function loop(t) { const dt = Math.min(.05, (t - LT) / 1000); LT = t; if (S && !DONE && P[S.type].tick && !$('play').classList.contains('hidden')) P[S.type].tick(dt); requestAnimationFrame(loop); })(LT);

// ===================== 녹음 대본 =====================
function appLines() {
  const out = new Set(['잘했어요', '그림에 표시했어요', '화살표와 반짝이는 곳을 따라 해요', '문이 열렸어요', '다시 해 봐요',
    '선에서 벗어났어요. 멈춘 곳에서 다시 이어서 해요.', '톱이 선에서 벗어났어요. 선을 따라 곧게 움직여요.', '선을 따라 짜요. 멈춘 곳에서 이어서 해요.',
    '너무 적어요. 조금 더 오래 눌러요.', '너무 많아요. 넘쳐 버렸어요.', '너무 많아요. 흘러넘쳤어요.', '너무 빨리 움직여서 양이 부족해요. 조금 더 천천히 짜요.', '너무 천천히 움직여서 넘쳤어요. 조금 더 빠르게 짜요.',
    '처음에는 살살 쳐야 해요. 못이 휘거나 손을 다칠 수 있어요.', '너무 세게 쳐서 못이 휘었어요. 새 못으로 다시 해요.',
    '다시 읽어 봐요. 0에서 시작했는지, 끝이 어느 눈금인지 봐요.', '물방울이 가운데 두 줄 사이에 오지 않았어요. 물방울은 높은 쪽으로 가요.',
    '반대 방향이에요. 그쪽은 풀리는 방향이에요. 시계 방향으로 돌려요.', '반대 방향이에요. 그쪽은 조이는 방향이에요. 시계 반대 방향으로 돌려요.',
    '테두리 밖에 묻었어요. 선 안쪽만 칠해요.', '나뭇결 방향(옆으로)으로 문질러요.', '덜 구부렸어요. 조금 더 올려요.', '너무 많이 구부렸어요. 조금 내려요.',
    '아직 준비되지 않았어요. 초록색이 될 때까지 기다려요.', '드릴이 기울었어요. 구멍이 비뚤어져요. ◀ ▶로 똑바로 세우며 뚫어요.', '너무 깊이 뚫어서 판자가 뚫려 버렸어요.', '너무 깊이 뚫었어요. 빨간 선에서 멈춰요.', '판자가 뚫려 버렸어요.',
    '그곳에는 없어요. 도구의 끝이 살짝 보이는 곳을 찾아요.', '비밀번호가 틀렸어요. 쪽지의 순서를 확인해요.']);
  const DJ = ['오른쪽으로', '왼쪽으로', '아래로', '위로']; DJ.forEach(d => out.add(`조금 더 ${d} 맞춰요.`));
  [1, 2, 3, 4].forEach(n => out.add(`${n}번째로 할 일이 아니에요.`));
  const KEYS = ['no', 'low', 'high', 'lowMsg', 'highMsg', 'offMsg', 'outMsg', 'dirMsg', 'early', 'wrongMsg'];
  FLOORS.forEach(F => { out.add(F.intro); out.add(F.outro); F.steps.forEach(s => {
    out.add(s.q); out.add(s.h); out.add(s.ok);
    KEYS.forEach(k => { if (typeof s[k] === 'string') { if (s[k].includes('%')) DJ.forEach(d => out.add(s[k].replace('%', d))); else out.add(s[k]); } });
    (s.opts || []).forEach(o => o.no && out.add(o.no));
    (s.ctrls || []).forEach(c => { KEYS.forEach(k => typeof c[k] === 'string' && out.add(c[k])); Object.values(c.msg || {}).forEach(m => out.add(m)); });
    if (s.type === 'measure' && s.ask === 'mark') { out.add(`조금 짧아요. ${s.target}${s.unit || 'cm'} 눈금을 찾아요.`); out.add(`조금 길어요. ${s.target}${s.unit || 'cm'} 눈금을 찾아요.`); }
  }); });
  out.delete(undefined);
  return [...out];
}
goHome();
</script>
<script>
/* 그리기 빠르게 (1.1.1): 도구를 끄는 동안은 손가락이 움직일 때마다 그리지 않고, 화면이 바뀌는 때(1/60초)에 한 번만 그려요.
   칠판(크롬 83)에서 끌기가 끊기던 것을 이것으로 고쳤어요 (11/27 칠판 확인: 취소 0번). */
(function () { try {
  var real = redraw, pend = false;
  redraw = function () {
    if (V && V.drag && !DONE) { if (!pend) { pend = true; requestAnimationFrame(function () { pend = false; real(); }); } return; }
    real();
  };
} catch (x) {} })();
</script>
<script>
// 초승달 전과로 돌아가는 단추 (늘 보여요): ◀ 이전 = 이 앱의 소개 화면, 🏠 홈 = 앱 고르기 화면
(function () {
  const go = h => { if (window.parent !== window) { try { window.parent.postMessage({ hub: 'close', h }, '*'); } catch (e) {} return; } location.href = encodeURI('혜광전과초등.html') + h; };
  const box = document.createElement('div'); box.id = 'hub-nav';
  box.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:20000;display:flex;gap:5px";
  const mk = (t, h) => { const b = document.createElement('button'); b.textContent = t; b.onclick = () => go(h);
    b.style.cssText = "background:#fff;border:2px solid #4a3428;border-radius:99px;padding:3px 11px;font:15px 'Jua','Malgun Gothic',sans-serif;color:#4a3428;cursor:pointer;box-shadow:0 2px 0 #f6c85f"; return b; };
  box.appendChild(mk('◀ 이전', '#app=tower')); box.appendChild(mk('🏠 홈', '#apps'));
  // 초승달 전과 초등에서 단원 칸을 눌러 들어오면 그 활동으로 바로 가요
  const H = window.__HUB_START;
  if (H && H.app === 'tower' && H.d != null) addEventListener('load', () => setTimeout(() => { try { const d = +H.d;  } catch (e) {} }, 700), { once: true });
  (document.body ? Promise.resolve() : new Promise(r => document.addEventListener('DOMContentLoaded', r))).then(() => document.body.appendChild(box));
})();
</script>
<script>
/* 이모지를 그림으로 보여 줌 — 칠판(안드로이드)마다 이모지 글꼴이 달라 빈칸이 생기지 않게. 글자는 그대로 두고 그 위에 그림을 보여 줌.
   그림: Noto Emoji (Google, Apache License 2.0) */
(function(){
