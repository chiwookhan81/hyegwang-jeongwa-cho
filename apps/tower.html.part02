];

// ---------- 도전방 만들기 ----------
function rng(seed) { let t = seed * 2654435761 >>> 0; return () => { t += 0x6D2B79F5; let x = t; x = Math.imul(x ^ x >>> 15, x | 1); x ^= x + Math.imul(x ^ x >>> 7, x | 61); return ((x ^ x >>> 14) >>> 0) / 4294967296; }; }
const pickR = (R, a) => a[Math.floor(R() * a.length)];
const T = d => [1, 2, 3, 4, 5][d - 1];
const MK = {
  ruler: (R, d) => { const t = 3 + Math.floor(R() * 14) + (d >= 3 && R() < .5 ? .5 : 0), g = String(Math.floor(t) % 10);
    return { type: 'measure', title: `${t}cm 표시`, q: `자에서 ${t}cm 자리에 표시해요. ${String(t).includes('.') ? '반 칸(5mm)까지 정확히! ' : ''}일의 자리 숫자가 쪽지가 돼요.`, bg: 'desk', ask: 'mark', target: t, tol: [.4, .3, .25, .2, .15][d - 1], snap: .5, start: 1, x0: 70, k: 40, cm: 18, y: 300, give: g, h: `숫자 ${Math.floor(t)} 위${String(t).includes('.') ? '에서 반 칸 더' : ''}에 맞춰요.`, ok: `${t}cm! 숫자 ${g}를 얻었어요.` }; },
  tape: (R, d) => { const t = 20 + Math.floor(R() * 70), g = String(t)[0];
    return { type: 'measure', title: `${t}cm 표시`, q: `줄자로 ${t}cm 자리에 표시해요. 앞자리가 쪽지 숫자예요.`, bg: 'bench', ask: 'mark', tape: 1, target: t, tol: [.75, .5, .5, .25, .25][d - 1], snap: .25, start: 5, x0: 60, k: 7.4, cm: 100, y: 300, give: g, obj: (X, y) => wood(X(0), y - 80, X(95) - X(0), 60), h: `숫자 ${t} 위에 맞춰요.`, ok: `${t}cm! 숫자 ${g}를 얻었어요.` }; },
  caliper: (R, d) => { const v = 6 + Math.floor(R() * 13), dd = d >= 3 ? 1 : 2, opts = [v - dd, v, v + dd].map(x => x + 'mm'), g = String(v % 10);
    return { type: 'measure', title: '굵기 재기', q: '캘리퍼스로 잰 굵기는 몇 mm일까요? 일의 자리가 쪽지 숫자예요.', bg: 'wall', ask: 'read', unit: 'mm', noSub: 1, opts, a: 1, x0: 120, k: 30, cm: 20, y: 300, give: g,
      obj: (X, y) => `<rect x="${X(0)}" y="${y - 90}" width="${X(v) - X(0)}" height="60" rx="30" fill="#e7c48d" stroke="#92400e" stroke-width="3"/><path d="M${X(v)},${y - 4} l-9,-16 l18,0 z" fill="#ef4444"/>`, read: X => `<circle cx="${X(v)}" cy="346" r="18" fill="none" stroke="#ef4444" stroke-width="4"/>`, h: '빨간 ▼ 아래 숫자를 읽어요.', ok: `${v}mm! 숫자 ${g}를 얻었어요.` }; },
  pour: (R, d) => { const st = d >= 3 ? 10 : 50, t = Math.round((120 + R() * 240) / st) * st, w = [14, 11, 8, 6, 4][d - 1], g = String(t)[0];
    return { type: 'squeeze', mode: 'hold', title: `물 ${t}mL`, q: `계량컵에 물 ${t}mL를 부어요. 앞자리가 쪽지 숫자예요.`, bg: 'kitchen', lo: t - w, hi: t + w, max: 400, rate: 55 + d * 6, gauge: '물의 양', btn: '붓기', col: '#60a5fa', bx: 600, by: 450, give: g,
      pic: V => { const f = y => 380 - y * .68; return `<path d="M260,90 L470,90 L455,380 L275,380 Z" fill="rgba(224,242,254,.6)" stroke="#334155" stroke-width="4"/><rect x="276" y="${f(Math.min(V.amt, 400))}" width="178" height="${380 - f(Math.min(V.amt, 400))}" fill="#60a5fa" opacity=".8"/>` + [...Array(d >= 3 ? 8 : 4)].map((_, i) => (i + 1) * (d >= 3 ? 50 : 100)).map(v => `<line x1="270" y1="${f(v)}" x2="${v % 100 ? 296 : 310}" y2="${f(v)}" stroke="#1e3a8a" stroke-width="3"/>${v % 100 ? '' : `<text x="318" y="${f(v) + 7}" font-size="20" fill="#1e3a8a">${v}mL</text>`}`).join('') + tx(600, 120, 30, `${t}mL`, '#b91c1c'); },
      lowMsg: `${t}mL보다 적어요.`, highMsg: `${t}mL를 넘었어요.`, h: `물 높이가 ${t}mL에 닿으면 떼요.`, ok: `${t}mL! 숫자 ${g}를 얻었어요.` }; },
  weigh: (R, d) => { const st = d >= 4 ? 1 : d >= 2 ? 5 : 10, t = Math.round((30 + R() * 60) / st) * st, w = [5, 4, 3, 2, 1.5][d - 1], g = String(t)[0], it = pickR(R, ['🍬', '🧈', '🥜', '🍚']);
    return { type: 'squeeze', mode: 'hold', title: `${t}g 재기`, q: `영점을 맞춘 저울에 ${t}g을 올려요. 앞자리가 쪽지 숫자예요.`, bg: 'kitchen', lo: t - w, hi: t + w, max: 120, rate: 14 + d * 2, gauge: '무게', btn: '붓기', col: '#fef3c7', bx: 620, by: 450, give: g,
      pic: V => tool('kscale', 330, 300, 1.5, 0, { val: Math.round(V.amt) }) + `<ellipse cx="330" cy="240" rx="110" ry="30" fill="#e0f2fe" stroke="#334155" stroke-width="3"/>` + em(330, 140, 60, it) + tx(640, 120, 30, `${t}g`, '#b91c1c'), lowMsg: `${t}g보다 적어요.`, highMsg: `${t}g을 넘었어요.`, h: `숫자가 ${t}${JO(t, '이', '가')} 되면 떼요.`, ok: `${t}g! 숫자 ${g}를 얻었어요.` }; },
  micro: (R, d, food) => { let m = 1 + Math.floor(R() * 4);
    let sc = d >= 2 ? pickR(R, [10, 20, 30, 40, 50]) : 0;
    const fd0 = pickR(R, ['즉석밥', '우유', '만두', '감자']), fd = food || fd0; if (food === '버터') { m = 0; sc = pickR(R, [20, 30, 40]); } const lab = m ? `${m}분${sc ? ' ' + sc + '초' : ''}` : `${sc}초`;
    return { type: 'dial', title: '시간 맞추기', q: (food === '버터' ? `버터를 부드럽게 녹여요. 레시피에 "${lab}"라고 쓰여 있어요. 분이 쪽지 숫자예요.` : `${fd} 포장에 "${lab}"라고 쓰여 있어요. 분이 쪽지 숫자예요.`), bg: 'kitchen', cy: 380, give: String(m), ctrls: [{ name: '분', min: 0, max: 5, step: 1, unit: '분', target: m, start: m === 5 ? 0 : 5, low: '짧아요.', high: '길어요.' }, { name: '초', opts: [0, 10, 20, 30, 40, 50], unit: '초', unitIn: 1, target: sc, start: sc ? 0 : 30, msg: {} }],
      pic: V => tool('microwave', 430, 170, 1.4, 0, { t: `${V.v[0]}:${String(V.v[1]).padStart(2, '0')}` }) + `<rect x="620" y="90" width="150" height="100" rx="10" fill="#fef9c3" stroke="#ca8a04" stroke-width="3"/>` + tx(695, 125, 18, fd, '#713f12') + tx(695, 158, 22, lab, '#b91c1c'), h: `분은 ${m}, 초는 ${sc}${JO(sc, '으로', '로')} 맞춰요.`, ok: `${lab}! 숫자 ${m}${JO(m, '을', '를')} 얻었어요.` }; },
  level: (R, d) => { let s0 = 1 + Math.floor(R() * 11), tg = 3 + Math.floor(R() * 6); if (s0 === tg) s0 = tg + 3; const g = String(Math.floor(R() * 10));
    return { type: 'level', title: '수평 맞추기', q: '선반을 반듯하게 맞추면 숫자가 보여요.', start: s0, target: tg, give: g, h: '물방울은 높은 쪽으로 가요.', ok: `반듯해요! 숫자 ${g}.` }; },
  angle: (R, d) => { const t = pickR(R, d >= 3 ? [30, 45, 60, 120, 135] : [45, 90]), g = String(t)[0];
    return { type: 'angle', title: `${t}° 만들기`, q: `철사를 ${t}°로 구부려요. 각도의 앞자리가 쪽지 숫자예요.`, bg: 'wall', target: t, tol: [6, 5, 4, 3, 2][d - 1], give: g, h: `숫자가 ${t}${JO(t, '이', '가')} 될 때까지 끌어요.`, ok: `${t}°! 숫자 ${g}를 얻었어요.` }; },
  claw: (R, d) => { const c = .5 + R() * .15, w = [.3, .24, .2, .16, .12][d - 1], g = String(Math.floor(R() * 10));
    return { type: 'hammer', title: '못 박기', q: '살살 두 번, 그다음 초록 칸에서 탕! 못 머리에 쪽지 숫자가 있어요.', tool: 'claw', light: 2, hits: 3, finger: 1, lightZone: [.12, .36], zone: [c - w / 2, c + w / 2], speed: 3 + d * .4, give: g, h: '초록 칸에 올 때 쳐요.', ok: `못이 들어갔어요! 숫자 ${g}.` }; },
  mallet: (R, d) => { const w = [.3, .25, .2, .16, .13][d - 1], c = .45, g = String(Math.floor(R() * 10));
    return { type: 'hammer', title: '다리 끼우기', q: '고무망치로 통통! 다리를 끝까지 끼우면 쪽지 숫자가 보여요.', tool: 'mallet', obj: 'peg', hits: 3 + d, zone: [c - w / 2, c + w / 2], speed: 3 + d * .4, strongMsg: '너무 세게 쳤어요. 살살 여러 번 쳐요.', give: g, h: '초록 칸(중간 힘)일 때 쳐요.', ok: `다리를 끼웠어요! 숫자 ${g}.` }; },
  drill: (R, d) => { const t = d >= 3 ? 12 + Math.floor(R() * 25) : pickR(R, [15, 20, 25, 30]), g = String(t)[0];
    return { type: 'drill', title: `깊이 ${t}mm`, q: `빨간 선(${t}mm)에서 직접 드릴을 꺼요. 앞자리가 쪽지 숫자예요.`, target: t, tol: [3, 2, 2, 1.5, 1][d - 1], mark: 1, thick: 40, bit: 6, lim: 7 - d * .5, wob: 4 + d, speed: 4 + d * .5, give: g, h: '보라색 깊이 막대가 빨간 선에 닿으면 "끄기"를 눌러요.', ok: `${t}mm! 숫자 ${g}를 얻었어요.` }; },
  bit: (R, d) => { const t = pickR(R, [4, 6, 8]), o = [4, 6, 8].map(x => ({ k: 'drill', t: `${x}mm 날` }));
    return { type: 'choice', title: '드릴 날 고르기', q: `설계도에 "지름 ${t}mm 구멍"이라고 쓰여 있어요. 어떤 날을 끼울까요? 날의 숫자가 쪽지예요.`, bg: 'bench', opts: o, a: [4, 6, 8].indexOf(t), elim: ([4, 6, 8].indexOf(t) + 1) % 3, give: String(t), h: '구멍 지름과 같은 숫자의 날을 끼워요.', ok: `${t}mm 날! 숫자 ${t}${JO(t, '을', '를')} 얻었어요.`, no: '구멍 크기와 날 크기가 달라요.' }; },
  bond: (R, d) => { const g = String(Math.floor(R() * 10)); return B.bondLine({ easy: d <= 2 ? 1 : 0, tol: [30, 26, 22, 18, 15][d - 1], give: g, ok: `고르게 짰어요! 숫자 ${g}.` }); },
  sil: (R, d) => { const g = String(Math.floor(R() * 10)); return B.silLine({ easy: d <= 2 ? 1 : 0, tol: [28, 24, 20, 17, 14][d - 1], give: g, ok: `틈을 메웠어요! 숫자 ${g}.` }); },
  glue: (R, d) => { const s = 4 + d + Math.floor(R() * 3), g = String(s % 10);
    return { type: 'wait', title: '데우기', q: '초록 불이 켜지면 방아쇠를 당겨요. 기다린 초 수의 끝자리가 쪽지 숫자예요.', bg: 'desk', sec: s, btn: '방아쇠 당기기', give: g, pic: V => tool('gluegun', 400, 280, 1.4, 0, { warm: V.t > s / 2, ready: V.t >= s }) + tx(400, 400, 26, `${Math.min(s, Math.floor(V.t))}초`, '#7c3aed'), early: '아직 덜 데워졌어요.', h: '초록색이 될 때까지 기다려요.', ok: `${s}초! 숫자 ${g}를 얻었어요.` }; },
  staple: (R, d) => { const g = String(Math.floor(R() * 10)); return B.stapler({ give: g, lo: 70 + d * 3, rate: 50 + d * 8, ok: `심이 박혔어요! 숫자 ${g}.` }); },
  cut: (R, d) => { const g = String(Math.floor(R() * 10)), n = 2 + d; return B.cutLine({ title: '꺾인 선 자르기', q: '꺾인 선을 따라 잘라요. 다 자르면 쪽지 숫자가 나와요.', path: [...Array(n + 1)].map((_, i) => [150 + i * 560 / n, i % 2 ? 180 : 330]), tol: [24, 21, 18, 16, 14][d - 1], give: g, ok: `잘 잘랐어요! 숫자 ${g}.` }); },
  turn: (R, d) => { const g = String(Math.floor(R() * 10)), cw = R() < .7; return B.turn({ title: cw ? '조이기' : '풀기', q: `전동 드라이버를 ${cw ? '시계 방향(조이기)' : '반시계 방향(풀기)'}으로 돌려요.`, dir: cw ? 'cw' : 'ccw', turns: 1 + d * .25, bg: 'bench', label: cw ? '시계 방향 ↻' : '반시계 방향 ↺', give: g, ok: `${cw ? '조였어요' : '풀었어요'}! 숫자 ${g}.` }); },
};
const THEME = {
  office: { n: '문구 창고', tools: ['scissors', 'ruler', 'stapler', 'glue', 'cutter', 'tape', 'punch'], mk: ['ruler', 'cut', 'staple', 'ruler'] },
  meas: { n: '측정 연구소', tools: ['tapemeasure', 'caliper', 'level', 'protractor', 'kscale', 'beaker', 'ruler'], mk: ['tape', 'caliper', 'pour', 'weigh', 'angle', 'level'] },
  hand: { n: '목공 작업장', tools: ['claw', 'mallet', 'pliers', 'saw', 'clamp', 'spanner', 'hexkey', 'awl'], mk: ['claw', 'mallet', 'angle', 'level'] },
  finish: { n: '마감 공방', tools: ['bond', 'gluegun', 'silicone', 'brush', 'roller', 'sander'], mk: ['bond', 'glue', 'sil', 'bond'] },
  power: { n: '전동 공구실', tools: ['drill', 'edriver', 'sander', 'clamp', 'tapemeasure'], mk: ['bit', 'drill', 'turn', 'drill'] },
  cook: { n: '요리 실습실', tools: ['mcup', 'kscale', 'knife', 'peeler', 'pan', 'spoon'], mk: ['pour', 'weigh', 'micro', 'pour'] },
};
const HPOS = [[200, 210, 'right'], [430, 320, 'up'], [650, 300, 'left'], [330, 150, 'down'], [560, 160, 'down'], [120, 340, 'right']];
const KINDS = ['box', 'drawer', 'books', 'cloth', 'bucket', 'bag'];
function genRoom(i, th, d) {
  const R = rng(1000 + i * 37), T0 = THEME[th], tl = [...T0.tools].sort(() => R() - .5).slice(0, 3), n = d >= 3 ? 4 : 3;
  const hs = tl.map((k, j) => HIDE(pickR(R, KINDS), HPOS[j][0], HPOS[j][1], k, HPOS[j][2], .58 - d * .03));
  let mk = [...T0.mk].sort(() => R() - .5); while (mk.length < n) mk.push(pickR(R, T0.mk)); mk = mk.slice(0, n);
  const steps = mk.map(m => MK[m](R, d)), ans = steps.map(s => s.give).join('');
  return { id: `gen${i + 1}`, gen: 1, d, cat: CATS[th], name: `${T0.n} Lv.${d}`, tool: tl.map(k => TOOLNAME[k]).join('·'), use: '도구를 정확히 써서 숫자를 모아요.', icon: ic(tl[0], .6),
    intro: `${T0.n}이에요. 숨은 도구를 찾고, 정확하게 써서 숫자 ${n}개를 모으면 문이 열려요. 난이도 Lv.${d}`,
    safe: d >= 4 ? '허용 범위가 아주 좁아요. 천천히 정확하게!' : '숫자를 정확히 맞춰야 쪽지가 나와요.',
    outro: `정확하게 해냈어요! 비밀번호 ${ans}${JO(ans, '으로', '로')} 문을 열었어요.`,
    steps: [B.find(Object.assign({ q: `숨은 도구 3개를 찾아요: ${tl.map(k => TOOLNAME[k]).join(', ')}` }, room(hs))), ...steps, B.code(ans)] };
}
const THS = ['office', 'meas', 'hand', 'finish', 'power', 'cook'];
const GEN = [...Array(35)].map((_, i) => genRoom(i, THS[(i * 5 + Math.floor(i / 6)) % 6], 1 + Math.floor(i * 5 / 35)));

// ---------- 99층 최종 도전 ----------
const BOSS = { id: 'boss', boss: 1, name: '99층 큰 관문', tool: '모든 도구', use: '지금까지 배운 도구를 모두 정확히!', cat: '👑 최종', icon: () => em(0, -10, 130, '👑'),
  intro: '월궁탑 99층 큰 관문이에요. 여섯 가지 도구를 찾고, 아주 정확하게 써서 비밀번호 9자리를 완성해요. 도움은 말로만 나와요.',
  safe: '서두르지 말고 숫자와 눈금을 끝까지 확인해요.',
  outro: '월궁탑 99층을 정복했어요! 진짜 도구 장인이에요.',
  steps: [
    B.find(Object.assign({ q: '줄자, 캘리퍼스, 계량컵, 장도리, 드릴, 수평계를 모두 찾아요.' }, room([HIDE('books', 200, 210, 'tapemeasure', 'right', .42), HIDE('drawer', 430, 320, 'caliper', 'up', .42), HIDE('cloth', 650, 300, 'mcup', 'left', .42), HIDE('box', 330, 150, 'claw', 'down', .42), HIDE('bag', 560, 160, 'drill', 'down', .42), HIDE('bucket', 120, 340, 'level', 'right', .42)]))),
    Object.assign(MK.tape(() => .5, 5), { title: '87cm 표시', q: '줄자로 87cm 자리에 정확히 표시해요. 앞자리가 숫자예요.', target: 87, tol: .25, give: '8', h: '숫자 87 위에 맞춰요.', ok: '87cm! 숫자 8.' }),
    Object.assign(MK.caliper(() => .6, 5), { q: '캘리퍼스로 잰 굵기의 일의 자리가 숫자예요.' }),
    Object.assign(MK.pour(() => .2, 5), { title: '물 175mL', q: '계량컵에 물 175mL를 부어요. 백의 자리가 숫자예요.', lo: 171, hi: 179, give: '1', lowMsg: '175mL보다 적어요.', highMsg: '175mL를 넘었어요.', h: '175mL에 닿으면 떼요.', ok: '175mL! 숫자 1.' }),
    { type: 'hammer', title: '못 박기', q: '살살 두 번, 그다음 아주 좁은 초록 칸에서 탕!', tool: 'claw', light: 2, hits: 3, finger: 1, lightZone: [.12, .34], zone: [.55, .65], speed: 4.6, give: '5', h: '초록 칸이 아주 좁아요.', ok: '못 머리에 숫자 5!' },
    B.bondLine({ easy: 0, tol: 15, give: '3', ok: '고르게 짰어요! 숫자 3.' }),
    { type: 'angle', title: '135° 만들기', q: '철사를 135°로 구부려요. 끝자리가 숫자예요.', bg: 'wall', target: 135, tol: 3, give: '5', h: '숫자가 135가 될 때까지 끌어요.', ok: '135°! 숫자 5.' },
    { type: 'drill', title: '깊이 27mm', q: '멈춤 막대 없이 빨간 선(27mm)에서 직접 꺼요. 십의 자리가 숫자예요.', target: 27, tol: 1, mark: 1, thick: 40, bit: 8, lim: 4.5, wob: 9, speed: 7, give: '2', h: '깊이 막대가 빨간 선에 닿는 순간 꺼요.', ok: '27mm! 숫자 2.' },
    { type: 'pick', title: '전자레인지 OK', q: '전자레인지에 넣어도 되는 것을 모두 골라요. 고른 개수가 숫자예요.', bg: 'kitchen', give: '4',
      items: [{ e: '🍲', t: '내열 유리 그릇', ok: 1, icon: 1 }, { e: '🥫', t: '참치 캔', no: '캔은 금속이에요.' }, { e: '🍱', t: '전자레인지용 용기', ok: 1, icon: 1 }, { e: '🍜', t: '스티로폼 그릇', no: '스티로폼은 녹아요.' }, { e: '🍽️', t: '도자기 접시', ok: 1, icon: 1 }, { e: '🌯', t: '은박지 김밥', no: '은박지는 금속이에요.' }, { e: '🥤', t: '일회용 컵', no: '표시 없는 일회용 플라스틱은 안 돼요.' }, { e: '☕', t: '전자레인지용 머그컵', ok: 1, icon: 1 }, { e: '🏆', t: '금테 접시', no: '금테는 금속이에요.' }, { e: '🥣', t: '스테인리스 그릇', no: '스테인리스는 쇠예요.' }],
      missMsg: '표시가 있는 것을 모두 골라요.', h: '초록 전자레인지 표시를 찾아요.', ok: '네 가지! 숫자 4.' },
    { type: 'level', title: '마지막 수평', q: '탑 꼭대기 선반을 반듯하게 맞춰요.', start: 12, target: 4, give: '6', h: '물방울은 높은 쪽으로 가요.', ok: '반듯해요! 숫자 6.' },
  ] };
BOSS.steps.push(B.code(BOSS.steps.slice(1).map(s => s.give).join(''), { clue: '모은 숫자 쪽지 9개를 찾은 순서대로 눌러요. 마지막 문이에요!' }));

ZONES.length = 0;
// ---------- 계량컵에 물 붓기 그림 ----------
function cupPic(s) {
  const t = +((s.title + s.q).match(/(\d+)\s*mL/) || [0, Math.round((s.lo + s.hi) / 2)])[1], max = t <= 250 ? 300 : t <= 400 ? 500 : 1000, st = max <= 300 ? 50 : 100;
  const X0 = 250, X1 = 430, YT = 70, YB = 420, f = v => YB - 12 - v / max * (YB - YT - 40);
  return (V, G) => {
    const a = Math.min(V.amt, max * 1.08), wy = f(a), on = V.hold && !DONE;
    let o = `<ellipse cx="${(X0 + X1) / 2}" cy="${YB + 6}" rx="120" ry="14" fill="rgba(0,0,0,.12)"/>`;
    if (a > 0) o += `<path d="M${X0 + 6},${wy} L${X0 + 6},${YB - 14} Q${(X0 + X1) / 2},${YB} ${X1 - 6},${YB - 14} L${X1 - 6},${wy} Z" fill="#60a5fa" opacity=".75"/><ellipse cx="${(X0 + X1) / 2}" cy="${wy}" rx="${(X1 - X0) / 2 - 6}" ry="9" fill="#93c5fd" stroke="#3b82f6" stroke-width="2"/>`;
    if (G >= 3 && !DONE) o += `<rect x="${X0 + 6}" y="${f(s.hi)}" width="${X1 - X0 - 12}" height="${f(s.lo) - f(s.hi)}" fill="#22c55e" opacity=".3"/>`;
    o += `<path d="M${X0},${YT} L${X0},${YB - 16} Q${(X0 + X1) / 2},${YB + 4} ${X1},${YB - 16} L${X1},${YT}" fill="rgba(240,249,255,.35)" stroke="#334155" stroke-width="4"/><ellipse cx="${(X0 + X1) / 2}" cy="${YT}" rx="${(X1 - X0) / 2}" ry="12" fill="none" stroke="#334155" stroke-width="3"/><path d="M${X0 - 2},${YT} l-16,-8" stroke="#334155" stroke-width="4"/>`;
    o += `<path d="M${X0},${YT + 40} q-60,6 -54,90 q4,60 54,70" fill="none" stroke="#334155" stroke-width="12" stroke-linecap="round"/><path d="M${X0 + 10},${YT + 20} L${X0 + 10},${YB - 30}" stroke="#fff" stroke-width="6" opacity=".6" stroke-linecap="round"/>`;
    for (let v = st; v <= max; v += st) { const big = v % (st * 2) === 0 || max <= 300; o += `<line x1="${X0}" y1="${f(v)}" x2="${X0 + (big ? 46 : 28)}" y2="${f(v)}" stroke="#1e3a8a" stroke-width="3"/>` + (big ? `<text x="${X0 + 52}" y="${f(v) + 7}" font-size="19" fill="#1e3a8a" font-weight="bold">${v}</text>` : ''); }
    o += `<text x="${X0 + 52}" y="${YB - 34}" font-size="16" fill="#1e3a8a">mL</text>`;
    // 물주전자
    const px = 560, py = 150, rot = on ? -38 : -8;
    if (on) o += `<path d="M${px - 92},${py - 26} Q${(X0 + X1) / 2 + 30},${py - 10} ${(X0 + X1) / 2 + 20},${wy}" fill="none" stroke="#60a5fa" stroke-width="10" stroke-linecap="round" opacity=".85"/>`;
    o += `<g transform="translate(${px},${py}) rotate(${rot})"><path d="M-60,-70 L60,-70 L70,60 L-70,60 Z" fill="#e0f2fe" stroke="#334155" stroke-width="4" stroke-linejoin="round"/><path d="M-60,-70 L-96,-86 L-62,-46" fill="#e0f2fe" stroke="#334155" stroke-width="4" stroke-linejoin="round"/><path d="M60,-50 q50,10 40,70 q-6,24 -34,24" fill="none" stroke="#334155" stroke-width="10" stroke-linecap="round"/><rect x="-62" y="-20" width="128" height="78" fill="#60a5fa" opacity=".6"/></g>`;
    o += `<rect x="600" y="250" width="200" height="60" rx="14" fill="#fff" stroke="#c4b5fd" stroke-width="3"/>` + tx(700, 282, 28, `목표 ${t}mL`, '#b91c1c');
    if (G >= 4 && !DONE) o += pill(X1 + 110, f((s.lo + s.hi) / 2), '여기서 떼요', '#16a34a', 16);
    return o;
  };
}
const fixPour = s => { if (s && s.type === 'squeeze' && s.mode === 'hold' && s.gauge === '물의 양') { s.pic = cupPic(s); s.noGauge = 1; s.bx = 700; s.by = 410; } };
FLOORS.forEach(F => F.steps.forEach(fixPour));
// ===== 명예의 전당 =====
// 꼭대기에 오른 학생 이름을 아래 따옴표 안에 적고 새 버전으로 배포해요.
// 예) const HALL = ['김하늘', '이진주'];
const HALL = [];

// ===================== 새 구성: 10구역 99층 =====================
// 1~20층 이름과 간단한 사용 · 21~40층 어림 측정과 바른 사용 · 41~60층 정밀 측정과 섬세한 사용
// 61~80층 목표에 맞는 도구 고르기와 간단한 계산 · 81~99층 개방형 상황 해결
const josa = (w, a, b) => { const c = w.charCodeAt(w.length - 1); return c >= 0xAC00 && c <= 0xD7A3 && (c - 0xAC00) % 28 ? a : b; };
const rot3 = (arr, a) => { const o = arr.slice(1); o.splice(a, 0, arr[0]); return o; };

// ---------- 1~20층: 이름 알기와 찾기 ----------
const Z12 = ['glue', 'scissors', 'tape', 'stapler', 'punch', 'sandpaper', 'bond', 'mallet', 'clamp', 'driver', 'paint', 'peeler', 'pan', 'claw', 'awl', 'saw'];
const KEYOF = { glue: 'glue', scissors: 'scissors', tape: 'tape', stapler: 'stapler', punch: 'punch', sandpaper: 'sandpaper', bond: 'bond', mallet: 'mallet', clamp: 'clamp', driver: 'driverP', paint: 'brush', peeler: 'peeler', pan: 'pan', claw: 'claw', awl: 'awl', saw: 'saw' };
const NAMEOF = { glue: '딱풀', scissors: '가위', tape: '테이프 커터', stapler: '스테이플러', punch: '펀치', sandpaper: '사포', bond: '목공본드', mallet: '고무망치', clamp: '클램프', driver: '드라이버', paint: '붓', peeler: '필러', pan: '프라이팬', claw: '장도리', awl: '송곳', saw: '톱' };
Z12.forEach((id, n) => {
  const F = BYID[id], k = KEYOF[id], nm = NAMEOF[id], o1 = Z12[(n + 5) % 16], o2 = Z12[(n + 11) % 16], a = n % 3, b = (n + 1) % 3;
  F.steps.unshift(
    { type: 'choice', title: '이름 알기', q: '이 도구의 이름은 무엇일까요?', bg: 'desk', pic: () => `<rect x="300" y="20" width="260" height="260" rx="30" fill="#fff" stroke="#c4b5fd" stroke-width="4"/>` + (IMG['c_k_' + k] ? `<image href="${IMG['c_k_' + k]}" x="308" y="28" width="244" height="244" preserveAspectRatio="xMidYMid slice"/>` : tool(k, 430, 150, 1.05)),
      opts: rot3([nm, NAMEOF[o1], NAMEOF[o2]], a).map(t => ({ e: '🏷️', t })), a, elim: (a + 1) % 3, h: `그림 속 도구를 잘 봐요. 이름은 「${nm}」${josa(nm, '이에요', '예요')}.`, ok: `맞아요! 이 도구는 ${nm}${josa(nm, '이에요', '예요')}.`, no: '다른 도구의 이름이에요. 그림을 다시 봐요.' },
    { type: 'choice', title: '도구 찾기', q: `${nm}${josa(nm, '을', '를')} 찾아 눌러요.`, bg: 'desk', opts: rot3([k, KEYOF[o1], KEYOF[o2]], b).map(kk => ({ k: kk, s: .7, t: ' ' })), a: b, elim: (b + 1) % 3, h: `${nm}의 모양을 떠올려 봐요.`, ok: `${nm}${josa(nm, '을', '를')} 찾았어요.`, no: `그건 ${nm}${josa(nm, '이', '가')} 아니에요.` });
});

// ---------- 21~40층: 어림 측정 ----------
const pencilBar = (x, y, L, c = '#f59e0b') => `<rect x="${x}" y="${y - 12}" width="${L}" height="24" rx="4" fill="${c}" stroke="#78350f" stroke-width="2"/><path d="M${x + L},${y - 12} l34,12 l-34,12 z" fill="#fde68a" stroke="#78350f" stroke-width="2"/><path d="M${x + L + 24},${y - 4} l10,4 l-10,4 z" fill="#334155"/>`;
const num = i => ['①', '②', '③', '④'][i];
const ph = (x, y, s, k) => IMG['c_ph_' + k] ? `<image href="${IMG['c_ph_' + k]}" x="${x - s / 2}" y="${y - s / 2}" width="${s}" height="${s}" preserveAspectRatio="xMidYMid meet"/>` : em(x, y, s * .7, '❓');
const BALPH = { '🍉': 'watermelon', '🍓': 'strawberry', '📕': 'book', '🪶': 'feather', '🎈': 'balloon', '⚙️': 'steelball', '🍍': 'pineapple' };
function balance(L, R, tilt) { // tilt>0: 왼쪽이 내려감
  const t = tilt * 10, cx = 430, cy = 250, dx = Math.cos(t * Math.PI / 180) * 200, dy = Math.sin(t * Math.PI / 180) * 200;
  return `<g transform="translate(81,-30) scale(.81)"><path d="M${cx},${cy} L${cx - 60},420 L${cx + 60},420 Z" fill="#a16207" stroke="#713f12" stroke-width="4"/><rect x="${cx - 120}" y="418" width="240" height="18" rx="6" fill="#713f12"/>`
    + `<line x1="${cx - dx}" y1="${cy + dy}" x2="${cx + dx}" y2="${cy - dy}" stroke="#78350f" stroke-width="12" stroke-linecap="round"/><circle cx="${cx}" cy="${cy}" r="12" fill="#fde047" stroke="#713f12" stroke-width="3"/>`
    + [[-1, L], [1, R]].map(([sg, e]) => { const px = cx + sg * dx, py = cy - sg * dy; return `<line x1="${px}" y1="${py}" x2="${px - 50}" y2="${py + 80}" stroke="#57534e" stroke-width="3"/><line x1="${px}" y1="${py}" x2="${px + 50}" y2="${py + 80}" stroke="#57534e" stroke-width="3"/><path d="M${px - 70},${py + 80} Q${px},${py + 120} ${px + 70},${py + 80} Z" fill="#cbd5e1" stroke="#475569" stroke-width="3"/>` + (BALPH[e] ? ph(px, py + 40, e === '🍉' || e === '🎈' ? 110 : 90, BALPH[e]) : em(px, py + 50, e.length > 2 ? 46 : 64, e)); }).join('') + '</g>';
}
const cupW = (x, lv, w = 90, h = 170, c = '#60a5fa') => `<path d="M${x - w / 2},${300 - h} L${x - w / 2 + 8},300 L${x + w / 2 - 8},300 L${x + w / 2},${300 - h} Z" fill="rgba(224,242,254,.5)" stroke="#334155" stroke-width="4"/><path d="M${x - w / 2 + 2 + (1 - lv) * 0},${300 - h * lv} L${x - w / 2 + 8},298 L${x + w / 2 - 8},298 L${x + w / 2 - 2},${300 - h * lv} Z" fill="${c}" opacity=".75"/>`;
const thermoPic = (x, lv) => `<rect x="${x - 16}" y="60" width="32" height="280" rx="16" fill="#fff" stroke="#334155" stroke-width="4"/><circle cx="${x}" cy="350" r="30" fill="#ef4444" stroke="#334155" stroke-width="4"/><rect x="${x - 7}" y="${330 - 260 * lv}" width="14" height="${260 * lv + 10}" fill="#ef4444"/>` + [...Array(12)].map((_, i) => `<line x1="${x + 16}" y1="${80 + i * 22}" x2="${x + (i % 2 ? 26 : 34)}" y2="${80 + i * 22}" stroke="#334155" stroke-width="2"/>`).join('');
const EST = (id, name, icon, intro, steps) => ({ id, est: 1, name, tool: '눈과 손', use: '눈대중과 손대중으로 비교하고 어림해요.', cat: '👀 어림 측정', icon: () => em(0, -10, 130, icon), intro, safe: '정확한 숫자 대신, 기준과 비교해서 어림해요.', outro: '눈대중과 손대중으로 잘 비교했어요. 어림을 잘하면 정확하게 잴 때도 실수를 금방 찾아요.', steps });
const C3 = (title, q, opts, a, ok, h, pic, no) => ({ type: 'choice', title, q, bg: 'room', pic: pic && (() => `<g transform="translate(86,4) scale(.8)">${pic()}</g>`), opts, a, elim: (a + 2) % opts.length === a ? (a + 1) % opts.length : (a + 2) % opts.length, ok, h, no: no || '다시 비교해 봐요.' });
const ESTS = [
  EST('est_len', '길다·짧다의 방', '📏', '길이를 눈으로 비교해요. 끝을 맞춰 대 보면 더 잘 보여요.', [
    C3('가장 긴 것', '가장 긴 연필은 몇 번일까요?', [0, 1, 2].map(i => ({ e: ['1️⃣', '2️⃣', '3️⃣'][i], t: num(i) + '번 연필' })), 1, '②번 연필이 가장 길어요.', '왼쪽 끝이 같으니 오른쪽 끝이 가장 먼 것을 찾아요.', () => [300, 440, 220].map((L, i) => pencilBar(120, 70 + i * 80, L) + tx(90, 78 + i * 80, 26, num(i), '#4c1d95')).join('')),
    C3('가장 짧은 것', '가장 짧은 리본은 몇 번일까요?', [0, 1, 2].map(i => ({ e: ['1️⃣', '2️⃣', '3️⃣'][i], t: num(i) + '번 리본' })), 2, '③번 리본이 가장 짧아요.', '오른쪽 끝이 가장 가까운 것을 찾아요.', () => [380, 300, 180].map((L, i) => `<rect x="120" y="${60 + i * 80}" width="${L}" height="22" rx="11" fill="${['#f472b6', '#60a5fa', '#34d399'][i]}"/>` + tx(90, 78 + i * 80, 26, num(i), '#4c1d95')).join('')),
    C3('끝 맞추기', '두 끈 중 어느 것이 더 길까요? 시작하는 곳이 달라요!', [{ e: '🟥', t: '빨간 끈' }, { e: '🟦', t: '파란 끈' }, { e: '🟰', t: '똑같아요' }], 0, '빨간 끈이 더 길어요. 파란 끈은 오른쪽에서 시작해서 길어 보였어요.', '두 끈의 왼쪽 끝을 맞췄다고 생각해 봐요. 빨간 끈은 왼쪽 끝부터 시작해요.', () => `<rect x="100" y="90" width="420" height="20" rx="10" fill="#ef4444"/><rect x="380" y="190" width="360" height="20" rx="10" fill="#3b82f6"/><line x1="100" y1="60" x2="100" y2="250" stroke="#7c3aed" stroke-dasharray="8 6" stroke-width="3"/>` + tx(560, 290, 20, '💡 길이는 끝을 맞춰서 비교해요', '#6d28d9')),
    { type: 'order', title: '짧은 것부터', q: '짧은 것부터 차례로 눌러요.', bg: 'room', items: [{ e: '🧽', t: '지우개' }, { e: '✏️', t: '연필' }, { e: '📏', t: '30cm 자' }, { e: '☂️', t: '우산' }], h: '손에 쥐어 본다고 생각해요. 가장 작은 것부터!', ok: '지우개 → 연필 → 자 → 우산 순서예요.' },
  ]),
  EST('est_wt', '무겁다·가볍다의 방', '⚖️', '양팔저울은 무거운 쪽이 아래로 내려가요.', [
    C3('더 무거운 것', '양팔저울을 보고, 더 무거운 것을 골라요.', [{ e: '🍉', t: '수박' }, { e: '🍓', t: '딸기' }, { e: '🟰', t: '똑같아요' }], 0, '수박 쪽이 내려갔으니 수박이 더 무거워요.', '아래로 내려간 쪽이 더 무거워요.', () => balance('🍉', '🍓', 2)),
    C3('더 가벼운 것', '이번에는 더 가벼운 것을 골라요.', [{ e: '📕', t: '책' }, { e: '🪶', t: '깃털' }, { e: '🟰', t: '똑같아요' }], 1, '깃털 쪽이 올라갔으니 깃털이 더 가벼워요.', '위로 올라간 쪽이 더 가벼워요.', () => balance('🪶', '📕', -2)),
    C3('크기와 무게', '큰 풍선과 작은 쇠구슬을 달았어요. 더 무거운 것은?', [{ e: '🎈', t: '큰 풍선' }, { e: '⚙️', t: '작은 쇠구슬' }, { e: '🟰', t: '똑같아요' }], 1, '크다고 무거운 게 아니에요. 작은 쇠구슬이 더 무거워요.', '크기가 아니라 저울이 기운 쪽을 봐요.', () => balance('🎈', '⚙️', -2)),
