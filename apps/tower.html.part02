// ===================== 99층 배치 =====================
const CATS = { office: '✂️ 사무용', meas: '📏 측정', hand: '🔨 수공구', finish: '🧴 접착·마감', power: '⚡ 전동', cook: '🍳 요리' };
const TUT = {
  office: ['glue', 'scissors', 'tape', 'stapler', 'punch', 'cutter'],
  meas: ['ruler', 'tapemeasure', 'level', 'caliper', 'square', 'vol', 'weight', 'thermo', 'protractor'],
  hand: ['awl', 'sandpaper', 'saw', 'claw', 'mallet', 'sledge', 'clamp', 'driver', 'pliers', 'spanner', 'monkey', 'hexkey'],
  finish: ['bond', 'gluegun', 'silicone', 'paint'],
  power: ['edriver', 'drill', 'sander'],
  cook: ['mcup', 'kscale', 'knife', 'peeler', 'pan', 'micro'],
};
const RANGE = { office: [0, .55], meas: [.04, .96], hand: [.08, 1], finish: [.25, .9], power: [.55, 1], cook: [.12, .95] };
const BYID = Object.fromEntries(FLOORS.map(F => [F.id, F]));
FLOORS.forEach(F => { F.intro = F.intro.replace(/^\d+층 ?/, ''); });
Object.entries(TUT).forEach(([c, ids]) => ids.forEach(id => { BYID[id].cat = CATS[c]; }));
const tutOrder = ['glue', 'scissors', 'tape', 'stapler', 'sandpaper', 'peeler', 'punch', 'bond', 'awl', 'cutter', 'clamp', 'knife', 'mallet', 'gluegun', 'driver', 'claw', 'pan', 'silicone', 'saw', 'level', 'paint', 'sledge', 'edriver', 'micro', 'ruler', 'square', 'tapemeasure', 'pliers', 'spanner', 'hexkey', 'monkey', 'mcup', 'kscale', 'vol', 'weight', 'drill', 'caliper', 'thermo', 'protractor', 'sander'];


// ---------- 안전 약속 ----------
const STOVE = (cx, cy, lv) => `<rect x="${cx - 260}" y="${cy - 150}" width="520" height="300" rx="26" fill="#1f2937" stroke="#9ca3af" stroke-width="6"/><rect x="${cx - 250}" y="${cy - 140}" width="500" height="280" rx="20" fill="#111827"/>`
  + `<circle cx="${cx}" cy="${cy}" r="120" fill="none" stroke="${['#4b5563', '#f97316', '#ef4444', '#dc2626'][lv]}" stroke-width="${4 + lv * 3}" opacity="${.5 + lv * .15}" ${lv ? `filter="drop-shadow(0 0 ${lv * 6}px #f97316)"` : ''}/>`
  + `<circle cx="${cx}" cy="${cy}" r="90" fill="none" stroke="#4b5563" stroke-width="2"/>` + [0, 1, 2].map(i => `<circle cx="${cx + 170 + i * 26}" cy="${cy + 112}" r="8" fill="${i < lv ? '#f97316' : '#374151'}"/>`).join('');
const SAFE = {
  scissors: ['가위를 들고 다닐 때는 어떻게 할까요?', ['🚶', '날을 닫아 감싸 쥐고 천천히 걸어요'], ['🏃', '가위를 들고 뛰어요'], ['⚔️', '친구에게 휘두르며 장난쳐요'], '가위는 날을 닫고 감싸 쥐어 걸어요. 들고 뛰지 않아요.'],
  cutter: ['커터칼을 쓰지 않을 때는 어떻게 할까요?', ['🔒', '칼날을 끝까지 넣고 잠가요'], ['🗡️', '칼날을 길게 빼 둬요'], ['🤺', '친구에게 겨누며 장난쳐요'], '칼날을 넣어 두면 아무도 다치지 않아요.'],
  awl: ['송곳으로 장난쳐도 될까요?', ['🙅', '절대 안 돼요. 끝이 사람을 향하지 않게 해요'], ['👉', '친구를 살짝 찔러 봐요'], ['⚔️', '칼싸움 놀이를 해요'], '송곳 끝은 아주 뾰족해요. 장난치지 않고, 끝은 늘 아래나 바깥을 향해요.'],
  knife: ['칼이 손에서 떨어지면 어떻게 할까요?', ['🔙', '뒤로 물러나 떨어질 때까지 기다려요'], ['🤲', '떨어지는 칼을 손으로 잡아요'], ['🦶', '발로 막아요'], '떨어지는 칼은 절대 잡지 않아요. 한 걸음 물러나요.'],
  saw: ['톱질할 때 나무를 잡은 손은 어디에 둘까요?', ['🖐️', '톱날에서 멀리 떨어진 곳을 꽉 눌러요'], ['🎯', '톱날 바로 옆을 잡아요'], ['🙌', '두 손으로 톱만 잡아요'], '손은 톱날에서 멀리! 나무는 클램프나 반대손으로 꽉 고정해요.'],
  claw: ['망치를 쓸 때 지킬 약속은?', ['👀', '칠 곳만 보고, 주변에 사람이 없을 때 쳐요'], ['🌀', '망치를 빙빙 돌리며 놀아요'], ['🤾', '망치를 던져서 건네요'], '망치는 휘두르거나 던지지 않아요. 주변을 확인하고 쳐요.'],
  sledge: ['쇠망치와 정을 쓸 때 꼭 쓰는 것은?', ['🥽', '보안경과 장갑'], ['🧢', '야구 모자'], ['🎧', '헤드폰'], '돌 조각이 튈 수 있어요. 보안경으로 눈을 지켜요.'],
  drill: ['전동 드릴을 쓸 때 하면 안 되는 것은?', ['🧣', '긴 목도리나 헐렁한 소매를 늘어뜨려요'], ['🥽', '보안경을 써요'], ['🗜️', '나무를 클램프로 고정해요'], '돌아가는 드릴에 옷이나 머리카락이 감길 수 있어요. 긴 것은 묶거나 걷어요.', 0],
