  ]),
  EST('est_vol', '많다·적다의 방', '🥛', '물이 얼마나 들어 있는지 눈으로 비교해요.', [
    C3('가장 많은 물', '똑같은 컵이에요. 물이 가장 많은 컵은?', [0, 1, 2].map(i => ({ e: ['1️⃣', '2️⃣', '3️⃣'][i], t: num(i) + '번 컵' })), 2, '③번 컵의 물 높이가 가장 높아서 가장 많아요.', '같은 컵이면 물 높이가 높을수록 많아요.', () => [.35, .6, .85].map((lv, i) => cupW(250 + i * 180, lv) + tx(250 + i * 180, 340, 26, num(i), '#4c1d95')).join('')),
    C3('넓은 컵과 좁은 컵', '물 높이가 같아요. 물이 더 많은 컵은?', [{ e: '🥣', t: '넓은 컵' }, { e: '🥂', t: '좁은 컵' }, { e: '🟰', t: '똑같아요' }], 0, '높이가 같으면 넓은 컵에 물이 더 많아요.', '물 높이가 같을 때는 컵이 넓은 쪽이 더 많이 담겨요.', () => cupW(300, .6, 220, 170) + cupW(580, .6, 70, 170) + tx(300, 340, 24, '넓은 컵', '#4c1d95') + tx(580, 340, 24, '좁은 컵', '#4c1d95')),
    C3('컵으로 세기', '가 물병의 물은 컵 3잔, 나 물병의 물은 컵 5잔이 나왔어요. 물이 더 많이 들어가는 물병은?', [{ e: '🅰️', t: '가 물병' }, { e: '🅱️', t: '나 물병' }, { e: '🟰', t: '똑같아요' }], 1, '같은 컵으로 더 많이 나온 나 물병이 더 많이 들어가요.', '같은 컵으로 몇 번 부었는지 세어 비교해요.', () => [0, 1, 2].map(i => ph(180 + i * 70, 140, 64, 'glass')).join('') + [0, 1, 2, 3, 4].map(i => ph(480 + i * 70, 140, 64, 'glass')).join('') + tx(250, 230, 28, '가: 3잔', '#4c1d95') + tx(620, 230, 28, '나: 5잔', '#4c1d95')),
    { type: 'order', title: '적은 것부터', q: '물이 적게 담기는 것부터 차례로 눌러요.', bg: 'room', items: [{ e: '🥄', t: '숟가락' }, { e: '🥛', t: '컵' }, { e: '🍶', t: '물병' }, { e: '🪣', t: '양동이' }], h: '가장 작은 그릇부터 골라요.', ok: '숟가락 → 컵 → 물병 → 양동이 순서예요.' },
  ]),
  EST('est_m', '1m 어림의 방', '📐', '1m가 어느 정도인지 몸으로 느껴 봐요. 어른 걸음 한 걸음이나 문손잡이까지의 높이가 약 1m예요.', [
    { type: 'pick', title: '1m보다 긴 것', q: '1m보다 긴 것을 모두 골라요.', bg: 'room', items: [{ e: '🚪', t: '교실 문 높이', ok: 1 }, { e: '✏️', t: '연필', no: '연필은 1m보다 훨씬 짧아요.' }, { e: '🛏️', t: '침대 길이', ok: 1 }, { e: '🧽', t: '지우개', no: '지우개는 손바닥보다 작아요.' }, { e: '🟩', t: '칠판 가로', ok: 1 }, { e: '🥄', t: '숟가락', no: '숟가락은 1m보다 짧아요.' }], h: '내 키보다 큰 것, 두 팔을 벌려도 모자란 것을 골라요.', ok: '문, 침대, 칠판은 1m보다 길어요.' },
    C3('클립으로 어림', '연필은 클립 몇 개쯤 길이일까요?', [{ e: '📎', t: '약 2개' }, { e: '📎', t: '약 5개' }, { e: '📎', t: '약 15개' }], 1, '클립이 5개쯤 들어가요. 연필은 클립 약 5개 길이예요.', '클립 하나를 연필 아래에 몇 번 놓을 수 있는지 세어 봐요.', () => pencilBar(150, 110, 470) + [0, 1].map(i => `<rect x="${150 + i * 98}" y="170" width="92" height="30" rx="15" fill="none" stroke="#64748b" stroke-width="5"/>`).join('') + tx(420, 190, 24, '… 이어서 놓으면?', '#6d28d9')),
    C3('1m와 비슷한 것', '1m와 길이가 가장 비슷한 것은?', [{ e: '🚪', t: '바닥에서 문손잡이까지' }, { e: '✏️', t: '연필 한 자루' }, { e: '🏫', t: '학교 건물 높이' }], 0, '바닥에서 문손잡이까지가 약 1m예요.', '내 허리쯤 높이를 떠올려 봐요.'),
  ]),
  EST('est_kg', '1kg 어림의 방', '🥛', '우유 큰 팩(1L) 하나가 약 1kg이에요. 손에 들었을 때의 느낌을 기억해요.', [
    C3('1kg과 비슷한 것', '1kg과 무게가 가장 비슷한 것은?', [{ e: '🪶', t: '깃털 한 개' }, { e: '🥛', t: '우유 큰 팩 1L' }, { e: '🛵', t: '오토바이' }], 1, '우유 1L 팩이 약 1kg이에요.', '물 1L가 1kg이에요.'),
    { type: 'pick', title: '1kg보다 무거운 것', q: '1kg보다 무거운 것을 모두 골라요.', bg: 'room', items: [{ e: '🍉', t: '수박', ok: 1 }, { e: '🍎', t: '사과 한 개', no: '사과 한 개는 1kg보다 가벼워요.' }, { e: '🎒', t: '책이 가득한 가방', ok: 1 }, { e: '✏️', t: '연필', no: '연필은 아주 가벼워요.' }, { e: '🪑', t: '의자', ok: 1 }, { e: '🥄', t: '숟가락', no: '숟가락은 1kg보다 가벼워요.' }], h: '우유 큰 팩보다 무거울지 손으로 들어 본다고 생각해요.', ok: '수박, 가득 찬 가방, 의자가 1kg보다 무거워요.' },
    C3('1kg 추와 비교', '1kg 추와 파인애플을 달았어요. 파인애플은?', [{ e: '⬆️', t: '1kg보다 가벼워요' }, { e: '⬇️', t: '1kg보다 무거워요' }, { e: '🟰', t: '딱 1kg이에요' }], 0, '파인애플 쪽이 올라갔으니 1kg보다 가벼워요.', '올라간 쪽이 더 가벼워요.', () => balance('1kg', '🍍', 2)),
  ]),
  EST('est_l', '1L 어림의 방', '🧃', '우유 큰 팩 하나가 1L예요. 컵(약 200mL)으로 5잔쯤이에요.', [
    C3('1L와 비슷한 것', '1L와 들이가 가장 비슷한 것은?', [{ e: '💧', t: '물방울 하나' }, { e: '🛁', t: '욕조' }, { e: '🧃', t: '우유 큰 팩' }], 2, '우유 큰 팩이 1L예요.', '마트에서 파는 큰 우유를 떠올려 봐요.'),
    { type: 'pick', title: '1L보다 많이', q: '1L보다 많이 담기는 것을 모두 골라요.', bg: 'room', items: [{ e: '🪣', t: '양동이', ok: 1 }, { e: '🥛', t: '컵', no: '컵은 1L보다 적게 담겨요.' }, { e: '🛁', t: '욕조', ok: 1 }, { e: '🥄', t: '숟가락', no: '숟가락은 아주 적게 담겨요.' }, { e: '🍶', t: '2L 생수병', ok: 1 }, { e: '🍵', t: '찻잔', no: '찻잔은 1L보다 적어요.' }], h: '우유 큰 팩보다 클지 생각해요.', ok: '양동이, 욕조, 2L 생수병은 1L보다 많이 담겨요.' },
    C3('컵으로 1L', '컵(약 200mL)으로 몇 잔을 부으면 약 1L가 될까요?', [{ e: '🥛', t: '약 1잔' }, { e: '🥛', t: '약 5잔' }, { e: '🥛', t: '약 20잔' }], 1, '컵 5잔쯤이면 약 1L예요.', '200을 몇 번 더하면 1000이 될까요?'),
  ]),
  EST('est_temp', '뜨겁다·차갑다의 방', '🌡️', '온도는 손으로 만지기 전에 눈과 도구로 먼저 확인해요.', [
    { type: 'order', title: '차가운 것부터', q: '차가운 것부터 차례로 눌러요.', bg: 'kitchen', items: [{ e: '🧊', t: '얼음' }, { e: '🥛', t: '냉장고 우유' }, { e: '🛁', t: '따뜻한 목욕물' }, { e: '☕', t: '막 끓인 차' }], h: '얼음이 가장 차갑고, 막 끓인 것이 가장 뜨거워요.', ok: '얼음 → 우유 → 목욕물 → 끓인 차 순서예요.' },
    C3('더 따뜻한 쪽', '온도계 두 개예요. 더 따뜻한 쪽은?', [{ e: '⬅️', t: '왼쪽 온도계' }, { e: '➡️', t: '오른쪽 온도계' }, { e: '🟰', t: '똑같아요' }], 1, '빨간 기둥이 더 높이 올라간 오른쪽이 더 따뜻해요.', '빨간 기둥이 높을수록 따뜻해요.', () => thermoPic(330, .3) + thermoPic(530, .75)),
    C3('뜨거운 냄비', '끓는 물이 담긴 냄비를 옮길 때는?', [{ e: '🤚', t: '맨손으로 잡아요' }, { e: '🧤', t: '두꺼운 주방 장갑을 껴요' }, { e: '💧', t: '젖은 행주로 잡아요' }], 1, '두꺼운 주방 장갑을 껴요. 젖은 행주는 열이 잘 전해져 데일 수 있어요.', '열을 막아 주는 도구를 써요.'),
  ]),
  EST('est_size', '높다·두껍다·넓다의 방', '📚', '높이, 두께, 넓이도 비교할 수 있어요.', [
    C3('가장 높은 탑', '가장 높은 블록 탑은?', [0, 1, 2].map(i => ({ e: ['1️⃣', '2️⃣', '3️⃣'][i], t: num(i) + '번 탑' })), 0, '①번 탑이 가장 높아요.', '바닥이 같으니 꼭대기가 가장 높은 것을 찾아요.', () => [6, 4, 5].map((n, i) => [...Array(n)].map((_, j) => `<rect x="${220 + i * 180}" y="${320 - (j + 1) * 44}" width="80" height="42" rx="6" fill="${['#f87171', '#60a5fa', '#34d399'][i]}" stroke="#334155" stroke-width="2"/>`).join('') + tx(260 + i * 180, 350, 26, num(i), '#4c1d95')).join('')),
    C3('두꺼운 책', '가장 두꺼운 책은?', [0, 1, 2].map(i => ({ e: ['1️⃣', '2️⃣', '3️⃣'][i], t: num(i) + '번 책' })), 1, '②번 책이 가장 두꺼워요.', '책 옆면(등)의 폭을 비교해요.', () => [30, 80, 50].map((w, i) => `<rect x="${250 + i * 160}" y="80" width="${w}" height="220" rx="4" fill="${['#a78bfa', '#f59e0b', '#22c55e'][i]}" stroke="#334155" stroke-width="3"/>` + tx(250 + i * 160 + w / 2, 340, 26, num(i), '#4c1d95')).join('')),
    C3('더 넓은 종이', '두 종이를 겹쳐 놓았어요. 더 넓은 종이는?', [{ e: '🟨', t: '노란 종이' }, { e: '🟦', t: '파란 종이' }, { e: '🟰', t: '똑같아요' }], 0, '노란 종이가 파란 종이를 다 덮고도 남으니 더 넓어요.', '겹쳐서 남는 쪽이 더 넓어요.', () => `<rect x="220" y="60" width="380" height="250" fill="#fde047" stroke="#a16207" stroke-width="3"/><rect x="240" y="80" width="250" height="180" fill="#60a5fa" stroke="#1d4ed8" stroke-width="3" opacity=".9"/>`),
    C3('비교하는 방법', '눈으로 보기 어려울 만큼 비슷할 때는 어떻게 비교할까요?', [{ e: '🤷', t: '느낌으로 골라요' }, { e: '📏', t: '끝을 맞춰 대 보거나 도구로 재요' }, { e: '🔭', t: '멀리서 봐요' }], 1, '끝을 맞춰 대 보거나, 자·저울 같은 도구로 정확히 재요.', '41층부터는 도구로 정확히 재는 법을 배워요.'),
  ]),
];

// ---------- 61~80층: 목표에 맞는 도구 고르기 + 계산 ----------
const numOf = s => +((s.title || '').match(/\d+(\.\d+)?/) || [0])[0];
const plain = s => { delete s.give; if (s.type === 'level') s.q = '선반이 반듯해지도록 맞춰요.'; s.q = s.q.replace(/\s*[^.!?]*(쪽지|숫자예요)[^.!?]*[.!?]?\s*$/, '').trim(); s.ok = s.ok.replace(/\s*숫자 .*$/, '').replace(/!\s*$/, '!'); return s; };
function calcStep(q, v, unit, alt) { const a = v % 3, base = [v, ...(alt || [v + 10, Math.max(1, v - 10)])], opts = rot3(base, a); { const ex = [v * 2, v + 20, v + 5, Math.max(1, v - 5), v + 1].find(c => c > 0 && !base.includes(c)); if (ex !== undefined) opts.push(ex); } return { type: 'choice', title: '계산하기', q, bg: 'desk', opts: opts.map(x => ({ e: '🧮', t: `${x}${unit}` })), a, elim: (a + 1) % 3, h: '잰 숫자를 쪽지에 적고 차근차근 계산해요.', ok: `${v}${unit}! 계산도 정확해요.`, no: '계산을 다시 해 봐요.' }; }
const toolPick = (goal, need, decoy) => { const it = [...need.map(k => ({ k, t: TOOLNAME[k] || k, ok: 1 })), ...decoy.map(k => ({ k, t: TOOLNAME[k] || k, no: `${TOOLNAME[k] || k}${josa(TOOLNAME[k] || k, '은', '는')} 이번 일에 필요 없어요.` }))]; const R = rng(need.length * 7 + decoy.length + goal.length); return { type: 'pick', title: '도구 고르기', q: `「${goal}」에 꼭 필요한 도구를 모두 골라요.`, bg: 'bench', items: it.sort(() => R() - .5), h: `${need.length}가지 도구가 필요해요. 하는 일을 순서대로 떠올려 봐요.`, ok: '알맞은 도구를 모두 골랐어요.', missMsg: '아직 필요한 도구가 더 있어요.' }; };
const GOALS = [
  { n: '선반 판자 잇기', e: '🪵', goal: '두 판자를 이어 긴 선반 만들기', need: ['tapemeasure', 'bond', 'clamp'], decoy: ['peeler', 'mcup', 'thermo'], mk: (R, d) => { const a = plain(MK.tape(R, d)), b = plain(MK.tape(R, d)), x = numOf(a), y = numOf(b); return [a, b, calcStep(`두 판자(${x}cm, ${y}cm)를 이어 붙이면 모두 몇 cm일까요?`, x + y, 'cm'), plain(MK.bond(R, d))]; } },
  { n: '레몬에이드 두 잔', e: '🍋', goal: '레몬에이드 두 잔 만들기', need: ['mcup', 'kscale', 'spoon'], decoy: ['saw', 'drill', 'level'], mk: (R, d) => { const a = plain(MK.pour(R, d)), b = plain(MK.weigh(R, d)), x = numOf(a); return [a, b, calcStep(`한 잔에 물 ${x}mL가 들어가요. 두 잔이면 물은 모두 몇 mL일까요?`, x * 2, 'mL', [x + 100, x])]; } },
  { n: '액자 가운데 걸기', e: '🖼️', goal: '벽 가운데에 액자 걸기', need: ['tapemeasure', 'level', 'drill'], decoy: ['knife', 'kscale', 'glue'], mk: (R, d) => { const a = plain(MK.tape(R, d)); let x = numOf(a); if (x % 2) { x++; a.target = x; a.title = `${x}cm 표시`; a.q = `줄자로 벽 너비 ${x}cm 자리에 표시해요.`; a.h = `숫자 ${x} 위에 맞춰요.`; a.ok = `${x}cm!`; } return [a, calcStep(`벽 너비가 ${x}cm예요. 가운데는 왼쪽 끝에서 몇 cm일까요?`, x / 2, 'cm', [x / 2 + 5, x]), plain(MK.level(R, d)), plain(MK.drill(R, d))]; } },
  { n: '의자 다리 굵기 맞추기', e: '🪑', goal: '굵기가 다른 의자 다리 맞추기', need: ['caliper', 'sandpaper', 'sander'], decoy: ['mcup', 'stapler', 'thermo'], mk: (R, d) => { const a = plain(MK.caliper(R, d)); let b = plain(MK.caliper(R, d)); const x = +a.opts[a.a].replace('mm', ''); let y = +b.opts[b.a].replace('mm', ''); if (y === x) { b = plain(MK.caliper(() => .9, d)); y = +b.opts[b.a].replace('mm', ''); } a.q = a.q.replace('잰 굵기는', '잰 첫 번째 다리 굵기는'); b.q = b.q.replace('잰 굵기는', '잰 두 번째 다리 굵기는'); a.title = '첫째 다리 재기'; b.title = '둘째 다리 재기'; return [a, b, calcStep(`두 다리 굵기는 ${x}mm와 ${y}mm예요. 굵기 차이는 몇 mm일까요?`, Math.abs(x - y), 'mm', [x + y, Math.abs(x - y) + 2])]; } },
  { n: '쿠키 반죽', e: '🍪', goal: '버터와 밀가루로 쿠키 반죽 만들기', need: ['kscale', 'microwave', 'spoon'], decoy: ['saw', 'clamp', 'awl'], mk: (R, d) => { const a = plain(MK.weigh(R, d)), b = plain(MK.weigh(R, d)), x = numOf(a), y = numOf(b); a.q = a.q.replace('을 올려요', ' 버터를 올려요'); b.q = b.q.replace('을 올려요', ' 밀가루를 올려요'); return [a, b, calcStep(`버터 ${x}g과 밀가루 ${y}g을 섞으면 반죽은 모두 몇 g일까요?`, x + y, 'g'), plain(MK.micro(R, d, '버터'))]; } },
  { n: '철사 옷걸이', e: '🧷', goal: '철사로 옷걸이 두 개 만들기', need: ['ruler', 'pliers', 'nipper'], decoy: ['mcup', 'brush', 'peeler'], mk: (R, d) => { const a = plain(MK.ruler(R, d)), x = numOf(a); return [a, calcStep(`옷걸이 하나에 철사 ${x}cm가 필요해요. 두 개면 몇 cm일까요?`, Math.round(x * 2 * 10) / 10, 'cm', [x + 2, x]), plain(MK.angle(R, d))]; } },
  { n: '책꽂이 나사', e: '📚', goal: '책꽂이에 나사로 칸막이 달기', need: ['tapemeasure', 'edriver', 'level'], decoy: ['kscale', 'peeler', 'glue'], mk: (R, d) => { const a = plain(MK.tape(R, d)); let x = numOf(a); if (x % 2) { x++; a.target = x; a.title = `${x}cm 표시`; a.q = `줄자로 책꽂이 안쪽 너비 ${x}cm를 표시해요.`; a.h = `숫자 ${x} 위에 맞춰요.`; a.ok = `${x}cm!`; } return [a, calcStep(`칸막이를 한가운데 달아요. 왼쪽 끝에서 몇 cm에 달까요?`, x / 2, 'cm', [x / 2 + 10, x]), plain(MK.turn(R, d)), plain(MK.level(R, d))]; } },
  { n: '돌의 부피', e: '🪨', goal: '물로 작은 돌의 부피 재기', need: ['mcup', 'beaker'], decoy: ['saw', 'hexkey', 'stapler'], mk: (R, d) => { const a = plain(MK.pour(R, d)), x = numOf(a), add = 30 + Math.floor(R() * 5) * 10; return [a, { type: 'choice', title: '돌 넣기', q: `물 ${x}mL에 돌을 넣었더니 물 높이가 ${x + add}mL가 되었어요. 왜 물이 올라갔을까요?`, bg: 'kitchen', opts: [{ e: '🪨', t: '돌이 자리를 차지해서' }, { e: '💧', t: '물이 새로 생겨서' }, { e: '🌡️', t: '물이 뜨거워져서' }], a: 0, elim: 2, h: '돌이 물속에서 자리를 차지해요.', ok: '돌이 차지한 만큼 물이 올라가요.' }, calcStep(`올라간 물의 양이 돌의 부피예요. 돌의 부피는 몇 mL일까요?`, add, 'mL', [x + add, add + 10])]; } },
  { n: '피자 소스', e: '🍕', goal: '토마토소스 알맞게 만들기', need: ['mcup', 'kscale', 'spoon'], decoy: ['drill', 'square', 'punch'], mk: (R, d) => { const a = plain(MK.pour(R, d)), b = plain(MK.weigh(R, d)), x = numOf(a); return [a, b, calcStep(`물 ${x}mL의 절반만 쓰기로 했어요. 몇 mL일까요?`, x / 2, 'mL', [x * 2, x / 2 + 50])]; } },
  { n: '울타리 기둥', e: '🏡', goal: '울타리 기둥 두 개를 같은 높이로', need: ['tapemeasure', 'saw', 'level'], decoy: ['mcup', 'glue', 'microwave'], mk: (R, d) => { const a = plain(MK.tape(R, d)), b = plain(MK.tape(R, d)), x = numOf(a), y = numOf(b); return [a, b, calcStep(`기둥이 ${Math.max(x, y)}cm와 ${Math.min(x, y)}cm예요. 긴 기둥을 몇 cm 잘라야 같아질까요?`, Math.abs(x - y), 'cm', [x + y, Math.abs(x - y) + 5]), plain(MK.level(R, d))]; } },
];
const GOALR = GOALS.map((g, i) => { const R = rng(500 + i * 41), d = i < 6 ? 4 : 5, st = g.mk(R, d);
  return { id: 'goal' + (i + 1), goalr: 1, name: g.n, tool: g.need.map(k => TOOLNAME[k] || k).join('·'), use: '목표에 맞는 도구를 골라 정확하게 쓰고 계산해요.', cat: '🎯 목표 해결', icon: () => em(0, -10, 130, g.e),
    intro: `목표: ${g.goal}! 알맞은 도구를 고르고, 정확하게 재고, 잰 숫자로 계산해요.`, safe: '도구를 고를 때는 할 일을 순서대로 떠올려요. 위험한 도구는 선생님이나 부모님과 함께 써요.', outro: `${g.goal}에 성공했어요! 도구 선택, 정확한 사용, 계산까지 모두 해냈어요.`,
    steps: [toolPick(g.goal, g.need, g.decoy), ...st] }; });

// ---------- 81~99층: 개방형 상황 문제 ----------
// 장소: [이름, 아이콘, '아이콘:이름|@도구키:이름|…'] · sets: 모으면 되는 묶음(방법마다) · cards/sols: 방법 카드와 정답 순서들
const IT = str => str.split('|').map(x => { const [a, b] = x.split(':'); return a[0] === '@' ? { k: a.slice(1), t: b, s: .34 } : { e: a, t: b }; });
function OPEN(id, name, icon, goal, places, sets, cards, sols, okBy, extra = []) {
  return { id, open: 1, name, tool: '생각하는 힘', use: '장소를 돌며 도구와 재료를 찾고, 해결 방법을 세워요.', cat: '🧠 상황 해결', icon: () => em(0, -10, 130, icon),
    intro: `${goal} 필요한 도구와 재료는 있을 법한 곳에서 직접 찾아요. 방법은 하나가 아닐 수 있어요!`, safe: '여러 방법이 정답이 될 수 있어요. 안전한 방법을 골라요. 위험한 일은 선생님이나 부모님과 함께해요.',
    outro: '스스로 찾고, 계획하고, 해결했어요. 이것이 진짜 도구 장인의 생각하는 힘이에요!',
    steps: [
      { type: 'explore', title: '도구·재료 찾기', q: '왼쪽 장소를 눌러 둘러보고, 필요한 도구와 재료를 가방에 담아요.', places: places.map(([n, e, s]) => ({ n, e, items: IT(s) })), sets, h: '이 일을 하려면 무엇이 필요할지 떠올리고, 그 물건이 있을 법한 곳을 찾아봐요.', ok: '필요한 것을 모두 찾았어요.' },
      { type: 'plan', title: '방법 세우기', q: '해결 방법 카드를 순서대로 눌러 놓아요. 필요 없는 카드도 있어요.', cards: cards.map(([id, e, t]) => ({ id, e, t })), sols, okBy, h: '처음에 할 일부터 차근차근 떠올려요. 다른 방법도 정답이 될 수 있어요.', ok: '훌륭한 방법이에요!' },
      ...extra] };
}
