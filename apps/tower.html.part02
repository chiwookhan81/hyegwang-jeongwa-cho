     PL('나무 상자 칠하기', '나무 상자를 칠하는 순서대로 카드를 놓아요.', [['a', '📰', '신문지를 깔고 창문을 열어요'], ['b', '😷', '장갑과 마스크를 써요'], ['c', '🧽', '사포로 겉을 매끄럽게 갈아요'], ['d', '🧹', '마른 걸레로 가루를 닦아요'], ['e', '🖍️', '붓으로 나뭇결 방향으로 얇게 칠해요'], ['f', '⏳', '다 마를 때까지 기다려요'], ['g', '🚿', '붓을 씻고 정리해요'], ['x1', '🪣', '한 번에 두껍게 듬뿍 칠해요'], ['x2', '✋', '마르기 전에 손으로 만져 봐요']], [['a', 'b', 'c', 'd', 'e', 'f', 'g'], ['b', 'a', 'c', 'd', 'e', 'f', 'g'], ['a', 'b', 'c', 'd', 'e', 'g', 'f'], ['b', 'a', 'c', 'd', 'e', 'g', 'f']]),
     PL('프라이팬에 불이 났어요!', '프라이팬에 불이 붙었어요. 해야 할 일을 순서대로 놓아요.', [['a', '📯', '"불이야!" 크게 외쳐요'], ['b', '🔥', '가스레인지 불을 꺼요'], ['c', '🍳', '프라이팬 뚜껑을 덮어요'], ['d', '❗', '비상벨을 눌러요'], ['e', '💧', '젖은 수건으로 코와 입을 막아요'], ['f', '🏃', '몸을 낮추고 계단으로 대피해요'], ['g', '🚒', '밖에서 어른께 알리고 119에 신고해요'], ['x1', '🪣', '기름 불에 물을 부어요'], ['x2', '⬇️', '엘리베이터를 타고 내려가요']], [['a', 'b', 'c', 'd', 'e', 'f', 'g']], { badFirst: ['e', '입을 먼저 막으면 소리를 못 질러요. "불이야!"부터 크게 외쳐요.'], no: '기름 불에 물은 절대 안 돼요. 엘리베이터도 타지 않아요.' })], { starN: 3 }),
