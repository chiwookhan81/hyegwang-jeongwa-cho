      pic: () => `<line x1="330" y1="330" x2="660" y2="330" stroke="#334155" stroke-width="5"/><line x1="330" y1="330" x2="${330 + 300 * Math.cos(-Math.PI / 3)}" y2="${330 + 300 * Math.sin(-Math.PI / 3)}" stroke="#334155" stroke-width="5"/><circle cx="330" cy="330" r="7" fill="#ef4444"/>`, obj: p => `<g transform="translate(${p[0]},${p[1] - 50}) scale(1.6)">${TOOLART.protractor({})}</g>`, ghost: t => `<circle cx="${t[0]}" cy="${t[1]}" r="8" fill="#16a34a"/>`, h: '각도기 아래 가운데 점이 빨간 꼭짓점에 오게 옮겨요.', ok: '중심을 맞췄어요.', no: '조금 더 % 옮겨요.' },
    { type: 'choice', title: '각도 읽기', q: '이 각은 몇 °일까요?', bg: 'wall', pic: () => `<line x1="330" y1="330" x2="660" y2="330" stroke="#334155" stroke-width="5"/><line x1="330" y1="330" x2="${330 + 300 * Math.cos(-Math.PI / 3)}" y2="${330 + 300 * Math.sin(-Math.PI / 3)}" stroke="#334155" stroke-width="5"/><g transform="translate(330,280) scale(1.6)">${TOOLART.protractor({})}</g>` + [0, 30, 60, 90].map(a => tx(330 + 175 * Math.cos(-a * Math.PI / 180), 330 + 175 * Math.sin(-a * Math.PI / 180), 18, a, '#713f12')).join(''), opts: [{ e: '📐', t: '30°' }, { e: '📐', t: '60°' }, { e: '📐', t: '90°' }], a: 1, elim: 0, h: '0에서 시작해 다른 변이 지나는 숫자를 읽어요.', ok: '60°예요.' },
    { type: 'angle', title: '90° 만들기', q: '철사를 끌어 올려 90°(직각)를 만들어요.', bg: 'wall', target: 90, tol: 5, h: '숫자가 90이 될 때까지 끌어요.', ok: '직각을 만들었어요.' },
  ] },
