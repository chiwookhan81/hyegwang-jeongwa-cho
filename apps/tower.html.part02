    { type: 'cut', title: '선 긋기', q: '자를 꼭 누르고 0에서 12까지 연필로 선을 그어요.', bg: 'desk', mat: 'paper', mx: 40, my: 120, mw: 780, mh: 300, guide: 'ruler', path: [[70, 300], [550, 300]], tol: 14, tool: 'pencil', toolAng: -60, lineCol: '#a78bfa',
      h: '초록 동그라미에서 시작해 자 가장자리를 따라 깃발까지 곧게 그어요.', ok: '자를 대고 곧은 선을 그었어요.' },
  ] },
{ id: 'tape', z: 0, name: '테이프의 방', tool: '테이프 커터', use: '상자나 종이를 붙일 때 써요.', icon: ic('tape', .8),
  intro: '4층 상자 뚜껑이 벌어져서 열쇠가 굴러 나올 것 같아요. 테이프를 알맞은 길이로 잘라 상자를 붙여요.',
