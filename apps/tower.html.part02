  cutLine: (o = {}) => Object.assign({ type: 'cut', title: '곧게 자르기', q: '점선을 따라 가위로 곧게 잘라요. 초록 동그라미에서 시작해요.', bg: 'desk', mat: 'paper', mx: 130, my: 120, mw: 600, mh: 280, path: [[130, 260], [730, 260]], tol: 22, tool: 'scissors', toolAng: -90,
    h: '가위를 점선 위에 놓고, 천천히 앞으로 밀면서 잘라요.', ok: '선을 따라 곧게 잘랐어요.' }, o),
  circle: (cx, cy, r, n = 36) => [...Array(n + 1)].map((_, i) => [Math.round(cx + r * Math.cos(-Math.PI / 2 + i * 2 * Math.PI / n)), Math.round(cy + r * Math.sin(-Math.PI / 2 + i * 2 * Math.PI / n))]),
  stapler: (o = {}) => Object.assign({ type: 'squeeze', mode: 'hold', title: '꾹 누르기', q: '손바닥으로 스테이플러를 끝까지 꾹 눌러요.', bg: 'desk', lo: 70, hi: 100, max: 100, rate: 55, gauge: '누르는 힘', btn: '꾹 누르기', col: '#ef4444',
    pic: V => paperR(220, 150, 300, 200) + paperR(232, 162, 300, 200) + tool('stapler', 211, 139, .8, 45, { press: V.amt > 70 }) + (V.amt >= 70 && DONE ? `<path d="M245,173 L261,189" stroke="#64748b" stroke-width="5" stroke-linecap="round"/>` : ''),
    lowMsg: '덜 눌러서 심이 박히지 않았어요. 끝까지 꾹 눌러요.', h: '버튼을 누른 채로 힘 막대가 초록 칸에 올 때까지 기다렸다가 떼요.', ok: '심이 단단히 박혔어요.' }, o),
  punchAlign: (o = {}) => Object.assign({ type: 'place', axis: 'x', title: '가운데 맞추기', q: '종이 가운데 표시(▼)를 펀치 화살표(▲)에 맞춰요.', bg: 'desk', from: [250, 230], to: [430, 230], tol: 12,
    pic: () => tool('punch', 430, 360, 1.1) + `<path d="M418,418 l12,-18 l12,18 z" fill="#ef4444"/>`,
    obj: p => paperR(p[0] - 150, p[1] - 110, 300, 200) + `<path d="M${p[0] - 12},${p[1] + 74} l12,16 l12,-16 z" fill="#7c3aed"/><line x1="${p[0]}" y1="${p[1] - 110}" x2="${p[0]}" y2="${p[1] + 90}" stroke="#c4b5fd" stroke-dasharray="6 6" stroke-width="2"/>`,
    h: '종이를 옆으로 밀어서 보라색 ▼가 빨간 ▲ 바로 위에 오게 해요.', ok: '가운데에 딱 맞췄어요. 구멍이 양쪽 똑같은 자리에 뚫려요.', no: '조금 더 % 밀어요.' }, o),
  bondLine: (o = {}) => { const e = o.easy ?? 1; return Object.assign({ type: 'squeeze', mode: 'line', easy: e, title: '본드 짜기', q: e ? '점선을 따라 목공본드를 한 줄로 짜요.' : '점선을 따라 목공본드를 한 줄로 고르게 짜요. 너무 천천히 하면 넘치고, 너무 빠르면 모자라요.', bg: 'bench', line: [[180, 250], [680, 250]], tol: e ? 34 : 28, rate: 270, lo: 5, hi: 15, col: '#fffbeb', tool: 'bond',
    pic: () => wood(150, 200, 560, 100), h: e ? '초록 동그라미를 누른 채로 점선을 따라 깃발까지 쭉 움직여요.' : '초록 동그라미를 누른 채로 깃발까지 일정한 빠르기로 쭉 움직여요.', ok: '본드를 한 줄로 짰어요.',
    lowMsg: '너무 빨리 움직여서 본드가 모자라요. 조금 더 천천히 짜요.', highMsg: '너무 천천히 움직여서 본드가 넘쳤어요. 조금 더 빠르게 짜요.' }, o); },
  silLine: (o = {}) => { const e = o.easy ?? 1; return Object.assign({ type: 'squeeze', mode: 'line', easy: e, title: '틈 메우기', q: e ? '타일 틈을 따라 실리콘을 한 줄로 짜요.' : '타일 틈을 따라 실리콘을 알맞은 빠르기로 고르게 짜요.', bg: 'bath', line: [[120, 330], [740, 330]], tol: e ? 30 : 24, rate: 270, lo: 5, hi: 15, col: '#f8fafc', tool: 'silicone',
    pic: () => `<rect x="0" y="322" width="860" height="16" fill="#64748b"/><rect x="0" y="338" width="860" height="182" fill="#e0f2fe"/>`,
    h: e ? '방아쇠를 누른 채 틈을 따라 끝까지 움직여요.' : '방아쇠를 꾹 누른 채 일정한 빠르기로 틈을 따라 움직여요.', ok: '틈을 빈틈없이 메웠어요.', lowMsg: '너무 빨라서 틈이 다 메워지지 않았어요.', highMsg: '너무 천천히 해서 실리콘이 넘쳤어요.' }, o); },
  turn: (o = {}) => Object.assign({ type: 'turn', title: '돌리기', dir: 'cw', turns: 1.5, h: '보라색 손을 잡고 큰 동그라미를 따라 돌려요.', ok: '단단히 조였어요.' }, o),
  find: (o = {}) => Object.assign({ type: 'find', title: '도구 찾기', h: '도구의 손잡이나 끝이 조금만 삐죽 나와 있어요. 상자, 서랍, 천 가장자리를 잘 봐요.', ok: '필요한 도구를 모두 찾았어요.' }, o),
  code: (ans, o = {}) => Object.assign({ type: 'code', title: '비밀번호 열기', q: '모은 숫자 쪽지를 순서대로 눌러 문을 열어요.', ans, h: `오른쪽 아래에 모은 숫자 쪽지를 왼쪽부터 차례로 눌러요.`, ok: '문이 열렸어요!', clue: '오른쪽 칸에 모인 숫자 쪽지를 찾은 순서대로 눌러요.' }, o),
};
// 숨긴 도구: 도구의 끝만 덮개 밖으로 나와요
const AX = { scissors: 90, glue: -90, bond: -90, clamp: -90, gluegun: 0, drill: 0, edriver: 0, silicone: 0, hammer: 90, hexkey: 0 };
function HIDE(kind, x, y, k, dir = 'up', s = .6, o = {}) {
  s *= 1.25;
  const da = { up: -90, down: 90, left: 180, right: 0 }[dir], r = da - (AX[k] || 0), L = 100 * s, vx = Math.round(Math.cos(da * Math.PI / 180)), vy = Math.round(Math.sin(da * Math.PI / 180));
  const hit = [x + vx * L * .66, y + vy * L * .66, 40];
  const cx = x - vx * L * .42, cy = y - vy * L * .42, W = (vx ? L * 1.3 : 170 * s + 36), H = (vy ? L * 1.3 : 170 * s + 36);
  const C = { box: '#d6a76c', drawer: '#a16207', books: '#60a5fa', cloth: '#c084fc', bucket: '#94a3b8', bag: '#f472b6' }[kind];
  let cover = `<rect x="${cx - W / 2}" y="${cy - H / 2}" width="${W}" height="${H}" rx="${kind === 'cloth' || kind === 'bag' ? 30 : 8}" fill="${C}" stroke="#334155" stroke-width="3"/>`;
  if (kind === 'books') cover += [0, 1, 2].map(i => `<rect x="${cx - W / 2}" y="${cy - H / 2 + i * H / 3}" width="${W}" height="${H / 3}" fill="${['#60a5fa', '#f87171', '#facc15'][i]}" stroke="#334155" stroke-width="3"/>`).join('');
  if (kind === 'drawer') cover += `<rect x="${cx - 26}" y="${cy - 6}" width="52" height="12" rx="6" fill="#fde047"/>`;
  if (kind === 'box') cover += `<path d="M${cx - W / 2},${cy - H / 2 + 14} h${W}" stroke="#92400e" stroke-width="3"/>`;
  if (kind === 'cloth') cover += `<path d="M${cx - W / 2 + 10},${cy} q${W / 4},-20 ${W / 2},0 t${W / 2 - 20},0" fill="none" stroke="#7e22ce" stroke-width="3"/>`;
  return { item: { k, x, y, s, r, hit, o }, cover };
}
function room(hides, deco = '') {
  return {
    scene: () => `<rect width="860" height="520" fill="#ede9fe"/><rect y="390" width="860" height="130" fill="#c4b5fd"/><rect x="40" y="70" width="300" height="16" fill="#a16207"/><rect x="520" y="70" width="300" height="16" fill="#a16207"/>${em(80, 40, 40, '🪴')}${em(780, 40, 40, '🕰️')}${deco}`,
    items: hides.map(h => h.item), cover: () => hides.map(h => h.cover).join('')
  };
}
// 입체 판자: 앞면 + 윗면(hl=1이면 붙일 면을 노랗게)
function board3d(x, y, w, h, c = '#e2b77c', hl = 0) {
  const d = 36, k = 22;
  return `<path d="M${x},${y} L${x + d},${y - k} L${x + w + d},${y - k} L${x + w},${y} Z" fill="${hl ? '#fde68a' : '#f0cf9a'}" stroke="#92400e" stroke-width="3" stroke-linejoin="round"/><path d="M${x + w},${y} L${x + w + d},${y - k} L${x + w + d},${y - k + h} L${x + w},${y + h} Z" fill="#b9874f" stroke="#92400e" stroke-width="3" stroke-linejoin="round"/>` + wood(x, y, w, h, c) + (hl ? `<text x="${x + w / 2 + 18}" y="${y - 30}" text-anchor="middle" font-size="20" fill="#a16207" font-weight="bold">▼ 붙일 면</text>` : '');
}
// F클램프(옆모습): sx=나사 위치, cy=두 턱 사이 가운데, open=턱 사이 거리
function fclamp(sx, cy, open, hy) {
  const t = cy - open / 2, b = cy + open / 2, arm = t - 40, fx = sx + 150;
  return `<path d="M${sx - 24},${arm} H${fx} V${b + 30} H${sx - 50}" fill="none" stroke="#2563eb" stroke-width="18" stroke-linejoin="round"/><rect x="${sx - 44}" y="${b}" width="88" height="16" rx="4" fill="#334155"/>`
    + `<line x1="${sx}" y1="${hy ?? arm - 50}" x2="${sx}" y2="${t - 14}" stroke="#94a3b8" stroke-width="12"/>` + [0, 1, 2, 3].map(k => `<line x1="${sx - 6}" y1="${arm + 6 + k * 8}" x2="${sx + 6}" y2="${arm + 2 + k * 8}" stroke="#64748b" stroke-width="2"/>`).join('')
    + `<rect x="${sx - 40}" y="${t - 16}" width="80" height="16" rx="4" fill="#334155"/>` + (hy === undefined ? `<rect x="${sx - 60}" y="${arm - 62}" width="120" height="16" rx="7" fill="#1e293b"/><circle cx="${sx}" cy="${arm - 54}" r="14" fill="#ef4444" stroke="#334155" stroke-width="3"/>` : '');
}
const clampBoards = gap => board3d(200, 302 + gap, 420, 60) + board3d(200, 250, 420, 52, '#d6a76c');
const clampTurn = (o = {}) => B.turn(Object.assign({ title: '클램프 조이기', q: '빨간 손잡이를 시계 방향으로 돌려 클램프를 꽉 조여요.', turns: 1.5, bg: 'bench', c: [540, 100], R: 80,
  obj: (c, V, f) => { const gap = (1 - f) * 16; return clampBoards(gap) + fclamp(540, 295 + gap / 2, 134 + gap + (1 - f) * 30, 100); },
  handle: () => `<rect x="-60" y="-8" width="120" height="16" rx="7" fill="#1e293b"/><circle r="14" fill="#ef4444" stroke="#334155" stroke-width="3"/>`,
  h: '빨간 손잡이를 잡고 시계 방향으로 동그라미를 따라 돌려요.', ok: '클램프로 두 판자를 꽉 물렸어요.' }, o));
// 드라이버를 나사 정면에서 본 모습: 둥근 손잡이 끝(홈 줄무늬)과 표시점이 돌아가요
const DRV_END = () => `<g transform="scale(.78)"><circle r="62" fill="#dc2626" stroke="#7f1d1d" stroke-width="4"/>` + [...Array(8)].map((_, i) => { const a = i * Math.PI / 4; return `<line x1="${Math.cos(a) * 40}" y1="${Math.sin(a) * 40}" x2="${Math.cos(a) * 60}" y2="${Math.sin(a) * 60}" stroke="#991b1b" stroke-width="7" stroke-linecap="round"/>`; }).join('') + `<circle r="34" fill="#ef4444" stroke="#b91c1c" stroke-width="3"/><circle r="14" fill="#fca5a5" opacity=".6"/><circle cx="0" cy="-48" r="7" fill="#fff"/></g>`;
// 붓 씻기 그림: 물이 담긴 대야에 붓을 담가요
const WASH_SCENE = cov => `<path d="M170,300 Q430,330 690,300 L650,470 Q430,500 210,470 Z" fill="#cbd5e1" stroke="#475569" stroke-width="4"/>`
  + `<ellipse cx="430" cy="300" rx="260" ry="46" fill="${cov > .5 ? '#93c5fd' : '#bfdbfe'}" stroke="#475569" stroke-width="4"/><ellipse cx="430" cy="300" rx="236" ry="36" fill="rgba(59,130,246,${.18 + cov * .45})"/>`
  + `<rect x="418" y="30" width="24" height="150" rx="10" fill="#b45309" stroke="#78350f" stroke-width="3"/><rect x="380" y="176" width="100" height="48" rx="6" fill="#cbd5e1" stroke="#475569" stroke-width="3"/>`
  + `<path d="M382,222 L478,222 L474,318 Q430,334 386,318 Z" fill="#e9c98f" stroke="#92400e" stroke-width="2"/><path d="M382,222 L478,222 L474,318 Q430,334 386,318 Z" fill="#3b82f6" opacity="${.85 * (1 - cov)}"/>`
  + `<path d="M200,300 Q430,348 660,300 L650,336 Q430,372 210,336 Z" fill="rgba(96,165,250,${.45 + cov * .3})"/>`
  + [0, 1, 2, 3, 4].map(i => `<path d="M${330 + i * 50},${296 + (i % 2) * 8} q12,-8 24,0" fill="none" stroke="#fff" stroke-width="3" opacity=".8"/>`).join('') + em(560, 250, 34, '💧') + em(300, 250, 28, '💧') + em(620, 210, 24, '🫧') + em(250, 220, 22, '🫧');
const WASH_ICON = `<ellipse cx="0" cy="40" rx="62" ry="14" fill="#93c5fd" stroke="#475569" stroke-width="3"/><path d="M-62,40 L-50,74 Q0,84 50,74 L62,40" fill="#cbd5e1" stroke="#475569" stroke-width="3"/><rect x="-5" y="-60" width="10" height="60" rx="4" fill="#b45309"/><rect x="-14" y="0" width="28" height="12" fill="#94a3b8"/><path d="M-14,12 L14,12 L12,44 L-12,44 Z" fill="#e9c98f"/>` + em(-40, 10, 22, '💧') + em(42, 4, 20, '🫧');
// 장도리 문제 그림: 실제 장도리 사진에 부분 표시, 못 길이 그림
const CLAWPART = part => { const b = TBB.claw, sc = .72, X = f => (b[0] + b[2] * f) * sc, Y = f => (b[1] + b[3] * f) * sc, p = { claw: [X(.86), Y(.1)], face: [X(.1), Y(.1)], end: [X(.5), Y(.95)] }[part];
  return tool('claw', 0, 0, sc) + `<circle cx="${p[0]}" cy="${p[1]}" r="22" fill="rgba(250,204,21,.25)" stroke="#f59e0b" stroke-width="5"/>`; };
const CLAWPULL = amt => { const b = TBB.claw, a = Math.min(amt, 100), r = (180 - a * .35) * Math.PI / 180, px = b[0] + b[2] * .86, py = b[1] + b[3] * .12, nx = 380, ny = 300 - a * .9 + 4; const cx = nx - (px * Math.cos(r) - py * Math.sin(r)), cy = ny - (px * Math.sin(r) + py * Math.cos(r)); return tool('claw', cx, cy, 1, r * 180 / Math.PI); };
const NAILI = L => `<rect x="-3" y="${-L / 2 + 6}" width="6" height="${L - 10}" fill="#94a3b8" stroke="#475569" stroke-width="1.5"/><rect x="-11" y="${-L / 2}" width="22" height="7" rx="2" fill="#64748b"/><path d="M-3,${L / 2 - 4} L0,${L / 2 + 6} L3,${L / 2 - 4} Z" fill="#94a3b8" stroke="#475569" stroke-width="1.5"/>`;
const giveNote = (d, text) => ({ give: d, okx: text });

const FLOORS = [
// =============== 1구역: 사무·공작 도구 ===============
{ id: 'glue', z: 0, name: '딱풀의 방', tool: '딱풀', use: '종이를 붙일 때 써요.', icon: ic('glue', .8, 0, { open: 1 }),
  intro: '1층 방문이 잠겼어요. 문에 붙은 쪽지가 찢어져 있어요. 딱풀로 쪽지를 붙이면 문이 열려요.',
  safe: '다 쓰면 풀을 내리고 뚜껑을 꼭 닫아요. 안 닫으면 말라서 못 써요.',
  outro: '딱풀로 쪽지를 붙였어요. 풀은 조금만 올리고, 골고루 칠하고, 다 쓰면 뚜껑을 닫아요.',
  steps: [
    { type: 'choice', title: '뚜껑 열기', q: '딱풀을 쓰려면 먼저 무엇을 할까요?', bg: 'desk', opts: [{ k: 'glue', o: { open: 1 }, t: '뚜껑을 열어요' }, { k: 'glue', t: '뚜껑을 닫은 채 문질러요' }, { e: '💧', t: '물을 묻혀요' }], a: 0, elim: 2, h: '뚜껑이 닫혀 있으면 풀이 나오지 않아요.', ok: '뚜껑을 열었어요.', no: '그렇게 하면 풀이 묻지 않아요.' },
    B.turn({ title: '풀 올리기', q: '아래쪽을 시계 방향으로 돌려 풀을 조금 올려요.', turns: .75, label: '시계 방향 ↻ 풀 올리기', bg: 'desk', handle: V => `<g transform="rotate(${-V.ang})">${tool('glue', 0, -20, .9, 0, { open: 1, up: Math.min(30, V.tot / 10) })}</g><circle r="22" fill="#ca8a04" stroke="#334155" stroke-width="3"/>`, ok: '풀이 조금 올라왔어요. 너무 많이 올리면 부러져요.' }),
    B.rubPaper({ q: '쪽지 뒷면 점선 안쪽에 풀을 골고루 문질러요.' }),
    { type: 'place', title: '붙이기', q: '쪽지를 문의 찢어진 자리에 딱 맞게 붙여요.', bg: 'room', from: [180, 380], to: [645, 200], tol: 28, pic: V => doorPic() + `<rect x="585" y="160" width="120" height="80" fill="none" stroke="#fde047" stroke-width="3" stroke-dasharray="8 6"/>`,
      obj: p => paperR(p[0] - 60, p[1] - 40, 120, 80, '#fef9c3') + tx(p[0], p[1], 20, '열려라!', '#7c2d12'), ghost: t => paperR(t[0] - 60, t[1] - 40, 120, 80), h: '쪽지를 끌어서 문 위의 노란 점선 네모에 놓아요.', ok: '쪽지를 딱 맞게 붙였어요!', no: '조금 더 % 옮겨요.' },
    { type: 'choice', title: '뚜껑 닫기', q: '다 쓴 딱풀은 어떻게 할까요?', bg: 'desk', opts: [{ k: 'glue', t: '풀을 내리고 뚜껑을 닫아요' }, { k: 'glue', o: { open: 1, up: 30 }, t: '열어 둔 채로 둬요' }, { e: '🎳', t: '책상에 굴려요' }], a: 0, elim: 2, h: '뚜껑을 닫아야 풀이 마르지 않아요.', ok: '뚜껑을 닫았어요.' },
  ] },
{ id: 'scissors', z: 0, name: '가위의 방', tool: '가위', use: '종이나 끈을 자를 때 써요.', icon: ic('scissors', .8, 45),
  intro: '2층 문 손잡이에 종이 열쇠가 붙어 있어요. 가위로 선을 따라 잘라 열쇠를 오려 내요.',
  safe: '가위를 건넬 때는 날을 감싸 잡고 손잡이를 상대에게 줘요. 가위를 들고 뛰지 않아요.',
