  let bankMsg = '';
  if (F.surprise && !BANKGOT[F.id]) { BANKGOT[F.id] = 1; BANK++; bankMsg = `<div style="margin-top:10px;padding:10px 14px;background:#fef9c3;border:3px solid #facc15;border-radius:16px;font-size:21px;text-align:left;line-height:1.45">💳 <b>월궁통장 1개를 받았어요!</b> (지금 ${BANK}개)<br>월궁통장은 <b>비장의 무기</b>예요. 너무 어려운 단계에서 오른쪽 위 <b>💳 단추</b>를 누르면 통장 1개를 쓰고 그 단계를 바로 통과해요.<br>통장은 <b>여러 개 모아 둘 수 있어요(스택)</b>. 아껴 두었다가 꼭 필요할 때 써요. 단, 돌발 스테이지와 99층에서는 쓸 수 없어요.</div>`; }
  else if (F.surprise) bankMsg = `<div style="margin-top:8px;font-size:19px;color:#64748b">이 돌발 스테이지의 월궁통장은 이미 받았어요. (지금 ${BANK}개)</div>`;
  save(); sfx('clear');
  $('cl-door').innerHTML = `<rect width="400" height="200" fill="#fef9c3"/><rect x="150" y="20" width="100" height="180" fill="#fde047"/><path d="M150,20 L110,36 L110,200 L150,200 Z" fill="#a16207"/>${em(200, 110, 60, F.surprise ? '💳' : '✨')}<g transform="translate(70,120) scale(.5)">${F.icon()}</g>${em(330, 120, 60, '🗝️')}`;
  $('cl-stars').innerText = '★'.repeat(st) + '☆'.repeat(3 - st);
  $('cl-title').innerText = F.surprise ? `${CUR + 1}층 돌발 스테이지 통과!` : `${CUR + 1}층 탈출 성공!`;
  $('cl-text').innerHTML = F.outro + bankMsg + (st < 3 ? `<div style="margin-top:10px;padding:8px 14px;background:#ecfeff;border:3px solid #67e8f9;border-radius:16px;font-size:22px;color:#155e75">💡 없이 다시 풀면 별 3개! 다음 구역은 모든 층이 별 3개일 때 열려요.</div>` : '');
