<!DOCTYPE html>
<html lang="ko">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<head><script>/* 1.2.0 앱을 내리면(최소화) 소리를 멈춰요: 읽어 주기·녹음 목소리·효과음·반복 음악. 돌아오면 반복 음악만 다시 나와요 */(function(){if(window.__hubHide)return;window.__hubHide=1;var A=[];try{['AudioContext','webkitAudioContext'].forEach(function(n){var C=window[n];if(!C||C.__hubW)return;var W=function(a){var c=a===undefined?new C():new C(a);A.push(c);return c};W.prototype=C.prototype;W.__hubW=1;try{Object.setPrototypeOf(W,C)}catch(e){}window[n]=W})}catch(e){}var L=[];document.addEventListener('visibilitychange',function(){if(document.hidden){try{speechSynthesis.cancel()}catch(e){}try{if(typeof window.stopVoice==='function')window.stopVoice()}catch(e){}A.forEach(function(c){try{if(c.state==='running'){c.suspend();c.__hubS=1}}catch(e){}});Array.prototype.forEach.call(document.querySelectorAll('audio,video'),function(m){if(m.srcObject||m.paused)return;try{m.pause();if(m.loop)L.push(m)}catch(e){}})}else{A.forEach(function(c){try{if(c.__hubS){c.__hubS=0;c.resume()}}catch(e){}});L.splice(0).forEach(function(m){try{m.play()}catch(e){}})}})})();</script><script>/* 1.1.3 크롬 83 보충: flex 간격(gap)을 모르는 엔진(칠판)에서만 fix83.html을 읽어 간격을 메워요. 되돌릴 때는 fix83.html만 바꾸면 돼요 */(function(){function need(){var d=document.createElement('div');d.style.cssText='display:flex;flex-direction:column;row-gap:1px;position:absolute;visibility:hidden';d.appendChild(document.createElement('div'));d.appendChild(document.createElement('div'));document.body.appendChild(d);var ok=d.scrollHeight===1;d.parentNode.removeChild(d);return !ok}function go(){try{if(!need())return;fetch((/\/apps\//.test(location.pathname)?'../':'')+'fix83.html').then(function(r){return r.ok?r.text():''}).then(function(t){var m=/<script type="text\/plain" id="gap83">([\s\S]*?)<\/script>/.exec(t);if(m&&m[1].trim())new Function(m[1])()}).catch(function(){})}catch(e){}}if(document.readyState==='loading')addEventListener('DOMContentLoaded',go);else go()})();</script>
<script>/* 칠판 끌기 고침 (2026-11-24): 누른 자리가 다시 그려져 사라져도 끌기가 끊기지 않게 이어 줘요 */
(function(){if(window.__dragFix)return;window.__dragFix=1;var C=null;
function fw(e){var t=e.currentTarget;if(t.isConnected||!C||C.n!==t)return;var h=null;for(var i=0;i<C.a.length;i++)if(C.a[i].isConnected){h=C.a[i];break}h=h||document.body;try{h.dispatchEvent(new PointerEvent(e.type,e))}catch(x){}if(e.type!=='pointermove')off()}
function off(){if(!C)return;['pointermove','pointerup','pointercancel'].forEach(function(k){C.n.removeEventListener(k,fw)});C=null}
document.addEventListener('pointerdown',function(e){if(e.pointerType==='mouse')return;off();var n=e.target;if(!n||!n.addEventListener)return;var a=[],p=n.parentNode;while(p&&p.nodeType===1){a.push(p);p=p.parentNode}C={n:n,a:a};['pointermove','pointerup','pointercancel'].forEach(function(k){n.addEventListener(k,fw)})},true);
document.addEventListener('pointerup',function(e){if(C&&C.n.isConnected)off()},true);
})();</script>

<title>월궁탑</title>
<script>/* 1.1.3 글꼴: 화면이 다 뜬 뒤 fonts.html에서 주아체·싱글데이를 불러와요. 되돌릴 때는 fonts.html만 바꾸면 돼요 */(function(){var T=1;function go(){try{fetch((/\/apps\//.test(location.pathname)?'../':'')+'fonts.html').then(function(r){return r.ok?r.text():''}).then(function(t){var re=/<style id="(body|title)"[^>]*>([\s\S]*?)<\/style>/g,m,c='';while((m=re.exec(t)))if(m[1]==='body'||T)c+=m[2];if(!c)return;var s=document.createElement('style');s.id='hgfont';s.textContent=c;document.head.appendChild(s)}).catch(function(){})}catch(e){}}function later(){setTimeout(go,700)}if(document.readyState==='complete')later();else addEventListener('load',later)})();</script>
<style>
  img.emi { height: 1.18em; width: auto; vertical-align: -.22em; display: inline-block; pointer-events: none; }
  :root { --font: 'Jua', 'Malgun Gothic', sans-serif; --emo: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif; }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: #1e1b4b; font-family: var(--font); overflow: hidden; -webkit-user-select: none; user-select: none; }
  #wrap { position: fixed; left: 50%; top: 0; transform: translateX(-50%); }
  #stage { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background: #ede9fe; touch-action: none; }
  .scr { position: absolute; inset: 0; }
  @keyframes godfloat { 0%,100% { transform: translateY(0) rotate(-.6deg) } 50% { transform: translateY(-22px) rotate(.6deg) } }
  @keyframes godpan { from { transform: scale(1.04) translateX(-12px) } to { transform: scale(1.1) translateX(12px) } }
  @keyframes gcl { from { transform: translateX(-300px) } to { transform: translateX(1500px) } }
  @keyframes gsp { 0% { opacity: 0; transform: translateY(0) scale(.6) } 30% { opacity: 1 } 100% { opacity: 0; transform: translateY(-120px) scale(1.2) } }
  .gcloud { position: absolute; border-radius: 50%; background: radial-gradient(circle at 50% 40%, rgba(255,255,255,.95), rgba(255,255,255,.55) 45%, rgba(255,255,255,0) 70%); animation: gcl linear infinite; }
  .gspk { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(#fff, #fde68a 40%, rgba(253,230,138,0) 70%); animation: gsp 3.2s ease-out infinite; }
  .godtxt { text-shadow: 0 0 10px #fde68a, 4px 4px 0 rgba(253,230,138,.28), 9px 9px 2px rgba(253,230,138,.16), 15px 15px 4px rgba(253,230,138,.08); }
  .godtxt .ec { display: block; margin-top: 6px; font-size: 22px; opacity: 0; letter-spacing: 4px; animation: gec 3.2s ease-out .8s forwards; }
  @keyframes gec { 0% { opacity: 0; transform: translateX(0) scale(1) } 30% { opacity: .65 } 100% { opacity: .15; transform: translateX(46px) scale(1.12); filter: blur(1.5px) } }

  .lcl { position: absolute; opacity: .75; animation: lcl 2.6s linear forwards; }
  @keyframes lcl { to { transform: translateY(1000px); } }
  .lsp { position: absolute; font-size: 26px; animation: lsp 1s ease-in infinite; }
  @keyframes lsp { 0% { opacity: 1; transform: translateY(0) } 100% { opacity: 0; transform: translateY(90px) } }

  .hidden { display: none !important; }
  button { font-family: var(--font); cursor: pointer; border: none; }
  svg { font-family: var(--font); }
  .btn2 { background: #fff; color: #475569; font-size: 22px; padding: 8px 16px; border-radius: 16px; box-shadow: 0 4px 0 #c4b5fd; border: 2px solid #ddd6fe; }
  .bigbtn { background: #7c3aed; color: #fff; font-size: 26px; padding: 12px 28px; border-radius: 22px; box-shadow: 0 6px 0 #4c1d95; }
  .panel { position: absolute; background: #fff; border-radius: 22px; border: 4px solid #c4b5fd; box-shadow: 0 5px 0 #8b5cf6; overflow: hidden; }
  .zone { font-size: 16px; padding: 7px 8px; border-radius: 18px; border: 4px solid #c4b5fd; background: #fff; color: #6d28d9; }
  .zone.on { color: #fff; border-color: transparent; box-shadow: 0 4px 0 rgba(0,0,0,.25); }
  .fl { position: absolute; width: 294px; height: 150px; background: #fff; border-radius: 20px; border: 4px solid #c4b5fd; box-shadow: 0 5px 0 #8b5cf6; overflow: hidden; cursor: pointer; text-align: left; padding: 0; display: flex; }
  .fl .ic { width: 120px; flex: none; background: #f5f3ff; }
  .fl .ic svg { width: 100%; height: 100%; display: block; }
  .fl .tx { flex: 1; padding: 10px 10px 6px; display: flex; flex-direction: column; gap: 4px; }
  .fl .fn { font-size: 18px; color: #7c3aed; }
  .fl .nm { font-size: 22px; color: #1e1b4b; line-height: 1.15; word-break: keep-all; }
  .fl .st { margin-top: auto; color: #f59e0b; font-size: 21px; }
  .fl.done { border-color: #86efac; box-shadow: 0 5px 0 #22c55e; }
  .fl.next { animation: nx 1s infinite alternate; }
  @keyframes nx { from { box-shadow: 0 5px 0 #8b5cf6 } to { box-shadow: 0 5px 0 #8b5cf6, 0 0 0 8px #fde047 } }
  #vis { touch-action: none; }
  .glow { animation: gl .6s infinite alternate; }
  @keyframes gl { from { opacity: 1 } to { opacity: .45 } }
  .shake { animation: sh .35s; }
  @keyframes sh { 25% { transform: translateX(-8px) } 75% { transform: translateX(8px) } }
  .stp { display: flex; gap: 8px; align-items: flex-start; font-size: 19px; color: #64748b; padding: 4px 0; line-height: 1.25; word-break: keep-all; }
  .stp.on { color: #4c1d95; }
  .stp.ok { color: #16a34a; }
  .stp b { flex: none; width: 28px; height: 28px; border-radius: 50%; background: #e2e8f0; color: #475569; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; }
  .stp.on b { background: #7c3aed; color: #fff; }
  .stp.ok b { background: #22c55e; color: #fff; }
  #staff { display: inline-block; background: rgba(255,255,255,.9); color: #4c1d95; font-size: 19px; padding: 5px 20px; border-radius: 99px; box-shadow: 0 3px 8px rgba(10,40,90,.18); }
  #staff b { font-weight: normal; color: #e8534a; }
  #rot { position: fixed; inset: 0; z-index: 9999; background: rgba(237,233,254,.97); display: none; flex-direction: column; align-items: center; justify-content: center; text-align: center; font-size: 26px; color: #4c1d95; gap: 14px; padding: 20px; }
  @media (orientation: portrait) and (max-width: 820px) { #rot.on { display: flex; } }
</style>
</head>
<body>
<div id="rot" class="on"><div style="font-size:80px">📱↻</div><div>휴대폰을 <b>가로로</b> 돌려 주세요.</div><button class="btn2" onclick="this.parentElement.classList.remove('on')">그냥 세로로 볼게요</button></div>
<div id="wrap"><div id="stage">

  <!-- 처음 화면 -->
  <div id="home" class="scr" style="background:linear-gradient(#4c1d95,#7c3aed 40%,#ede9fe 40%)">
    <svg style="position:absolute;left:0;top:0" width="1280" height="290" viewBox="0 0 1280 290">
      <g opacity=".9"><rect x="1040" y="40" width="150" height="250" fill="#a78bfa"/><rect x="1060" y="0" width="110" height="60" fill="#c4b5fd"/><path d="M1050,0 L1115,-50 L1180,0 Z" fill="#fde047"/>
      ${''}</g>
    </svg>
    <div style="position:absolute;left:24px;top:10px;display:flex;align-items:flex-end;gap:6px"><img data-char="wol" style="height:70px"><img data-char="hami" style="height:78px"><img data-char="ari" style="height:70px"></div>
    <div style="position:absolute;left:230px;top:8px;font-size:48px;color:#fff;text-shadow:0 4px 0 #2e1065">🗼 월궁탑</div><button class="btn2" onclick="showHall()" style="position:absolute;left:690px;top:20px;font-size:20px;padding:6px 14px">🏛️ 명예의 전당</button><div id="bank-home" style="position:absolute;left:470px;top:22px;font-size:22px;color:#4c1d95;background:#fef9c3;border:3px solid #facc15;border-radius:16px;padding:4px 14px"></div>
    <div style="position:absolute;left:236px;top:68px;font-size:20px;color:#ede9fe">도구를 바르게 써서 층마다 잠긴 문을 열어요. 꼭대기까지 올라가 볼까요?</div>
    <div style="position:absolute;right:20px;top:16px;display:flex;gap:6px;align-items:center"><select id="voice-sel" onchange="pickVoice(this.value)" style="font-family:var(--font);font-size:15px;max-width:170px;border-radius:12px;border:2px solid #c4b5fd;padding:5px"></select><button class="btn2" onclick="toggleSound()" id="snd-home" style="font-size:18px">🔊 소리 켜짐</button></div>
    <div id="zones" style="position:absolute;left:24px;top:104px;display:flex;gap:10px"></div>
    <div id="floors"></div>
    <div style="position:absolute;left:150px;bottom:8px;font-size:12px;color:#64748b"><span id="staff">✨ 크리에이터 <b style="color:#0891d0">강천석</b></span> <span id="ver">· 초등 초승달 전과 1.2.0</span> <span style="font-size:11px">· 장구·도구 소리: 공유마당 ((재)전주정보문화산업진흥원·JICA 공공누리 1유형, 한국저작권위원회 CC BY) · 비영리 교육용</span> <span id="rec-credit"></span> <button class="btn2" onclick="resetAll()" style="font-size:14px;padding:4px 10px;margin-left:8px">처음부터 다시</button> <span id="tot" style="font-size:17px;color:#4c1d95;margin-left:8px"></span></div>
  </div>

  <!-- 층 소개 -->
  <div id="intro" class="scr hidden" style="background:linear-gradient(#2e1065,#6d28d9)">
    <button class="btn2" onclick="goHome()" style="position:absolute;left:20px;top:18px">🏠</button>
    <div style="position:absolute;left:40px;top:90px;width:560px;height:470px;background:#f5f3ff;border-radius:30px;border:6px solid #c4b5fd;overflow:hidden"><svg id="in-svg" viewBox="0 0 560 470" style="width:100%;height:100%;display:block"></svg></div>
    <div style="position:absolute;left:640px;top:86px;width:600px;color:#fff">
      <div id="in-zone" style="display:inline-block;font-size:20px;padding:4px 16px;border-radius:14px;background:#fde047;color:#4c1d95"></div>
      <div id="in-title" style="font-size:42px;margin-top:10px;text-shadow:0 3px 0 #2e1065"></div>
      <div id="in-text" style="font-size:26px;line-height:1.5;margin-top:14px;word-break:keep-all;color:#ede9fe"></div>
      <div id="in-safe" style="font-size:21px;line-height:1.45;margin-top:14px;padding:12px 16px;background:rgba(254,240,138,.95);color:#713f12;border-radius:16px;word-break:keep-all"></div>
    </div>
    <div style="position:absolute;left:640px;top:610px;display:flex;gap:14px;align-items:center"><button class="bigbtn" onclick="startFloor()" style="font-size:30px;background:#facc15;color:#4c1d95;box-shadow:0 6px 0 #a16207">🚪 방에 들어가기</button><button class="btn2" onclick="playLines([FLOORS[CUR].intro])">🗣️ 다시 듣기</button></div>
  </div>

  <!-- 방 (문제) -->
  <div id="play" class="scr hidden" style="background:linear-gradient(#ede9fe,#faf5ff)">
    <div style="position:absolute;left:0;right:0;top:0;height:88px;background:rgba(255,255,255,.96);border-bottom:4px solid #a78bfa;display:flex;align-items:center;gap:12px;padding:0 14px;z-index:5">
      <button class="btn2" onclick="goHome()">🏠</button>
      <div style="display:flex;flex-direction:column;min-width:230px">
        <div id="p-title" style="font-size:24px;color:#4c1d95;white-space:nowrap"></div>
        <div id="p-num" style="font-size:18px;color:#7c3aed"></div>
      </div>
      <img id="hp-img" style="height:80px;align-self:flex-end">
      <div id="hp-bub" style="flex:1;background:#f5f3ff;border:3px solid #c4b5fd;border-radius:20px;padding:6px 16px;font-size:21px;color:#334155;line-height:1.28;min-height:56px;max-height:80px;overflow:hidden;display:flex;align-items:center"></div>
      <button class="btn2" id="bankb" onclick="useBank()" style="font-size:20px">💳 0</button>
      <button class="btn2" onclick="hintMore()">💡</button>
      <button class="btn2" onclick="sayAgain()">🗣️</button>
      <button class="btn2" onclick="toggleSound()" id="snd-play">🔊</button>
    </div>
    <div class="panel" style="left:14px;top:98px;width:864px;height:608px">
      <div id="qtext" style="height:62px;padding:6px 18px;font-size:26px;color:#4c1d95;line-height:1.25;display:flex;align-items:center;word-break:keep-all;background:#f5f3ff;border-bottom:3px solid #ede9fe"></div>
      <svg id="vis" viewBox="0 0 860 520" style="width:856px;height:538px;display:block"></svg>
    </div>
    <div class="panel" style="left:892px;top:98px;width:374px;height:608px;padding:12px 14px;display:flex;flex-direction:column">
      <div id="toolc" style="display:flex;align-items:center;gap:10px;padding-bottom:8px;border-bottom:3px dashed #ddd6fe"></div>
      <div id="steps" style="margin-top:8px;flex:1;overflow:hidden"></div>
      <div id="inv" style="display:flex;gap:6px;flex-wrap:wrap;margin:4px 0"></div>
      <div id="fb" style="min-height:96px;font-size:20px;color:#334155;line-height:1.35;word-break:keep-all;background:#f8fafc;border-radius:14px;padding:8px 10px"></div>
      <button id="nextb" class="bigbtn hidden" onclick="nextStep()" style="margin-top:8px">다음 ▶</button>
    </div>
  </div>

  <!-- 통장 쓰기 확인 -->
  <div id="bankq" class="scr hidden" style="background:rgba(30,10,60,.55);z-index:30">
    <div style="position:absolute;left:340px;top:170px;width:600px;background:#fff;border-radius:30px;border:6px solid #facc15;padding:26px;text-align:center">
      <div style="font-size:70px">💳</div><div style="font-size:28px;color:#4c1d95;line-height:1.4;word-break:keep-all">월궁통장 1개를 써서<br>이 단계를 바로 통과할까요?</div>
      <div style="font-size:20px;color:#64748b;margin-top:8px">지금 가진 통장: <b id="bankq-n">0</b>개</div>
      <div style="display:flex;justify-content:center;gap:16px;margin-top:18px"><button class="bigbtn" onclick="bankYes()" style="background:#facc15;color:#4c1d95;box-shadow:0 6px 0 #a16207">네, 쓸래요</button><button class="btn2" onclick="bankNo()">아껴 둘래요</button></div>
    </div>
  </div>
  <!-- 99층 인증 -->
  <div id="hall" class="scr hidden" style="z-index:45;background:linear-gradient(#57534e,#292524)">
    <div style="position:absolute;left:60px;right:60px;top:40px;bottom:40px;background:linear-gradient(#d6d3d1,#a8a29e);border:12px solid #78716c;border-radius:12px;text-align:center;padding:24px;box-shadow:inset 0 0 40px rgba(0,0,0,.35)">
      <div style="font-size:56px;color:#292524;text-shadow:0 2px 0 #fff">🏛️ 월궁탑 명예의 전당</div>
      <div style="font-size:22px;color:#44403c;margin:6px 0 10px">월궁탑 꼭대기에 오른 도구 장인들이에요.</div>
      <div id="hall-list"></div>
      <button class="btn2" onclick="$('hall').classList.add('hidden')" style="position:absolute;right:20px;bottom:16px">닫기</button>
    </div>
  </div>
  <div id="cert" class="scr hidden" style="z-index:40;background:linear-gradient(rgba(76,29,149,.35),rgba(46,16,101,.55)),url('data:image/webp;base64,') center/cover">
    <div style="position:absolute;inset:40px;border:10px double #fff;border-radius:40px;text-align:center;color:#fff;text-shadow:0 4px 0 #4c1d95">
      <div style="font-size:80px;margin-top:6px">🏆</div>
      <div style="font-size:64px">월궁탑 99층 정복!</div>
      <div style="margin-top:8px"><input id="cert-name" placeholder="여기에 이름을 써요" maxlength="12" oninput="try{localStorage.setItem('tower-name',this.value)}catch(e){}" style="font-family:inherit;font-size:40px;width:min(520px,80%);text-align:center;border:none;border-bottom:5px solid #fde047;background:rgba(255,255,255,.15);color:#fff;border-radius:14px;padding:4px 10px"> <span style="font-size:36px">학생</span></div>
      <div style="font-size:34px;margin-top:16px;line-height:1.5;color:#fef9c3">📸 이 화면을 <b>인증샷</b>으로 찍고<br><b>강천석 선생님</b>을 찾아가세요.</div>
      <div style="font-size:46px;margin-top:14px;color:#fde047">100층에 도전합니다!</div>
      <div id="cert-date" style="font-size:24px;margin-top:14px;color:#ede9fe"></div>
      <button class="btn2" onclick="$('cert').classList.add('hidden');goHome()" style="position:absolute;right:20px;bottom:16px;text-shadow:none">🏠 탑 입구</button>
    </div>
  </div>
  <!-- 엘리베이터 -->
  <div id="lift" class="scr hidden" style="z-index:35;overflow:hidden;background:#2e1065">
    <svg id="lift-svg" viewBox="0 0 1280 720" style="position:absolute;inset:0;width:1280px;height:720px"></svg>
    <div id="lift-cl" style="position:absolute;inset:0;pointer-events:none"></div>
    <img id="lift-pf" src="data:image/webp;base64," style="position:absolute;left:760px;top:250px;width:300px;filter:drop-shadow(0 0 18px #fde68a)">
    <div style="position:absolute;left:40px;top:36px;padding:14px 26px;background:rgba(255,255,255,.92);border-radius:24px;border:5px solid #facc15;font-size:40px;color:#4c1d95;box-shadow:0 6px 0 #a16207"><span id="lift-a"></span> <span style="color:#f59e0b">⬆</span> <b id="lift-b" style="font-size:52px"></b></div>
    <div id="lift-k" style="position:absolute;left:40px;bottom:36px;padding:10px 22px;background:rgba(76,29,149,.85);border-radius:20px;font-size:28px;color:#fff"></div>
    <button class="btn2" onclick="liftEnd()" style="position:absolute;right:24px;bottom:24px">건너뛰기 ⏭</button>
  </div>
  <!-- 꼭대기 화면 -->
  <div id="god" class="scr hidden" style="z-index:42;overflow:hidden;background:#1e1b4b">
    <div id="god-bg" style="position:absolute;inset:-40px;background:url('data:image/webp;base64,') center/cover;animation:godpan 26s ease-in-out infinite alternate"></div>
    <svg id="god-tower" viewBox="0 0 1280 720" style="position:absolute;inset:0;width:1280px;height:720px;filter:blur(1.6px);opacity:.78"></svg>
    <div style="position:absolute;left:0;right:0;bottom:0;height:200px;background:linear-gradient(rgba(253,244,255,0),rgba(253,244,255,.55) 60%,rgba(253,244,255,.8))"></div>
    <div id="god-cl"></div>
    <img id="god-img" src="data:image/webp;base64," style="position:absolute;left:250px;top:30px;width:780px;animation:godfloat 5s ease-in-out infinite;filter:drop-shadow(0 0 30px rgba(253,230,138,.8))">
    <div id="god-sp"></div>
    <div id="god-box" style="position:absolute;left:150px;right:150px;bottom:26px;min-height:120px;padding:18px 34px;background:linear-gradient(rgba(30,27,75,.86),rgba(59,7,100,.86));border:4px solid #fcd34d;border-radius:28px;box-shadow:0 0 40px rgba(252,211,77,.55);color:#fef3c7;font-size:31px;line-height:1.45;text-align:center">
      <div style="position:absolute;left:24px;top:-24px;background:#fcd34d;color:#3b0764;font-size:22px;padding:4px 18px;border-radius:14px">⛰️ 월궁탑 산신령</div>
      <div id="god-t" class="godtxt"></div>
    </div>
    <button class="btn2" id="god-next" onclick="godNext()" style="position:absolute;right:30px;bottom:170px">다음 ▶</button>
    <button class="btn2" onclick="godSay()" style="position:absolute;left:30px;bottom:170px">🔊 다시 듣기</button>
  </div>
  <!-- 문 열림 -->
  <div id="clear" class="scr hidden" style="background:rgba(30,10,60,.6);z-index:20">
    <div style="position:absolute;left:190px;top:46px;width:900px;height:630px;background:#fff;border-radius:36px;border:6px solid #fde047;padding:20px 30px;text-align:center">
      <svg id="cl-door" viewBox="0 0 400 200" style="width:400px;height:200px"></svg>
      <div id="cl-stars" style="font-size:52px;color:#f59e0b;text-shadow:0 3px 0 #b45309"></div>
      <div id="cl-title" style="font-size:36px;color:#4c1d95"></div>
      <div id="cl-text" style="margin:12px auto;width:780px;font-size:24px;color:#334155;line-height:1.5;word-break:keep-all"></div>
      <div style="display:flex;justify-content:center;gap:14px;margin-top:10px"><button class="bigbtn" id="cl-next" onclick="nextFloor()">⬆ 다음 층으로</button><button class="btn2" onclick="openFloor(CUR)">🔁 다시 하기</button><button class="btn2" onclick="goHome()">🏠 탑 입구</button></div>
    </div>
  </div>
</div></div>

<script>
const CHARS = {
  wol:  { name:'월이', color:'#0369a1', img:'data:image/webp;base64,' },
  ari:  { name:'아리', color:'#9333ea', img:'data:image/webp;base64,' },
  hami: { name:'대롱이', color:'#db2777', img:'data:image/webp;base64,' }
};
document.querySelectorAll('img[data-char]').forEach(el => el.src = CHARS[el.dataset.char].img);
const $ = id => document.getElementById(id);
const stage = $('stage');
let SC = 1;
function fit() {
  const vv = window.visualViewport, W = vv ? vv.width : innerWidth, H = vv ? vv.height : innerHeight;
  SC = Math.min(W / 1280, H / 720);
  stage.style.transform = `scale(${SC})`;
  $('wrap').style.width = 1280 * SC + 'px'; $('wrap').style.height = 720 * SC + 'px';
  $('wrap').style.top = (H > W ? 0 : Math.max(0, (H - 720 * SC) / 2)) + 'px';
}
addEventListener('resize', fit); addEventListener('orientationchange', () => setTimeout(fit, 300)); if (window.visualViewport) visualViewport.addEventListener('resize', fit); fit();
const pick = a => a[Math.floor(Math.random() * a.length)];
// 조사: 끝소리에 맞춰 붙여요. JO(82, '이', '가') → '가', JO(40, '으로', '로') → '으로'
const JO = (w, a, b) => { w = String(w); const ch = w[w.length - 1]; let bat, rieul;
  if (/\d/.test(ch)) { bat = '013678'.includes(ch); rieul = '178'.includes(ch); }
  else { const c = ch.charCodeAt(0) - 0xAC00; if (c < 0 || c > 11171) { bat = false; rieul = false; } else { bat = c % 28 > 0; rieul = c % 28 === 8; } }
  return a === '으로' ? (bat && !rieul ? '으로' : '로') : (bat ? a : b); };

// ===================== 소리 =====================
let soundOn = true, AC = null;
function ac() { try { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); if (AC.state === 'suspended') AC.resume(); } catch (e) {} return AC; }
function tone(f, t, dur, type = 'sine', vol = .2, f2) {
  const a = ac(); if (!a) return;
  const o = a.createOscillator(), g = a.createGain();
  o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dur);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + .01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
  o.connect(g).connect(a.destination); o.start(t); o.stop(t + dur + .02);
}
function toggleSound() { soundOn = !soundOn; $('snd-home').innerText = soundOn ? '🔊 소리 켜짐' : '🔇 소리 꺼짐'; $('snd-play').innerText = soundOn ? '🔊' : '🔇'; if (!soundOn) stopVoice(); }
const VOICE_KEY = 'tower-voice';
// ===================== 음성 (최소 대사 방식) =====================
// 화면 말풍선은 문장 그대로, 소리는 짧은 대사 조각만 읽어요.
// VOICE_SPRITES 의 clips 에 [시작초, 끝초]가 있으면 녹음을 틀고, 없으면 기기 목소리로 읽어요.
// 공통 녹음(모든 앱이 같이 씀) + 앱 녹음, 여러 개를 함께 쓸 수 있어요.
const VOICE_SPRITES = [];   // 예: [{ name:'공통', src:'data:audio/mpeg;base64,...', clips:{ '맞아요':[0.0, 0.8] } }]
let VOICES = [], VOICE = null, LAST_AUDIO = [], playToken = 0, curSrc = null;
function cleanSay(t) {
  // 1.2.0: 단위는 우리말로 읽어요 (1L를 '원 엘'로 읽던 것), 동그라미 번호(①②③)는 숫자로 읽어요(전에는 건너뜀)
  t = String(t).replace(/[\u2460-\u2473]/g, c => String(c.charCodeAt(0) - 0x245F)).replace(/\s*(°C|℃)/g, ' 도').replace(/\s*°/g, ' 도').replace(/(^|[^A-Za-z])(cm|mm|km|kg|mL|g|L|m)(?=[^A-Za-z0-9자]|$)/g, (m, a, u) => a + ({ cm: ' 센티미터', mm: ' 밀리미터', km: ' 킬로미터', kg: ' 킬로그램', mL: ' 밀리리터', g: ' 그램', L: ' 리터', m: ' 미터' })[u]).replace(/(\d)\s*mL\b/gi, '$1 밀리리터').replace(/(\d)\s*L\b/g, '$1 리터').replace(/(\d)\s*km\b/g, '$1 킬로미터').replace(/(\d)\s*cm\b/g, '$1 센티미터').replace(/(\d)\s*mm\b/g, '$1 밀리미터')
    .replace(/(\d)\s*kg\b/g, '$1 킬로그램').replace(/(\d)\s*g\b/g, '$1 그램').replace(/(\d)\s*m\b/g, '$1 미터').replace(/(\d)\s*(°C|℃)/g, '$1 도').replace(/(\d)\s*W\b/g, '$1 와트');
  return String(t).replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ')
    .replace(/[~～〜]/g, '').replace(/[→←⇒▶◀›»]/g, ', ').replace(/[·•ㆍ]/g, ', ')
    .replace(/[…]/g, '. ').replace(/[※★☆♪♥#*_|\/\\"'“”‘’「」『』\[\]{}<>]/g, ' ')
    .replace(/[()]/g, ', ').replace(/[\u{1F300}-\u{1FAFF}\u{1F000}-\u{1F2FF}←-⇿⌀-➿⬀-⯿️‍]/gu, '')
    .replace(/\s*,\s*(,\s*)+/g, ', ').replace(/\s+/g, ' ').trim();
}
function voiceScore(v) {
  const n = v.name; let s = 0;
  if (/natural|neural|online/i.test(n)) s += 50;
  if (/google/i.test(n)) s += 30;
  if (/sunhi|injoon|hyunsu|yuna|sora|jimin|seoyeon/i.test(n)) s += 15;
  if (v.localService === false) s += 5;
  return s;
}
function loadVoices() {
  try {
    VOICES = speechSynthesis.getVoices().filter(v => /^ko/i.test(v.lang)).sort((a, b) => voiceScore(b) - voiceScore(a));
    let saved = null; try { saved = localStorage.getItem(VOICE_KEY); } catch (e) {}
    VOICE = VOICES.find(v => v.name === saved) || VOICES[0] || null;
    const sel = document.getElementById('voice-sel');
    if (sel) sel.innerHTML = (VOICE_SPRITES.length ? '<option value="__rec">🎙️ 녹음 목소리</option>' : '') + (VOICES.length ? VOICES.map(v => `<option ${v === VOICE ? 'selected' : ''}>${v.name}</option>`).join('') : '<option>기본 목소리</option>');
  } catch (e) {}
}
function pickVoice(name) { if (name !== '__rec') { VOICE = VOICES.find(v => v.name === name) || VOICE; try { localStorage.setItem(VOICE_KEY, name); } catch (e) {} } playLines(['맞아요']); }
try { loadVoices(); speechSynthesis.onvoiceschanged = loadVoices; } catch (e) {}
async function loadSprite() {
  for (const sp of VOICE_SPRITES) { if (sp.buf || sp.failed) continue; try { const a = ac(); sp.buf = await a.decodeAudioData(await fetch(sp.src).then(r => r.arrayBuffer())); } catch (e) { sp.failed = true; } }
}
const VOICE_ALIAS = {}; // 쉬운 글 → 원래 녹음 문장
function findClip(l) { for (const k of [l, VOICE_ALIAS[l]]) { if (!k) continue; for (const sp of VOICE_SPRITES) if (sp.buf && sp.clips[k]) return [sp.buf, sp.clips[k]]; } return null; }
function stopVoice() { playToken++; try { speechSynthesis.cancel(); } catch (e) {} try { curSrc && curSrc.stop(); } catch (e) {} }
// 녹음 목소리 크기: 녹음 파일을 미리 두 배 정도(+7dB) 키워 두었어요. 더 키우려면 VOICE_GAIN 을 올려요.
const VOICE_GAIN = 1;
let VOUT = null;
function voiceOut() { const a = ac(); if (VOUT && VOUT.context === a) return VOUT; const g = a.createGain(); g.gain.value = VOICE_GAIN; g.connect(a.destination); VOUT = g; return g; }
function playClip([buf, c]) {
  return new Promise(res => { try { const a = ac(); const s = a.createBufferSource(); s.buffer = buf; s.connect(voiceOut()); curSrc = s; s.onended = res; s.start(0, c[0], c[1] - c[0]); } catch (e) { res(); } });
}
function ttsLine(t) {
  return new Promise(res => {
    try {
      const u = new SpeechSynthesisUtterance(cleanSay(t));
      u.lang = 'ko-KR'; if (VOICE) u.voice = VOICE;
      const nat = VOICE && voiceScore(VOICE) >= 30; u.rate = nat ? 1 : .92; u.pitch = nat ? 1 : 1.08;
      let done = false; const fin = () => { if (!done) { done = true; res(); } };
      u.onend = fin; u.onerror = fin; setTimeout(fin, 1500 + t.length * 260);
      speechSynthesis.speak(u);
    } catch (e) { res(); }
  });
}
// lines: 읽을 대사 조각 배열
async function playLines(lines) {
  if (typeof onVoiceUsed === 'function') onVoiceUsed(lines);
  LAST_AUDIO = lines || []; stopVoice();
  if (!soundOn || !lines || !lines.length) return;
  await loadSprite();
  const tok = playToken;
  const cs = lines.map(findClip);
  // 한 번에 읽는 말은 한 목소리로: 녹음이 모두 있으면 녹음, 하나라도 없으면 전체를 기기 목소리로
  if (cs.every(Boolean)) { for (const c of cs) { if (tok !== playToken) return; await playClip(c); } }
  else if (tok === playToken) await ttsLine(lines.join(' '));
}
function sayAgain() { playLines(LAST_AUDIO); }


function sfx(n) {
  if (!soundOn) return; const a = ac(); if (!a) return; const t = a.currentTime;
  if (n === 'good') { tone(523, t, .1, 'triangle', .16); tone(784, t + .08, .18, 'triangle', .16); }
  if (n === 'wrong') { tone(300, t, .2, 'square', .07, 200); }
  if (n === 'clear') { [523, 659, 784, 1047, 1319].forEach((f, i) => tone(f, t + i * .11, .3, 'triangle', .16)); }
  if (n === 'tap') tone(900, t, .05, 'sine', .08);
  if (n === 'bang') { tone(140, t, .12, 'square', .14, 60); }
  if (n === 'buzz') { tone(110, t, .09, 'sawtooth', .05, 115); }
  // 1.2.0: 금고 열리는 소리 — 다이얼 딸깍딸깍, 철컥, 띠링
  if (n === 'safe') { for (let i = 0; i < 9; i++) tone(1400 - i * 60, t + i * .08, .03, 'square', .05); tone(180, t + .78, .1, 'square', .14, 90); tone(260, t + .9, .08, 'square', .12, 120); [784, 1047, 1319].forEach((f, i) => tone(f, t + 1.05 + i * .1, .28, 'triangle', .15)); }
}
let HELPER = 'wol';
function say(html, who, audio) { HELPER = who || HELPER; const c = CHARS[HELPER]; $('hp-img').src = c.img; $('hp-bub').innerHTML = `<span><b style="color:${c.color}">${c.name}:</b> ${html}</span>`; if (audio) playLines(audio); }

// ===================== 도구 그림 (가운데 0,0 / 약 ±100 크기) =====================
const OL = 'stroke="#334155" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"';
const TOOLART = {
  // 1.2.0: 문풍지 — 둘둘 말린 스펀지 띠, 한쪽이 풀려 나온 모습(뒷면 종이는 노랑)
  wstrip: o => `<g transform="scale(1.3) translate(-10,4)">` + `<rect x="-30" y="22" width="104" height="22" rx="4" fill="#f8fafc" ${OL}/><rect x="-30" y="42" width="104" height="7" rx="2" fill="#fbbf24" stroke="#92400e" stroke-width="2"/>` + [0, 1, 2, 3, 4, 5].map(i => `<circle cx="${-14 + i * 16}" cy="33" r="2.5" fill="#cbd5e1"/>`).join('') + `<circle cx="-24" cy="-6" r="52" fill="#f8fafc" ${OL}/><circle cx="-24" cy="-6" r="40" fill="none" stroke="#cbd5e1" stroke-width="3"/><circle cx="-24" cy="-6" r="29" fill="none" stroke="#cbd5e1" stroke-width="3"/><circle cx="-24" cy="-6" r="19" fill="#fde68a" ${OL}/><circle cx="-24" cy="-6" r="9" fill="#fff" stroke="#92400e" stroke-width="2"/></g>`,
  // 1.2.0: 걸레 — 반으로 접은 하늘색 천, 줄무늬와 올 풀린 끝
  rag: o => `<g transform="rotate(-8)"><path d="M-80,-40 Q-40,-52 0,-42 Q40,-32 80,-44 L84,34 Q40,46 0,36 Q-40,26 -82,38 Z" fill="#93c5fd" ${OL}/><path d="M-80,-6 Q-40,-16 0,-6 Q40,4 82,-8" fill="none" stroke="#1d4ed8" stroke-width="4" opacity=".55"/><path d="M-81,16 Q-40,6 0,16 Q40,26 83,14" fill="none" stroke="#1d4ed8" stroke-width="4" opacity=".55"/><path d="M-80,-40 Q-40,-52 0,-42 Q40,-32 80,-44 L80,-28 Q40,-16 0,-26 Q-40,-36 -80,-24 Z" fill="#bfdbfe" ${OL}/>` + [0, 1, 2, 3, 4, 5, 6].map(i => `<line x1="${-70 + i * 22}" y1="${34 - i * 0.6 + (i % 2 ? 2 : -2)}" x2="${-72 + i * 22}" y2="${46 - i * 0.6 + (i % 2 ? 2 : -2)}" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>`).join('') + `</g>`,
  glue: o => `<rect x="-26" y="-50" width="52" height="110" rx="10" fill="#facc15" ${OL}/><rect x="-26" y="10" width="52" height="16" fill="#ef4444"/>` +
    (o.open ? `<rect x="-20" y="${-78 - (o.up || 0)}" width="40" height="${30 + (o.up || 0)}" rx="6" fill="#fff" ${OL}/>` : `<rect x="-30" y="-92" width="60" height="46" rx="10" fill="#ef4444" ${OL}/>`) + `<rect x="-26" y="44" width="52" height="16" rx="4" fill="#ca8a04"/>`,
  scissors: o => { const a = o.open ?? 14, bl = (m) => `<path d="M${-7 * m},6 Q${-9 * m},-40 ${-1 * m},-112 Q${8 * m},-60 ${7 * m},-2 Z" fill="${m < 0 ? '#e2e8f0' : '#cbd5e1'}" stroke="#475569" stroke-width="3" stroke-linejoin="round"/><path d="M${-2 * m},-6 Q${-2 * m},-50 ${-1 * m},-100" stroke="#fff" stroke-width="2" opacity=".8" fill="none"/>`;
    return `<g transform="rotate(${-a / 2})">${bl(-1)}<path d="M4,4 L18,34" stroke="#eab308" stroke-width="12" stroke-linecap="round"/><ellipse cx="26" cy="54" rx="21" ry="27" fill="none" stroke="#eab308" stroke-width="11"/></g><g transform="rotate(${a / 2})">${bl(1)}<path d="M-4,4 L-15,30" stroke="#2563eb" stroke-width="12" stroke-linecap="round"/><ellipse cx="-22" cy="46" rx="15" ry="19" fill="none" stroke="#2563eb" stroke-width="10"/></g><circle r="7" fill="#64748b" stroke="#334155" stroke-width="2"/><circle r="2.5" fill="#e2e8f0"/>`; },
  ruler: o => `<rect x="-110" y="-20" width="220" height="40" rx="5" fill="${o.steel ? '#cbd5e1' : '#fde68a'}" ${OL}/>` + [...Array(21)].map((_, i) => `<line x1="${-100 + i * 10}" y1="-20" x2="${-100 + i * 10}" y2="${i % 5 ? -10 : -2}" stroke="#334155" stroke-width="2"/>`).join(''),
  pencil: o => `<rect x="-90" y="-11" width="150" height="22" fill="#facc15" ${OL}/><rect x="-104" y="-11" width="16" height="22" rx="3" fill="#f9a8d4" ${OL}/><path d="M60,-11 L96,0 L60,11 Z" fill="#fde68a" ${OL}/><path d="M86,-3 L96,0 L86,3 Z" fill="#334155"/>`,
  tape: o => `<path d="M-80,40 Q-90,-40 -20,-60 L60,-60 Q90,-60 90,-20 L90,40 Z" fill="#60a5fa" ${OL}/><circle cx="-10" cy="-10" r="44" fill="#fef9c3" ${OL}/><circle cx="-10" cy="-10" r="20" fill="#93c5fd" ${OL}/><path d="M70,-60 l6,-10 l6,10 l6,-10 l6,10" fill="none" stroke="#64748b" stroke-width="4"/><rect x="-90" y="40" width="190" height="20" rx="6" fill="#1e3a8a"/>`,
  stapler: o => `<rect x="-100" y="20" width="200" height="22" rx="8" fill="#475569" ${OL}/><path d="M-96,${o.press ? 10 : -6} Q-96,-34 -60,-34 L96,${o.press ? 4 : -22} L96,${o.press ? 18 : 2} L-80,18 Z" fill="#ef4444" ${OL}/><circle cx="-80" cy="14" r="7" fill="#94a3b8"/>`,
  punch: o => `<rect x="-100" y="10" width="200" height="40" rx="10" fill="#334155"/><rect x="-90" y="${o.press ? -6 : -40}" width="180" height="22" rx="10" fill="#22c55e" ${OL}/><rect x="-70" y="-14" width="20" height="26" fill="#94a3b8"/><rect x="50" y="-14" width="20" height="26" fill="#94a3b8"/><path d="M-8,50 l8,-12 l8,12 z" fill="#fde047"/>`,
  cutter: o => { const n = o.blade ?? 1; return `<rect x="-90" y="-16" width="130" height="32" rx="8" fill="#f97316" stroke="#334155" stroke-width="3"/><rect x="-80" y="-4" width="110" height="8" rx="3" fill="#c2410c" opacity=".5"/><rect x="${-66 + Math.min(n, 6) * 10}" y="-20" width="24" height="40" rx="5" fill="#334155"/><rect x="38" y="-9" width="4" height="18" fill="#7c2d12"/>` + (n > 0 ? [...Array(n)].map((_, i) => `<path d="M${40 + i * 14},-10 L${54 + i * 14},-10 L${54 + i * 14},10 L${40 + i * 14},10 Z" fill="#cbd5e1" stroke="#64748b" stroke-width="2"/>`).join('') + `<path d="M${40 + n * 14},-10 L${62 + n * 14},-10 L${40 + n * 14},10 Z" fill="#e2e8f0" stroke="#64748b" stroke-width="2"/>` : ''); },
  bond: o => `<path d="M-40,-30 L40,-30 L46,90 L-46,90 Z" fill="#f8fafc" ${OL}/><rect x="-38" y="10" width="76" height="44" fill="#fdba74"/><text x="0" y="38" font-size="18" text-anchor="middle" fill="#7c2d12">목공본드</text><rect x="-18" y="-56" width="36" height="28" rx="6" fill="#f97316" ${OL}/><path d="M-6,-56 L-3,-96 L3,-96 L6,-56 Z" fill="#f97316" ${OL}/>`,
  gluegun: o => `<path d="M-90,-40 L60,-40 Q80,-40 80,-20 L80,0 Q80,10 60,10 L10,10 L-6,90 L-46,90 L-36,10 L-90,10 Z" fill="#3b82f6" ${OL}/><path d="M80,-26 L112,-20 L80,-14 Z" fill="#94a3b8" ${OL}/><rect x="-130" y="-30" width="44" height="20" rx="8" fill="#f1f5f9" ${OL}/><path d="M-20,12 q-10,26 4,40" fill="none" stroke="#1e3a8a" stroke-width="8"/><circle cx="40" cy="-24" r="7" fill="${o.ready ? '#22c55e' : o.warm ? '#f59e0b' : '#ef4444'}"/>`,
  tapemeasure: o => `<rect x="-70" y="-70" width="120" height="120" rx="26" fill="#facc15" ${OL}/><circle cx="-10" cy="-10" r="34" fill="#fde68a" ${OL}/><rect x="50" y="24" width="${60 + (o.out || 0)}" height="20" fill="#fef08a" ${OL}/><rect x="${106 + (o.out || 0)}" y="16" width="8" height="34" fill="#64748b"/><rect x="-40" y="-82" width="30" height="16" rx="4" fill="#ef4444"/>`,
  // 1.2.0: 입체 수평계 — 윗면·옆면 그늘, 양 끝 고무 마개, 유리관 안 물방울
  level: o => `<path d="M-120,-24 L-108,-34 L132,-34 L120,-24 Z" fill="#86efac" stroke="#334155" stroke-width="2.5"/><path d="M120,-24 L132,-34 L132,14 L120,24 Z" fill="#15803d" stroke="#334155" stroke-width="2.5"/><rect x="-120" y="-24" width="240" height="48" rx="4" fill="#22c55e" ${OL}/><rect x="-120" y="-24" width="16" height="48" rx="3" fill="#1f2937"/><rect x="104" y="-24" width="16" height="48" rx="3" fill="#1f2937"/><rect x="-96" y="10" width="192" height="6" rx="3" fill="#16a34a"/><rect x="-40" y="-14" width="80" height="28" rx="14" fill="#d9f99d" ${OL}/><line x1="-14" y1="-14" x2="-14" y2="14" stroke="#334155" stroke-width="2"/><line x1="14" y1="-14" x2="14" y2="14" stroke="#334155" stroke-width="2"/><ellipse cx="${o.bub || 0}" cy="0" rx="11" ry="9" fill="#fff" stroke="#65a30d" stroke-width="2"/>`,
  awl: o => `<path d="M-6,-14 Q-60,-26 -86,0 Q-60,26 -6,14 Z" fill="#b45309" stroke="#334155" stroke-width="3"/>` + [-50, -36, -22].map(x => `<path d="M${x},-17 Q${x - 4},0 ${x},17" stroke="#78350f" stroke-width="2.5" fill="none" opacity=".7"/>`).join('') + `<rect x="-6" y="-9" width="18" height="18" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="3"/><path d="M12,-3.5 L96,-1.5 L110,0 L96,1.5 L12,3.5 Z" fill="#cbd5e1" stroke="#475569" stroke-width="2"/>`,
  sandpaper: o => `<rect x="-80" y="-60" width="160" height="120" rx="6" fill="${o.col || '#d6b98c'}" ${OL}/>` + [...Array(40)].map((_, i) => `<circle cx="${-70 + (i * 37) % 140}" cy="${-50 + (i * 53) % 100}" r="${o.fine ? 1.3 : 2.6}" fill="#7c5a2a"/>`).join('') + (o.grit ? `<text x="0" y="12" font-size="34" text-anchor="middle" fill="#3f2a10">${o.grit}</text>` : ''),
  saw: o => `<path d="M-60,-40 L110,-24 L110,24 L-60,40 Z" fill="#cbd5e1" ${OL}/>` + [...Array(17)].map((_, i) => `<path d="M${-56 + i * 10},${40 - i} l5,8 l5,-8" fill="#94a3b8"/>`).join('') + `<path d="M-60,-46 L-120,-50 Q-136,-50 -136,-30 L-136,30 Q-136,50 -120,50 L-60,46 Z" fill="#b45309" ${OL}/><ellipse cx="-104" cy="0" rx="16" ry="26" fill="#fef3c7" ${OL}/>`,
  hammer: o => `<rect x="-10" y="-40" width="20" height="140" rx="8" fill="#b45309" ${OL}/><path d="M-60,-70 L40,-70 Q60,-70 70,-90 L74,-60 Q60,-36 40,-36 L-60,-36 Z" fill="#64748b" ${OL}/><rect x="-74" y="-74" width="20" height="42" rx="4" fill="#475569" ${OL}/>`,
  nail: o => `<rect x="-26" y="-70" width="52" height="10" rx="3" fill="#94a3b8" ${OL}/><path d="M-6,-60 L6,-60 L4,60 L0,74 L-4,60 Z" fill="#cbd5e1" ${OL}/>`,
  clamp: o => { const w = o.w ?? 60; return `<rect x="-90" y="-80" width="16" height="170" fill="#94a3b8" ${OL}/><rect x="-90" y="-80" width="120" height="24" rx="4" fill="#ef4444" ${OL}/><rect x="-90" y="${-56 + w}" width="120" height="24" rx="4" fill="#ef4444" ${OL}/><rect x="16" y="${-32 + w}" width="10" height="60" fill="#64748b"/><rect x="0" y="${28 + w}" width="44" height="40" rx="10" fill="#1e293b"/>`; },
  driverP: o => `<rect x="-100" y="-20" width="90" height="40" rx="18" fill="#ef4444" ${OL}/><rect x="-10" y="-6" width="96" height="12" fill="#cbd5e1" ${OL}/><path d="M86,-8 L104,0 L86,8 Z" fill="#94a3b8" ${OL}/><text x="-56" y="10" font-size="26" text-anchor="middle" fill="#fff">+</text>`,
  driverM: o => `<rect x="-100" y="-20" width="90" height="40" rx="18" fill="#facc15" ${OL}/><rect x="-10" y="-6" width="96" height="12" fill="#cbd5e1" ${OL}/><rect x="86" y="-10" width="16" height="20" fill="#94a3b8" ${OL}/><text x="-56" y="10" font-size="26" text-anchor="middle" fill="#334155">−</text>`,
  // 1.2.0: 펜치 — 쇠 머리(톱니 턱·자르는 날), 가운데 굴대, 빨간 고무 손잡이 두 개; 턱 끝이 +x
  pliers: o => `<path d="M2,-4 Q-40,-8 -104,-26 L-108,-14 Q-44,4 0,8 Z" fill="#6b7280" ${OL}/><path d="M2,4 Q-40,8 -104,26 L-108,14 Q-44,-4 0,-8 Z" fill="#6b7280" ${OL}/><path d="M-36,-12 L-104,-27 Q-114,-22 -108,-13 L-40,0 Z" fill="#dc2626" ${OL}/><path d="M-36,12 L-104,27 Q-114,22 -108,13 L-40,0 Z" fill="#dc2626" ${OL}/>`
    + `<path d="M-8,-19 Q30,-22 62,-13 L96,-7 Q103,-3 98,1 L-2,1 Z" fill="#9ca3af" ${OL}/><path d="M-8,19 Q30,22 62,13 L96,7 Q103,3 98,-1 L-2,-1 Z" fill="#94a3b8" ${OL}/>` + [0, 1, 2, 3, 4, 5].map(k => `<line x1="${64 + k * 6}" y1="-6" x2="${67 + k * 6}" y2="6" stroke="#4b5563" stroke-width="1.5"/>`).join('') + `<path d="M22,-1 L36,-8 L40,0 L36,8 L22,1" fill="#e5e7eb" stroke="#334155" stroke-width="2"/><circle r="10" fill="#6b7280" stroke="#1f2937" stroke-width="3"/><circle r="4" fill="#d1d5db"/>`,
  nipper: o => `<path d="M-100,-26 Q-40,-30 0,-8 L30,-22 Q60,-22 64,0 L0,-2 Q-40,-8 -100,-8 Z" fill="#ef4444" ${OL}/><path d="M-100,26 Q-40,30 0,8 L30,22 Q60,22 64,0 L0,2 Q-40,8 -100,8 Z" fill="#dc2626" ${OL}/><circle r="8" fill="#94a3b8"/>`,
  spanner: o => `<rect x="-80" y="-12" width="150" height="24" rx="10" fill="#94a3b8" ${OL}/><path d="M70,-30 Q110,-34 112,-12 L92,-8 L92,8 L112,12 Q110,34 70,30 Z" fill="#cbd5e1" ${OL}/><circle cx="-84" cy="0" r="22" fill="#cbd5e1" ${OL}/><text x="0" y="8" font-size="20" text-anchor="middle" fill="#334155">${o.size ? o.size + 'mm' : ''}</text>`,
  // 1.2.0: 몽키스패너 — 손잡이(걸이 구멍), 고정 턱(위), 움직이는 턱(아래), 조절 나사(톱니 원통)
  monkey: o => { const w = o.w ?? 16, h = w / 2; return `<path d="M-104,-9 Q-112,0 -104,9 L24,13 L24,-13 Z" fill="#94a3b8" ${OL}/><circle cx="-95" cy="0" r="4.5" fill="#f8fafc" stroke="#334155" stroke-width="2"/><path d="M-82,-3 L14,-6" stroke="#e2e8f0" stroke-width="3" stroke-linecap="round"/>`
    + `<path d="M18,-14 Q22,-44 54,-44 L100,-44 Q110,-44 105,-33 L97,${-h} L62,${-h} Q56,${-h} 56,${-h + 6} L56,16 L18,16 Z" fill="#cbd5e1" ${OL}/>`
    + `<path d="M56,${h} L97,${h} L101,${h + 8} Q97,${h + 18} 85,${h + 18} L56,${h + 18} Z" fill="#e2e8f0" ${OL}/>`
    + `<rect x="27" y="17" width="27" height="16" rx="5" fill="#94a3b8" ${OL}/>` + [0, 1, 2, 3, 4].map(k => `<line x1="${31 + k * 5}" y1="19" x2="${31 + k * 5}" y2="31" stroke="#334155" stroke-width="1.5"/>`).join(''); },
  // 1.2.0: 육각렌치 — 둥글게 꺾인 ㄱ자 육각 막대, 양 끝에 육각 단면
  hexkey: o => `<path d="M-84,-9 L18,-9 Q39,-9 39,12 L39,84 L21,84 L21,15 Q21,9 15,9 L-84,9 Z" fill="#1f2937" stroke="#0f172a" stroke-width="3" stroke-linejoin="round"/><path d="M-80,-4 L16,-4 Q34,-4 34,14 L34,80" fill="none" stroke="#6b7280" stroke-width="3" stroke-linecap="round"/><polygon points="-84,-9 -92,-5 -92,5 -84,9 -80,5 -80,-5" fill="#4b5563" stroke="#0f172a" stroke-width="2"/><polygon points="21,84 25,92 35,92 39,84 35,80 25,80" fill="#4b5563" stroke="#0f172a" stroke-width="2"/><text x="-30" y="-20" font-size="18" text-anchor="middle" fill="#334155">${o.size ? o.size + 'mm' : ''}</text>`,
  edriver: o => `<path d="M-60,-40 L50,-40 Q66,-40 66,-24 L66,6 L10,6 L0,70 L-40,70 L-30,6 L-60,6 Z" fill="#22c55e" ${OL}/><rect x="66" y="-28" width="24" height="20" fill="#475569"/><rect x="90" y="-22" width="36" height="8" fill="#cbd5e1"/><rect x="-44" y="70" width="48" height="30" rx="6" fill="#1e293b"/><circle cx="-10" cy="-20" r="7" fill="${o.dir === 'ccw' ? '#ef4444' : '#22c55e'}" stroke="#fff" stroke-width="2"/>`,
  drill: o => { const d = o.bit ?? 6; return `<path d="M-80,-50 L50,-50 Q70,-50 70,-30 L70,10 L10,10 L0,90 L-46,90 L-36,10 L-80,10 Z" fill="#f59e0b" ${OL}/><path d="M70,-40 L104,-34 L104,-2 L70,4 Z" fill="#334155" ${OL}/><rect x="104" y="${-18 - d / 2}" width="${o.len ?? 70}" height="${d}" fill="#94a3b8" stroke="#475569" stroke-width="2"/><rect x="-50" y="90" width="60" height="34" rx="6" fill="#1e293b"/><path d="M-6,14 q-10,24 6,34" fill="none" stroke="#7c2d12" stroke-width="9"/>`; },
  silicone: o => `<rect x="-100" y="-24" width="150" height="40" rx="6" fill="#f1f5f9" ${OL}/><path d="M50,-14 L104,-6 L104,0 L50,8 Z" fill="#e2e8f0" ${OL}/><rect x="-130" y="-30" width="40" height="52" fill="#ef4444" ${OL}/><path d="M-120,22 L-110,90 L-80,90 L-96,22 Z" fill="#ef4444" ${OL}/><path d="M-140,-6 L-180,-6" stroke="#64748b" stroke-width="6"/>`,
  board: o => `<rect x="-110" y="-30" width="220" height="60" rx="4" fill="#e2b77c" ${OL}/><path d="M-100,-12 q60,-8 200,0 M-100,10 q80,8 200,0" fill="none" stroke="#a16207" stroke-width="2" opacity=".5"/>`,
  dowel: o => `<rect x="-90" y="-${(o.d || 8) * 1.5}" width="180" height="${(o.d || 8) * 3}" rx="${(o.d || 8) * 1.5}" fill="#e7c48d" ${OL}/>`,
  screw: o => `<circle r="26" fill="#cbd5e1" ${OL}/>` + (o.head === 'm' ? `<rect x="-20" y="-4" width="40" height="8" fill="#475569"/>` : `<rect x="-18" y="-4" width="36" height="8" fill="#475569"/><rect x="-4" y="-18" width="8" height="36" fill="#475569"/>`),
  nut: o => `<polygon points="${[...Array(6)].map((_, i) => `${32 * Math.cos(i * Math.PI / 3)},${32 * Math.sin(i * Math.PI / 3)}`).join(' ')}" fill="#94a3b8" ${OL}/><circle r="13" fill="#475569"/>`,
  wire: o => `<path d="M-100,0 L100,0" stroke="#b45309" stroke-width="8" stroke-linecap="round"/>`,
  paper: o => `<rect x="-90" y="-64" width="180" height="128" fill="#fff" ${OL}/><line x1="-70" y1="-30" x2="70" y2="-30" stroke="#cbd5e1" stroke-width="3"/><line x1="-70" y1="0" x2="70" y2="0" stroke="#cbd5e1" stroke-width="3"/><line x1="-70" y1="30" x2="40" y2="30" stroke="#cbd5e1" stroke-width="3"/>`,
};
const EMOTOOL = { finger: '👆', goggles: '🥽', gloves: '🧤', mask: '😷', plug: '🔌', battery: '🔋', box: '📦', key: '🗝️' };
const TOOLNAME = { glue: '딱풀', scissors: '가위', ruler: '자', pencil: '연필', tape: '테이프 커터', stapler: '스테이플러', punch: '펀치', cutter: '커터칼', bond: '목공본드', gluegun: '글루건', tapemeasure: '줄자', level: '수평계', awl: '송곳', sandpaper: '사포', saw: '톱', hammer: '망치', nail: '못', clamp: '클램프', driverP: '십자 드라이버', driverM: '일자 드라이버', pliers: '펜치', nipper: '니퍼', spanner: '스패너', monkey: '몽키스패너', hexkey: '육각렌치', edriver: '전동 드라이버', drill: '전동 드릴', silicone: '실리콘건', goggles: '보안경', gloves: '장갑', mask: '마스크', board: '나무 판자', dowel: '나무못', screw: '나사', nut: '너트', wire: '철사', paper: '종이' };

Object.assign(TOOLART, {
  caliper: o => { const w = o.w ?? 40; return `<rect x="-100" y="-30" width="210" height="26" fill="#cbd5e1" ${OL}/>` + [...Array(20)].map((_, i) => `<line x1="${-90 + i * 10}" y1="-30" x2="${-90 + i * 10}" y2="${i % 5 ? -22 : -16}" stroke="#334155" stroke-width="1.5"/>`).join('') + `<path d="M-100,-4 L-100,70 L-84,70 L-84,-4 Z" fill="#94a3b8" ${OL}/><path d="M-100,-30 L-100,-60 L-90,-60 L-90,-30 Z" fill="#94a3b8" ${OL}/><g transform="translate(${-84 + w},0)"><rect x="0" y="-36" width="44" height="40" rx="4" fill="#e2e8f0" ${OL}/><path d="M0,-4 L0,70 L16,70 L16,-4 Z" fill="#94a3b8" ${OL}/><path d="M0,-36 L0,-60 L10,-60 L10,-36 Z" fill="#94a3b8" ${OL}/></g>`; },
  square: o => `<path d="M-90,-80 L-60,-80 L-60,60 L100,60 L100,90 L-90,90 Z" fill="#cbd5e1" ${OL}/><rect x="-100" y="-80" width="44" height="170" rx="4" fill="#b45309" ${OL}/>` + [...Array(14)].map((_, i) => `<line x1="${-50 + i * 11}" y1="60" x2="${-50 + i * 11}" y2="${i % 5 ? 68 : 74}" stroke="#334155" stroke-width="1.5"/>`).join(''),
  sander: o => `<rect x="-90" y="20" width="180" height="40" rx="8" fill="#334155" ${OL}/><rect x="-86" y="56" width="172" height="12" fill="#d6b98c"/><path d="M-70,20 L-60,-30 Q-40,-60 20,-60 L60,-60 Q80,-60 80,-40 L80,20 Z" fill="#facc15" ${OL}/><rect x="-10" y="-80" width="70" height="26" rx="12" fill="#1e293b"/>`,
  brush: o => `<rect x="-100" y="-12" width="110" height="24" rx="10" fill="#b45309" ${OL}/><rect x="10" y="-20" width="26" height="40" fill="#cbd5e1" ${OL}/><path d="M36,-24 L100,-28 L100,28 L36,24 Z" fill="${o.col || '#f1f5f9'}" ${OL}/>`,
  roller: o => `<rect x="-30" y="-80" width="120" height="44" rx="20" fill="${o.col || '#bae6fd'}" ${OL}/><path d="M30,-36 L30,-10 L-10,-10 L-10,90" fill="none" stroke="#64748b" stroke-width="8"/><rect x="-24" y="60" width="28" height="44" rx="10" fill="#ef4444" ${OL}/>`,
  mcup: o => `<path d="M-60,-70 L60,-70 L50,80 L-50,80 Z" fill="rgba(224,242,254,.7)" ${OL}/><path d="M60,-40 q40,10 30,60 q-6,20 -34,22" fill="none" stroke="#334155" stroke-width="8"/>` + [0, 1, 2, 3].map(i => `<line x1="-50" y1="${60 - i * 36}" x2="-28" y2="${60 - i * 36}" stroke="#1e3a8a" stroke-width="3"/>`).join(''),
  spoon: o => `<ellipse cx="-50" cy="0" rx="44" ry="30" fill="#e2e8f0" ${OL}/><rect x="-8" y="-8" width="110" height="16" rx="8" fill="#cbd5e1" ${OL}/>`,
  kscale: o => `<rect x="-100" y="-10" width="200" height="80" rx="16" fill="#f1f5f9" ${OL}/><rect x="-110" y="-30" width="220" height="20" rx="8" fill="#cbd5e1" ${OL}/><rect x="-50" y="10" width="100" height="36" rx="6" fill="#14532d"/><text x="0" y="36" font-size="24" text-anchor="middle" fill="#bbf7d0" font-family="monospace">${o.val ?? 0}g</text><circle cx="72" cy="40" r="10" fill="#ef4444"/>`,
  // 1.2.0: 믹싱 볼 — 반죽을 섞는 스테인리스 그릇
  bowl: o => `<ellipse cx="0" cy="-30" rx="92" ry="20" fill="#e2e8f0" stroke="#334155" stroke-width="4"/><path d="M-92,-30 Q-86,50 0,56 Q86,50 92,-30 A92,20 0 0,1 -92,-30 Z" fill="#cbd5e1" stroke="#334155" stroke-width="4"/><path d="M-70,-8 Q-62,36 -14,44" fill="none" stroke="#f8fafc" stroke-width="8" stroke-linecap="round" opacity=".8"/><ellipse cx="0" cy="-30" rx="78" ry="14" fill="#94a3b8"/><ellipse cx="0" cy="58" rx="40" ry="8" fill="#94a3b8" stroke="#334155" stroke-width="3"/>`,
  // 1.2.0: 계량스푼 위를 깎는 젓가락(뭉툭한 나무 젓가락 한 짝)
  chopstick: o => `<path d="M-150,-9 L110,-3 Q114,0 110,3 L-150,9 Q-154,0 -150,-9 Z" fill="#d6a35c" stroke="#78350f" stroke-width="2.5" stroke-linejoin="round"/><path d="M-140,-4 L100,-1" stroke="#f3d9a6" stroke-width="2" stroke-linecap="round"/><path d="M-150,-9 L-100,-7.5 L-100,7.5 L-150,9 Z" fill="#92400e" opacity=".55"/>`,
  knife: o => `<path d="M-14,-16 L84,-16 Q116,-14 124,-6 Q96,16 60,16 L-14,16 Z" fill="#e2e8f0" stroke="#475569" stroke-width="3" stroke-linejoin="round"/><path d="M-10,10 L62,12 Q96,10 118,-4" stroke="#fff" stroke-width="3" fill="none" opacity=".9"/><rect x="-24" y="-18" width="12" height="36" rx="3" fill="#94a3b8" stroke="#334155" stroke-width="2"/><rect x="-110" y="-15" width="88" height="30" rx="12" fill="#1e293b" stroke="#0f172a" stroke-width="2"/>` + [-92, -68, -44].map(x => `<circle cx="${x}" cy="0" r="4" fill="#cbd5e1"/>`).join(''),
  peeler: o => `<rect x="-100" y="-14" width="110" height="28" rx="12" fill="#22c55e" ${OL}/><path d="M10,-8 L40,-30 L100,-30 L100,30 L40,30 L10,8" fill="none" stroke="#64748b" stroke-width="6"/><rect x="50" y="-6" width="44" height="12" fill="#cbd5e1" ${OL}/>`,
  pan: o => `<ellipse cx="-20" cy="0" rx="80" ry="40" fill="#334155" ${OL}/><ellipse cx="-20" cy="-4" rx="66" ry="30" fill="#475569"/><rect x="58" y="-8" width="80" height="16" rx="8" fill="#1e293b"/>`,
  turner: o => `<rect x="-100" y="-8" width="120" height="16" rx="8" fill="#1e293b"/><rect x="20" y="-34" width="80" height="68" rx="10" fill="#f97316" ${OL}/>` + [0, 1, 2].map(i => `<rect x="${36 + i * 20}" y="-22" width="8" height="44" rx="4" fill="#fdba74"/>`).join(''),
  microwave: o => `<rect x="-110" y="-70" width="220" height="140" rx="14" fill="#e2e8f0" ${OL}/><rect x="-96" y="-56" width="140" height="112" rx="8" fill="#334155"/><rect x="56" y="-56" width="42" height="26" rx="4" fill="#14532d"/><text x="77" y="-37" font-size="15" text-anchor="middle" fill="#bbf7d0" font-family="monospace">${o.t || '0:00'}</text>` + [0, 1, 2].map(i => `<circle cx="77" cy="${-6 + i * 22}" r="8" fill="#94a3b8"/>`).join(''),
});
Object.assign(TOOLNAME, { bowl: '믹싱 볼', chopstick: '젓가락', caliper: '캘리퍼스', square: '직각자', sander: '전동 샌더', brush: '붓', roller: '롤러', mcup: '계량컵', spoon: '계량스푼', kscale: '주방 저울', knife: '칼', peeler: '필러(감자칼)', pan: '프라이팬', turner: '뒤집개', microwave: '전자레인지' });

Object.assign(TOOLART, {
  claw: o => `<rect x="-10" y="-40" width="20" height="140" rx="8" fill="#b45309" ${OL}/><path d="M-40,-72 L30,-72 Q52,-72 66,-96 L72,-88 Q66,-58 56,-50 L66,-30 L56,-26 L40,-40 L-40,-40 Z" fill="#64748b" ${OL}/><rect x="-62" y="-76" width="24" height="40" rx="4" fill="#475569" ${OL}/>`,
  mallet: o => `<rect x="-9" y="-30" width="18" height="130" rx="8" fill="#d6a76c" ${OL}/><rect x="-70" y="-78" width="140" height="56" rx="18" fill="#1f2937" ${OL}/><rect x="-70" y="-78" width="26" height="56" rx="10" fill="#f8fafc" ${OL}/>`,
  sledge: o => `<rect x="-10" y="-40" width="20" height="140" rx="8" fill="#92400e" ${OL}/><rect x="-66" y="-80" width="132" height="44" rx="6" fill="#475569" ${OL}/><rect x="-74" y="-84" width="16" height="52" rx="3" fill="#334155"/><rect x="58" y="-84" width="16" height="52" rx="3" fill="#334155"/>`,
  chisel: o => `<rect x="-14" y="-90" width="28" height="70" rx="8" fill="#b45309" ${OL}/><path d="M-10,-20 L10,-20 L10,70 L0,90 L-10,70 Z" fill="#94a3b8" ${OL}/>`,
  beaker: o => { const v = o.v ?? 0, m = o.max ?? 500; return `<path d="M-60,-90 L60,-90 L60,90 Q60,100 50,100 L-50,100 Q-60,100 -60,90 Z" fill="rgba(224,242,254,.6)" ${OL}/><rect x="-58" y="${100 - v / m * 170}" width="116" height="${v / m * 170}" fill="#60a5fa" opacity=".8"/>` + [1, 2, 3, 4, 5].map(i => `<line x1="-60" y1="${100 - i * 34}" x2="-36" y2="${100 - i * 34}" stroke="#1e3a8a" stroke-width="3"/>`).join(''); },
  thermo: o => `<rect x="-14" y="-100" width="28" height="160" rx="14" fill="#fff" ${OL}/><circle cx="0" cy="76" r="26" fill="#ef4444" ${OL}/><rect x="-6" y="${60 - (o.h ?? 80)}" width="12" height="${(o.h ?? 80) + 20}" fill="#ef4444"/>` + [0, 1, 2, 3, 4].map(i => `<line x1="14" y1="${40 - i * 30}" x2="30" y2="${40 - i * 30}" stroke="#334155" stroke-width="3"/>`).join(''),
  protractor: o => `<path d="M-100,40 A100,100 0 0,1 100,40 Z" fill="rgba(254,240,138,.85)" ${OL}/>` + [...Array(19)].map((_, i) => { const a = Math.PI - i * Math.PI / 18; return `<line x1="${100 * Math.cos(a)}" y1="${40 - 100 * Math.sin(a)}" x2="${(i % 3 ? 88 : 80) * Math.cos(a)}" y2="${40 - (i % 3 ? 88 : 80) * Math.sin(a)}" stroke="#713f12" stroke-width="2"/>`; }).join('') + `<circle cx="0" cy="40" r="5" fill="#713f12"/>`,
  dscale: o => `<circle r="80" fill="#f1f5f9" ${OL}/><circle r="62" fill="#fff" stroke="#94a3b8" stroke-width="3"/><line x1="0" y1="0" x2="${44 * Math.cos(((o.a ?? 0) - 90) * Math.PI / 180)}" y2="${44 * Math.sin(((o.a ?? 0) - 90) * Math.PI / 180)}" stroke="#ef4444" stroke-width="5"/><rect x="-90" y="-110" width="180" height="20" rx="6" fill="#94a3b8" ${OL}/>`,
  mwicon: o => `<rect x="-60" y="-50" width="120" height="100" rx="14" fill="#fff" stroke="#16a34a" stroke-width="6"/><rect x="-42" y="-30" width="64" height="50" rx="6" fill="none" stroke="#16a34a" stroke-width="5"/>` + [0, 1, 2].map(i => `<path d="M${-30 + i * 18},-18 q6,8 0,16 q-6,8 0,16" fill="none" stroke="#16a34a" stroke-width="4"/>`).join('') + `<circle cx="40" cy="-14" r="5" fill="#16a34a"/><circle cx="40" cy="6" r="5" fill="#16a34a"/>`,
});
Object.assign(TOOLNAME, { claw: '장도리', mallet: '고무망치', sledge: '쇠망치', chisel: '정(끌)', beaker: '눈금 실린더', thermo: '온도계', protractor: '각도기', dscale: '바늘 저울', mwicon: '전자레인지 사용 가능 표시' });

const TIMG = {"awl": "data:image/webp;base64,", "beaker": "data:image/webp;base64,", "bond": "data:image/webp;base64,", "brush": "data:image/webp;base64,", "caliper": "data:image/webp;base64,", "chisel": "data:image/webp;base64,", "clamp": "data:image/webp;base64,", "claw": "data:image/webp;base64,", "cutter": "data:image/webp;base64,", "drill": "data:image/webp;base64,", "driverP": "data:image/webp;base64,", "edriver": "data:image/webp;base64,", "glue": "data:image/webp;base64,", "gluegun": "data:image/webp;base64,", "hexkey": "data:image/webp;base64,", "knife": "data:image/webp;base64,", "kscale": "data:image/webp;base64,", "level": "data:image/webp;base64,", "mallet": "data:image/webp;base64,", "mcup": "data:image/webp;base64,", "microwave": "data:image/webp;base64,", "monkey": "data:image/webp;base64,", "nipper": "data:image/webp;base64,", "pan": "data:image/webp;base64,", "peeler": "data:image/webp;base64,", "pencil": "data:image/webp;base64,", "pliers": "data:image/webp;base64,", "protractor": "data:image/webp;base64,", "punch": "data:image/webp;base64,", "roller": "data:image/webp;base64,", "ruler": "data:image/webp;base64,", "sander": "data:image/webp;base64,", "sandpaper": "data:image/webp;base64,", "saw": "data:image/webp;base64,", "scissors": "data:image/webp;base64,", "silicone": "data:image/webp;base64,", "sledge": "data:image/webp;base64,", "spanner": "data:image/webp;base64,", "spoon": "data:image/webp;base64,", "square": "data:image/webp;base64,", "stapler": "data:image/webp;base64,", "tape": "data:image/webp;base64,", "tapemeasure": "data:image/webp;base64,", "thermo": "data:image/webp;base64,", "turner": "data:image/webp;base64,", "hammer": "data:image/webp;base64,"}, TBB = {"glue":[-30,-92,60,152],"scissors":[-45,-117,101,198],"ruler":[-110,-20,220,40],"pencil":[-104,-11,200,22],"tape":[-90,-70,190,130],"stapler":[-100,-34,200,76],"punch":[-100,-40,200,90],"cutter":[-90,-20,166,40],"bond":[-46,-96,92,186],"gluegun":[-130,-40,242,130],"tapemeasure":[-70,-82,184,132],"level":[-120,-24,240,48],"awl":[-86,-18,196,36],"sandpaper":[-80,-60,160,120],"saw":[-136,-50,250,100],"hammer":[-74,-90,148,190],"nail":[-26,-70,52,144],"clamp":[-90,-80,134,208],"driverP":[-100,-20,204,40],"driverM":[-100,-20,202,40],"pliers":[-114,-28,216,56],"nipper":[-100,-27,164,53],"spanner":[-106,-31,218,61],"monkey":[-90,-30,180,62],"hexkey":[-90,-10,130,100],"edriver":[-60,-40,186,140],"drill":[-80,-50,254,174],"silicone":[-180,-30,284,120],"board":[-110,-30,220,60],"dowel":[-90,-12,180,24],"screw":[-26,-26,52,52],"nut":[-32,-28,64,55],"wire":[-100,0,200,0],"paper":[-90,-64,180,128],"caliper":[-100,-60,210,130],"square":[-100,-80,200,170],"sander":[-90,-80,180,148],"brush":[-100,-28,200,56],"roller":[-30,-80,120,184],"mcup":[-60,-70,152,150],"spoon":[-94,-30,196,60],"kscale":[-110,-30,220,100],"knife":[-110,-18,234,36],"peeler":[-100,-30,200,60],"pan":[-100,-40,238,80],"turner":[-100,-34,200,68],"microwave":[-110,-70,220,140],"claw":[-62,-96,134,196],"mallet":[-70,-78,140,178],"sledge":[-74,-84,148,184],"chisel":[-14,-90,28,180],"beaker":[-60,-90,120,190],"thermo":[-26,-100,56,202],"protractor":[-100,-60,200,105],"dscale":[-90,-110,180,190],"mwicon":[-60,-50,120,100]};
const timgOK = (k, o) => TIMG[k] && Object.keys(o).every(key => !TOOLART[k].toString().includes('o.' + key));
function tool(k, x = 0, y = 0, s = 1, rot = 0, o = {}) {
  if (timgOK(k, o)) { const b = TBB[k]; return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><image href="${TIMG[k]}" x="${b[0] - 4}" y="${b[1] - 4}" width="${b[2] + 8}" height="${b[3] + 8}" preserveAspectRatio="xMidYMid meet"/></g>`; }
  if (EMOTOOL[k]) return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><text x="0" y="0" font-size="150" text-anchor="middle" dominant-baseline="central" style="font-family:var(--emo)">${EMOTOOL[k]}</text></g>`;
  return `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})">${TOOLART[k](o)}</g>`;
}


