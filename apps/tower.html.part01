const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
function bg(s) { return s.bg ? BG[s.bg](s) : `<rect width="860" height="520" fill="#faf5ff"/><rect y="400" width="860" height="120" fill="#ede9fe"/>`; }
const BG = {
  desk: () => `<rect width="860" height="520" fill="#f5f3ff"/><rect y="330" width="860" height="190" fill="#d6a76c"/><rect y="330" width="860" height="12" fill="#b45309"/>`,
  bench: () => `<rect width="860" height="520" fill="#fef3c7"/><rect y="350" width="860" height="170" fill="#a16207"/><rect y="350" width="860" height="14" fill="#78350f"/>` + [...Array(6)].map((_, i) => `<rect x="${40 + i * 140}" y="40" width="90" height="60" rx="8" fill="#fde68a" opacity=".6"/>`).join(''),
  wall: () => `<rect width="860" height="520" fill="#e0f2fe"/><rect y="440" width="860" height="80" fill="#cbd5e1"/>` + [...Array(9)].map((_, i) => `<line x1="${i * 100}" y1="0" x2="${i * 100}" y2="440" stroke="#bae6fd" stroke-width="2"/>`).join(''),
  bath: () => `<rect width="860" height="520" fill="#ecfeff"/>` + [...Array(12)].map((_, i) => [...Array(8)].map((_, j) => `<rect x="${i * 72}" y="${j * 66}" width="70" height="64" fill="#fff" stroke="#a5f3fc" stroke-width="2"/>`).join('')).join(''),
  kitchen: () => `<rect width="860" height="520" fill="#fff7ed"/><rect y="330" width="860" height="190" fill="#e7e5e4"/><rect y="330" width="860" height="12" fill="#a8a29e"/>` + [...Array(7)].map((_, i) => `<rect x="${30 + i * 120}" y="40" width="100" height="70" rx="8" fill="#fed7aa" opacity=".6"/>`).join(''),
  room: () => `<rect width="860" height="520" fill="#ede9fe"/><rect y="390" width="860" height="130" fill="#c4b5fd"/>`,
};

// ===================== 조작 종류 =====================
// 각 종류: init(s) → 상태, draw(s, V, G) → SVG, down/move/up(p), act(name), tick(dt)
const P = {};
let S = null, V = null, G = 0, DONE = false, BUSY = false;
function pass(msg) { if (DONE) return; DONE = true; V.active = false; sfx('good'); redraw(); stepDone(msg); }
function fail(msg, keep) { if (DONE) return; sfx('wrong'); MISS++; ERR++; V.active = false; $('vis').classList.remove('shake'); void $('vis').offsetWidth; $('vis').classList.add('shake'); showFail(msg); if (!keep && P[S.type].reset) P[S.type].reset(S, V); redraw(); }

// 1. 고르기
P.choice = {
  init: s => ({ off: {} }),
  draw: (s, V, G) => {
    let o = bg(s); const n = s.opts.length, ph = !s.pic && !s.img && !s.snd && s.opts.every(o => o.photo), w = ph ? 860 / n - 14 : Math.min(250, 780 / n - 20), gap = 860 / n;
    if (s.pic) o += s.pic(V, G);
    if (s.img) o += `<rect x="${430 - 142}" y="8" width="284" height="284" rx="22" fill="#fff" stroke="#c4b5fd" stroke-width="4"/><image href="${IMG[s.img]}" x="${430 - 136}" y="14" width="272" height="272" preserveAspectRatio="xMidYMid slice" clip-path="inset(0 round 18px)"/>`;
    if (s.snd) o += `<g data-act="snd" style="cursor:pointer"><circle cx="430" cy="140" r="96" fill="#7c3aed" stroke="#fff" stroke-width="8"/>${em(430, 140, 96, '🔊')}</g>` + tx(430, 262, 22, '눌러서 다시 들어요', '#4c1d95');
    const hp = s.pic || s.img || s.snd, y0 = hp ? 300 : 120, h = hp ? 190 : 300;
    s.opts.forEach((op, i) => {
      const x = gap * i + gap / 2, ok = DONE && i === s.a, gl = G >= 4 && i === s.a && !DONE, off = V.off[i] || (G >= 3 && !DONE && i !== s.a && i === s.elim);
      o += `<g data-act="opt:${i}" style="cursor:pointer" opacity="${off ? .3 : 1}" ${gl ? 'class="glow"' : ''}><rect x="${x - w / 2}" y="${y0 + 6}" width="${w}" height="${h}" rx="22" fill="rgba(76,29,149,.2)"/><rect x="${x - w / 2}" y="${y0}" width="${w}" height="${h}" rx="22" fill="${ok ? '#dcfce7' : '#fff'}" stroke="${ok ? '#22c55e' : gl ? '#facc15' : '#c4b5fd'}" stroke-width="${gl ? 8 : 4}"/>`;
      const icy = y0 + h * .4;
      if (s.bitPic && BITART[op.t]) op = Object.assign({}, op, { svg: `<g transform="translate(-4,6) scale(1.15)">${BITART[op.t]}</g>`, img: null, k: null, txt: null });
      if (op.img && !IMG[op.img]) op = Object.assign({}, op, { img: null });
      if (op.k && !op.img && !op.svg && IMG['c_k_' + op.k] && !op.r) op = Object.assign({}, op, { img: 'c_k_' + op.k, k: null });
      if (ph && op.img) { const iw = w - 12, ih = Math.min(h * .7, iw / 1.25); o += `<image href="${IMG[op.img]}" x="${x - iw / 2}" y="${y0 + 8}" width="${iw}" height="${ih}" preserveAspectRatio="xMidYMid slice" clip-path="inset(0 round 14px)"/>`; }
      else if (op.img) { const iw = hp ? 110 : 190; o += `<image href="${IMG[op.img]}" x="${x - iw / 2}" y="${icy - iw / 2 - (hp ? 4 : 10)}" width="${iw}" height="${iw}" preserveAspectRatio="xMidYMid ${op.obj ? 'meet' : 'slice'}"/>`; }
      else if (op.svg) o += `<g transform="translate(${x},${icy}) scale(${hp ? .7 : 1})">${op.svg}</g>`;
      else if (op.k) o += tool(op.k, x, icy, (op.s || .62) * (hp ? .7 : 1), op.r || 0, op.o || {}); else if (op.e && !op.txt) o += em(x, icy, hp ? 60 : 84, op.e);
      if (op.txt && !op.img && !op.k && !op.svg) o += `<foreignObject x="${x - w / 2 + 10}" y="${y0 + 10}" width="${w - 20}" height="${h - 20}"><div xmlns="http://www.w3.org/1999/xhtml" style="height:100%;display:flex;align-items:center;justify-content:center;font:bold ${op.t.length > 24 ? 20 : op.t.length > 12 ? 24 : op.t.length > 6 ? 30 : 40}px var(--font);color:#1e1b4b;text-align:center;line-height:1.25;word-break:keep-all">${op.t}</div></foreignObject></g>`;
      else o += `<foreignObject x="${x - w / 2 + 8}" y="${y0 + h * .72}" width="${w - 16}" height="${h * .28}"><div xmlns="http://www.w3.org/1999/xhtml" style="font:${op.t.length > 14 ? 18 : 22}px var(--font);color:#1e1b4b;text-align:center;line-height:1.2;word-break:keep-all">${op.t}</div></foreignObject></g>`;
    });
    return o;
  },
  act: (a) => { if (a === 'snd') { playSnd(S.snd); return; } if (!a.startsWith('opt:')) return; const i = +a.slice(4); if (i === S.a || S.opts[i].good) pass(S.opts[i].okMsg); else { V.off[i] = 1; fail(S.opts[i].no || S.no, true); } } // 1.2.0: good 표시가 있는 보기는 모두 정답
};
// 2. 순서대로 누르기
P.order = {
  // 1.2.0: s.grp = 순위 배열 — 같은 순위끼리는 순서가 바뀌어도 정답 (예: [0, 0, 1, 2])
  ok: (s, V, i) => !V.got.includes(i) && s.items.every((_, j) => V.got.includes(j) || (s.grp ? s.grp[j] >= s.grp[i] : j >= i)),
  // 1.2.0: 카드는 시작할 때마다 섞어요 — 늘 같은 자리면 자리만 외워서 풀려요. 정답 차례 그대로이거나 첫 카드가 맨 앞이면 다시 섞어요
  init: s => { const n = s.items.length, first = s.grp ? s.items.map((_, i) => i).filter(i => s.grp[i] === Math.min(...s.grp)) : [0]; let mix, k = 0;
    do { mix = s.items.map((_, i) => i); for (let i = n - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)), t = mix[i]; mix[i] = mix[j]; mix[j] = t; } k++; }
    while (k < 30 && (first.includes(mix[0]) || mix.every((v, i) => v === i)));
    return { got: [], mix }; },
  reset: (s, V) => { V.got = []; },
  draw: (s, V, G) => {
    let o = bg(s); const n = V.mix.length, cols = n > 4 ? 3 : n, rows = Math.ceil(n / cols), w = Math.min(250, 860 / cols - 18), h = rows > 1 ? 190 : 260;
    V.mix.forEach((it, j) => {
      const c = j % cols, r = Math.floor(j / cols), x = 860 / cols * c + 430 / cols, y = 40 + r * (h + 24) + (rows > 1 ? 0 : 60), I = s.items[it], k = V.got.indexOf(it), nx = P.order.ok(s, V, it) && G >= 4;
      o += `<g data-act="ord:${it}" style="cursor:pointer" ${nx ? 'class="glow"' : ''}><rect x="${x - w / 2}" y="${y}" width="${w}" height="${h}" rx="22" fill="${k >= 0 ? '#dcfce7' : '#fff'}" stroke="${nx ? '#facc15' : k >= 0 ? '#22c55e' : '#c4b5fd'}" stroke-width="${nx ? 8 : 4}"/>` + (I.img && IMG[I.img] ? `<image href="${IMG[I.img]}" x="${x - w / 2 + 8}" y="${y + 8}" width="${w - 16}" height="${h * .62}" preserveAspectRatio="xMidYMid ${I.obj ? 'meet' : 'slice'}" clip-path="inset(0 round 14px)"/>` : I.k ? tool(I.k, x, y + h * .38, .5, 0, I.o || {}) : I.txt ? '' : em(x, y + h * .38, 64, I.e)) +
        `<foreignObject x="${x - w / 2 + 8}" y="${y + h * .68}" width="${w - 16}" height="${h * .32}"><div xmlns="http://www.w3.org/1999/xhtml" style="font:20px var(--font);color:#1e1b4b;text-align:center;line-height:1.2;word-break:keep-all">${I.t}</div></foreignObject>` + (k >= 0 ? badge(x - w / 2 + 22, y + 22, k + 1, '#22c55e', 18) : (G >= 3 && P.order.ok(s, V, it) ? badge(x - w / 2 + 22, y + 22, '?', '#f97316', 18) : '')) + `</g>`;
      // 1.2.0: 순서를 다 맞추면 마지막 카드가 뒤집히며 숫자가 나와요
      if (s.flip && DONE && it === V.got[V.got.length - 1]) o += `<style>@keyframes flipIn{0%{transform:scaleX(0)}100%{transform:scaleX(1)}}</style><g style="transform-box:fill-box;transform-origin:center;animation:flipIn .7s ease-out"><rect x="${x - w / 2}" y="${y}" width="${w}" height="${h}" rx="22" fill="#fde68a" stroke="#d97706" stroke-width="6"/><rect x="${x - w / 2 + 14}" y="${y + 14}" width="${w - 28}" height="${h - 28}" rx="14" fill="none" stroke="#f59e0b" stroke-width="3" stroke-dasharray="10 6"/>` + tx(x, y + h * .28, 22, '숨은 숫자', '#92400e') + tx(x, y + h * .62, Math.min(120, h * .5), s.give, '#7c2d12', 'font-weight="bold"') + `</g>`;
    });
    return o;
  },
  act: a => { if (!a.startsWith('ord:')) return; const i = +a.slice(4); if (V.got.includes(i)) return; if (P.order.ok(S, V, i)) { V.got.push(i); sfx('tap'); if (V.got.length === S.items.length) pass(); else redraw(); } else fail(S.no || `${V.got.length + 1}번째로 할 일이 아니에요.`); }
};
// 3. 선 따라 자르기·긋기
function pathLen(pts) { let L = [0]; for (let i = 1; i < pts.length; i++) L.push(L[i - 1] + dist(pts[i - 1], pts[i])); return L; }
function nearOnPath(pts, L, p) { let best = [1e9, 0]; for (let i = 1; i < pts.length; i++) { const a = pts[i - 1], b = pts[i], dx = b[0] - a[0], dy = b[1] - a[1], l2 = dx * dx + dy * dy, t = clamp(((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / l2, 0, 1), q = [a[0] + t * dx, a[1] + t * dy], d = dist(p, q); if (d < best[0]) best = [d, L[i - 1] + t * Math.sqrt(l2)]; } return best; }
function ptAt(pts, L, s) { for (let i = 1; i < pts.length; i++) if (L[i] >= s) { const t = (s - L[i - 1]) / (L[i] - L[i - 1] || 1); return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * t, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * t]; } return pts[pts.length - 1]; }
P.cut = {
  init: s => ({ L: pathLen(s.path), prog: 0, active: false, trav: 0, last: null, cur: s.path[0] }),
  reset: (s, V) => { V.active = false; },
  draw: (s, V, G) => {
    let o = bg(s); const tol = s.tol * (G >= 4 ? 1.8 : 1), tot = V.L[V.L.length - 1], pd = 'M' + s.path.map(p => p.join(',')).join(' L');
    o += s.mat ? MAT[s.mat](s, V) : '';
    if (s.pic) o += s.pic(V, G);
    // 1.2.0: 눈금 숫자가 있는 자 — 0이 선의 시작점에 오도록 (s.rcm = 선 길이 cm)
    if (s.guide === 'ruler' && s.rcm) { const a = s.path[0], b = s.path[s.path.length - 1], ang = Math.atan2(b[1] - a[1], b[0] - a[0]) * 180 / Math.PI, L = dist(a, b), k = L / s.rcm, n = s.rcm + 2, x0 = -L / 2;
      let r = `<rect x="${x0 - 24}" y="-24" width="${n * k + 48}" height="48" rx="5" fill="#fde68a" ${OL}/>`;
      for (let i = 0; i <= n * 10; i++) { const x = x0 + i * k / 10, h = i % 10 ? (i % 5 ? 7 : 11) : 16; r += `<line x1="${x}" y1="24" x2="${x}" y2="${24 - h}" stroke="#334155" stroke-width="${i % 10 ? 1.2 : 2}"/>`; }
      for (let c = 0; c <= n; c++) r += tx(x0 + c * k, 0, 17, String(c), '#1e293b');
      o += `<g style="pointer-events:none" transform="translate(${(a[0] + b[0]) / 2},${(a[1] + b[1]) / 2}) rotate(${ang}) translate(0,-30)">${r}</g>`; }
    else if (s.guide === 'ruler' || s.guide === 'steel') { const a = s.path[0], b = s.path[s.path.length - 1], ang = Math.atan2(b[1] - a[1], b[0] - a[0]) * 180 / Math.PI; o += `<g transform="translate(${(a[0] + b[0]) / 2},${(a[1] + b[1]) / 2}) rotate(${ang}) translate(0,-34)">${TOOLART.ruler({ steel: s.guide === 'steel' }).replace('-110', '-' + (dist(a, b) / 2 + 30)).replace('width="220"', `width="${dist(a, b) + 60}"`)}</g>`; }
    if (G >= 3) o += `<path d="${pd}" fill="none" stroke="#86efac" stroke-width="${tol * 2}" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>`;
    o += `<path d="${pd}" fill="none" stroke="${s.lineCol || '#334155'}" stroke-width="3" stroke-dasharray="10 8"/>`;
    // 이미 자른 부분
    if (V.prog > 0) { const pts = [s.path[0]]; for (let i = 1; i < s.path.length && V.L[i] < V.prog; i++) pts.push(s.path[i]); pts.push(ptAt(s.path, V.L, V.prog)); o += `<path d="M${pts.map(p => p.join(',')).join(' L')}" fill="none" stroke="${s.tool === 'pencil' ? '#334155' : '#7c2d12'}" stroke-width="${s.tool === 'pencil' ? 4 : 5}" stroke-linecap="round"/>`; }
    const st = s.path[0], en = s.path[s.path.length - 1];
    o += `<circle cx="${st[0]}" cy="${st[1]}" r="16" fill="#22c55e" opacity=".85"/>` + em(en[0], en[1] - 26, 30, '🚩');
    if (G >= 4 && !V.active && !DONE) { const a = ptAt(s.path, V.L, V.prog), b = ptAt(s.path, V.L, Math.min(tot, V.prog + 90)); o += arrow(a[0], a[1] - 40, b[0], b[1] - 40); }
    if (DONE && s.done) o += s.done(V);
    const c = V.active ? V.cur : ptAt(s.path, V.L, V.prog), tk = { chopstick: ['chopstick', 1, 0], scissors: ['scissors', .5, -90], cutter: ['cutter', .9, 0], saw: ['saw', .6, 0], pencil: ['pencil', .55, 0], silicone: ['silicone', .5, 0], knife: ['knife', .6, 0] }[s.tool] || ['pencil', .5, 0];
    let ang = s.toolAng ?? tk[2];
    if (s.tool === 'scissors') { const pa = ptAt(s.path, V.L, Math.min(tot - 1, V.prog)), pb = ptAt(s.path, V.L, Math.min(tot, V.prog + 12)), th = Math.atan2(pb[1] - pa[1], pb[0] - pa[0]); ang = th * 180 / Math.PI + 90;
      o += `<g style="pointer-events:none" opacity=".95">${tool('scissors', c[0] - 34 * Math.cos(th), c[1] - 34 * Math.sin(th), .55, ang, { open: V.active ? 8 + 22 * Math.abs(Math.sin(V.trav / 30)) : 24 })}</g>`; }
    else
    o += `<g style="pointer-events:none" opacity=".92">${tool(tk[0], s.tool === 'cutter' ? c[0] - (69 * Math.cos(ang * Math.PI / 180) - 4 * Math.sin(ang * Math.PI / 180)) * tk[1] : c[0] + (s.tool === 'scissors' ? 0 : -(s.tool === 'knife' ? 80 : 55) * Math.cos(ang * Math.PI / 180)), s.tool === 'cutter' ? c[1] - (69 * Math.sin(ang * Math.PI / 180) + 4 * Math.cos(ang * Math.PI / 180)) * tk[1] : c[1] + (s.tool === 'scissors' ? 46 : -(s.tool === 'knife' ? 80 : 55) * Math.sin(ang * Math.PI / 180)), tk[1], ang, { open: V.active ? 10 + 14 * Math.abs(Math.sin(V.trav / 30)) : 20 })}</g>`;
    if (s.strokes) o += pill(430, 30, `앞뒤로 쓱싹쓱싹! ${Math.round(V.prog / tot * 100)}%`, '#b45309', 20);
    return o;
  },
  down: p => { const c = ptAt(S.path, V.L, V.prog); if (dist(p, c) < 46) { V.active = true; V.last = p; V.cur = p; } else if (V.prog === 0) say('초록 동그라미에서 시작해요.', 'ari'); },
  move: p => {
    if (!V.active) return; const tol = S.tol * (G >= 4 ? 1.8 : 1), [d, sp] = nearOnPath(S.path, V.L, p), tot = V.L[V.L.length - 1];
    V.trav += dist(p, V.last); V.last = p; V.cur = p;
    if (sp < V.prog - 60) return;
    if (d > tol) return fail(S.offMsg || '선에서 벗어났어요. 멈춘 곳에서 다시 이어서 해요.', true);
    const np = Math.max(V.prog, Math.min(sp, V.prog + 40));
    V.prog = np; if (V.prog >= tot - 8) { V.prog = tot; pass(); } else redraw();
  },
  up: () => { V.active = false; redraw(); }
};
// 톱질: 움직인 거리의 일부만 진행되도록 (앞뒤로 여러 번)
const _cutMove = P.cut.move;
P.cut.move = p => {
  if (!S.strokes || !V.active) return _cutMove(p);
  const tol = S.tol * (G >= 4 ? 1.8 : 1), [d, sp] = nearOnPath(S.path, V.L, p), tot = V.L[V.L.length - 1];
  const mv = dist(p, V.last); V.trav += mv; V.last = p; V.cur = p;
  if (d > tol) return fail(S.offMsg || '톱이 선에서 벗어났어요. 선을 따라 곧게 움직여요.', true);
  V.prog = Math.min(tot, V.prog + mv * (S.rate || .2)); if (V.prog >= tot - 4) { V.prog = tot; pass(); } else { if (Math.random() < .3) sfx('buzz'); redraw(); }
};
P.cut.down = p => { const c = ptAt(S.path, V.L, V.prog); if (dist(p, c) < (S.strokes ? 140 : 46)) { V.active = true; V.last = p; V.cur = S.strokes ? c : p; } else if (V.prog === 0) say('초록 동그라미에서 시작해요.', 'ari'); };
const MAT = {
  paper: s => paperR(s.mx ?? 130, s.my ?? 60, s.mw ?? 600, s.mh ?? 400),
  card: s => `<rect x="${s.mx ?? 130}" y="${s.my ?? 60}" width="${s.mw ?? 600}" height="${s.mh ?? 400}" rx="6" fill="#d6a76c" stroke="#92400e" stroke-width="3"/>`,
  wood: s => wood(s.mx ?? 100, s.my ?? 150, s.mw ?? 660, s.mh ?? 220),
  veg: s => `<rect x="80" y="380" width="700" height="40" rx="10" fill="#d6a76c"/><rect x="${s.mx ?? 200}" y="${s.my ?? 220}" width="${s.mw ?? 460}" height="${s.mh ?? 110}" rx="50" fill="${s.vcol || '#fb923c'}" stroke="#9a3412" stroke-width="3"/>` + (s.marks || []).map(x => `<line x1="${x}" y1="${(s.my ?? 220) - 14}" x2="${x}" y2="${(s.my ?? 220) + (s.mh ?? 110) + 8}" stroke="#7c3aed" stroke-width="7" stroke-linecap="round" opacity=".75"/>`).join(''),
  tile: s => `<rect x="0" y="${s.my ?? 300}" width="860" height="14" fill="#94a3b8"/>`,
};
// 4. 짜기·누르기 (양 맞추기)
// 1.2.0: 손 감각 판정(점 찍기·선 따라 짜기·붓기) — 낮은 층은 너그럽게, 높은 층으로 갈수록 정밀하게
const LENI = () => { const f = (typeof CUR === 'number' ? CUR : 0) + 1, F = FLOORS[CUR]; if (F && F.gen) return 1; return f <= 20 ? 1.6 : f >= 80 ? 1 : 1.6 - (f - 20) / 60 * .6; };
const SQ = (i, t = S) => { const k = LENI(); if (t.mode === 'hold') { const m = (t.lo + t.hi) / 2, h = (t.hi - t.lo) / 2 * k; return i ? m + h : m - h; } return i ? t.hi * k : t.lo / k; };
P.squeeze = {
  init: s => ({ amt: 0, hold: false, dots: (s.dots || []).map(() => 0), di: -1, cov: 0, bead: [], last: null }),
  reset: (s, V) => { Object.assign(V, P.squeeze.init(s)); },
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : '');
    const zone = s.showZone || G >= 3;
    if (s.mode === 'hold') {
      const x = 760, y0 = 80, H = 320, f = v => y0 + H - v / s.max * H;
      if (!s.noGauge) o += `<rect x="${x - 26}" y="${y0}" width="52" height="${H}" rx="14" fill="#f1f5f9" stroke="#94a3b8" stroke-width="3"/>` + (zone ? `<rect x="${x - 26}" y="${f(SQ(1, s))}" width="52" height="${f(SQ(0, s)) - f(SQ(1, s))}" fill="#86efac"/>` : '') + `<rect x="${x - 18}" y="${f(Math.min(V.amt, s.max))}" width="36" height="${f(0) - f(Math.min(V.amt, s.max))}" rx="10" fill="${s.col || '#f59e0b'}"/>` + tx(x, y0 - 22, 20, s.gauge || '양', '#475569');
      // 1.2.0: 눈금이 보이는 붓기는 여러 번 나눠 붓고, 많으면 덜어 내고, 확인을 눌러 판정해요
      if (s.btn === '붓기') { const yb = s.noGauge ? (s.by ?? 440) + 74 : (s.by ?? 440), xb = s.noGauge ? (s.bx ?? 600) + 40 : (s.bx ?? 600); o += btn(xb - 160, yb, 120, 52, '➖ 덜기', 'less', '#f97316', 21) + btn(xb - 300, yb, 130, 52, '✔ 확인', 'ok', '#16a34a', 21); }
      o += `<g data-act="hold"><circle cx="${s.bx ?? 600}" cy="${s.by ?? 440}" r="56" fill="${V.hold ? '#6d28d9' : '#7c3aed'}" stroke="#fff" stroke-width="6"/>${tx(s.bx ?? 600, s.by ?? 440, 22, s.btn || '꾹 누르기', '#fff')}</g>`;
      if (G >= 4 && !DONE && !s.noGauge) o += pill(x, f((SQ(0, s) + SQ(1, s)) / 2), '여기서 떼요', '#16a34a', 16);
    } else if (s.mode === 'dots') {
      s.dots.forEach((d, i) => {
        const a = V.dots[i], r = 4 + Math.sqrt(a) * 9, ok = a >= SQ(0, s) && a <= SQ(1, s);
        o += `<circle cx="${d[0]}" cy="${d[1]}" r="22" fill="none" stroke="${zone ? '#16a34a' : '#94a3b8'}" stroke-width="3" stroke-dasharray="6 5"/>` + (a > 0 ? `<circle cx="${d[0]}" cy="${d[1]}" r="${r}" fill="${s.col || '#fef9c3'}" stroke="${ok ? '#16a34a' : '#f59e0b'}" stroke-width="2" opacity=".95"/>` : '') + (G >= 3 && a === 0 ? badge(d[0], d[1] - 38, i + 1, '#f97316', 13) : '');
      });
      o += tx(430, 490, 20, s.tip || '동그라미를 꾹 누르고 있다가 알맞을 때 떼요.', '#6d28d9');
    } else if (s.mode === 'line') {
      const a = s.line[0], b = s.line[1];
      o += `<line x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="#94a3b8" stroke-width="3" stroke-dasharray="8 6"/>` + (zone ? `<line x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="#86efac" stroke-width="${s.tol * 2}" opacity=".5" stroke-linecap="round"/>` : '') + `<circle cx="${a[0]}" cy="${a[1]}" r="14" fill="#22c55e"/>` + em(b[0], b[1] - 26, 26, '🚩');
      V.bead.forEach(([x, y, t]) => { o += `<circle cx="${x}" cy="${y}" r="${clamp(t, 2, 30)}" fill="${s.col || '#fef9c3'}" stroke="${t > SQ(1, s) ? '#ef4444' : '#d97706'}" stroke-width="1.4"/>`; });
      const c = V.last || a; o += `<g style="pointer-events:none">${tool(s.tool || 'bond', c[0] + 30, c[1] - 60, .45, s.tool === 'silicone' ? 150 : -150)}</g>`;
      o += pill(430, 30, `${Math.round(V.cov * 100)}% 짰어요${s.easy ? '' : ' · 알맞은 빠르기로'}`, '#6d28d9', 18);
      if (G >= 4 && !DONE) o += arrow(a[0], a[1] + 50, b[0], b[1] + 50);
    }
    if (DONE && s.done) o += s.done(V);
    return o;
  },
  act: a => { if (S.mode !== 'hold') return; if (a === 'hold') { V.hold = true; if (S.btn !== '붓기') V.amt = 0; return; }
    if (S.btn !== '붓기') return;
    if (a === 'less') { V.amt = Math.max(0, V.amt - Math.max(.5, (SQ(1) - SQ(0)) / 2)); sfx('tap'); return redraw(); }
    if (a === 'ok') { if (V.amt < SQ(0)) return fail(S.lowMsg || '아직 적어요. 조금 더 부어요.', true); if (V.amt > SQ(1)) return fail((S.highMsg || '너무 많아요.') + ' 덜기로 조금 덜어요.', true); return pass(); } },
  down: p => { if (S.mode === 'dots') { const i = S.dots.findIndex(d => dist(d, p) < 34); if (i >= 0) { if (V.dots[i] > 0) return; V.di = i; V.hold = true; } } else if (S.mode === 'line') { if (dist(p, S.line[0]) < 40 || (V.cov > 0 && V.last && dist(p, V.last) < 50)) { V.hold = true; V.last = p; V.lt = performance.now(); } } },
  move: p => {
    if (S.mode !== 'line' || !V.hold) return; const a = S.line[0], b = S.line[1], [d, sp] = nearOnPath([a, b], [0, dist(a, b)], p), tol = S.tol * (G >= 4 ? 1.8 : 1);
    if (d > tol) { V.hold = false; return fail('선을 따라 짜요. 멈춘 곳에서 이어서 해요.', true); }
    const now = performance.now(), dt = (now - V.lt) / 1000, ds = Math.max(1, dist(p, V.last)); V.lt = now;
    const t = S.easy ? 9 : clamp(S.rate * dt / ds * 10, 0, 40); V.bead.push([p[0], p[1], t]); V.last = p; V.cov = Math.max(V.cov, sp / dist(a, b)); redraw();
    if (V.cov > .97 && S.easy) { V.hold = false; return pass(); }
    if (V.cov > .97) { V.hold = false; const th = V.bead.map(x => x[2]), avg = th.reduce((x, y) => x + y, 0) / th.length, big = th.filter(x => x > SQ(1)).length / th.length;
      if (avg < SQ(0)) { V.bead = []; V.cov = 0; V.last = null; return fail(S.lowMsg || '너무 빨리 움직여서 양이 부족해요. 조금 더 천천히 짜요.'); }
      if (avg > SQ(1) || big > .3) { V.bead = []; V.cov = 0; V.last = null; return fail(S.highMsg || '너무 천천히 움직여서 넘쳤어요. 조금 더 빠르게 짜요.'); }
      pass(); }
  },
  up: () => {
    if (!V.hold) return; V.hold = false;
    if (S.mode === 'hold' && S.btn === '붓기') return redraw();
    if (S.mode === 'hold') { if (V.amt < SQ(0)) return fail(S.lowMsg || '너무 적어요. 조금 더 오래 눌러요.'); if (V.amt > SQ(1)) return fail(S.highMsg || '너무 많아요. 넘쳐 버렸어요.'); return pass(); }
    if (S.mode === 'dots') { const i = V.di, a = V.dots[i]; V.di = -1; if (a < SQ(0)) { V.dots[i] = 0; return fail(S.lowMsg || '너무 적어요. 조금 더 오래 눌러요.', true); } if (a > SQ(1)) { V.dots[i] = 0; return fail(S.highMsg || '너무 많아요. 흘러넘쳤어요.', true); } sfx('tap'); if (V.dots.every(x => x >= SQ(0) && x <= SQ(1))) pass(); else redraw(); }
  },
  tick: dt => { if (!V.hold) return; if (S.mode === 'hold') { V.amt += S.rate * dt; if (V.amt > S.max) { V.hold = false; V.amt = S.max; fail(S.highMsg || '너무 많아요. 넘쳐 버렸어요.'); return; } redraw(); } else if (S.mode === 'dots' && V.di >= 0) { V.dots[V.di] += S.rate * dt; if (V.dots[V.di] > SQ(1) * 1.6) { V.dots[V.di] = 0; V.di = -1; V.hold = false; fail(S.highMsg || '너무 많아요. 흘러넘쳤어요.', true); return; } redraw(); } }
};
// 5. 값 맞추기 (드릴 비트, 깊이, 크기, 방향 등)
P.dial = {
  init: s => ({ v: s.ctrls.map(c => c.start ?? (c.opts ? c.opts[0] : c.min)) }),
  reset: () => {},
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : '');
    const n = s.ctrls.length, cw = 380, y0 = s.cy ?? 380;
    s.ctrls.forEach((c, i) => {
      const x = n === 1 ? 430 : 230 + i * 400, val = V.v[i], show = G >= 4;
      o += `<rect x="${x - cw / 2}" y="${y0 - 56}" width="${cw}" height="112" rx="22" fill="#fff" stroke="#c4b5fd" stroke-width="4"/>` + tx(x, y0 - 34, 20, c.name, '#6d28d9');
      if (c.opts) {
        const m = c.opts.length, bw = Math.min(70, (cw - 20) / m - 6);
        c.opts.forEach((op, j) => { const bx = x - (m * (bw + 6)) / 2 + j * (bw + 6) + bw / 2, on = op === val, tg = show && op === c.target;
          o += `<g data-act="set:${i}:${j}" style="cursor:pointer" ${tg && !on ? 'class="glow"' : ''}><rect x="${bx - bw / 2}" y="${y0 - 10}" width="${bw}" height="52" rx="14" fill="${on ? '#7c3aed' : '#f5f3ff'}" stroke="${tg ? '#facc15' : '#c4b5fd'}" stroke-width="${tg ? 5 : 3}"/>${tx(bx, y0 + 16, c.fs || (String(op).length > 3 ? 17 : 22), op + (c.unitIn ? c.unit : ''), on ? '#fff' : '#4c1d95')}</g>`; });
      } else {
        o += btn(x - 130, y0 + 16, 70, 56, '−', `dec:${i}`, '#a78bfa', 34) + btn(x + 130, y0 + 16, 70, 56, '+', `inc:${i}`, '#a78bfa', 34) + `<rect x="${x - 80}" y="${y0 - 12}" width="160" height="56" rx="14" fill="#f5f3ff" stroke="#c4b5fd" stroke-width="3"/>` + tx(x, y0 + 16, 30, `${val}${c.unit || ''}`, '#4c1d95');
        if (show) o += pill(x, y0 + 74, `${c.target}${c.unit || ''}${JO(c.unit || c.target, '으로', '로')} 맞춰요`, '#16a34a', 17);
      }
    });
    o += btn(s.okx ?? 430, s.oky ?? 486, 220, 56, s.okText || '✔ 확인', 'ok', '#16a34a', 24);
    return o;
  },
  act: a => {
    const [k, i, j] = a.split(':');
    if (k === 'set') { V.v[+i] = S.ctrls[+i].opts[+j]; sfx('tap'); redraw(); }
    if (k === 'inc' || k === 'dec') { const c = S.ctrls[+i]; V.v[+i] = Math.round(clamp(V.v[+i] + (k === 'inc' ? 1 : -1) * (c.step || 1), c.min, c.max) * 100) / 100; sfx('tap'); redraw(); }
    if (k === 'ok') {
      for (let n = 0; n < S.ctrls.length; n++) { const c = S.ctrls[n], v = V.v[n], t = c.target, tol = (c.tol || 0) * (G >= 4 ? 2 : 1);
        const ok = Array.isArray(t) ? t.includes(v) : (typeof t === 'number' && typeof v === 'number' ? Math.abs(v - t) <= tol + 1e-9 : v === t);
        if (!ok) { let m = c.msg && c.msg[v]; if (!m && typeof v === 'number' && typeof t === 'number') m = v < t ? c.low : c.high; return fail(m || c.no || `${c.name}이(가) 맞지 않아요.`, true); } }
      pass();
    }
  }
};
// 6. 망치질 (힘 조절)
P.hammer = {
  init: s => ({ ph: 0, depth: 0, n: 0, bent: false, swing: 0 }),
  reset: (s, V) => { V.depth = 0; V.n = 0; V.bent = false; },
  draw: (s, V, G) => {
    let o = bg({ bg: 'bench' }) + (s.obj === 'chisel' ? `<rect x="250" y="300" width="360" height="110" rx="10" fill="#a8a29e" stroke="#57534e" stroke-width="3"/>` : wood(250, 300, 360, 50) + wood(250, 350, 360, 60, '#d6a76c'));
    const L = 120, top = 300 - L * (1 - V.depth), nx = 430;
    if (s.obj === 'peg') o += V.bent ? `<rect x="${nx - 24}" y="${top}" width="48" height="${300 - top}" fill="#e7c48d" stroke="#92400e" stroke-width="3"/>` + em(nx, top - 20, 36, '💢') : `<rect x="${nx - 24}" y="${top}" width="48" height="${300 - top}" rx="4" fill="#e7c48d" stroke="#92400e" stroke-width="3"/>`;
    else if (s.obj === 'chisel') o += `<g transform="translate(${nx},${top + 10}) scale(.9)">${TOOLART.chisel({})}</g>` + (V.depth > .2 ? `<path d="M${nx - 40},300 l20,-${10 + V.depth * 20} l14,${8 + V.depth * 10} l18,-${12 + V.depth * 20} l14,${14 + V.depth * 18}" fill="none" stroke="#334155" stroke-width="3"/>` : '');
    else o += V.bent ? `<path d="M${nx},300 L${nx},${top + 40} Q${nx},${top + 10} ${nx + 30},${top}" stroke="#94a3b8" stroke-width="8" fill="none"/>` : `<rect x="${nx - 4}" y="${top}" width="8" height="${300 - top}" fill="#cbd5e1" stroke="#475569" stroke-width="2"/><rect x="${nx - 16}" y="${top - 8}" width="32" height="9" rx="3" fill="#94a3b8" stroke="#475569" stroke-width="2"/>`;
    if (V.n < (s.light || 0) && s.finger) o += em(nx - 34, top + 34, 46, '🤏');
    o += `<g transform="translate(${nx + 120},${top - 70}) rotate(${-40 + V.swing * 40})" style="pointer-events:none">${TOOLART[s.tool || 'claw']({})}</g>`;
    // 힘 막대
    const light = V.n < (s.light || 0), zone = light ? s.lightZone || [.1, .35] : s.zone || [.45, .75], X = 760, Y0 = 70, H = 330, f = v => Y0 + H - v * H, pw = (Math.sin(V.ph) + 1) / 2;
    o += `<rect x="${X - 28}" y="${Y0}" width="56" height="${H}" rx="14" fill="#fee2e2" stroke="#94a3b8" stroke-width="3"/><rect x="${X - 28}" y="${f(zone[1])}" width="56" height="${f(zone[0]) - f(zone[1])}" fill="#86efac"/><rect x="${X - 28}" y="${Y0}" width="56" height="${f(.88) - Y0}" rx="14" fill="#fca5a5"/>` + tx(X, Y0 - 22, 20, '힘', '#475569') + `<rect x="${X - 40}" y="${f(pw) - 5}" width="80" height="10" rx="5" fill="#1e1b4b"/>`;
    o += pill(430, 40, light ? `먼저 살살 ${s.light}번 (${V.n}/${s.light})` : `세게 탕! ${Math.round(V.depth * 100)}%`, light ? '#0ea5e9' : '#7c3aed', 20);
    o += btn(430, 470, 260, 70, '🔨 탕!', 'hit', '#7c3aed', 30);
    if (G >= 4) o += pill(X - 120, f((zone[0] + zone[1]) / 2), '초록에서!', '#16a34a', 16);
    return o;
  },
  act: a => {
    if (a !== 'hit') return; const pw = (Math.sin(V.ph) + 1) / 2, light = V.n < (S.light || 0), z = light ? S.lightZone || [.1, .35] : S.zone || [.45, .75], wz = G >= 4 ? [z[0] - .08, z[1] + .08] : z;
    V.swing = 1; sfx('bang');
    if (light) { if (pw > wz[1]) return fail('처음에는 살살 쳐야 해요. 못이 휘거나 손을 다칠 수 있어요.'); if (pw < wz[0]) { say('조금 더 힘을 줘요.', 'ari'); return redraw(); } V.n++; V.depth += .08; return redraw(); }
    if (pw > .88 || pw > wz[1] + .12) { V.bent = true; redraw(); return fail(S.strongMsg || '너무 세게 쳐서 못이 휘었어요. 새 못으로 다시 해요.'); }
    if (pw < wz[0]) { V.depth += .03; say('힘이 약해요. 초록 칸에서 쳐요.', 'ari'); return redraw(); }
    V.depth = Math.min(1, V.depth + (1 - (S.light || 0) * .08) / S.hits); V.n++; if (V.depth >= .99) { V.depth = 1; pass(); } else redraw();
  },
  tick: dt => { V.ph += dt * (S.speed || 3.2) * (G >= 4 ? .6 : 1); V.swing = Math.max(0, V.swing - dt * 4); redraw(); }
};
// 7. 재기 (읽기·표시하기)
// 1.2.0: 긴 줄자(50cm 넘게)는 목표 근처 20cm만 실제 크기 느낌으로 보여 줘요 (mm 눈금까지)
const tapeWin = s => { if (!(s.tape && (s.cm || 18) >= 50)) return null; if (s._w) return s._w; const t = s.target ?? (s.opts ? parseFloat(s.opts[s.a]) : 50), a = clamp(Math.floor(t / 10) * 10 - 5, 0, (s.cm || 100) - 20), k = 34; return (s._w = { a, b: a + 20, k, x0: 90 - a * k }); };
P.measure = {
  init: s => ({ mk: tapeWin(s) ? tapeWin(s).a + 2 : (s.start ?? 2), drag: false, off: {} }),
  draw: (s, V, G) => {
    let o = bg(s); const TW = tapeWin(s), k = TW ? TW.k : (s.k || 40), x0 = TW ? TW.x0 : (s.x0 || 70), y = s.y || 300, cm = s.cm || 18, X = c => x0 + c * k;
    if (s.obj) o += s.obj(X, y, V, G);
    if (TW) { const A = TW.a, B = TW.b; o += `<rect x="${X(A) - 40}" y="${y}" width="${X(B) - X(A) + 80}" height="70" fill="#fde047" stroke="#a16207" stroke-width="3"/><path d="M${X(A) - 40},${y - 2} l10,18 l-10,18 l10,18 l-10,18" fill="none" stroke="#fef3c7" stroke-width="8"/><path d="M${X(B) + 40},${y - 2} l-10,18 l10,18 l-10,18 l10,18" fill="none" stroke="#fef3c7" stroke-width="8"/>`;
      for (let t = A * 10; t <= B * 10; t++) { const x = X(t / 10), c = t / 10, l = t % 10 ? (t % 5 ? 10 : 16) : 28; o += `<line x1="${x}" y1="${y}" x2="${x}" y2="${y + l}" stroke="#111827" stroke-width="${t % 10 ? 1 : (c % 5 ? 1.8 : 2.8)}"/>`; if (t % 10 === 0) o += tx(x, y + 50, c % 5 ? 15 : 21, c, c % 10 ? '#111827' : '#dc2626', c % 5 ? '' : 'font-weight="bold"'); }
      o += tx(X(B) + 10, y - 10, 15, s.unit || 'cm', '#a16207') + tx(X(B) - 140, y + 98, 15, '← 0(줄자 고리)은 왼쪽 끝에 걸려 있어요', '#fef3c7'); }
    else {
    o += `<rect x="${x0 - 20}" y="${y}" width="${cm * k + 40}" height="70" rx="6" fill="${s.tape ? '#fde047' : '#fef08a'}" stroke="#a16207" stroke-width="3"/>`;
    if (k < 25) { for (let c = 0; c <= cm; c++) { const x = X(c), l = c % 10 === 0 ? 40 : c % 5 === 0 ? 26 : 13; o += `<line x1="${x}" y1="${y}" x2="${x}" y2="${y + l}" stroke="#111827" stroke-width="${c % 10 === 0 ? 3 : c % 5 === 0 ? 2 : 1.2}"/>`; if (c % 10 === 0) o += tx(x + (c ? 0 : 8), y + 58, 20, s.mul ? c * s.mul : c, c % 100 === 0 && c ? '#dc2626' : '#111827'); else if (c % 5 === 0) o += tx(x, y + 44, 13, c, '#57534e'); } if (s.tape) o += `<rect x="${x0 - 8}" y="${y - 6}" width="10" height="82" rx="2" fill="#78716c" stroke="#44403c" stroke-width="2"/>`; }
    else for (let t = 0; t <= cm * 10; t++) { const x = X(t / 10), l = t % 10 ? (t % 5 ? 10 : 18) : 28; if (s.noSub && t % 10) continue; if (k >= 25 || t % 5 === 0) o += `<line x1="${x}" y1="${y}" x2="${x}" y2="${y + l}" stroke="#713f12" stroke-width="${t % 10 ? 1.2 : 2.4}"/>`; if (t % 10 === 0 && (k >= 25 || t % 50 === 0)) o += tx(x, y + 46, 20, s.mul ? t / 10 * s.mul : t / 10, '#713f12'); }
    o += k < 25 ? tx(X(cm) + 6, y - 10, 15, s.unit || 'cm', '#a16207') : tx(X(cm) + 10, y + 64, 15, s.unit || 'cm', '#a16207'); }
    if (s.ask === 'mark') {
      o += `<g data-drag="mk"><line x1="${X(V.mk)}" y1="${y - 70}" x2="${X(V.mk)}" y2="${y + 4}" stroke="#ef4444" stroke-width="4"/>${tool('pencil', X(V.mk) + 16, y - 117, .5, 110)}<circle cx="${X(V.mk)}" cy="${y - 40}" r="34" fill="transparent"/></g>` + pill(X(V.mk), y - 170, `${V.mk}${s.unit || 'cm'}`, '#ef4444', 18);
      if (G >= 3) o += `<rect x="${X(s.target - s.tol)}" y="${y - 6}" width="${X(s.target + s.tol) - X(s.target - s.tol)}" height="76" fill="#86efac" opacity=".5"/>`;
      if (G >= 4) o += arrow(X(s.target), y + 130, X(s.target), y + 78, '#16a34a');
      o += btn(430, 486, 220, 56, '✏️ 표시하기', 'ok', '#16a34a');
    } else {
      const n = s.opts.length; s.opts.forEach((op, i) => { const bx = 430 + (i - (n - 1) / 2) * 170, gl = G >= 4 && i === s.a && !DONE; o += `<g data-act="opt:${i}" opacity="${V.off[i] ? .3 : 1}" ${gl ? 'class="glow"' : ''}><rect x="${bx - 75}" y="455" width="150" height="56" rx="18" fill="${DONE && i === s.a ? '#22c55e' : '#7c3aed'}" stroke="${gl ? '#facc15' : 'none'}" stroke-width="6"/>${tx(bx, 484, 24, op, '#fff')}</g>`; });
      if (G >= 3 && s.read) o += s.read(X, y);
    }
    return o;
  },
  down: p => { if (S.ask !== 'mark') return; const TW = tapeWin(S), k = TW ? TW.k : (S.k || 40), x0 = TW ? TW.x0 : (S.x0 || 70); if (Math.abs(p[0] - (x0 + V.mk * k)) < 50 && p[1] < (S.y || 300) + 80) V.drag = true; },
  move: p => { if (!V.drag) return; const TW = tapeWin(S), k = TW ? TW.k : (S.k || 40), x0 = TW ? TW.x0 : (S.x0 || 70), st = TW ? .1 : (S.snap || .5); V.mk = Math.round(clamp(Math.round((p[0] - x0) / k / st) * st, TW ? TW.a : 0, TW ? TW.b : (S.cm || 18)) * 10) / 10; redraw(); },
  up: () => { V.drag = false; },
  act: a => {
    if (a === 'ok') { const tol = S.tol * (G >= 4 ? 2 : 1); if (Math.abs(V.mk - S.target) <= tol + 1e-9) pass(); else fail(V.mk < S.target ? `조금 짧아요. ${S.target}${S.unit || 'cm'} 눈금을 찾아요.` : `조금 길어요. ${S.target}${S.unit || 'cm'} 눈금을 찾아요.`, true); }
    if (a.startsWith('opt:')) { const i = +a.slice(4); if (i === S.a) pass(); else { V.off[i] = 1; fail(S.no || '다시 읽어 봐요. 0에서 시작했는지, 끝이 어느 눈금인지 봐요.', true); } }
  }
};
// 8. 끌어다 놓기 (맞추기)
P.place = {
  init: s => ({ p: [...s.from], drag: false }),
  reset: (s, V) => { V.p = [...s.from]; },
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : '');
    const t = s.to, tol = s.tol * (G >= 4 ? 1.8 : 1);
    if (G >= 3 || s.showTo) o += s.axis === 'x' ? `<rect x="${t[0] - tol}" y="${t[1] - 90}" width="${tol * 2}" height="180" fill="#86efac" opacity=".45"/>` : `<circle cx="${t[0]}" cy="${t[1]}" r="${tol}" fill="#86efac" opacity=".5" stroke="#16a34a" stroke-width="3" stroke-dasharray="8 6"/>`;
    if (s.ghost && (G >= 3 || s.showTo)) o += `<g opacity=".3">${s.ghost(t)}</g>`;
    o += `<g data-drag="obj" style="cursor:grab">${s.obj(V.p, V)}<circle cx="${V.p[0]}" cy="${V.p[1]}" r="${s.grab || 70}" fill="transparent"/></g>`;
    if (G >= 4 && !DONE) o += arrow(V.p[0], V.p[1] - 60, t[0], t[1] - 60, '#16a34a');
    if (DONE && s.done) o += s.done(V);
    return o;
  },
  down: p => { if (dist(p, V.p) < (S.grab || 70)) { V.drag = true; V.off = [V.p[0] - p[0], V.p[1] - p[1]]; } },
  move: p => { if (!V.drag) return; V.p = S.axis === 'x' ? [p[0] + V.off[0], S.from[1]] : S.axis === 'y' ? [S.from[0], p[1] + V.off[1]] : [p[0] + V.off[0], p[1] + V.off[1]]; redraw(); },
  up: () => {
    if (!V.drag) return; V.drag = false; const t = S.to, tol = S.tol * (G >= 4 ? 1.8 : 1), d = S.axis === 'x' ? Math.abs(V.p[0] - t[0]) : dist(V.p, t);
    if (dist(V.p, S.from) < 12) return;
    if (d <= tol) { V.p = [...t]; pass(); return; }
    const dx = t[0] - V.p[0], dy = t[1] - V.p[1], dir = Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? '오른쪽' : '왼쪽') : (dy > 0 ? '아래' : '위');
    const dj = dir + (dir === '아래' || dir === '위' ? '로' : '으로'); fail(S.no ? S.no.replace('%', dj) : `조금 더 ${dj} 맞춰요.`, true);
  }
};
// 9. 수평 맞추기 (왼쪽 받침 높이 조절)
P.level = {
  // 1.2.0: 같은 모양이 되풀이되지 않게 — 받침(기본)·쐐기 끼우기·돌리는 조절 발 세 가지
  mode: s => { if (s.lmode) return s.lmode; if (!P.level._m) { P.level._m = new Map(); let n = 0; FLOORS.forEach(F => F.steps.forEach(t => { if (t && t.type === 'level') P.level._m.set(t, F.id === 'level' ? 'prop' : ['shim', 'foot'][n++ % 2]); })); } return P.level._m.get(s) || 'prop'; },
  init: s => ({ h: s.start ?? 4, c: (s.corners || [3, 6, 2, 5]).slice() }),
  reset: (s, V) => { V.h = s.start ?? 4; V.c = (s.corners || [3, 6, 2, 5]).slice(); },
  // 1.2.0: 위에서 본 책상 — 네 귀퉁이 높이를 올리고 내려, 직각으로 놓인 수평계 두 개를 모두 맞춰요
  tilt: V => [(V.c[1] + V.c[3]) - (V.c[0] + V.c[2]), (V.c[2] + V.c[3]) - (V.c[0] + V.c[1])],
  drawTop: (s, V, G) => { let o = bg({ bg: 'wall' }); const [tx2, ty2] = P.level.tilt(V), C = [[230, 110], [630, 110], [230, 370], [630, 370]];
    o += `<rect x="230" y="110" width="400" height="260" rx="10" fill="#e7c48d" stroke="#92400e" stroke-width="4"/>` + [0, 1, 2, 3, 4].map(i => `<path d="M240,${135 + i * 52} Q430,${128 + i * 52} 620,${137 + i * 52}" fill="none" stroke="#c08a46" stroke-width="2" opacity=".7"/>`).join('');
    C.forEach(([x, y], i) => { const L = x < 430, T = y < 240; o += `<circle cx="${x}" cy="${y}" r="16" fill="#94a3b8" stroke="#334155" stroke-width="3"/><circle cx="${x}" cy="${y}" r="5" fill="#475569"/>` + /* 1.2.0: 다리 높이 숫자는 숨기고 물방울만 보고 맞춰요 */ btn(L ? x - 75 : x + 75, T ? y - 22 : y - 22, 66, 42, '▲', 'c' + i + 'u', '#a78bfa', 22) + btn(L ? x - 75 : x + 75, y + 28, 66, 42, '▼', 'c' + i + 'd', '#a78bfa', 22); });
    o += `<g transform="translate(430,318) scale(.72)">${TOOLART.level({ bub: clamp(tx2 * 6, -28, 28) })}</g><g transform="translate(430,178) rotate(90) scale(.55)">${TOOLART.level({ bub: clamp(ty2 * 6, -28, 28) })}</g>`;
    if (G >= 3) o += pill(430, 470, tx2 ? (tx2 > 0 ? '오른쪽이 높아요' : '왼쪽이 높아요') : ty2 ? (ty2 > 0 ? '앞쪽(아래)이 높아요' : '뒤쪽(위)이 높아요') : '둘 다 딱 맞아요', '#16a34a', 18);
    o += btn(760, 486, 170, 52, '✔ 확인', 'ok', '#16a34a', 22);
    return o; },
  draw: (s, V, G) => {
    if (P.level.mode(s) === 'top4') return P.level.drawTop(s, V, G);
    let o = bg({ bg: 'wall' }); const MD = P.level.mode(s); const L = [170, 330], Rr = [690, 330 - s.target * 6], ly = 330 - V.h * 6, ang = Math.atan2(Rr[1] - ly, Rr[0] - L[0]) * 180 / Math.PI;
    o += `<rect x="${Rr[0] - 15}" y="${Rr[1] + 14}" width="30" height="${440 - Rr[1] - 14}" fill="#94a3b8"/><rect x="${L[0] - 15}" y="330" width="30" height="110" fill="#94a3b8"/>`;
    const SH = Math.max(0, 330 - ly - 14);
    if (MD === 'shim') { const th = SH / Math.max(1, V.h); for (let i = 0; i < V.h && SH > 0; i++) { const yy = 330 - (i + 1) * th; o += `<path d="M${L[0] - 44 + (i % 2) * 6},${yy + 6} L${L[0] + 40 - (i % 2) * 6},${yy + 6} L${L[0] + 44 - (i % 2) * 8},${yy} L${L[0] - 40 + (i % 2) * 4},${yy} Z" fill="${i % 2 ? '#d6a35c' : '#e7c48d'}" stroke="#92400e" stroke-width="1.5"/>`; } o += tx(L[0], 470, 18, `얇은 쐐기 ${V.h}장`, '#475569'); }
    else if (MD === 'foot') { o += `<rect x="${L[0] - 9}" y="${ly + 14}" width="18" height="${SH}" fill="#cbd5e1" stroke="#475569" stroke-width="2"/>` + [...Array(Math.floor(SH / 6))].map((_, i) => `<line x1="${L[0] - 9}" y1="${ly + 18 + i * 6}" x2="${L[0] + 9}" y2="${ly + 21 + i * 6}" stroke="#64748b" stroke-width="1.5"/>`).join('') + `<ellipse cx="${L[0]}" cy="${(ly + 14 + 330) / 2}" rx="42" ry="12" fill="#475569" stroke="#1e293b" stroke-width="2"/>` + [0, 1, 2, 3, 4, 5].map(k => { const a = (V.h * 40 + k * 60) * Math.PI / 180, c = Math.cos(a); return c > 0 ? `<line x1="${L[0] + 40 * Math.sin(a)}" y1="${(ly + 14 + 330) / 2 - 6}" x2="${L[0] + 40 * Math.sin(a)}" y2="${(ly + 14 + 330) / 2 + 6}" stroke="#94a3b8" stroke-width="${1 + c * 2}"/>` : ''; }).join('') + tx(L[0], 470, 18, '돌리는 조절 발', '#475569'); }
    else o += `<rect x="${L[0] - 40}" y="${ly + 14}" width="80" height="${SH}" fill="#fde68a" stroke="#a16207" stroke-width="2"/>` + tx(L[0], 470, 18, '왼쪽 받침', '#475569');
    o += `<g transform="rotate(${ang},${L[0]},${ly})">${wood(L[0] - 30, ly - 16, Rr[0] - L[0] + 60, 30)}<g transform="translate(${(L[0] + Rr[0]) / 2},${ly - 46}) scale(.9)">${TOOLART.level({ bub: clamp(-ang * 6, -28, 28) })}</g></g>`;
    o += MD === 'shim' ? btn(100, 110, 160, 52, '➕ 쐐기 끼우기', 'up', '#a78bfa', 19) + btn(100, 172, 160, 52, '➖ 쐐기 빼기', 'down', '#a78bfa', 19) : MD === 'foot' ? btn(100, 110, 160, 52, '↻ 돌려 올리기', 'up', '#a78bfa', 19) + btn(100, 172, 160, 52, '↺ 돌려 내리기', 'down', '#a78bfa', 19) : btn(80, 200, 80, 56, '▲', 'up', '#a78bfa', 26) + btn(80, 270, 80, 56, '▼', 'down', '#a78bfa', 26);
    if (G >= 3) o += pill(430, 120, ang < -0.5 ? '왼쪽이 낮아요. 올려요 ▲' : ang > 0.5 ? '왼쪽이 높아요. 내려요 ▼' : '딱 맞아요', '#16a34a', 20);
    o += btn(430, 486, 220, 56, '✔ 확인', 'ok', '#16a34a');
    if (DONE && s.give) o += tx(430, 200, 90, s.give, '#7c3aed');
    return o;
  },
  act: a => { if (P.level.mode(S) === 'top4') { const m = a.match(/^c(\d)([ud])$/); if (m) { V.c[+m[1]] = clamp(V.c[+m[1]] + (m[2] === 'u' ? 1 : -1), 0, 9); sfx('tap'); return redraw(); } if (a === 'ok') { const [x, y] = P.level.tilt(V); if (!x && !y) return pass(); return fail(x ? '가로 수평계 물방울이 가운데에 없어요. 물방울은 높은 쪽으로 가요.' : '세로 수평계 물방울이 가운데에 없어요. 물방울은 높은 쪽으로 가요.', true); } return; }
    if (a === 'up') V.h = Math.min(V.h + 1, 14); if (a === 'down') V.h = Math.max(V.h - 1, 0); if (a === 'up' || a === 'down') { sfx('tap'); redraw(); } if (a === 'ok') { if (V.h === S.target) pass(); else fail('물방울이 가운데 두 줄 사이에 오지 않았어요. 물방울은 높은 쪽으로 가요.', true); } }
};
// 10. 돌리기 (조이기·풀기)
// 송곳 비틀기: 손잡이를 누른 채 좌우로 비틀면 조금씩 들어가요
P.twist = {
  init: s => ({ n: 0, dx: 0, dir: 0, sw: 0, drag: false, last: null }),
  reset: (s, V) => { V.n = 0; V.dx = 0; },
  draw: (s, V, G) => {
    const need = s.n || 6, f = clamp(V.n / need, 0, 1), cx = 430, top = 330, dep = f * 46, tipY = top + 6 + dep;
    let o = bg(s) + (s.pic ? s.pic(V, G) : '') + wood(170, top, 520, 120) + `<rect x="170" y="${top}" width="520" height="8" fill="#c08a4a" opacity=".5"/>`;
    o += `<path d="M${cx - 6 - f * 3},${top} L${cx},${top + 4 + dep} L${cx + 6 + f * 3},${top} Z" fill="#78350f"/>`;
    const sh = V.dx * .25, sx = clamp(sh, -14, 14);
    o += `<g style="pointer-events:none"><rect x="${cx - 4}" y="${tipY - 150}" width="8" height="140" fill="#cbd5e1" stroke="#475569" stroke-width="2"/><path d="M${cx - 4},${tipY - 12} L${cx},${tipY} L${cx + 4},${tipY - 12} Z" fill="#94a3b8" stroke="#475569" stroke-width="2"/>`;
    o += `<rect x="${cx - 12}" y="${tipY - 170}" width="24" height="22" rx="3" fill="#94a3b8" stroke="#334155" stroke-width="3"/>`;
    o += `<path d="M${cx - 30},${tipY - 170} Q${cx - 46},${tipY - 230} ${cx},${tipY - 268} Q${cx + 46},${tipY - 230} ${cx + 30},${tipY - 170} Z" fill="#b45309" stroke="#334155" stroke-width="3"/>`;
    o += [-2, -1, 0, 1, 2].map(i => { const x = cx + i * 12 + sx; return Math.abs(x - cx) < 32 ? `<path d="M${x},${tipY - 176} Q${x + (x - cx) * .2},${tipY - 220} ${x * .5 + cx * .5},${tipY - 258}" stroke="#78350f" stroke-width="3" fill="none" opacity=".7"/>` : ''; }).join('');
    o += em(cx + sx * .6, tipY - 250, 70, '✋') + `</g>`;
    o += `<g data-act="tw"><circle cx="${cx}" cy="${tipY - 215}" r="70" fill="transparent"/></g>`;
    o += `<path d="M${cx - 120},${tipY - 215} l-30,0 m0,0 l12,-10 m-12,10 l12,10 M${cx + 120},${tipY - 215} l30,0 m0,0 l-12,-10 m12,10 l-12,10" stroke="#7c3aed" stroke-width="6" fill="none" stroke-linecap="round" opacity="${G >= 2 ? 1 : .5}"/>`;
    o += pill(430, 490, `${s.label || '누르면서 좌우로 비틀기 ↔'} ${Math.round(f * 100)}%`, '#b45309', 20);
    o += `<rect x="720" y="330" width="40" height="120" rx="8" fill="#f1f5f9" stroke="#94a3b8" stroke-width="3"/><rect x="726" y="${330 + 6}" width="28" height="${f * 108}" rx="6" fill="#78350f"/>` + tx(740, 316, 18, '구멍 깊이', '#475569');
    if (G >= 4 && !DONE) o += arrow(cx - 60, tipY - 215, cx + 60, tipY - 215, '#16a34a');
    return o;
  },
  down: p => { V.drag = true; V.last = p; V.dir = 0; V.sw = 0; },
  move: p => {
    if (!V.drag || DONE) return; const d = p[0] - V.last[0]; V.last = p; if (!d) return;
    const dir = Math.sign(d); V.dx = clamp(V.dx + d, -60, 60);
    if (dir !== V.dir) { if (V.sw >= 40 && V.dir) { V.n++; sfx('tap'); if (V.n >= (S.n || 6)) { V.drag = false; return pass(); } } V.dir = dir; V.sw = 0; }
    V.sw += Math.abs(d); redraw();
  },
  up: () => { V.drag = false; }
};
// 1.2.0: 돌리기 단계의 드라이버 — 손잡이를 위로 세워 제자리에서 돌아요 (나사는 풀면 올라오고 조이면 들어가요)
const standDriver = (s, c, V, f) => { const cw = s.dir === 'cw', lift = (cw ? 1 - f : f) * 22, base = c[1] + 100, sx = c[0], hy = base - 10 - lift, col = cw ? '#7c3aed' : '#0284c7', a0 = (V.ang || 0) * Math.PI / 180;
  let o = `<rect x="${sx - 120}" y="${base}" width="240" height="34" rx="4" fill="#d6a35c" stroke="#92400e" stroke-width="3"/><path d="M${sx - 110},${base + 12} L${sx + 110},${base + 14} M${sx - 110},${base + 24} L${sx + 110},${base + 22}" stroke="#b7793a" stroke-width="2"/>`
    + `<rect x="${sx - 6}" y="${hy + 8}" width="12" height="${base - hy - 8}" fill="#9ca3af" stroke="#475569" stroke-width="2"/>` + [...Array(Math.max(0, Math.floor((base - hy - 10) / 6)))].map((_, i) => `<line x1="${sx - 6}" y1="${hy + 12 + i * 6}" x2="${sx + 6}" y2="${hy + 15 + i * 6}" stroke="#475569" stroke-width="1.5"/>`).join('')
    + `<rect x="${sx - 24}" y="${hy}" width="48" height="11" rx="4" fill="#cbd5e1" stroke="#475569" stroke-width="2.5"/>`;
  if (s.tool === 'edriver') return o + `<g transform="translate(${sx},${hy}) scale(.7)">${drillV(V.drag).replace(/#f59e0b/g, '#16a34a').replace(/#fbbf24/g, '#4ade80').replace(/#92400e/g, '#14532d')}</g>`; // 전동 드라이버는 초록
  const hc = s.tool === 'driverM' ? '#facc15' : '#dc2626', top = hy - 215;
  o += `<rect x="${sx - 5}" y="${hy - 112}" width="10" height="106" fill="#e2e8f0" stroke="#475569" stroke-width="2"/><path d="M${sx - 5},${hy - 6} L${sx},${hy + 2} L${sx + 5},${hy - 6} Z" fill="#94a3b8" stroke="#475569" stroke-width="1.5"/><rect x="${sx - 12}" y="${hy - 124}" width="24" height="14" rx="3" fill="#94a3b8" stroke="#475569" stroke-width="2"/>`
    + `<rect x="${sx - 24}" y="${top}" width="48" height="94" rx="20" fill="${hc}" stroke="#7f1d1d" stroke-width="3"/>`;
  for (let k = 0; k < 6; k++) { const a = a0 + k * Math.PI / 3, cz = Math.cos(a); if (cz > 0) o += `<line x1="${sx + 19 * Math.sin(a)}" y1="${top + 10}" x2="${sx + 19 * Math.sin(a)}" y2="${top + 84}" stroke="#7f1d1d" stroke-width="${2 + cz * 2}" opacity="${.3 + cz * .5}" stroke-linecap="round"/>`; }
  const ay = top + 47; o += `<ellipse cx="${sx}" cy="${ay}" rx="40" ry="10" fill="none" stroke="${col}" stroke-width="3" stroke-dasharray="7 5" opacity=".8"/><path d="M${sx + (cw ? -6 : 6)},${ay + 10} l${cw ? -12 : 12},0 m0,0 l${cw ? 7 : -7},-6 m${cw ? -7 : 7},6 l${cw ? 7 : -7},6" stroke="${col}" stroke-width="3.5" stroke-linecap="round" fill="none"/>`;
  return o; };
P.turn = {
  init: s => ({ ang: 0, tot: 0, drag: false, last: null, wrong: 0 }),
  reset: (s, V) => { V.tot = 0; V.ang = 0; V.wrong = 0; },
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : '');
    const R = s.R || 150, c = s.c || [430, 270], need = s.turns * 360, f = clamp(V.tot / need, 0, 1);
    const cw = s.dir === 'cw', sg = cw ? 1 : -1, col = cw ? '#7c3aed' : '#0284c7', W = R < 150 ? 20 : 24, P = t => [c[0] + R * Math.cos(t), c[1] + R * Math.sin(t)];
    o += `<circle cx="${c[0]}" cy="${c[1]}" r="${R}" fill="none" stroke="rgba(255,255,255,.75)" stroke-width="${W + 8}"/><circle cx="${c[0]}" cy="${c[1]}" r="${R}" fill="none" stroke="${cw ? '#ede9fe' : '#e0f2fe'}" stroke-width="${W}"/>`;
    if (f > 0) { const sw = Math.min(f, .999) * 2 * Math.PI, e = P(sg * sw), st = P(0); o += `<path d="M${st[0]},${st[1]} A${R},${R} 0 ${sw > Math.PI ? 1 : 0},${cw ? 1 : 0} ${e[0]},${e[1]}" fill="none" stroke="${col}" stroke-width="${W}" stroke-linecap="round" opacity=".85"/>`; }
    for (let k = 0; k < 8; k++) { const t = k * Math.PI / 4 + .2 * sg, p = P(t), d = t * 180 / Math.PI + (cw ? 90 : -90); o += `<path d="M-7,-8 L6,0 L-7,8" transform="translate(${p[0]},${p[1]}) rotate(${d})" fill="none" stroke="${col}" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>`; }
    if (!s.handle) o += `<g style="pointer-events:none">${standDriver(s, c, V, f)}</g>`;
    else { if (s.obj) o += s.obj(c, V, f); o += `<g transform="translate(${c[0]},${c[1]}) rotate(${V.ang})" style="pointer-events:none">${s.handle(V)}</g>`; }
    const hx = c[0] + R * Math.cos(V.ang * Math.PI / 180), hy = c[1] + R * Math.sin(V.ang * Math.PI / 180);
    o += `<circle cx="${hx}" cy="${hy}" r="27" fill="${col}" stroke="#fff" stroke-width="5" filter="drop-shadow(0 3px 3px rgba(0,0,0,.3))"/>` + em(hx, hy, 24, '✋');
    o += pill(c[0] < 300 ? 640 : 160, 40, `${s.label || (cw ? '시계 방향 ↻ 조이기' : '시계 반대 방향 ↺ 풀기')} ${Math.round(f * 100)}%`, col, 20);
    if (G >= 3) o += em(c[0] + R + 60, c[1] - R * .8, 64, s.dir === 'cw' ? '↻' : '↺');
    if (G >= 4 && !DONE) { const a2 = (V.ang + (s.dir === 'cw' ? 40 : -40)) * Math.PI / 180; o += arrow(hx, hy, c[0] + R * Math.cos(a2), c[1] + R * Math.sin(a2), '#16a34a'); }
    return o;
  },
  down: p => { const R = S.R || 150, c = S.c || [430, 270], hx = c[0] + R * Math.cos(V.ang * Math.PI / 180), hy = c[1] + R * Math.sin(V.ang * Math.PI / 180); if (dist(p, [hx, hy]) < 60 || Math.abs(dist(p, c) - R) < 50) { V.drag = true; V.last = Math.atan2(p[1] - c[1], p[0] - c[0]) * 180 / Math.PI; } },
  move: p => {
    if (!V.drag) return; const c = S.c || [430, 270], a = Math.atan2(p[1] - c[1], p[0] - c[0]) * 180 / Math.PI; let d = a - V.last; if (d > 180) d -= 360; if (d < -180) d += 360; V.last = a;
    const good = S.dir === 'cw' ? d : -d; V.ang += d;
    if (good < 0) { V.wrong += -good; if (V.wrong > 60) { V.drag = false; V.wrong = 0; return fail(S.wrongMsg || (S.dir === 'cw' ? '반대 방향이에요. 그쪽은 풀리는 방향이에요. 시계 방향으로 돌려요.' : '반대 방향이에요. 그쪽은 조이는 방향이에요. 시계 반대 방향으로 돌려요.'), true); } }
    else { V.wrong = Math.max(0, V.wrong - good); V.tot += good; }
    if (V.tot >= S.turns * 360) { V.drag = false; pass(); } else { if (Math.random() < .15) sfx('tap'); redraw(); }
  },
  up: () => { V.drag = false; }
};
// 11. 문지르기 (풀칠·사포질·펴 바르기)
P.rub = {
  init: s => ({ cells: {}, out: 0, drag: false, last: null, wrongDir: 0 }),
  reset: (s, V) => { V.cells = {}; V.out = 0; },
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : ''); const [x, y, w, h] = s.region, n = s.grid || [12, 5], cw = w / n[0], ch = h / n[1];
    if (G >= 3) o += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="none" stroke="#16a34a" stroke-width="4" stroke-dasharray="10 6"/>`;
    for (const k in V.cells) { const [i, j] = k.split(',').map(Number); o += `<rect x="${x + i * cw}" y="${y + j * ch}" width="${cw + .5}" height="${ch + .5}" fill="${s.col || 'rgba(250,250,210,.85)'}"/>`; }
    if (s.rough && !DONE) for (let i = 0; i < n[0]; i++) for (let j = 0; j < n[1]; j++) if (!V.cells[i + ',' + j]) o += `<circle cx="${x + (i + .5) * cw}" cy="${y + (j + .5) * ch}" r="3" fill="#78350f" opacity=".6"/>`;
    const cov = Object.keys(V.cells).length / (n[0] * n[1]);
    o += pill(430, 30, `${s.label || '칠한 곳'} ${Math.round(cov * 100)}%`, '#6d28d9', 18);
    if (s.dir && G >= 3) o += em(x + w / 2, y - 40, 44, s.dir === 'h' ? '↔️' : '↕️');
    if (G >= 4 && !DONE) o += arrow(x + 20, y + h + 40, x + w - 20, y + h + 40, '#16a34a');
    { const tp = V.last || (!DONE && !s.noTool ? rubRest(s) : null);   // 도구는 처음부터 칠할 곳 옆에 놓여 있어요 (1.1.0)
      if (tp && !s.noTool) { const gp = rubGrabPt(s, tp); if (!V.last) o += `<circle cx="${gp[0]}" cy="${gp[1]}" r="58" fill="#fde68a" opacity="${.35 + .25 * Math.sin(Date.now() / 300)}"/>` + pill(gp[0], gp[1] + 78, '잡고 끌어요', '#b45309', 16);
        o += `<g style="pointer-events:none">${(s.tool || 'glue') === 'glue' ? (q => tool('glue', q[0], q[1], .5, 20, { open: 1, up: 6 }))(glueAt(tp)) : (q => tool(s.tool, q[0], q[1], s.tool === 'sandpaper' ? .4 : .5, s.tool === 'sandpaper' ? 0 : 20, { open: 1 }))(rubAt(s, tp))}</g>`; } }
    if (DONE && s.done) o += s.done(V);
    return o;
  },
  down: p => {
    // 도구 그림을 눌러 잡으면, 도구 끝(풀 끝·손끝)이 칠하는 자리가 돼요. 그림 밖을 눌러도 예전처럼 칠해져요.
    const tp = V.last || rubRest(S);
    if (!S.noTool && tp && dist(p, rubGrabPt(S, tp)) < 80) { V.drag = true; V.grab = true; V.ent = false; V.off = [tp[0] - p[0], tp[1] - p[1]]; V.last = tp; V.dx = 0; V.dy = 0; redraw(); return; }
    V.grab = false; V.off = null; V.drag = true; V.last = p; V.dx = 0; V.dy = 0; P.rub.paint(p); redraw(); },
  move: p => {
    if (!V.drag) return; if (V.off) p = [p[0] + V.off[0], p[1] + V.off[1]]; V.dx += Math.abs(p[0] - V.last[0]); V.dy += Math.abs(p[1] - V.last[1]);
    if (S.dir && V.dx + V.dy > 120) { const bad = S.dir === 'h' ? V.dy > V.dx * 1.4 : V.dx > V.dy * 1.4; if (bad) { V.drag = false; V.dx = V.dy = 0; return fail(S.dirMsg || (S.dir === 'h' ? '나뭇결 방향(옆으로)으로 문질러요.' : '위아래로 문질러요.'), true); } V.dx = V.dy = 0; }
    const steps = Math.ceil(dist(p, V.last) / 8); for (let k = 1; k <= steps; k++) P.rub.paint([V.last[0] + (p[0] - V.last[0]) * k / steps, V.last[1] + (p[1] - V.last[1]) * k / steps]);
    V.last = p; if (S.tool === 'sandpaper' && Math.random() < .2) sfx('buzz');
    const n = S.grid || [12, 5]; if (V.out > (S.outMax ?? 40) * (G >= 4 ? 2 : 1)) { V.drag = false; return fail(S.outMsg || '테두리 밖에 묻었어요. 선 안쪽만 칠해요.'); }
    if (Object.keys(V.cells).length / (n[0] * n[1]) >= (S.need || .85)) { V.drag = false; pass(); } else redraw();
  },
  up: () => { V.drag = false; },
  paint: p => { const [x, y, w, h] = S.region, n = S.grid || [12, 5], i = Math.floor((p[0] - x) / (w / n[0])), j = Math.floor((p[1] - y) / (h / n[1])), r = S.brush || 0;
    if (V.grab && !V.ent) { if (i < 0 || j < 0 || i >= n[0] || j >= n[1]) return; V.ent = true; }   // 잡은 도구를 칠할 곳으로 옮기는 동안은 '밖에 묻음'으로 세지 않아요
    if (i < -1 || j < -1 || i > n[0] || j > n[1]) { V.out++; return; } if (i < 0 || j < 0 || i >= n[0] || j >= n[1]) { V.out += .5; return; }
    for (let a = -r; a <= r; a++) for (let b = -r; b <= r; b++) { const ii = i + a, jj = j + b; if (ii >= 0 && jj >= 0 && ii < n[0] && jj < n[1]) V.cells[ii + ',' + jj] = 1; } }
};
// 문지르기 도구가 처음 놓이는 자리(도구 끝 기준)와 잡는 자리
function rubRest(s) { const [x, y, w, h] = s.region, sp = s.tool === 'sandpaper'; let tx, ty = y + h / 2 + (sp ? 0 : 40);
  if (860 - (x + w) >= 120) tx = x + w + 70; else if (x >= 120) tx = x - 70; else { tx = Math.min(800, x + w - 40); ty = Math.min(470, y + h + (sp ? 60 : 110)); }
  return [tx, Math.max(sp ? 60 : 110, Math.min(sp ? 470 : 500, ty))]; }
// 딱풀은 풀 끝(흰 부분 맨 위)이 칠하는 자리 tp에 오도록 몸통 자리를 셈 (1.1.3)
function glueAt(tp) { const r = 20 * Math.PI / 180, L = (78 + 6) * .5; return [tp[0] - L * Math.sin(r), tp[1] + L * Math.cos(r)]; }
// 1.2.0: 손가락·롤러·샌더·필러도 그림 속 닿는 곳(손끝·롤러 몸통·샌더 바닥·필러 날)이 칠하는 자리 tp에 오게, 누르는 곳도 tp
const RUBTIP = { finger: [-19, -73], roller: [23.6, -59.3], sander: [-18.8, 35.3], peeler: [89.4, -1.8] };
function rubAt(s, tp) { if (s.tool === 'sandpaper') return tp; const c = RUBTIP[s.tool]; if (!c) return [tp[0], tp[1] - 50]; const r = 20 * Math.PI / 180, k = .5;
  return [tp[0] - k * (c[0] * Math.cos(r) - c[1] * Math.sin(r)), tp[1] - k * (c[0] * Math.sin(r) + c[1] * Math.cos(r))]; }
function rubGrabPt(s, tp) { return s.tool === 'sandpaper' ? tp : (s.tool || 'glue') === 'glue' ? glueAt(tp) : RUBTIP[s.tool] ? tp : [tp[0] + 10, tp[1] - 40]; }
// 12. 각도 맞추기 (구부리기)
P.angle = {
  init: s => ({ a: 0, drag: false }),
  draw: (s, V, G) => {
    let o = bg(s); const c = s.c || [330, 330], L = 300, a = V.a * Math.PI / 180, ex = c[0] + L * Math.cos(-a), ey = c[1] + L * Math.sin(-a);
    // 1.2.0: 바탕에 큰 각도기 — 숫자 대신 눈금을 읽어 각도를 맞춰요
    if (s.prot !== 0) { const R = 240; o += `<path d="M${c[0] - R},${c[1]} A${R},${R} 0 0,1 ${c[0] + R},${c[1]} Z" fill="rgba(254,240,138,.6)" stroke="#a16207" stroke-width="3"/><path d="M${c[0] - R + 60},${c[1]} A${R - 60},${R - 60} 0 0,1 ${c[0] + R - 60},${c[1]}" fill="none" stroke="#a16207" stroke-width="1.5" opacity=".6"/>`;
      for (let d = 0; d <= 180; d += 5) { const t = d * Math.PI / 180, l = d % 10 ? 10 : 20; o += `<line x1="${c[0] + R * Math.cos(-t)}" y1="${c[1] + R * Math.sin(-t)}" x2="${c[0] + (R - l) * Math.cos(-t)}" y2="${c[1] + (R - l) * Math.sin(-t)}" stroke="#713f12" stroke-width="${d % 10 ? 1.5 : 2.5}"/>`; if (d % 10 === 0) o += tx(c[0] + (R - 36) * Math.cos(-t), c[1] + (R - 36) * Math.sin(-t), d % 30 ? 14 : 18, d, '#713f12', d % 30 ? '' : 'font-weight="bold"'); }
      o += `<circle cx="${c[0]}" cy="${c[1]}" r="6" fill="#713f12"/>`; }
    o += `<line x1="${c[0] - 260}" y1="${c[1]}" x2="${c[0]}" y2="${c[1]}" stroke="#b45309" stroke-width="10" stroke-linecap="round"/><line x1="${c[0]}" y1="${c[1]}" x2="${ex}" y2="${ey}" stroke="#d97706" stroke-width="10" stroke-linecap="round"/>`;
    o += /* 1.2.0: 펜치 턱이 구부리는 자리 바로 앞에서 철사를 물어요 */ `<g transform="translate(${c[0] - 85},${c[1]}) scale(.85)">${TOOLART.pliers({})}</g>`;
    if (G >= 3) { const ta = s.target * Math.PI / 180; o += `<line x1="${c[0]}" y1="${c[1]}" x2="${c[0] + L * Math.cos(-ta)}" y2="${c[1] + L * Math.sin(-ta)}" stroke="#16a34a" stroke-width="${s.tol * 2.6}" opacity=".3" stroke-linecap="round"/>`; }
    o += `<path d="M${c[0] + 60},${c[1]} A60,60 0 0,0 ${c[0] + 60 * Math.cos(-a)},${c[1] + 60 * Math.sin(-a)}" fill="none" stroke="#7c3aed" stroke-width="4"/>` + (s.slot || (s.prot !== 0 && !DONE) ? '' : pill(c[0] + 110, c[1] + 50, `${Math.round(V.a)}°`, '#7c3aed', 22));
    o += `<circle cx="${ex}" cy="${ey}" r="30" fill="#7c3aed" stroke="#fff" stroke-width="5" data-drag="end"/>` + em(ex, ey, 24, '✋');
    if (s.ref) o += s.ref();
    // 1.2.0: 자물쇠 틈 — 숫자 대신 틈 모양을 보고 철사 열쇠를 같은 각도로 구부려요
    if (s.slot) { const v = [745, 215], t = s.target * Math.PI / 180, e2 = [v[0] + 95 * Math.cos(-t), v[1] + 95 * Math.sin(-t)], gr = `M${v[0] - 100},${v[1]} L${v[0]},${v[1]} L${e2[0]},${e2[1]}`;
      o += `<rect x="610" y="78" width="236" height="180" rx="18" fill="#94a3b8" stroke="#334155" stroke-width="4"/><circle cx="628" cy="96" r="6" fill="#64748b"/><circle cx="828" cy="96" r="6" fill="#64748b"/><circle cx="628" cy="240" r="6" fill="#64748b"/><circle cx="828" cy="240" r="6" fill="#64748b"/><path d="${gr}" fill="none" stroke="#0f172a" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>` + (DONE ? `<path d="${gr}" fill="none" stroke="#d97706" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>` + tx(728, 62, 20, '쏙! 딱 맞아요', '#15803d', 'font-weight="bold"') : tx(728, 62, 19, s.slotLabel || '🔒 자물쇠 틈', '#334155')); }
    o += btn(700, 486, 220, 56, '✔ 확인', 'ok', '#16a34a');
    if (G >= 4 && s.prot === 0 && !s.slot) o += pill(700, 120, `${s.target}°까지`, '#16a34a', 20);
    return o;
  },
  down: p => { const c = S.c || [330, 330], a = V.a * Math.PI / 180, e = [c[0] + 300 * Math.cos(-a), c[1] + 300 * Math.sin(-a)]; if (dist(p, e) < 60) V.drag = true; },
  move: p => { if (!V.drag) return; const c = S.c || [330, 330]; V.a = clamp(Math.round(Math.atan2(c[1] - p[1], p[0] - c[0]) * 180 / Math.PI), 0, 150); redraw(); },
  up: () => { V.drag = false; },
  act: a => { if (a !== 'ok') return; const tol = S.tol * (G >= 4 ? 2 : 1); if (Math.abs(V.a - S.target) <= tol) pass(); else fail(V.a < S.target ? '덜 구부렸어요. 조금 더 올려요.' : '너무 많이 구부렸어요. 조금 내려요.', true); }
};
// 13. 기다렸다가 하기 (예열)
P.wait = {
  init: s => ({ t: 0 }),
  reset: (s, V) => { V.t = 0; },
  draw: (s, V, G) => {
    let o = bg(s) + (s.pic ? s.pic(V, G) : ''); const f = clamp(V.t / s.sec, 0, 1), ready = f >= 1;
    o += `<rect x="230" y="80" width="400" height="34" rx="17" fill="#f1f5f9" stroke="#94a3b8" stroke-width="3"/><rect x="234" y="84" width="${392 * f}" height="26" rx="13" fill="${ready ? '#22c55e' : f > .6 ? '#f59e0b' : '#ef4444'}"/>` + tx(430, 60, 22, ready ? s.readyText || '준비됐어요!' : s.waitText || '데우는 중…', ready ? '#16a34a' : '#b45309');
    o += btn(430, 470, 260, 68, s.btn || '시작', 'go', ready ? '#16a34a' : '#94a3b8', 26);
    if (G >= 3 && !ready) o += pill(430, 150, '초록색이 될 때까지 기다려요', '#f97316', 18);
    return o;
  },
  act: a => { if (a !== 'go') return; if (V.t < S.sec) return fail(S.early || '아직 준비되지 않았어요. 초록색이 될 때까지 기다려요.'); pass(); },
  tick: dt => { if (!DONE) { V.t += dt; redraw(); } }
};
// 14. 드릴로 뚫기
// 1.2.0: 드릴 깊이 허용 범위 — 원래 범위에 목표 깊이의 5%를 더 줘요
const DTOL = t => (t.tol || 2) + (t.target || 0) * .05;
P.drill = {
  init: s => ({ on: false, depth: 0, tilt: 0, vt: 0 }),
  reset: (s, V) => { V.on = false; V.depth = 0; V.tilt = 0; },
  draw: (s, V, G) => {
    let o = bg({ bg: 'bench' }); const thick = s.thick || 40, k = 4, bx = 430, top = 260, bot = top + thick * k;
    o += wood(200, top, 460, thick * k);
    if (s.mark) o += `<line x1="${bx - 70}" y1="${top + s.target * k}" x2="${bx + 70}" y2="${top + s.target * k}" stroke="#ef4444" stroke-width="2" stroke-dasharray="6 5"/>` + tx(bx + 120, top + s.target * k, 18, `${s.target}mm`, '#ef4444');
    const d = s.bit || 8, hd = V.depth * k, BL = s.stop ? Math.max(110, s.stop * k + 26) : 110;
    if (hd > 0) o += `<rect x="${bx - d * 1.6}" y="${top}" width="${d * 3.2}" height="${hd}" fill="#78350f" opacity=".7"/>`;
    o += `<g transform="rotate(${V.tilt},${bx},${top + hd})"><rect x="${bx - d * 1.6}" y="${top - BL + hd}" width="${d * 3.2}" height="${BL}" fill="#94a3b8" stroke="#475569" stroke-width="2"/><path d="M${bx - d * 1.6},${top + hd} L${bx},${top + hd + d * 2} L${bx + d * 1.6},${top + hd} Z" fill="#94a3b8" stroke="#475569" stroke-width="2"/>` + [...Array(Math.floor(BL / 18))].map((_, i) => `<line x1="${bx - d * 1.6}" y1="${top - BL + 6 + hd + i * 18 + (V.on ? (performance.now() / 30) % 18 : 0)}" x2="${bx + d * 1.6}" y2="${top - BL + 16 + hd + i * 18 + (V.on ? (performance.now() / 30) % 18 : 0)}" stroke="#475569" stroke-width="2"/>`).join('');
    if (s.stop) o += `<rect x="${bx - 28}" y="${top - s.stop * k + hd - 12}" width="56" height="12" rx="3" fill="#ef4444" stroke="#7f1d1d" stroke-width="2"/>`;
    o += `<g transform="translate(${bx},${top - BL + hd}) scale(.65)">${drillV(V.on)}</g></g>`;
    // 기울기 표시
    const lim = (s.lim || 6) * (G >= 4 ? 1.6 : 1);
    o += `<rect x="40" y="70" width="140" height="40" rx="20" fill="#f1f5f9" stroke="#94a3b8" stroke-width="3"/><rect x="${110 - lim * 6}" y="72" width="${lim * 12}" height="36" fill="#86efac"/><circle cx="${110 + clamp(V.tilt, -12, 12) * 6}" cy="90" r="13" fill="#fff" stroke="#16a34a" stroke-width="3"/>` + tx(110, 50, 18, '똑바로', '#475569');
    o += btn(60, 200, 80, 60, '◀', 'L', '#a78bfa', 28) + btn(160, 200, 80, 60, '▶', 'R', '#a78bfa', 28);
    // 깊이
    o += `<rect x="720" y="${top}" width="30" height="${thick * k}" fill="#f1f5f9" stroke="#94a3b8" stroke-width="2"/><rect x="720" y="${top}" width="30" height="${hd}" fill="#7c3aed"/>` + tx(735, top - 22, 18, `${Math.round(V.depth)}mm`, '#4c1d95');
    if (G >= 3 && !s.stop) o += `<rect x="712" y="${top + (s.target - DTOL(s)) * k}" width="46" height="${DTOL(s) * 2 * k}" fill="none" stroke="#16a34a" stroke-width="3"/>`;
    o += btn(430, 486, 260, 60, V.on ? '⏹ 끄기' : '▶ 드릴 켜기', 'pow', V.on ? '#ef4444' : '#16a34a', 24);
    return o;
  },
  act: a => {
    if (a === 'L') { V.tilt -= 2; sfx('tap'); } if (a === 'R') { V.tilt += 2; sfx('tap'); }
    if (a === 'pow') { if (!V.on) { V.on = true; } else { V.on = false; if (!S.stop) { const tol = DTOL(S) * (G >= 4 ? 1.8 : 1); if (Math.abs(V.depth - S.target) <= tol) return pass(); if (V.depth < S.target) { say('아직 덜 뚫었어요. 다시 켜서 조금 더 뚫어요.', 'ari'); } } } }
    redraw();
  },
  tick: dt => {
    if (DONE) return; if (V.on) { V.vt += (Math.random() - .5) * (S.wob || 6) * dt * 6; V.vt *= .96; V.tilt += V.vt * dt * 4; V.depth += (S.speed || 6) * dt; if (Math.random() < .5) sfx('buzz');
      const lim = (S.lim || 6) * (G >= 4 ? 1.6 : 1);
      if (Math.abs(V.tilt) > lim) { V.on = false; return fail('드릴이 기울었어요. 구멍이 비뚤어져요. ◀ ▶로 똑바로 세우며 뚫어요.'); }
      if (S.stop && V.depth >= S.stop) { V.depth = S.stop; V.on = false; return pass(); }
      if (!S.stop && V.depth > S.target + DTOL(S) * (G >= 4 ? 1.8 : 1)) { V.on = false; return fail(V.depth >= (S.thick || 40) - 1 ? '너무 깊이 뚫어서 판자가 뚫려 버렸어요.' : '너무 깊이 뚫었어요. 빨간 선에서 멈춰요.'); }
      if (V.depth >= (S.thick || 40)) { V.on = false; return fail('판자가 뚫려 버렸어요.'); } }
    redraw();
  }
};
// 15. 찾기 (도구의 일부만 보여요)
P.find = {
  init: s => ({ got: [], miss: 0 }),
  draw: (s, V, G) => {
    let o = s.scene() + `<rect width="860" height="520" fill="transparent" data-act="miss"/>`;
    s.items.forEach((it, i) => {
      if (V.got.includes(i)) return;
      o += `<g style="pointer-events:none">${tool(it.k, it.x, it.y, it.s || .6, it.r || 0, it.o || {})}</g>`;
    });
    o += s.cover ? s.cover(V) : '';
    s.items.forEach((it, i) => { if (V.got.includes(i)) return; const h = it.hit; o += `<circle cx="${h[0]}" cy="${h[1]}" r="${h[2] || 40}" fill="transparent" data-act="find:${i}"/>`; if (G >= 3) o += `<circle cx="${h[0]}" cy="${h[1]}" r="${(h[2] || 40) + 10}" fill="none" stroke="#facc15" stroke-width="5" class="glow"/>`; if (G >= 4) o += arrow(h[0] - 80, h[1] - 80, h[0] - 30, h[1] - 30, '#f97316'); });
    return o;
  },
  act: a => {
    if (a === 'miss') { V.miss++; if (V.miss % 3 === 0) fail('그곳에는 없어요. 도구의 끝이 살짝 보이는 곳을 찾아요.', true); else { sfx('tap'); } return; }
    if (!a.startsWith('find:')) return; const i = +a.slice(5); V.got.push(i); sfx('good'); addInv(S.items[i].k);
    say(`${TOOLNAME[S.items[i].k]}을(를) 찾았어요!`, 'hami'); if (V.got.length === S.items.length) pass(); else redraw();
  }
};
// 17. 여러 개 고르기
P.pick = {
  init: s => ({ sel: {} }),
  reset: (s, V) => { V.sel = {}; },
  draw: (s, V, G) => {
    let o = bg(s); const n = s.items.length, cols = Math.min(5, n), rows = Math.ceil(n / cols), w = 860 / cols - 14, h = Math.min(200, 410 / rows - 12);
    s.items.forEach((it, i) => { const c = i % cols, r = Math.floor(i / cols), x = 7 + c * (w + 14), y = 8 + r * (h + 12), on = V.sel[i], gl = G >= 4 && !!it.ok !== !!on, dim = G >= 3 && !it.ok && !on;
      o += `<g data-act="pk:${i}" style="cursor:pointer" ${gl ? 'class="glow"' : ''} opacity="${dim ? .45 : 1}"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="18" fill="${on ? '#ede9fe' : '#fff'}" stroke="${gl ? '#facc15' : on ? '#7c3aed' : '#c4b5fd'}" stroke-width="${on || gl ? 6 : 3}"/>` + (it.img && IMG[it.img] ? `<image href="${IMG[it.img]}" x="${x + 8}" y="${y + 8}" width="${w - 16}" height="${h * .62 - 4}" preserveAspectRatio="xMidYMid meet"/>` : it.k ? tool(it.k, x + w / 2, y + h * .4, it.s || .45, 0, it.o || {}) : em(x + w / 2, y + h * .4, Math.min(64, h * .38), it.e)) +
        (it.icon ? `<g transform="translate(${x + w - 30},${y + 30}) scale(.32)">${TOOLART.mwicon({})}</g>` : '') + (it.mark ? em(x + 26, y + 26, 22, it.mark) : '') +
        `<foreignObject x="${x + 4}" y="${y + h * .7}" width="${w - 8}" height="${h * .3}"><div xmlns="http://www.w3.org/1999/xhtml" style="font:${h < 150 ? 15 : 17}px var(--font);color:#1e1b4b;text-align:center;line-height:1.15;word-break:keep-all">${it.t}</div></foreignObject>` + (on ? em(x + 20, y + h - 20, 26, '✅') : '') + `</g>`; });
    o += btn(430, 492, 240, 48, s.okText || '✔ 다 골랐어요', 'ok', '#16a34a', 22);
    return o;
  },
  act: a => {
    if (a.startsWith('pk:')) { const i = +a.slice(3); V.sel[i] = !V.sel[i]; sfx('tap'); return redraw(); }
    if (a !== 'ok') return;
    const bad = S.items.findIndex((it, i) => V.sel[i] && !it.ok); if (bad >= 0) { V.sel[bad] = false; return fail(S.items[bad].no || '고르면 안 되는 것이 있어요.', true); }
    if (S.items.some((it, i) => it.ok && !V.sel[i])) return fail(S.missMsg || '아직 고를 것이 더 있어요.', true);
    pass();
  }
};
// 1.2.0: 비트 그림 — 대각선 몸통, 위쪽 끝에 날 모양(끝 단면)이 보여요
const BITART = (() => { const hex = (cx, cy, r) => [...Array(6)].map((_, i) => `${cx + r * Math.cos(i * Math.PI / 3)},${cy + r * Math.sin(i * Math.PI / 3)}`).join(' ');
  const shank = `<rect x="-86" y="-10" width="98" height="20" fill="#9ca3af" stroke="#374151" stroke-width="2.5"/><rect x="-86" y="-10" width="98" height="6" fill="#e5e7eb"/><rect x="-86" y="4" width="98" height="6" fill="#6b7280"/><rect x="-66" y="-10" width="7" height="20" fill="#4b5563"/>`;
  const wrap = (tip, face) => `<g transform="translate(-6,8) rotate(-40)">${shank}${tip}</g>${face}`;
  const fx = 46 * Math.cos(-40 * Math.PI / 180) - 6, fy = 46 * Math.sin(-40 * Math.PI / 180) + 8, F = (x, y) => [x + fx + 14, y + fy - 14];
  const disc = (inner) => { const [cx, cy] = F(0, 0); return `<circle cx="${cx}" cy="${cy}" r="19" fill="#d1d5db" stroke="#374151" stroke-width="2.5"/>${inner(cx, cy)}`; };
  return {
    '십자(+) 비트': wrap(`<path d="M12,-10 L42,-6 L54,0 L42,6 L12,10 Z" fill="#9ca3af" stroke="#374151" stroke-width="2.5"/><path d="M24,-7 L54,0 L24,7" fill="none" stroke="#374151" stroke-width="2"/>`, disc((x, y) => `<path d="M${x - 12},${y} L${x + 12},${y} M${x},${y - 12} L${x},${y + 12}" stroke="#111827" stroke-width="5" stroke-linecap="round"/>`)),
    '일자(−) 비트': wrap(`<path d="M12,-10 L52,-3 L52,3 L12,10 Z" fill="#9ca3af" stroke="#374151" stroke-width="2.5"/>`, disc((x, y) => `<rect x="${x - 14}" y="${y - 3}" width="28" height="6" rx="2" fill="#111827"/>`)),
    '드릴 비트': `<g transform="translate(-6,8) rotate(-40)"><rect x="-86" y="-8" width="60" height="16" fill="#9ca3af" stroke="#374151" stroke-width="2.5"/><rect x="-26" y="-9" width="76" height="18" fill="#cbd5e1" stroke="#374151" stroke-width="2.5"/>` + [0, 1, 2, 3, 4].map(i => `<path d="M${-22 + i * 15},9 L${-12 + i * 15},-9" stroke="#475569" stroke-width="4"/>`).join('') + `<path d="M50,-9 L66,0 L50,9 Z" fill="#cbd5e1" stroke="#374151" stroke-width="2.5"/></g>` + (() => { const [cx, cy] = F(14, -10); return `<circle cx="${cx}" cy="${cy}" r="17" fill="#e5e7eb" stroke="#374151" stroke-width="2.5"/><path d="M${cx - 11},${cy + 6} Q${cx},${cy - 14} ${cx + 11},${cy + 6}" fill="none" stroke="#475569" stroke-width="3"/><circle cx="${cx}" cy="${cy}" r="3" fill="#111827"/>`; })(),
    '육각 비트': wrap(`<rect x="12" y="-16" width="40" height="32" rx="3" fill="#9ca3af" stroke="#374151" stroke-width="2.5"/><rect x="12" y="-16" width="40" height="9" fill="#e5e7eb"/>`, (() => { const [cx, cy] = F(6, -6); return `<polygon points="${hex(cx, cy, 21)}" fill="#d1d5db" stroke="#374151" stroke-width="2.5"/><polygon points="${hex(cx, cy, 10)}" fill="#111827"/>`; })())
  }; })();
// 1.2.0: 위에서 아래로 뚫는 전동 드릴(옆모습) — 척 끝이 (0,0), 아래를 향해요
const drillV = on => `<rect x="36" y="-134" width="84" height="34" rx="10" fill="#1f2937" stroke="#0f172a" stroke-width="3"/><rect x="44" y="-128" width="60" height="8" rx="4" fill="#f59e0b"/><path d="M42,-100 q4,14 16,14 l4,-14 z" fill="#ef4444" stroke="#7f1d1d" stroke-width="2"/><rect x="112" y="-160" width="46" height="86" rx="8" fill="#334155" stroke="#0f172a" stroke-width="3"/><rect x="118" y="-150" width="34" height="10" rx="3" fill="#f59e0b"/><rect x="118" y="-96" width="34" height="14" rx="3" fill="#475569"/>`
  + `<rect x="-34" y="-168" width="74" height="22" rx="10" fill="#1f2937" stroke="#0f172a" stroke-width="3"/><rect x="-36" y="-150" width="78" height="100" rx="18" fill="#f59e0b" stroke="#92400e" stroke-width="3"/><rect x="-24" y="-140" width="16" height="80" rx="8" fill="#fbbf24" opacity=".8"/>` + [0, 1, 2].map(i => `<line x1="14" y1="${-132 + i * 10}" x2="30" y2="${-132 + i * 10}" stroke="#92400e" stroke-width="3" stroke-linecap="round"/>`).join('')
  + `<rect x="-24" y="-54" width="48" height="14" rx="4" fill="#1f2937"/><path d="M-18,-40 L18,-40 L11,0 L-11,0 Z" fill="#4b5563" stroke="#111827" stroke-width="3"/>` + [0, 1, 2].map(i => `<line x1="${-14 + i * 2}" y1="${-32 + i * 11}" x2="${14 - i * 2}" y2="${-32 + i * 11 + (on ? ((performance.now() / 40 + i * 3) % 6) - 3 : 0)}" stroke="#9ca3af" stroke-width="2"/>`).join('');
// 1.2.0: 구부린 열쇠를 각도기로 재어 읽는 단계 (숫자는 아이가 직접 읽어요)
const angPic = t => { const c = [330, 330], R = 240, a = t * Math.PI / 180; let o = `<path d="M${c[0] - R},${c[1]} A${R},${R} 0 0,1 ${c[0] + R},${c[1]} Z" fill="rgba(254,240,138,.6)" stroke="#a16207" stroke-width="3"/>`;
  for (let d = 0; d <= 180; d += 5) { const u = d * Math.PI / 180, l = d % 10 ? 10 : 20; o += `<line x1="${c[0] + R * Math.cos(-u)}" y1="${c[1] + R * Math.sin(-u)}" x2="${c[0] + (R - l) * Math.cos(-u)}" y2="${c[1] + (R - l) * Math.sin(-u)}" stroke="#713f12" stroke-width="${d % 10 ? 1.5 : 2.5}"/>`; if (d % 10 === 0) o += tx(c[0] + (R - 36) * Math.cos(-u), c[1] + (R - 36) * Math.sin(-u), d % 30 ? 14 : 18, d, '#713f12', d % 30 ? '' : 'font-weight="bold"'); }
  return o + `<line x1="${c[0] - 260}" y1="${c[1]}" x2="${c[0]}" y2="${c[1]}" stroke="#b45309" stroke-width="10" stroke-linecap="round"/><line x1="${c[0]}" y1="${c[1]}" x2="${c[0] + 280 * Math.cos(-a)}" y2="${c[1] + 280 * Math.sin(-a)}" stroke="#d97706" stroke-width="10" stroke-linecap="round"/><circle cx="${c[0]}" cy="${c[1]}" r="7" fill="#713f12"/>`; };
const angleRead = (t, g, where) => { const cand = [t - 15, t + 15, 180 - t, t - 30, t + 30].filter((x, i, A) => x > 0 && x < 180 && x !== t && A.indexOf(x) === i).slice(0, 2), ai = t % 3, vals = cand.slice(); vals.splice(ai, 0, t);
  return { type: 'choice', title: '각도 재기', q: `구부린 열쇠를 각도기로 재요. 몇 °일까요? 각도의 ${where}가 숫자예요.`, bg: 'wall', pic: () => angPic(t), opts: vals.map(v => ({ e: '📐', t: v + '°' })), a: ai, give: g, h: '0에서 시작해서, 구부린 철사가 지나는 눈금을 읽어요.', ok: `${t}°예요. 숫자 ${g}를 얻었어요.` }; };
// 1.2.0: 택배 물건 그림 (가운데 0,0 기준, 약 100×100)
const PACKART = {
  rice: `<path d="M-34,-38 Q0,-50 34,-38 L40,42 Q0,52 -40,42 Z" fill="#f5f5f4" stroke="#57534e" stroke-width="3"/><path d="M-34,-38 L-28,-48 L-16,-40 L-4,-50 L8,-40 L20,-50 L30,-40" fill="none" stroke="#57534e" stroke-width="2.5"/><rect x="-26" y="-12" width="52" height="34" rx="6" fill="#16a34a"/><text x="0" y="12" font-size="22" text-anchor="middle" fill="#fff" font-weight="bold">쌀</text><path d="M-20,30 q4,-6 8,0 q4,-6 8,0 q4,-6 8,0 q4,-6 8,0" fill="none" stroke="#a3a3a3" stroke-width="2"/>`,
  water: [-36, -8, 20].map(x => [0, 1].map(r => `<g transform="translate(${x + r * 8},${r * 14 - 10})"><rect x="-11" y="-22" width="22" height="50" rx="7" fill="#e0f2fe" stroke="#0369a1" stroke-width="2.5"/><rect x="-11" y="0" width="22" height="12" fill="#38bdf8"/><rect x="-6" y="-32" width="12" height="10" rx="2" fill="#2563eb" stroke="#1e3a8a" stroke-width="2"/></g>`).join('')).join('') + `<rect x="-46" y="-18" width="100" height="58" rx="10" fill="rgba(186,230,253,.25)" stroke="#7dd3fc" stroke-width="2" stroke-dasharray="5 4"/><rect x="-6" y="-40" width="20" height="10" rx="4" fill="none" stroke="#475569" stroke-width="3"/>`,
  book: [['#ef4444', 12], ['#3b82f6', -6], ['#22c55e', -24]].map(([c, y], i) => `<rect x="${-38 + i * 4}" y="${y}" width="76" height="18" rx="3" fill="${c}" stroke="#1e293b" stroke-width="2.5"/><rect x="${-30 + i * 4}" y="${y + 4}" width="60" height="10" fill="#fff" opacity=".85"/>`).join(''),
  bear: `<circle cx="-24" cy="-30" r="12" fill="#b45309" stroke="#78350f" stroke-width="2.5"/><circle cx="24" cy="-30" r="12" fill="#b45309" stroke="#78350f" stroke-width="2.5"/><ellipse cx="0" cy="22" rx="28" ry="26" fill="#b45309" stroke="#78350f" stroke-width="2.5"/><circle cx="0" cy="-14" r="26" fill="#d97706" stroke="#78350f" stroke-width="2.5"/><ellipse cx="0" cy="-6" rx="11" ry="8" fill="#fde68a"/><circle cx="-9" cy="-18" r="3.5" fill="#1e293b"/><circle cx="9" cy="-18" r="3.5" fill="#1e293b"/><circle cx="0" cy="-8" r="3" fill="#1e293b"/><circle cx="-30" cy="14" r="9" fill="#d97706" stroke="#78350f" stroke-width="2"/><circle cx="30" cy="14" r="9" fill="#d97706" stroke="#78350f" stroke-width="2"/>`,
  apple: `<path d="M0,-22 C-30,-40 -48,-10 -40,16 C-32,42 -12,46 0,38 C12,46 32,42 40,16 C48,-10 30,-40 0,-22 Z" fill="#ef4444" stroke="#991b1b" stroke-width="3"/><path d="M0,-22 Q2,-36 8,-42" stroke="#78350f" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M6,-32 Q22,-44 30,-30 Q16,-26 6,-32 Z" fill="#22c55e" stroke="#15803d" stroke-width="2"/><ellipse cx="-20" cy="-6" rx="6" ry="10" fill="#fff" opacity=".45"/>`,
  can: `<rect x="-28" y="-34" width="56" height="70" fill="#e2e8f0" stroke="#334155" stroke-width="3"/><ellipse cx="0" cy="-34" rx="28" ry="8" fill="#cbd5e1" stroke="#334155" stroke-width="3"/><path d="M-28,36 A28,8 0 0 0 28,36" fill="none" stroke="#334155" stroke-width="3"/><rect x="-28" y="-18" width="56" height="38" fill="#dc2626"/><circle cx="0" cy="1" r="11" fill="#fca5a5" stroke="#fff" stroke-width="2"/>`
};
const packPic = (k, x, y, sz) => `<g transform="translate(${x},${y}) scale(${sz / 100})">${PACKART[k]}</g>`;
// 1.2.0: 택배 상자에 물건을 넣었다 뺐다 하며 무게 맞추기 (s.max를 넘지 않고 s.min 이상)
P.pack = {
  init: s => ({ inn: {} }),
  reset: (s, V) => { V.inn = {}; },
  tot: (s, V) => s.items.reduce((a, it, i) => a + (V.inn[i] ? it.kg : 0), 0),
  draw: (s, V, G) => {
    let o = bg(s); const T = P.pack.tot(s, V), over = T > s.max, sol = s.sol || [];
    s.items.forEach((it, i) => { const c = i % 2, r = Math.floor(i / 2), x = 10 + c * 212, y = 10 + r * 132, on = V.inn[i], gl = G >= 4 && sol.includes(i) !== !!on;
      o += `<g data-act="pa:${i}" style="cursor:pointer" ${gl ? 'class="glow"' : ''}><rect x="${x}" y="${y}" width="200" height="120" rx="18" fill="${on ? '#e5e7eb' : '#fff'}" stroke="${gl ? '#facc15' : on ? '#94a3b8' : '#c4b5fd'}" stroke-width="${gl ? 6 : 3}"/><g opacity="${on ? .35 : 1}">` + (it.p ? packPic(it.p, x + 52, y + 60, 82) : em(x + 52, y + 58, 54, it.e)) + tx(x + 138, y + 44, 21, it.t, '#1e1b4b') + tx(x + 138, y + 80, 26, it.kg + 'kg', '#b45309', 'font-weight="bold"') + `</g>` + (on ? tx(x + 100, y + 104, 15, '상자 안 (누르면 빼요)', '#475569') : '') + `</g>`; });
    const ins = s.items.map((it, i) => V.inn[i] ? i : -1).filter(i => i >= 0);
    o += `<rect x="470" y="330" width="370" height="26" rx="8" fill="#cbd5e1" stroke="#334155" stroke-width="3"/><rect x="490" y="356" width="330" height="80" rx="14" fill="#f1f5f9" stroke="#334155" stroke-width="3"/><rect x="565" y="370" width="180" height="52" rx="8" fill="${over ? '#7f1d1d' : '#14532d'}"/>` + tx(655, 397, 34, T + 'kg', over ? '#fecaca' : '#bbf7d0');
    o += `<path d="M500,190 L810,190 L800,330 L510,330 Z" fill="#d6a35c" stroke="#78350f" stroke-width="3"/><path d="M500,190 L460,156 L520,156 Z M810,190 L850,156 L790,156 Z" fill="#c08a46" stroke="#78350f" stroke-width="3"/><rect x="600" y="250" width="110" height="40" rx="4" fill="#fde68a" opacity=".7"/>` + tx(655, 270, 18, '📦 택배', '#78350f');
    ins.forEach((i, k) => { o += `<g data-act="pa:${i}" style="cursor:pointer">` + (s.items[i].p ? packPic(s.items[i].p, 540 + (k % 5) * 58, 158 - Math.floor(k / 5) * 48, 56) : em(540 + (k % 5) * 58, 160 - Math.floor(k / 5) * 48, 46, s.items[i].e)) + `</g>`; });
    o += tx(655, 30, 20, `목표: ${s.min}kg ~ ${s.max}kg (넘으면 안 돼요)`, '#7c2d12');
    if (G >= 2) o += tx(655, 58, 18, over ? `${T - s.max}kg 넘었어요. 하나 빼요.` : `${s.max}kg까지 ${s.max - T}kg 남았어요.`, over ? '#dc2626' : '#475569');
    o += btn(655, 492, 240, 48, '📦 보내기', 'ok', '#16a34a', 22);
    return o;
  },
  act: a => {
    if (a.startsWith('pa:')) { const i = +a.slice(3); V.inn[i] = !V.inn[i]; sfx('tap'); return redraw(); }
    if (a !== 'ok') return;
    const T = P.pack.tot(S, V);
    if (T > S.max) return fail(`${T}kg이에요. ${S.max}kg을 넘으면 보낼 수 없어요. 하나 빼요.`, true);
    if (T < S.min) return fail(`${T}kg이에요. 아직 더 담을 수 있어요.`, true);
    pass();
  }
};
// 17. 장소를 돌며 도구·재료 찾기 (방법이 여러 개면 sets 중 하나만 다 모으면 통과)
P.explore = {
  init: s => ({ pl: 0, bag: {} }),
  reset: (s, V) => { V.bag = {}; },
  draw: (s, V, G) => {
    let o = bg({ bg: 'room' }); const P0 = s.places, ph = Math.min(92, 400 / P0.length);
    P0.forEach((p, i) => { const y = 8 + i * (ph + 8), on = V.pl === i, nx = G >= 3 && P.explore.nextPlace(s, V) === i && !on;
      o += `<g data-act="pl:${i}" style="cursor:pointer" ${nx ? 'class="glow"' : ''}><rect x="8" y="${y}" width="178" height="${ph}" rx="16" fill="${on ? '#7c3aed' : '#fff'}" stroke="${nx ? '#facc15' : '#a78bfa'}" stroke-width="${nx ? 6 : 3}"/>` + em(44, y + ph / 2, Math.min(44, ph * .55), p.e) + `<text x="118" y="${y + ph / 2 + 8}" text-anchor="middle" font-size="${p.n.length > 5 ? 18 : 21}" fill="${on ? '#fff' : '#3b0764'}">${p.n}</text></g>`; });
    const its = P0[V.pl].items, cols = 4, w = 150, h = 128;
    o += `<rect x="198" y="8" width="654" height="${Math.ceil(its.length / cols) * (h + 10) + 14}" rx="18" fill="rgba(255,255,255,.75)" stroke="#c4b5fd" stroke-width="3"/>`;
    its.forEach((it, j) => { const c = j % cols, r = Math.floor(j / cols), x = 208 + c * (w + 8), y = 16 + r * (h + 10), key = V.pl + ':' + j, got = V.bag[key], gl = G >= 4 && P.explore.useful(s, V, it) && !got;
      o += `<g data-act="it:${j}" style="cursor:pointer" ${gl ? 'class="glow"' : ''} opacity="${got ? .45 : 1}"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="14" fill="#fff" stroke="${gl ? '#facc15' : '#ddd6fe'}" stroke-width="${gl ? 6 : 2}"/>` + (it.k ? tool(it.k, x + w / 2, y + 50, it.s || .36) : em(x + w / 2, y + 52, 50, it.e)) + `<text x="${x + w / 2}" y="${y + h - 14}" text-anchor="middle" font-size="${it.t.length > 7 ? 15 : 18}" fill="#1e1b4b">${it.t}</text>` + (got ? em(x + w - 20, y + 20, 26, '✅') : '') + `</g>`; });
    const bagL = Object.keys(V.bag).map(k => { const [a, b] = k.split(':'); return P0[a].items[b]; });
    o += `<rect x="8" y="430" width="844" height="84" rx="16" fill="#fef9c3" stroke="#facc15" stroke-width="3"/>` + tx(60, 480, 22, '🎒 가방', '#713f12');
    bagL.forEach((it, i) => { o += it.k ? tool(it.k, 150 + i * 70, 472, .24) : em(150 + i * 70, 474, 40, it.e); });
    if (G >= 2 && !DONE) o += tx(560, 452, 17, '필요한 것: ' + s.sets[0].join(', '), '#92400e');
    return o;
  },
  useful: (s, V, it) => s.sets.some(set => set.includes(it.t)),
  have: (s, V) => Object.keys(V.bag).map(k => { const [a, b] = k.split(':'); return s.places[a].items[b].t; }),
  nextPlace: (s, V) => { const h = P.explore.have(s, V), need = s.sets[0].filter(t => !h.includes(t)); return s.places.findIndex(p => p.items.some(it => need.includes(it.t))); },
  act: a => {
    if (a.startsWith('pl:')) { V.pl = +a.slice(3); sfx('tap'); return redraw(); }
    if (!a.startsWith('it:')) return; const j = +a.slice(3), it = S.places[V.pl].items[j], key = V.pl + ':' + j;
    if (V.bag[key]) return;
    if (!P.explore.useful(S, V, it)) return fail(it.no || `${it.t}은(는) 이번 일에 꼭 필요하지 않아요.`, true);
    V.bag[key] = 1; sfx('good');
    const h = P.explore.have(S, V); if (S.sets.some(set => set.every(t => h.includes(t)))) return pass(); redraw();
  }
};
// 18. 방법 카드를 순서대로 놓기 (정답 순서가 여러 개일 수 있어요)
P.plan = {
  // 1.2.0: 카드는 섞어서 놓아요 — 적힌 차례대로 누르면 풀리지 않게, 정답 차례와 앞 두 장이 같으면 다시 섞어요
  init: s => { const ids = s.cards.map(c => c.id); let ord = ids, k = 0;
    do { ord = ids.slice(); for (let i = ord.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)), t = ord[i]; ord[i] = ord[j]; ord[j] = t; } k++; }
    while (k < 30 && s.sols.some(so => so[0] === ord[0] || so[1] === ord[1]));
    return { seq: [], ord }; },
  reset: (s, V) => { V.seq = []; },
  best: (s, seq) => { let bi = 0, bl = -1; s.sols.forEach((so, i) => { let l = 0; while (l < seq.length && so[l] === seq[l]) l++; if (l > bl) { bl = l; bi = i; } }); return [bi, bl]; },
  draw: (s, V, G) => {
    let o = bg({ bg: 'room' }); const C = s.cards, byId = Object.fromEntries(C.map(c => [c.id, c]));
    const maxL = Math.max(...s.sols.map(x => x.length)), sw = 274, sh = 52;
    o += `<rect x="8" y="6" width="844" height="${Math.ceil(Math.max(maxL, V.seq.length + 1) / 3) * (sh + 8) + 12}" rx="16" fill="#ede9fe" stroke="#a78bfa" stroke-width="3"/>`;
    for (let i = 0; i < Math.max(maxL, V.seq.length); i++) { const c = i % 3, r = Math.floor(i / 3), x = 16 + c * (sw + 8), y = 14 + r * (sh + 8), cd = byId[V.seq[i]];
      o += `<g ${cd ? `data-act="un:${i}" style="cursor:pointer"` : ''}><rect x="${x}" y="${y}" width="${sw}" height="${sh}" rx="12" fill="${cd ? '#fff' : 'rgba(255,255,255,.4)'}" stroke="${cd ? '#7c3aed' : '#c4b5fd'}" stroke-width="2" ${cd ? '' : 'stroke-dasharray="6 5"'}/>` + badge(x + 18, y + sh / 2, i + 1, '#7c3aed') + (cd ? `<foreignObject x="${x + 36}" y="${y + 3}" width="${sw - 40}" height="${sh - 6}"><div xmlns="http://www.w3.org/1999/xhtml" style="font:16px var(--font);color:#1e1b4b;line-height:1.15;height:100%;display:flex;align-items:center;word-break:keep-all">${cd.e || ''} ${cd.t}</div></foreignObject>` : '') + `</g>`; }
    const y0 = 20 + Math.ceil(Math.max(maxL, V.seq.length + 1) / 3) * (sh + 8) + 8, pool = (V.ord ? V.ord.map(id => byId[id]) : C).filter(c => !V.seq.includes(c.id)), [bi, bl] = P.plan.best(s, V.seq), nxt = s.sols[bi][V.seq.length], ph = Math.min(66, (480 - y0 - 10) / Math.ceil(pool.length / 3) - 8);
    pool.forEach((c, j) => { const x = 16 + (j % 3) * (sw + 8), y = y0 + Math.floor(j / 3) * (ph + 8), gl = G >= 4 && bl === V.seq.length && c.id === nxt;
      o += `<g data-act="cd:${c.id}" style="cursor:pointer" ${gl ? 'class="glow"' : ''}><rect x="${x}" y="${y}" width="${sw}" height="${ph}" rx="12" fill="#fff" stroke="${gl ? '#facc15' : '#c4b5fd'}" stroke-width="${gl ? 6 : 3}"/><foreignObject x="${x + 8}" y="${y + 2}" width="${sw - 16}" height="${ph - 4}"><div xmlns="http://www.w3.org/1999/xhtml" style="font:${ph < 50 ? 15 : 17}px var(--font);color:#1e1b4b;line-height:1.15;height:100%;display:flex;align-items:center;word-break:keep-all">${c.e || ''} ${c.t}</div></foreignObject></g>`; });
    if (s.recipe && G >= 1) o += s.recipe(); // 1.2.0: 힌트를 누르면 읽었던 조리법이 다시 보여요
    if (G >= 3 && !DONE) o += tx(430, 470, 17, `💡 방법은 ${s.sols.map(x => x.length).filter((v, i, a) => a.indexOf(v) === i).join(' 또는 ')}단계예요. 필요 없는 카드도 섞여 있어요.`, '#92400e');
    o += btn(250, 500, 200, 44, '↺ 다시 놓기', 'clr', '#94a3b8', 20) + btn(610, 500, 220, 44, '✔ 이 방법으로!', 'ok', '#16a34a', 22);
    return o;
  },
  act: a => {
    if (a.startsWith('cd:')) { V.seq.push(a.slice(3)); sfx('tap'); return redraw(); }
    if (a.startsWith('un:')) { V.seq.splice(+a.slice(3), 1); sfx('tap'); return redraw(); }
    if (a === 'clr') { V.seq = []; return redraw(); }
    if (a !== 'ok') return;
    if (S.sols.some(so => so.length === V.seq.length && so.every((x, i) => x === V.seq[i]))) return pass(S.okBy ? S.okBy[S.sols.findIndex(so => so.length === V.seq.length && so.every((x, i) => x === V.seq[i]))] : null);
    if (S.badFirst && V.seq[0] === S.badFirst[0]) return fail(S.badFirst[1], true);
    const [bi, bl] = P.plan.best(S, V.seq);
    if (bl === V.seq.length && V.seq.length < S.sols[bi].length) return fail('좋아요, 여기까지는 맞아요. 다음 단계 카드를 더 놓아요.', true);
    fail(`${bl + 1}번째 카드부터 다시 생각해 봐요. ${S.no || ''}`, true);
  }
};
// ===================== 돌발 스테이지 새 활동 =====================
// ---- 소리 만들기 (60층 임시 소리, 70층 장구) ----
function nbuf(len) { const a = ac(), b = a.createBuffer(1, Math.floor(a.sampleRate * len), a.sampleRate), d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; return b; }
function snNoise(t, len, f, q, vol, type = 'bandpass', att = .002, dec) { const a = ac(), s = a.createBufferSource(); s.buffer = nbuf(len); const fl = a.createBiquadFilter(); fl.type = type; fl.frequency.value = f; fl.Q.value = q; const g = a.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att); g.gain.exponentialRampToValueAtTime(.0005, t + (dec || len)); s.connect(fl); fl.connect(g); g.connect(a.destination); s.start(t); s.stop(t + len + .05); SNDS.push(s); return fl; }
function snTone(t, f, len, vol, type = 'sine', f2) { const a = ac(), o = a.createOscillator(); o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + len); const g = a.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + .005); g.gain.exponentialRampToValueAtTime(.0005, t + len); o.connect(g); g.connect(a.destination); o.start(t); o.stop(t + len + .05); SNDS.push(o); return o; }
let SNDS = [];
function sndStop() { SNDS.forEach(s => { try { s.stop(); } catch (e) {} }); SNDS = []; }
function motor(t, len, f0, f1, vol, rough) { const a = ac(), o = a.createOscillator(); o.type = 'sawtooth'; o.frequency.setValueAtTime(f0, t); f1.forEach(([dt, f]) => o.frequency.linearRampToValueAtTime(f, t + dt)); const fl = a.createBiquadFilter(); fl.type = 'bandpass'; fl.frequency.value = 900; fl.Q.value = .8; const g = a.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + .08); g.gain.setValueAtTime(vol, t + len - .1); g.gain.linearRampToValueAtTime(0, t + len); o.connect(fl); fl.connect(g); g.connect(a.destination); o.start(t); o.stop(t + len + .05); SNDS.push(o);
  if (rough) { const lfo = a.createOscillator(), lg = a.createGain(); lfo.frequency.value = rough; lg.gain.value = vol * .9; lfo.connect(lg); lg.connect(g.gain); lfo.start(t); lfo.stop(t + len); SNDS.push(lfo); } }
// 60층 도구 소리: 공유마당 음원을 잘라 썼어요. 없거나 못 읽으면 앱에서 만든 소리로 대신해요.
// 망치·전자레인지·드릴 = 한국저작권위원회(CC BY) · 톱 = (재)전주정보문화산업진흥원(공공누리 1유형)
// 테이프 = JICA(공공누리 1유형) · 전동드라이버(박기·헛돌기) = (재)전주정보문화산업진흥원(공공누리 1유형, 헛도는 소리는 잘게 끊어 만듦)
const SNDREC = {hammer: 'data:audio/mpeg;base64,', saw: 'data:audio/mpeg;base64,', micro: 'data:audio/mpeg;base64,', tape: 'data:audio/mpeg;base64,', drv_high: 'data:audio/mpeg;base64,', drv_slip: 'data:audio/mpeg;base64,', drill_hole: 'data:audio/mpeg;base64,'}, SNDBUF = {};
function sndLoad(k) { if (!SNDREC[k] || SNDBUF[k]) return; SNDBUF[k] = 'wait'; try { fetch(SNDREC[k]).then(r => r.arrayBuffer()).then(b => ac().decodeAudioData(b)).then(bf => { SNDBUF[k] = bf; }).catch(() => { SNDBUF[k] = null; }); } catch (e) { SNDBUF[k] = null; } }
const SND = {
  hammer: () => { const t = ac().currentTime + .05; for (let i = 0; i < 3; i++) { const u = t + i * .55; snTone(u, 2600, .25, .35, 'triangle'); snTone(u, 3900, .18, .15, 'triangle'); snNoise(u, .06, 2500, 1, .6); snTone(u, 180, .12, .4, 'sine', 90); } return 1.8; },
  saw: () => { const t = ac().currentTime + .05; for (let i = 0; i < 6; i++) { const u = t + i * .38, f = snNoise(u, .3, i % 2 ? 2600 : 3400, 2.5, .45, 'bandpass', .12, .3); f.frequency.linearRampToValueAtTime(i % 2 ? 2200 : 3800, u + .28); } return 2.4; },
  micro: () => { const t = ac().currentTime + .05; motor(t, 2.2, 120, [], .12); snNoise(t, 2.2, 300, .7, .08, 'lowpass', .1, 2.2); snTone(t + 2.35, 1975, 1.2, .35); snTone(t + 2.35, 3950, .6, .08); return 3.7; },
  tape: () => { const t = ac().currentTime + .05; const f = snNoise(t, .8, 1200, 1.5, .45, 'bandpass', .03, .8); f.frequency.linearRampToValueAtTime(2800, t + .75); snNoise(t + .9, .06, 3000, 2, .7); snTone(t + .9, 900, .06, .3, 'square'); return 1.3; },
  drv_high: () => { const t = ac().currentTime + .05; motor(t, 2.6, 160, [[2.2, 120], [2.45, 60]], .14); snTone(t + 2.45, 300, .12, .4, 'square'); return 3; },
  drv_slip: () => { const t = ac().currentTime + .05; motor(t, 2.6, 160, [[1.4, 110]], .14, 0); motor(t + 1.5, 1.1, 90, [], .16, 22); return 3; },
  drill_hole: () => { const t = ac().currentTime + .05; motor(t, 2.6, 260, [[2.6, 245]], .12); snNoise(t + .2, 2.3, 1800, 1, .08, 'bandpass', .3, 2.3); return 3; },
};
function playSnd(k) { sndStop(); if (!soundOn) return 0; const bf = SNDBUF[k]; if (bf && bf !== 'wait') { const a = ac(), s = a.createBufferSource(); s.buffer = bf; s.connect(a.destination); s.start(); SNDS.push(s); return bf.duration; } sndLoad(k); return SND[k] ? SND[k]() : 0; }
// 장구 (앱에서 만든 소리)
// 장구: 공유마당 '전통악기_장구_치다_보통속도_Ver.1'((재)전주정보문화산업진흥원, 공공누리 1유형)에서 잘라 낸 덩·쿵·덕. 못 읽으면 만든 소리로 대신해요.
const JGREC = {"kung": "data:audio/mpeg;base64,", "deok": "data:audio/mpeg;base64,", "deong": "data:audio/mpeg;base64,"}, JGBUF = {};
function jgLoad() { Object.entries(JGREC).forEach(([k, u]) => { if (JGBUF[k]) return; JGBUF[k] = 'wait'; fetch(u).then(r => r.arrayBuffer()).then(b => ac().decodeAudioData(b)).then(bf => { JGBUF[k] = bf; }).catch(() => { JGBUF[k] = null; }); }); }
function jgPlay(k, t, vol = 1.2) { const bf = JGBUF[k]; if (!bf || bf === 'wait') return false; const a = ac(), s = a.createBufferSource(), g = a.createGain(); s.buffer = bf; g.gain.value = vol; s.connect(g); g.connect(a.destination); s.start(Math.max(t, a.currentTime)); SNDS.push(s); return true; }
const JG = {
  kung: t => { if (jgPlay('kung', t)) return; snTone(t, 115, .5, .7, 'sine', 70); snNoise(t, .08, 500, .7, .2, 'lowpass'); },
  deok: t => { if (jgPlay('deok', t)) return; snNoise(t, .05, 3200, 1.2, .6); snTone(t, 520, .06, .3, 'triangle', 430); },
  deong: t => { if (jgPlay('deong', t)) return; JG.kung(t); JG.deok(t); },
  durr: (t, len = .4) => { for (let i = 0; i < len / .045; i++) snNoise(t + i * .045, .04, 3000, 1.2, .25 + .1 * Math.sin(i)); },
};
// ---- 10·20층: 짝 맞추기 ----
P.memory = {
  init: s => { const ks = [...s.keys].sort(() => Math.random() - .5).slice(0, s.pairs), deck = [...ks, ...ks].map((k, i) => ({ k, i })); for (let i = deck.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [deck[i], deck[j]] = [deck[j], deck[i]]; }
    const V = { deck, up: {}, done: {}, open: [], lock: true, peek: true, wrong: 0 }; setTimeout(() => { if (V === window.V_MEM) { V.peek = false; V.lock = false; redraw(); } }, (s.peek || 2.5) * 1000); window.V_MEM = V; return V; },
  draw: (s, V, G) => {
    let o = bg({ bg: 'room' }); const n = V.deck.length, cols = n <= 8 ? 4 : 4, rows = Math.ceil(n / cols), cw = n <= 8 ? 170 : 150, ch = n <= 8 ? 200 : 112, gx = 14, x0 = 430 - (cols * cw + (cols - 1) * gx) / 2, y0 = n <= 8 ? 40 : 14;
    V.deck.forEach((c, i) => { const x = x0 + (i % cols) * (cw + gx), y = y0 + Math.floor(i / cols) * (ch + 10), show = V.peek || V.up[i] || V.done[i];
      const hl = G >= 3 && !show && V.open.length === 1 && V.deck[V.open[0]].k === c.k;
      o += `<g data-act="mc:${i}" style="cursor:pointer" ${hl ? 'class="glow"' : ''}><rect x="${x}" y="${y + 5}" width="${cw}" height="${ch}" rx="18" fill="rgba(76,29,149,.25)"/><rect x="${x}" y="${y}" width="${cw}" height="${ch}" rx="18" fill="${V.done[i] ? '#dcfce7' : show ? '#fff' : '#7c3aed'}" stroke="${hl ? '#facc15' : V.done[i] ? '#22c55e' : '#a78bfa'}" stroke-width="${hl ? 7 : 4}"/>`;
      o += show ? tool(c.k, x + cw / 2, y + ch / 2, Math.min(cw, ch) / 260) : `${tx(x + cw / 2, y + ch / 2, ch * .38, '?', '#ede9fe')}`;
      o += '</g>'; });
    if (V.peek) o += pill(430, 500, '잘 봐 두세요! 곧 뒤집혀요', '#7c3aed', 22);
    else o += tx(430, 500, 20, `틀리게 뒤집은 횟수: ${V.wrong}번`, '#4c1d95');
    return o;
  },
  act: a => { if (!a.startsWith('mc:') || V.lock || V.open.length >= 2) return; const i = +a.slice(3); if (V.up[i] || V.done[i]) return; sfx('tap'); V.up[i] = 1; V.open.push(i); redraw();
    if (V.open.length < 2) return; const [p, q] = V.open; V.lock = true;
    if (V.deck[p].k === V.deck[q].k) { setTimeout(() => { V.done[p] = V.done[q] = 1; V.open = []; V.lock = false; sfx('good'); redraw(); if (Object.keys(V.done).length === V.deck.length) pass(S.ok); }, 350); }
    else setTimeout(() => { V.up = {}; V.open = []; V.lock = false; V.wrong++; if (V.wrong > S.pairs) { MISS++; } if (V.wrong === S.pairs * 2) hint(3, '같은 그림이 어디 있었는지 떠올려 봐요.'); redraw(); }, 900); }
};
// ---- 30·40층: 틀린 그림 찾아 고쳐 끼우기 ----
// spots: [{ x, y, r, name, q, opts:[{e,t}], a, ok }] (그림 좌표: 860×430 안)
P.spotfix = {
  init: s => ({ fixed: {}, phase: 'find', cur: -1, piece: null, drag: false, off: {} }),
  draw: (s, V, G) => {
    let o = `<rect width="860" height="520" fill="#fef9c3"/>`; const W = 860, H = 430;
    o += `<image href="${IMG[s.danger]}" x="0" y="0" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice"/>`;
    o += `<defs>${s.spots.map((p, i) => `<clipPath id="sc${i}"><circle cx="${p.x}" cy="${p.y}" r="${p.r}"/></clipPath>`).join('')}</defs>`;
    const pimg = (p, dx = 0, dy = 0) => `<image href="${IMG[p.patch]}" x="${p.pb[0] + dx}" y="${p.pb[1] + dy}" width="${p.pb[2] - p.pb[0]}" height="${p.pb[3] - p.pb[1]}"/>`;
    s.spots.forEach((p, i) => { if (V.fixed[i]) o += (p.patch ? pimg(p) : `<g clip-path="url(#sc${i})"><image href="${IMG[s.safe]}" x="0" y="0" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice"/></g>`) + `<circle cx="${p.x}" cy="${p.y}" r="${p.r}" fill="none" stroke="#22c55e" stroke-width="5"/>`; });
    // 1.2.0: 책상 위 물건 제자리 이름표 — 이름표만 있고 물건이 없으면 빠진 것을 알아챌 수 있어요
    o += (s.tags || []).map(g => { const w = g.t.length * 15 + 18; return `<g style="pointer-events:none"><rect x="${g.x - w / 2}" y="${g.y - 13}" width="${w}" height="26" rx="6" fill="#fffbeb" stroke="#92400e" stroke-width="2"/>${tx(g.x, g.y + 6, 15, g.t, '#78350f')}</g>`; }).join('');
    if (V.phase === 'find') { s.spots.forEach((p, i) => { if (V.fixed[i]) return; /* 1.2.0: 빠진 물건 자리는 처음엔 이름표만, 점선은 힌트를 누른 뒤에 */ if (p.miss && G >= 2) o += `<g style="pointer-events:none"><ellipse cx="${p.x}" cy="${p.y}" rx="${p.r * 1.25}" ry="${p.r * .8}" fill="rgba(255,255,255,.35)" stroke="#475569" stroke-width="3" stroke-dasharray="9 7"/>${G >= 2 ? tx(p.x, p.y + 10, 30, '?', '#475569') : ''}</g>`; o += `<circle data-act="sp:${i}" cx="${p.x}" cy="${p.y}" r="${p.r}" fill="transparent"/>`; if (G >= 3) o += `<circle cx="${p.x}" cy="${p.y}" r="${p.r + 6}" fill="none" stroke="#facc15" stroke-width="6" stroke-dasharray="10 8" ${G >= 4 ? 'class="glow"' : ''}/>`; });
      o += `<rect data-act="miss" x="0" y="0" width="${W}" height="${H}" fill="transparent" style="pointer-events:${V.phase === 'find' ? 'auto' : 'none'}"/>`;
      s.spots.forEach((p, i) => { if (!V.fixed[i]) o += `<circle data-act="sp:${i}" cx="${p.x}" cy="${p.y}" r="${p.r}" fill="transparent"/>`; });
      o += `<rect y="${H}" width="860" height="${520 - H}" fill="#ede9fe"/>` + tx(430, H + 45, 24, `위험한 곳을 찾아 눌러요. (${Object.keys(V.fixed).length} / ${s.spots.length} 고침)`, '#4c1d95');
    } else if (V.phase === 'fix') { const p = s.spots[V.cur]; o += `<circle cx="${p.x}" cy="${p.y}" r="${p.r}" fill="none" stroke="#ef4444" stroke-width="6"/><rect width="860" height="${H}" fill="rgba(30,10,60,.35)"/>`;
      o += `<rect x="20" y="${H - 150}" width="820" height="${520 - H + 150 - 10}" rx="20" fill="#fff" stroke="#c4b5fd" stroke-width="4"/>` + tx(430, H - 120, 24, p.q, '#4c1d95');
      const n = p.opts.length, w = 780 / n - 12; p.opts.forEach((op, j) => { const x = 40 + j * (w + 12), y = H - 90, gl = G >= 4 && j === p.a; o += `<g data-act="fx:${j}" style="cursor:pointer" opacity="${V.off[j] ? .3 : 1}" ${gl ? 'class="glow"' : ''}><rect x="${x}" y="${y}" width="${w}" height="170" rx="18" fill="#faf5ff" stroke="${gl ? '#facc15' : '#a78bfa'}" stroke-width="${gl ? 7 : 3}"/>${em(x + w / 2, y + 55, 60, op.e)}<foreignObject x="${x + 6}" y="${y + 96}" width="${w - 12}" height="70"><div xmlns="http://www.w3.org/1999/xhtml" style="font:20px var(--font);color:#1e1b4b;text-align:center;line-height:1.2;word-break:keep-all">${op.t}</div></foreignObject></g>`; });
    } else if (V.phase === 'place') { const p = s.spots[V.cur], pc = V.piece;
      o += `<circle cx="${p.x}" cy="${p.y}" r="${p.r}" fill="rgba(255,255,255,.55)" stroke="#16a34a" stroke-width="5" stroke-dasharray="12 8" ${G >= 3 ? 'class="glow"' : ''}/>`;
      o += `<rect y="${H}" width="860" height="${520 - H}" fill="#ede9fe"/>` + tx(430, H + 45, 22, '바르게 고친 그림 조각을 끌어서 제자리에 끼워요. (조각을 톡 눌러도 돼요)', '#4c1d95');
      o += p.patch ? `<g opacity=".35">${pimg(p)}</g><g data-drag="pc" style="cursor:grab;filter:drop-shadow(0 0 6px #fff) drop-shadow(0 6px 10px rgba(0,0,0,.45))"><circle cx="${pc[0]}" cy="${pc[1]}" r="${p.r}" fill="transparent"/>${p.piece ? `<image href="${IMG[p.piece]}" x="${p.ob[0] + pc[0] - p.x}" y="${p.ob[1] + pc[1] - p.y}" width="${p.ob[2] - p.ob[0]}" height="${p.ob[3] - p.ob[1]}"/>` : pimg(p, pc[0] - p.x, pc[1] - p.y)}</g>` : `<defs><clipPath id="pcl"><circle cx="${pc[0]}" cy="${pc[1]}" r="${p.r}"/></clipPath></defs><g data-drag="pc" style="cursor:grab"><g clip-path="url(#pcl)"><image href="${IMG[s.safe]}" x="${pc[0] - p.x}" y="${pc[1] - p.y}" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice"/></g><circle cx="${pc[0]}" cy="${pc[1]}" r="${p.r}" fill="transparent" stroke="#fff" stroke-width="6"/></g>`;
      if (G >= 4) o += arrow(pc[0], pc[1], p.x, p.y, '#16a34a');
    }
    return o;
  },
  act: a => { const s = S;
    if (V.phase === 'find') { if (a.startsWith('sp:')) { const i = +a.slice(3); if (V.fixed[i]) return; V.cur = i; V.phase = 'fix'; V.off = {}; sfx('good'); $('fb').innerHTML = `🔎 ${s.spots[i].name}`; say(s.spots[i].name + ' ' + s.spots[i].q, 'ari', [s.spots[i].name]); redraw(); } else if (a === 'miss') fail('그곳은 괜찮아요. 위험해 보이는 곳을 다시 찾아봐요.', true); return; }
    if (V.phase === 'fix' && a.startsWith('fx:')) { const j = +a.slice(3), p = s.spots[V.cur]; if (j === p.a) { V.phase = 'place'; const bw = p.pb[2] - p.pb[0], bh = p.pb[3] - p.pb[1], ox = p.x - p.pb[0], oy = p.y - p.pb[1]; const lx = p.x < 430 ? 860 - bw - 10 : 10; V.piece = [lx + ox, Math.min(430 - bh - 5, Math.max(5, p.pb[1])) + oy]; sfx('good'); $('fb').innerHTML = `✅ ${p.ok}`; say(p.ok, 'hami', [p.ok]); redraw(); } else { V.off[j] = 1; fail(p.no || '그렇게 하면 위험해요. 다시 골라요.', true); } }
  },
  down: p => { if (V.phase !== 'place') return; const pc = V.piece, sp = S.spots[V.cur], b = sp.piece ? sp.ob : sp.pb, dx = pc[0] - sp.x, dy = pc[1] - sp.y; const inBox = b && p[0] > b[0] + dx - 25 && p[0] < b[2] + dx + 25 && p[1] > b[1] + dy - 25 && p[1] < b[3] + dy + 25; if (inBox || Math.hypot(p[0] - pc[0], p[1] - pc[1]) < sp.r + 20) { V.drag = [p[0] - pc[0], p[1] - pc[1]]; V.d0 = p.slice(); V.mv = 0; } else if (Math.hypot(p[0] - sp.x, p[1] - sp.y) < sp.r) { V.drag = [0, 0]; V.d0 = p.slice(); V.mv = 0; V.tapT = 1; } },
  move: p => { if (!V.drag) return; V.mv = Math.max(V.mv || 0, Math.hypot(p[0] - V.d0[0], p[1] - V.d0[1])); if (V.tapT) return; V.piece = [p[0] - V.drag[0], p[1] - V.drag[1]]; redraw(); },
  up: p => { if (!V.drag) return; V.drag = false; const tap = (V.mv || 0) < 12, tt = V.tapT; V.tapT = 0; const sp = S.spots[V.cur], pc = V.piece; if (tap || tt || Math.hypot(pc[0] - sp.x, pc[1] - sp.y) < Math.max(70, sp.r * .9) * (G >= 4 ? 1.5 : 1)) { V.piece = [sp.x, sp.y]; V.fixed[V.cur] = 1; V.phase = 'find'; V.cur = -1; sfx('good'); if (Object.keys(V.fixed).length === S.spots.length) return pass(S.ok); $('fb').innerHTML = `딸깍! 제자리에 끼웠어요. 남은 위험한 곳을 찾아요.`; redraw(); } else { redraw(); } }
};
// ---- 60층: 소리 듣고 고르기 (P.choice에 s.snd 지원) ----
// ---- 70층: 도구 리듬 게임 (장구 장단) ----
// 단추를 누르면 나는 도구 소리 (망치 탕 · 톱 쓱 · 드라이버 드르륵 · 사포 사각)
const RH_HIT = [t => { snTone(t, 2600, .2, .3, 'triangle'); snNoise(t, .05, 2500, 1, .5); snTone(t, 180, .1, .35, 'sine', 90); }, t => { const f = snNoise(t, .25, 2600, 2.5, .45, 'bandpass', .06, .25); f.frequency.linearRampToValueAtTime(3800, t + .22); }, t => motor(t, .3, 170, [], .14), t => snNoise(t, .2, 1500, .8, .35, 'bandpass', .04, .2)];
const RH_LANES = [['claw', '망치', '#f97316'], ['saw', '톱', '#0ea5e9'], ['driverP', '드라이버', '#a855f7'], ['sandpaper', '사포', '#22c55e']];
P.rhythm = {
  init: s => { jgLoad(); return { run: false, t: 0, notes: [], hit: 0, total: 0, flash: {}, res: null, speed: 1 }; },
  reset: (s, V) => { Object.assign(V, P.rhythm.init(s)); },
  chart: (s, slow) => { // 굿거리(느림) → 세마치 → 자진모리(빠름)
    const parts = [[70, 6, [0, 1.5, 3, 4.5]], [92, 6, [0, 1, 2]], [116, 7, [0, 1, 1.5, 2.5]]], out = []; let t = 2.2, sp = slow ? .8 : 1;
    parts.forEach(([bpm, bars, pat], pi) => { const beat = 60 / (bpm * sp), barLen = pi === 0 ? 6 : pi === 1 ? 3 : 4; for (let b = 0; b < bars; b++) { pat.forEach((p, k) => { const lane = (b * 3 + k * (pi + 1)) % 4; out.push({ t: t + p * beat, lane, jg: k === 0 ? 'deong' : k % 2 ? 'deok' : 'kung' }); if (pi === 2 && b % 2 === 1 && k === 2) out.push({ t: t + p * beat, lane: (lane + 2) % 4, jg: 'deok', dbl: 1 }); }); t += barLen * beat; } });
    return out;
  },
  draw: (s, V, G) => {
    let o = `<rect width="860" height="520" fill="#1e1b4b"/>`; const lx = i => 215 + i * 145, JL = 400;
    RH_LANES.forEach(([k, n, c], i) => { o += `<rect x="${lx(i) - 62}" y="0" width="124" height="${JL + 40}" fill="${c}" opacity="${V.flash[i] ? .45 : .12}"/>`; });
    o += `<rect x="140" y="${JL - 6}" width="590" height="12" rx="6" fill="#fde047"/>`;
    if (V.run) V.notes.forEach(nt => { if (nt.done) return; const y = JL - (nt.t - V.t) * 260 * V.speed; if (y < -60 || y > JL + 60) return; o += `<g>${`<circle cx="${lx(nt.lane)}" cy="${y}" r="44" fill="#fff" stroke="${RH_LANES[nt.lane][2]}" stroke-width="6"/>`}${tool(RH_LANES[nt.lane][0], lx(nt.lane), y, .3)}</g>`; });
    RH_LANES.forEach(([k, n, c], i) => { o += `<g data-act="rh:${i}" style="cursor:pointer"><rect x="${lx(i) - 66}" y="${JL + 18}" width="132" height="100" rx="20" fill="${c}" stroke="#fff" stroke-width="${V.flash[i] ? 8 : 3}"/>${tool(k, lx(i), JL + 58, .26)}${tx(lx(i), JL + 104, 18, n, '#fff')}</g>`; });
    o += tx(70, 40, 20, '맞힘', '#c4b5fd') + tx(70, 72, 34, `${V.hit}`, '#fde047');
    if (!V.run) o += `<rect x="190" y="120" width="480" height="${V.res ? 220 : 180}" rx="24" fill="#fff"/>` + (V.res ? tx(430, 170, 30, V.res, '#4c1d95') : tx(430, 165, 24, '도구가 노란 줄에 닿을 때', '#4c1d95') + tx(430, 200, 24, '아래 같은 도구 단추를 눌러요!', '#4c1d95')) + btn(430, V.res ? 290 : 255, 220, 60, V.res ? '↺ 다시 하기' : '▶ 시작', 'rhgo', '#16a34a', 26);
    return o;
  },
  act: a => {
    if (a === 'rhgo') { V.notes = P.rhythm.chart(S, MISS >= 2 || G >= 3); V.total = V.notes.length; V.hit = 0; V.t = 0; V.res = null; V.run = true; V.speed = 1; V.start = ac().currentTime; V.notes.forEach(nt => JG[nt.jg] && nt.t > 0 && JG[nt.jg](V.start + nt.t)); redraw(); return; }
    if (!a.startsWith('rh:') || !V.run) return; const i = +a.slice(3); const VF = V.flash; VF[i] = 1; setTimeout(() => { VF[i] = 0; }, 120);
    const win = (MISS >= 2 || G >= 3) ? .3 : .22; const nt = V.notes.find(n => !n.done && n.lane === i && Math.abs(n.t - V.t) < win);
    if (nt) { nt.done = 1; V.hit++; const t0 = ac().currentTime; RH_HIT[i](t0); }
  },
  tick: dt => { if (!V.run) return; V.t = ac().currentTime - V.start; V.notes.forEach(n => { if (!n.done && n.t < V.t - .35) n.done = 2; });
    if (V.t > V.notes[V.notes.length - 1].t + 1) { V.run = false; const r = V.hit / V.total, pct = Math.round(r * 100);
      if (r >= .9) { V.res = `${pct}% 맞혔어요! 최고예요!`; redraw(); return pass(`${pct}%! 장구 장단에 맞춰 도구를 척척 눌렀어요.`); }
      if (r >= .7) { MISS += 1; V.res = `${pct}% 통과!`; redraw(); return pass(`${pct}% 맞혀서 통과! 90%를 넘으면 별 3개예요.`); }
      V.res = `${pct}% 맞혔어요`; fail(`70%를 넘어야 통과예요. (지금 ${pct}%) ${MISS >= 2 ? '이번엔 조금 느리게 내려와요.' : ''}`, true); redraw(); return; }
    redraw(); }
};
// ---- 90층: 『개미』 수열 ----
P.ant = {
  init: s => ({ v: '' }),
  draw: (s, V, G) => {
    let o = `<rect width="860" height="520" fill="#fffbeb"/>`; const L = s.lines;
    L.forEach((ln, i) => { const y = 34 + i * 52; o += `<g>${tx(250, y, 34, ln, '#334155', 'style="font-family:monospace;letter-spacing:6px"')}</g>`; });
    const last = L[L.length - 1], y8 = 34 + L.length * 52;
    if (G >= 3) { let gx = 250 - last.length * 13.5, groups = last.match(/(\d)\1*/g); const cols = ['#fde047', '#86efac', '#93c5fd', '#f9a8d4', '#fdba74']; groups.forEach((g, k) => { o = o.replace(/$/, ''); o += `<rect x="${gx - 2}" y="${34 + (L.length - 1) * 52 - 24}" width="${g.length * 27 + 4}" height="48" rx="10" fill="${cols[k % 5]}" opacity=".55"/>`; gx += g.length * 27; }); o += tx(250, 34 + (L.length - 1) * 52, 34, last, '#334155', 'style="font-family:monospace;letter-spacing:6px"'); }
    for (let i = 0; i < s.ans.length; i++) { const x = 250 - (s.ans.length - 1) * 21 + i * 42; o += `<rect x="${x - 18}" y="${y8 - 24}" width="36" height="48" rx="8" fill="#fff" stroke="#7c3aed" stroke-width="3"/>` + tx(x, y8, 30, V.v[i] || '', '#4c1d95'); }
    [1, 2, 3, '⌫', 4, 5, 6, '↵'].forEach((k, i) => { const x = 590 + (i % 4) * 62, y = 300 + Math.floor(i / 4) * 66; o += `<g data-act="ak:${k}" style="cursor:pointer"><rect x="${x - 27}" y="${y - 27}" width="54" height="54" rx="12" fill="${k === '↵' ? '#16a34a' : k === '⌫' ? '#94a3b8' : '#7c3aed'}"/>${tx(x, y + 1, 26, k, '#fff')}</g>`; });
    o += `<foreignObject x="560" y="40" width="280" height="230"><div xmlns="http://www.w3.org/1999/xhtml" style="font:21px var(--font);color:#4c1d95;line-height:1.5;word-break:keep-all">${s.clue}</div></foreignObject>`;
    return o;
  },
  act: a => { if (!a.startsWith('ak:')) return; const k = a.slice(3); sfx('tap'); if (k === '⌫') V.v = V.v.slice(0, -1); else if (k === '↵') { if (V.v === S.ans) return pass(); V.v = ''; return fail('같은 숫자끼리 묶어서 읽어 봐요.', true); } else if (V.v.length < S.ans.length) V.v += k; redraw(); }
};
// 16. 비밀번호
P.code = {
  init: s => ({ v: '' }),
  draw: (s, V, G) => {
    let o = bg({ bg: 'room' }) + `<rect x="300" y="40" width="260" height="420" rx="20" fill="#7c2d12"/><rect x="316" y="56" width="228" height="388" rx="14" fill="#a16207"/><circle cx="520" cy="250" r="12" fill="#fde047"/>`;
    o += `<rect x="610" y="90" width="220" height="330" rx="18" fill="#1e293b"/><rect x="630" y="108" width="180" height="56" rx="10" fill="#14532d"/>` + tx(720, 137, s.ans.length > 6 ? 22 : 34, (V.v + '_'.repeat(s.ans.length)).slice(0, s.ans.length).split('').join(s.ans.length > 6 ? '' : ' '), '#bbf7d0', 'style="font-family:monospace"');
    [1, 2, 3, 4, 5, 6, 7, 8, 9, '⌫', 0, '↵'].forEach((k, i) => { const x = 655 + (i % 3) * 65, y = 200 + Math.floor(i / 3) * 56; o += `<g data-act="key:${k}" style="cursor:pointer"><rect x="${x - 28}" y="${y - 23}" width="56" height="46" rx="10" fill="${k === '↵' ? '#16a34a' : '#475569'}"/>${tx(x, y + 1, 24, k, '#fff')}</g>`; });
    o += `<foreignObject x="30" y="60" width="250" height="400"><div xmlns="http://www.w3.org/1999/xhtml" style="font:22px var(--font);color:#4c1d95;line-height:1.5;word-break:keep-all">${s.clue || '모은 숫자 쪽지를 순서대로 눌러요.'}</div></foreignObject>`;
    if (G >= 4) o += pill(720, 470, `비밀번호: ${s.ans}`, '#16a34a', 20);
    return o;
  },
  act: a => { if (!a.startsWith('key:')) return; const k = a.slice(4); sfx('tap'); if (k === '⌫') V.v = V.v.slice(0, -1); else if (k === '↵') { if (V.v === S.ans) return pass(); V.v = ''; return fail('비밀번호가 틀렸어요. 쪽지의 순서를 확인해요.', true); } else if (V.v.length < S.ans.length) V.v += k; redraw(); }
};

// ===================== 진행 =====================
const IMG = {"c_awl": "data:image/webp;base64,", "c_claw": "data:image/webp;base64,", "c_clawpull": "data:image/webp;base64,", "c_grip": "data:image/webp;base64,", "c_hand": "data:image/webp;base64,", "c_k24_1_0": "data:image/webp;base64,", "c_k24_1_1": "data:image/webp;base64,", "c_k24_1_2": "data:image/webp;base64,", "c_k24_3_0": "data:image/webp;base64,", "c_k24_3_1": "data:image/webp;base64,", "c_k24_3_2": "data:image/webp;base64,", "c_k24_7_0": "data:image/webp;base64,", "c_k24_7_1": "data:image/webp;base64,", "c_k24_7_2": "data:image/webp;base64,", "c_k24_8_0": "data:image/webp;base64,", "c_k24_8_1": "data:image/webp;base64,", "c_k24_8_2": "data:image/webp;base64,", "c_k24_9_0": "data:image/webp;base64,", "c_k24_9_1": "data:image/webp;base64,", "c_k24_9_2": "data:image/webp;base64,", "c_k26_4_0": "data:image/webp;base64,", "c_k26_4_1": "data:image/webp;base64,", "c_k26_4_2": "data:image/webp;base64,", "c_k28_4_0": "data:image/webp;base64,", "c_k28_4_1": "data:image/webp;base64,", "c_k28_4_2": "data:image/webp;base64,", "c_k32_4_0": "data:image/webp;base64,", "c_k32_4_1": "data:image/webp;base64,", "c_k32_4_2": "data:image/webp;base64,", "c_k35_3_0": "data:image/webp;base64,", "c_k35_3_1": "data:image/webp;base64,", "c_k35_3_2": "data:image/webp;base64,", "c_k37_4_0": "data:image/webp;base64,", "c_k37_4_1": "data:image/webp;base64,", "c_k37_4_2": "data:image/webp;base64,", "c_k38_5_0": "data:image/webp;base64,", "c_k38_5_1": "data:image/webp;base64,", "c_k38_5_2": "data:image/webp;base64,", "c_k43_4_0": "data:image/webp;base64,", "c_k43_4_1": "data:image/webp;base64,", "c_k43_4_2": "data:image/webp;base64,", "c_k43_4_3": "data:image/webp;base64,", "c_k46_1_0": "data:image/webp;base64,", "c_k46_1_1": "data:image/webp;base64,", "c_k46_1_2": "data:image/webp;base64,", "c_k46_1_3": "data:image/webp;base64,", "c_k48_4_0": "data:image/webp;base64,", "c_k48_4_1": "data:image/webp;base64,", "c_k48_4_2": "data:image/webp;base64,", "c_k48_4_3": "data:image/webp;base64,", "c_k51_3_0": "data:image/webp;base64,", "c_k51_3_1": "data:image/webp;base64,", "c_k51_3_2": "data:image/webp;base64,", "c_k51_3_3": "data:image/webp;base64,", "c_k53_3_0": "data:image/webp;base64,", "c_k53_3_1": "data:image/webp;base64,", "c_k53_3_2": "data:image/webp;base64,", "c_k53_3_3": "data:image/webp;base64,