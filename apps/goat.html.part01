      <button class="btn b" id="doTeams" style="font-size:26px">팀 나누기</button>
      <button class="btn c" id="doOrder" style="font-size:26px">순서 뽑기</button>
      <button class="btn" id="doOne" style="font-size:26px">한 명 뽑기</button>
    </div>
