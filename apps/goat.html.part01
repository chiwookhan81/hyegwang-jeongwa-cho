<!DOCTYPE html>
<html lang="ko">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<head>
<script>/* 칠판 끌기 고침 (2026-11-24): 누른 자리가 다시 그려져 사라져도 끌기가 끊기지 않게 이어 줘요 */
(function(){if(window.__dragFix)return;window.__dragFix=1;var C=null;
function fw(e){var t=e.currentTarget;if(t.isConnected||!C||C.n!==t)return;var h=null;for(var i=0;i<C.a.length;i++)if(C.a[i].isConnected){h=C.a[i];break}h=h||document.body;try{h.dispatchEvent(new PointerEvent(e.type,e))}catch(x){}if(e.type!=='pointermove')off()}
function off(){if(!C)return;['pointermove','pointerup','pointercancel'].forEach(function(k){C.n.removeEventListener(k,fw)});C=null}
document.addEventListener('pointerdown',function(e){if(e.pointerType==='mouse')return;off();var n=e.target;if(!n||!n.addEventListener)return;var a=[],p=n.parentNode;while(p&&p.nodeType===1){a.push(p);p=p.parentNode}C={n:n,a:a};['pointermove','pointerup','pointercancel'].forEach(function(k){n.addEventListener(k,fw)})},true);
document.addEventListener('pointerup',function(e){if(C&&C.n.isConnected)off()},true);
})();</script>

<title>월궁goat</title>
<style>
:root{--pink:#f4a6bd;--blue:#7fb4e6;--purple:#b79be0;--cream:#fff7e8;--ink:#4a3b52;--red:#e8505b;--bl:#3f7fd6;--green:#5cbf7a}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{margin:0;height:100%;overflow:hidden;background:#fdf4ec;color:var(--ink);font-family:"Jua","BM JUA","Malgun Gothic","Apple SD Gothic Neo","Noto Sans KR",sans-serif}
button{font-family:inherit;color:inherit;cursor:pointer;border:none}
.screen{position:absolute;top:0;right:0;bottom:0;left:0;display:none}
.screen.on{display:block}
.big{font-weight:800}
/* 공통 상단바 */
.topbar{position:absolute;left:0;right:0;top:0;height:64px;display:flex;align-items:center;gap:10px;padding:0 12px;z-index:20}
.btn{background:#fff;border-radius:18px;padding:10px 18px;font-size:22px;font-weight:800;box-shadow:0 4px 0 #f1d4df;border:3px solid #fde3ec;transition:transform .08s}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(0,0,0,.12)}
.btn.c{background:var(--pink);color:#fff}
.btn.b{background:var(--bl);color:#fff}
.btn.r{background:var(--red);color:#fff}
.btn.g{background:var(--green);color:#fff}
.btn.sel{outline:5px solid #ffcf3a}
.ico{width:28px;height:28px;vertical-align:middle}
.home-btn{position:absolute;left:12px;top:10px;z-index:30;display:flex;align-items:center;gap:6px}
/* 첫 화면 */
#home{background:#cfe9ff center/cover no-repeat}
#home .title{position:absolute;left:0;right:0;top:3%;text-align:center;font-size:clamp(40px,8vw,92px);font-weight:900;color:#fff;letter-spacing:2px;
 text-shadow:0 4px 0 #e98aa8,0 8px 0 rgba(0,0,0,.12)}
#home .menu{position:absolute;left:0;right:0;bottom:3%;display:flex;justify-content:center;gap:2.5vw;padding:0 2vw}
.card{width:28vw;max-width:320px;background:rgba(255,255,255,.9);border-radius:26px;padding:8px 10px 10px;box-shadow:0 8px 0 rgba(0,0,0,.12);text-align:center;transition:transform .1s}
.card:active,.card.focus{transform:scale(1.04)}
.card.focus{outline:6px solid #ffcf3a}
.card img{height:min(13vh,110px);display:block;margin:0 auto 2px}
.card .nm{font-size:clamp(22px,3.4vw,40px);font-weight:900}
.card .tag{font-size:clamp(12px,1.4vw,17px);margin-top:4px;color:#6b5a74;line-height:1.35}
.card.k1 .nm{color:#d0405a}.card.k2 .nm{color:#7a52c7}.card.k3 .nm{color:#2f78c4}
#home .corner{position:absolute;top:12px;display:flex;gap:10px}
/* 사용법 */
#help{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(40,30,50,.55);z-index:100;display:none;align-items:center;justify-content:center}
#help.on{display:flex}
#help .box{width:min(94vw,980px);max-height:92vh;overflow:auto;background:#fffaf3;border-radius:28px;padding:22px 26px;font-size:20px;line-height:1.5}
#help h2{margin:0 0 10px;font-size:32px}
#help .row{display:flex;gap:14px;align-items:center;margin:10px 0;padding:10px;border-radius:18px;background:#fff}
#help .row img{width:90px;flex:none}
#help .chips span{display:inline-block;background:#ffe2ea;border-radius:12px;padding:2px 10px;margin:2px 4px 2px 0;font-size:16px}
#help .safe{background:#e8f6ec;border-radius:18px;padding:12px 16px;margin-top:12px;font-size:18px}
/* 설정 */
#settings{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(40,30,50,.55);z-index:110;display:none;align-items:center;justify-content:center}
#settings.on{display:flex}
#settings .box{width:min(94vw,900px);max-height:92vh;overflow:auto;background:#fffaf3;border-radius:28px;padding:20px 24px;font-size:20px}
#settings h3{margin:16px 0 6px;font-size:22px;color:#7a52c7}
.opt{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:6px 0}
.opt b{min-width:170px}
.opt button{background:#fff;border-radius:14px;padding:8px 14px;font-size:18px;box-shadow:0 3px 0 rgba(0,0,0,.1)}
.opt button.on{background:#7a52c7;color:#fff}
.gear-hold{position:relative}
.gear-hold .ring{position:absolute;top:-4px;right:-4px;bottom:-4px;left:-4px;border-radius:22px;border:5px solid #ffcf3a;clip-path:inset(0 100% 0 0);pointer-events:none}
/* 보치아 */
#bocce{background:#fdeef6}
#bc{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;touch-action:none}
#bocce .hud{position:absolute;right:12px;top:10px;display:flex;gap:10px;z-index:25}
#bocce .msg{position:absolute;left:50%;top:76px;transform:translateX(-50%);background:rgba(255,255,255,.95);border:4px solid #ffd6e2;border-radius:24px;padding:8px 22px;font-size:clamp(20px,2.6vw,32px);font-weight:900;z-index:25;white-space:nowrap}
#bocce .press{position:absolute;right:2vw;bottom:3vh;width:min(22vw,200px);height:min(22vw,200px);border-radius:50%;background:radial-gradient(circle at 35% 28%,#fff0f4 0%,#ffc2d1 45%,#ff9fb6 100%);color:#fff;text-shadow:0 2px 0 #f07b98;font-size:clamp(26px,3.6vw,44px);font-weight:900;border:7px solid #fff;box-shadow:0 8px 0 #f7b6c8,0 12px 24px rgba(255,140,170,.35);z-index:25}
#bocce .press:active{transform:translateY(6px);box-shadow:0 2px 0 #f7b6c8}
#bocce .press.blue{background:radial-gradient(circle at 35% 28%,#f0f8ff 0%,#b9dcff 45%,#8fc2ff 100%);text-shadow:0 2px 0 #5f9be0;box-shadow:0 8px 0 #b3d4f7,0 12px 24px rgba(120,170,240,.35)}
#bocce .start{position:absolute;top:0;right:0;bottom:0;left:0;z-index:40;background:linear-gradient(#e6f4ff,#fff0f6);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px}
#bocce .start .row{display:flex;gap:24px}
.modebtn{width:min(36vw,330px);padding:16px;border-radius:30px;background:#fff;border:5px solid #ffd6e2;box-shadow:0 8px 0 #f7c7d6;color:#e0506c;font-size:clamp(22px,3vw,36px);font-weight:900}
.modebtn img{height:min(20vh,150px);display:block;margin:0 auto 6px}
.modebtn.focus{outline:6px solid #ffcf3a}
/* 보치아 규칙 */ #bcRules{position:fixed;top:0;right:0;bottom:0;left:0;z-index:120;background:rgba(40,30,50,.55);display:none;align-items:center;justify-content:center} #bcRules.on{display:flex} #bcRules .box{width:min(96vw,1100px);max-height:94vh;overflow:auto;background:#fffaf3;border-radius:28px;padding:18px 24px;font-size:clamp(17px,2.1vw,22px);line-height:1.4;color:#4a3b52;word-break:keep-all} #bcRules .rg{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px} #bcRules .rr:last-child{grid-column:1 / -1} @media (max-width:760px){#bcRules .rg{grid-template-columns:1fr}} #bcRules h2{margin:0 0 8px;font-size:clamp(26px,3.4vw,38px);color:#e0506c;text-align:center} #bcRules .rr{display:flex;gap:12px;align-items:center;margin:0;padding:8px 12px;border-radius:18px;background:#fff} #bcRules .rr svg{width:clamp(84px,11vw,120px);flex:none} #bcRules .rt{color:#e0506c} #bcRules .note{background:#e8f6ec;border-radius:16px;padding:10px 14px;margin-top:8px;font-size:clamp(15px,1.8vw,19px)} #bcRules .okbar{position:sticky;bottom:-18px;background:#fffaf3;padding:8px 0 4px} #bcRules .ok{display:block;margin:0 auto;font-size:clamp(24px,3vw,34px);padding:12px 60px} #bcRules .ok.focus{outline:6px solid #ffcf3a} #bcRulesBtn{font-size:clamp(18px,2.2vw,24px)} /* 움직여 봐요 */
#move{background:#cfe9ff}
#mv{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}
#cam{position:absolute;right:12px;bottom:12px;width:min(46vw,560px);border-radius:16px;border:5px solid #fff;transform:scaleX(-1);z-index:22;background:#333;box-shadow:0 4px 12px rgba(0,0,0,.25)}
#move .pick{position:absolute;top:0;right:0;bottom:0;left:0;z-index:40;background:rgba(255,248,238,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:64px 10px 10px;overflow:auto}
#move .acts{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
.act{width:min(15vw,170px);padding:10px;border-radius:24px;background:#fff;box-shadow:0 6px 0 rgba(0,0,0,.12);font-size:clamp(18px,2.2vw,28px);font-weight:900}
.act img{height:min(11vh,100px);display:block;margin:0 auto 4px}
.act.sel{outline:6px solid #ffcf3a}
#move .camrow{display:flex;gap:14px;align-items:center}
.cambar{width:min(30vw,280px);height:22px;border-radius:11px;background:#e6e0ea;overflow:hidden}.cambar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#69db7c,#ffd43b,#ff6b6b);transition:width .1s}
.cammsg{max-width:860px;font-size:18px;line-height:1.5;text-align:center;padding:10px 16px;border-radius:16px;background:#fff}
.cammsg.ok{background:#e3f7e8}.cammsg.bad{background:#ffe6e6}
.camchip{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);z-index:23;padding:6px 14px;border-radius:14px;font-size:16px;font-weight:800;background:#fff}
.camchip.bad{background:#ffe6e6;color:#c03}.camchip.ok{background:#e3f7e8;color:#1b7a3a}
#move .camnote{font-size:17px;color:#6b5a74;text-align:center;max-width:820px;line-height:1.5}
/* 체육수업툴 */
#helper{background:#f3f7ff}
#helper .tabs{position:absolute;left:0;right:0;top:0;height:78px;display:flex;justify-content:center;align-items:center;gap:10px;padding-left:150px;padding-right:10px}
.tab{background:#fff;border-radius:18px;padding:8px 16px;font-size:clamp(17px,2vw,24px);font-weight:900;box-shadow:0 4px 0 rgba(0,0,0,.1);display:flex;align-items:center;gap:6px}
.tab img{height:40px}
.tab.on{background:#2f78c4;color:#fff}
.pane{position:absolute;left:0;right:0;top:84px;bottom:0;display:none;padding:10px 18px}
.pane.on{display:block}
/* 타이머 */
#tTime{font-size:clamp(90px,22vw,300px);font-weight:900;text-align:center;line-height:1;color:#2f78c4;font-variant-numeric:tabular-nums}
#tRing{display:block;margin:0 auto}
.tc{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:10px 0}
/* 팀 */
.tok{display:inline-flex;flex-direction:column;align-items:center;width:110px;margin:6px;padding:6px;border-radius:18px;background:#fff;box-shadow:0 4px 0 rgba(0,0,0,.08);font-size:18px;font-weight:800;opacity:.35}
.tok.on{opacity:1;outline:4px solid #ffcf3a}
.tok img{height:80px}
.teams{display:flex;gap:12px;justify-content:center;margin-top:10px}
.team{flex:1;max-width:330px;border-radius:24px;padding:10px;min-height:150px;text-align:center}
.team .tt{font-size:28px;font-weight:900;color:#fff}
.team img{height:90px;margin:4px}
.order{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:12px}
.order .o{background:#fff;border-radius:20px;padding:8px;width:120px;text-align:center;font-size:30px;font-weight:900;box-shadow:0 4px 0 rgba(0,0,0,.08);animation:pop .4s}
.order .o img{height:80px;display:block;margin:0 auto}
@keyframes pop{0%{transform:scale(.2);opacity:0}70%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}
/* 점수판 */
.sb{display:flex;gap:12px;height:calc(100% - 70px)}
.st{flex:1;border-radius:28px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:12px;color:#fff}
.st input{width:90%;text-align:center;font-size:clamp(22px,3vw,40px);font-weight:900;border:none;border-radius:14px;background:rgba(255,255,255,.25);color:#fff;font-family:inherit;user-select:text;-webkit-user-select:text}
.st .sc{font-size:clamp(90px,16vw,240px);font-weight:900;line-height:1;cursor:pointer;text-shadow:0 6px 0 rgba(0,0,0,.15)}
.st .pm{display:flex;gap:10px}
.st .pm button{width:clamp(60px,8vw,110px);height:clamp(60px,8vw,110px);border-radius:50%;background:rgba(255,255,255,.9);font-size:clamp(30px,5vw,60px);font-weight:900;color:#444}
/* 준비운동 */
#wuStage{display:flex;align-items:center;justify-content:center;gap:4vw;height:calc(100% - 90px)}
#wuImg{height:min(60vh,520px);transition:transform .15s}
#wuSide{text-align:center}
#wuName{font-size:clamp(34px,5vw,64px);font-weight:900;color:#d0405a}
#wuCount{font-size:clamp(90px,14vw,200px);font-weight:900;color:#2f78c4;line-height:1.1;min-height:1.1em}
#wuDots{display:flex;gap:8px;justify-content:center;margin-top:8px}
#wuDots i{width:18px;height:18px;border-radius:50%;background:#ddd;display:block}
#wuDots i.on{background:#d0405a}
/* 폭죽 오버레이 */
#fx{position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;z-index:90;width:100%;height:100%}
.cheer{position:fixed;left:50%;top:44%;transform:translate(-50%,-50%);z-index:95;text-align:center;pointer-events:none;display:none}
.cheer.on{display:block;animation:pop .5s}
.cheer .t{font-size:clamp(50px,9vw,120px);font-weight:900;color:#fff;text-shadow:0 5px 0 #e98aa8,0 10px 20px rgba(0,0,0,.25)}
.cheer img{height:min(34vh,300px)}
.bounce{animation:bnc .6s ease}
@keyframes bnc{0%{transform:scale(1)}30%{transform:scale(1.2) translateY(-10px)}60%{transform:scale(.95)}100%{transform:scale(1)}}
.hint{font-size:16px;color:#6b5a74}
/* 폰처럼 작은 화면 */
#move .pick,#bocce .start{justify-content:flex-start}
#move .pick>:first-child,#bocce .start>:first-child{margin-top:auto}
#move .pick>:last-child,#bocce .start>:last-child{margin-bottom:auto}
.pin{display:flex;flex-direction:column;align-items:center;gap:inherit;width:100%}
@media (max-height:520px),(max-width:640px){
 .btn{padding:6px 12px;font-size:16px;border-radius:14px;border-width:2px;box-shadow:0 3px 0 #f1d4df}
 .ico{width:20px;height:20px}
 .home-btn{left:6px;top:6px}
 #home .title{font-size:min(9vw,13vh)}
 .card{border-radius:18px;padding:5px 6px 6px}
 .card img{height:min(13vh,64px)}
 .card .nm{font-size:min(5vw,22px)}
 .card .tag{font-size:10px;margin-top:2px}
 #home .corner{top:6px}
 #help .box,#settings .box{padding:12px 14px;font-size:15px;border-radius:20px}
 #help h2{font-size:22px}#help .row{gap:8px;padding:6px}#help .row img{width:54px}
 #help .chips span{font-size:12px}#help .safe{font-size:14px}
 #settings h3{font-size:17px;margin:10px 0 4px}
 .opt{gap:5px;margin:4px 0}.opt b{min-width:0;font-size:14px}.opt button{padding:5px 10px;font-size:14px;border-radius:10px}
 #bocce .msg{top:50px;font-size:17px;padding:4px 12px;border-width:3px}
 #bocce .press{width:min(24vw,110px);height:min(24vw,110px);font-size:20px}
 #bocce .start{gap:10px}#bocce .start .row{gap:12px}
 .modebtn{padding:8px;border-radius:20px;border-width:3px;font-size:18px}.modebtn img{height:min(18vh,80px)}
 #move .pick{gap:6px;padding:46px 6px 6px}
 #mvPin>div:first-child{font-size:20px!important}
 #move .acts{gap:6px}
 .act{width:auto;min-width:62px;padding:4px 6px;border-radius:14px;font-size:13px;box-shadow:0 3px 0 rgba(0,0,0,.12)}
 .act img{height:40px}.act.sel{outline-width:4px}
 #move .camrow{gap:8px}.cambar{width:28vw;height:14px}
 .cammsg{font-size:12px;padding:5px 10px;line-height:1.4}
 #move .camnote{font-size:11px}
 #mvGo{font-size:22px!important;padding:8px 30px!important}
 #cam{width:min(42vw,280px);border-width:3px;right:6px;bottom:6px}
 .camchip{font-size:12px;padding:3px 8px;bottom:6px}
 #helper .tabs{height:50px;padding-left:118px;padding-right:6px;gap:5px;justify-content:flex-start;overflow-x:auto;overflow-y:hidden}
 .tab{padding:4px 8px;font-size:14px;border-radius:12px;flex:none;box-shadow:0 3px 0 rgba(0,0,0,.1)}.tab img{height:26px}
 .pane{top:54px;padding:6px 8px;overflow:auto}
 #tTime{font-size:min(22vw,24vh)}
 .tc{gap:6px;margin:6px 0}
 .tok{width:70px;font-size:12px;margin:3px;padding:3px;border-radius:12px}.tok img{height:44px}
 .teams{gap:6px}.team{min-height:80px;padding:6px;border-radius:16px}.team .tt{font-size:18px}.team img{height:46px;margin:2px}
 .order .o{width:74px;font-size:20px;padding:4px}.order .o img{height:46px}
 .sb{gap:6px;height:calc(100% - 50px)}.st{border-radius:18px;padding:6px}
 .st input{font-size:18px}.st .sc{font-size:min(15vw,22vh)}
 .st .pm button{width:46px;height:46px;font-size:26px}
 #wuStage{height:calc(100% - 60px);gap:3vw}#wuImg{height:min(52vh,300px)}
 #wuName{font-size:min(6vw,26px)}#wuCount{font-size:min(14vw,20vh)}
 .cheer .t{font-size:min(10vw,16vh)}.cheer img{height:min(30vh,160px)}
 .hint{font-size:12px}
}
</style>
</head>
<body>

<!-- ===== 첫 화면 ===== -->
<div id="home" class="screen on">
  <div class="title">월궁goat</div>
  <div class="corner" style="left:12px">
    <button class="btn" id="helpBtn"><img class="ico" data-a="i_help"> 사용법</button>
  </div>
  <div class="corner" style="right:12px">
    <button class="btn gear-hold" id="gearBtn" title="길게 누르면 설정"><img class="ico" data-a="i_gear"> 설정<span class="ring"></span></button>
  </div>
  <div class="menu">
    <button class="card k1" data-go="bocce"><img data-a="c_wol_roll"><div class="nm">보치아</div><div class="tag">터치만으로 가능 · 스위치 사용 가능</div></button>
    <button class="card k2" data-go="move"><img data-a="fly1"><div class="nm">움직여 봐요</div><div class="tag">몸 움직임만으로 가능 · 카메라 필요</div></button>
    <button class="card k3" data-go="helper"><img data-a="wv10"><div class="nm">체육수업툴</div><div class="tag">교사용 · 글 읽기 필요</div></button>
  </div>
</div>

<!-- ===== 사용법 ===== -->
<div id="help"><div class="box">
  <h2>월궁goat 사용법</h2>
  <div class="row"><img data-a="c_wol_roll"><div><b>보치아</b> — 공을 흰 표적구에 가까이 굴려요. 혼자 연습, 두 팀 대결.<br>
   던지는 방법: <b>누르기</b>(막대가 움직이다 한 번 누르면 멈춤) · <b>끌어서 던지기</b> · <b>홈통</b><br>방향과 세기를 고르면 공이 갈 길이 보여요. 좋으면 <b>굴리기</b>, 아니면 <b>◀ 다시 고르기</b> (키보드는 백스페이스).
   <div class="chips"><span>터치만으로 가능</span><span>스위치 사용 가능 (스페이스·엔터 키)</span></div></div></div>
  <div class="row"><img data-a="fly1"><div><b>움직여 봐요</b> — 카메라 앞에서 움직이면 불꽃이 터지고, 아리가 날고 헤엄치고 산을 오르고, 달리고 뛰고, 팔 벌려 뛰기와 노 젓기도 해요. 앉아서 할 수 있는 동작(노 젓기 등)도 있어요. 노 젓기는 카메라 쪽으로 비스듬히 앉으면 더 잘 알아봐요. 반 아이들이 다 보이면 카메라 화면에서 한 아이를 눌러 그 아이만 보게 할 수 있어요. 다리가 화면에 보이면 공 차기·등산은 다리 움직임만 쳐 줘요. 비슷한 동작을 할수록 더 빨리 가요.
   <div class="chips"><span>몸 움직임만으로 가능</span><span>카메라 필요</span><span>카메라가 없으면 마우스·터치로도 가능</span></div></div></div>
  <div class="row"><img data-a="wv10"><div><b>체육수업툴</b> — 타이머·신호음, 팀 나누기·순서 뽑기, 점수판, 준비운동 따라 하기(대롱이 시범 + 구령)
   <div class="chips"><span>교사용</span><span>글 읽기 필요</span></div></div></div>
  <div class="safe">
   <b>인터넷</b>: 필요 없어요. 파일 하나로 어디서나 열려요.<br>
   <b>권한</b>: '움직여 봐요'에서만 <b>카메라</b>를 써요. 몸의 움직임을 알아보기 위해서예요. 몸의 관절을 찾는 인식기(구글 MediaPipe)가 앱 안에 들어 있어 인터넷 없이 기기 안에서만 처리해요. 화면에서 고른 아이도 화면 안에서만 따라가고, 사진이나 영상으로 저장하지 않아요.<br>
   <b>폰에서 카메라</b>: 내려받은 파일로는 카메라가 안 켜져요. 크롬에서 <b>chiwookhan81.github.io/hyegwang-goat</b> 주소로 열어 주세요.<br>
   <b>정보 보호</b>: 카메라 영상은 저장하지 않고, 어디에도 보내지 않아요. 학생 이름도 받지 않아요. 설정만 이 기기에 저장돼요.<br>
   <b>설정</b>: 오른쪽 위 '설정'을 <b>길게(1.5초)</b> 누르면 열려요. (학생이 실수로 바꾸지 않게)
  </div>
  <div style="text-align:center;margin-top:14px"><button class="btn c" id="helpClose" style="font-size:28px;padding:12px 40px">시작하기</button></div>
</div></div>

<!-- ===== 설정 ===== -->
<div id="settings"><div class="box" id="setBox"></div></div>

<!-- ===== 보치아 ===== -->
<div id="bocce" class="screen">
  <canvas id="bc"></canvas>
  <button class="btn home-btn" data-home><img class="ico" data-a="i_home"> 처음으로</button>
  <div class="hud"><button class="btn" id="bcAgain">다시 하기</button></div>
  <div class="msg" id="bcMsg"></div>
  <button class="press" id="bcPress">누르기</button>
  <button class="btn" id="bcRedo" style="position:absolute;right:calc(2vw + min(22vw,200px) + 22px);bottom:calc(3vh + 30px);font-size:clamp(20px,2.6vw,30px);padding:14px 22px;display:none;z-index:6">◀ 방향 다시</button>
  <div class="start" id="bcStart">
    <div style="font-size:clamp(30px,4.4vw,56px);font-weight:900">보치아 — 누가 할까요?</div>
    <div class="row">
      <button class="modebtn" data-bm="solo"><img data-a="c_wol_roll">혼자 연습</button>
      <button class="modebtn" data-bm="vs"><img data-a="i_balls">두 팀 대결</button>
    </div>
    <button class="btn" id="bcRulesBtn">보치아 규칙 보기</button><div class="hint" id="bcModeHint"></div>
  </div>
</div>

<div id="bcRules" role="dialog" aria-label="보치아 규칙"><div class="box"><h2>보치아 규칙</h2><div class="rg"><div class="rr"><svg viewBox="0 0 120 70" aria-hidden="true"><rect x="2" y="2" width="116" height="66" rx="14" fill="#e9f6e6"/><circle cx="60" cy="32" r="9" fill="#fff" stroke="#9a8aa5" stroke-width="2.5"/><path d="M60 62 L60 46" stroke="#9a8aa5" stroke-width="3" stroke-dasharray="4 4"/></svg><div><b class="rt">1. 흰 공 먼저</b><br>흰 공(표적구)을 먼저 놓아요. 설정에 따라 저절로 놓이거나 빨강 팀이 던져요.</div></div><div class="rr"><svg viewBox="0 0 120 70" aria-hidden="true"><rect x="2" y="2" width="116" height="66" rx="14" fill="#e9f6e6"/><circle cx="60" cy="26" r="9" fill="#fff" stroke="#9a8aa5" stroke-width="2.5"/><circle cx="44" cy="44" r="13" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="80" cy="50" r="13" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/></svg><div><b class="rt">2. 한 개씩</b><br>빨강 팀이 한 개, 파랑 팀이 한 개 굴려요.</div></div><div class="rr"><svg viewBox="0 0 120 70" aria-hidden="true"><rect x="2" y="2" width="116" height="66" rx="14" fill="#e9f6e6"/><circle cx="46" cy="24" r="9" fill="#fff" stroke="#9a8aa5" stroke-width="2.5"/><circle cx="54" cy="38" r="13" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="96" cy="50" r="13" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><path d="M96 34 Q80 18 62 22" fill="none" stroke="#4f8fe0" stroke-width="3" stroke-dasharray="5 4"/></svg><div><b class="rt">3. 먼 팀이 굴려요</b><br>그다음부터는 흰 공에서 <b>더 먼 팀</b>이 굴려요. 더 가까워질 때까지 같은 팀이 이어서 굴려요.</div></div><div class="rr"><svg viewBox="0 0 120 70" aria-hidden="true"><rect x="2" y="2" width="116" height="66" rx="14" fill="#e9f6e6"/><circle cx="20" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="36" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="52" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="68" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="84" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="100" cy="22" r="7" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="20" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><circle cx="36" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><circle cx="52" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><circle cx="68" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><circle cx="84" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><circle cx="100" cy="48" r="7" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/></svg><div><b class="rt">4. 공은 6개씩</b><br>팀마다 공이 6개예요. 한 팀이 다 굴리면 남은 팀이 마저 굴려요.</div></div><div class="rr"><svg viewBox="0 0 120 70" aria-hidden="true"><rect x="2" y="2" width="116" height="66" rx="14" fill="#e9f6e6"/><circle cx="66" cy="26" r="9" fill="#fff" stroke="#9a8aa5" stroke-width="2.5"/><circle cx="48" cy="22" r="13" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="84" cy="36" r="13" fill="#ef5b6e" stroke="#00000022" stroke-width="2"/><circle cx="102" cy="12" r="10" fill="#4f8fe0" stroke="#00000022" stroke-width="2"/><text x="16" y="62" font-size="15" font-weight="900" fill="#ef5b6e">빨강 2점</text></svg><div><b class="rt">5. 점수</b><br>다 굴리면 흰 공에 <b>가장 가까운 팀</b>이 이겨요. 상대 팀의 가장 가까운 공보다 더 가까운 공마다 1점이에요.</div></div></div><div class="note">선 밖으로 나간 공은 세지 않아요. 혼자 연습은 공 6개를 굴려 흰 공에 가까울수록 별을 받아요.<br>정식 경기는 이렇게 한 판(엔드)을 여러 번 해서 점수를 더해요.</div><div class="okbar"><button class="btn c ok" id="bcRulesOk">알겠어요</button></div></div></div>
<!-- ===== 움직여 봐요 ===== -->
<div id="move" class="screen">
  <canvas id="mv"></canvas>
  <video id="cam" playsinline muted></video>
  <div class="camchip" id="camChip"></div>
  <button class="btn home-btn" data-home><img class="ico" data-a="i_home"> 처음으로</button>
  <div class="hud" style="position:absolute;right:12px;top:10px;display:flex;gap:10px;z-index:25"><button class="btn" id="mvBack">놀이 고르기</button></div>
  <div class="pick" id="mvNext" style="display:none;background:rgba(255,248,238,.55)"><button class="btn c" id="mvNextBtn" style="font-size:36px;padding:16px 50px">다음 단계</button><button class="btn" id="mvNextPick" style="font-size:24px">놀이 고르기</button></div>
  <div class="pick" id="mvPick">
   <div class="pin" id="mvPin">
    <div style="font-size:clamp(28px,4vw,50px);font-weight:900">아리와 함께 움직여 봐요!</div>
    <div class="acts" id="mvActs"></div>
    <div class="opt" id="mvStage" style="justify-content:center"></div>
    <div class="opt" id="mvPlayers" style="justify-content:center"></div>
     <div class="opt" id="mvZoom" style="justify-content:center"></div>
    <div class="camrow"><button class="btn b" id="camOn">카메라 켜기 / 다시 연결</button><div class="cambar"><i id="camBar"></i></div></div>
    <div class="cammsg" id="camMsg"></div>
    <button class="btn c" id="mvGo" style="font-size:32px;padding:14px 50px">시작!</button>
    <div class="camnote">카메라 앞 2~3걸음 떨어져 서거나 앉아요. 카메라 영상은 이 화면에서만 쓰고 저장하거나 보내지 않아요.</div>
   </div>
  </div>
</div>

<!-- ===== 체육수업툴 ===== -->
<div id="helper" class="screen">
  <button class="btn home-btn" data-home><img class="ico" data-a="i_home"> 처음으로</button>
  <div class="tabs">
    <button class="tab on" data-tab="pTimer"><img data-a="i_timer">타이머</button>
    <button class="tab" data-tab="pTeam"><img data-a="ani02">팀·순서</button>
    <button class="tab" data-tab="pScore"><img data-a="i_trophy">점수판</button>
    <button class="tab" data-tab="pWarm"><img data-a="wv03">준비운동</button>
  </div>
  <div class="pane on" id="pTimer">
    <div class="tc" id="tPresets"></div>
