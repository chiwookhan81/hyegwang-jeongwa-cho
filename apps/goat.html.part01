    <div class="tc"><span class="opt" id="sbN"></span><button class="btn" id="sbReset">모두 0점</button></div>
    <div class="sb" id="sbWrap"></div>
  </div>
  <div class="pane" id="pWarm">
    <div class="tc">
      <button class="btn" id="wuPrev">◀ 앞 동작</button>
      <button class="btn g" id="wuPlay" style="font-size:28px;padding:10px 36px">시작</button>
      <button class="btn" id="wuNext">다음 동작 ▶</button>
    </div>
    <div id="wuStage">
      <img id="wuImg">
      <div id="wuSide"><div id="wuName"></div><div id="wuCount"></div><div id="wuDots"></div></div>
    </div>
  </div>
</div>

<canvas id="fx"></canvas>
<div class="cheer" id="cheer"><img id="cheerImg"><div class="t" id="cheerTxt"></div></div>

<script>
const ASSETS={"ani01": "data:image/webp;base64,", "ani02": "data:image/webp;base64,", "ani03": "data:image/webp;base64,", "ani04": "data:image/webp;base64,", "ani05": "data:image/webp;base64,", "ani06": "data:image/webp;base64,", "hd01": "data:image/webp;base64,", "hd02": "data:image/webp;base64,", "hd03": "data:image/webp;base64,", "hd04": "data:image/webp;base64,", "wv01": "data:image/webp;base64,", "wv02": "data:image/webp;base64,", "wv03": "data:image/webp;base64,", "wv04": "data:image/webp;base64,", "wv05": "data:image/webp;base64,", "wv06": "data:image/webp;base64,", "wv07": "data:image/webp;base64,", "wv08": "data:image/webp;base64,", "wv09": "data:image/webp;base64,", "wv10": "data:image/webp;base64,", "climb1": "data:image/webp;base64,", "climb2": "data:image/webp;base64,", "fly1": "data:image/webp;base64,", "fly2": "data:image/webp;base64,", "g_bell": "data:image/webp;base64,", "g_chest1": "data:image/webp;base64,", "g_chest2": "data:image/webp;base64,", "g_moon": "data:image/webp;base64,", "g_stele": "data:image/webp;base64,", "hike1": "data:image/webp;base64,", "hike2": "data:image/webp;base64,", "kick1": "data:image/webp;base64,", "kick2": "data:image/webp;base64,", "swim1": "data:image/webp;base64,", "swim2": "data:image/webp;base64,", "bg_sky": "data:image/webp;base64,", "bg_water": "data:image/webp;base64,", "bg_field": "data:image/webp;base64,", "bg_mountain": "data:image/webp;base64,", "bg_wall": "data:image/webp;base64,", "bg_home": "data:image/webp;base64,", "i_trophy": "data:image/webp;base64,", "c_wol_cheer": "data:image/webp;base64,", "c_wol_roll": "data:image/webp;base64,", "i_gear": "data:image/webp;base64,", "c_hami_stand": "data:image/webp;base64,", "i_whistle": "data:image/webp;base64,", "i_help": "data:image/webp;base64,", "i_timer": "data:image/webp;base64,", "i_home": "data:image/webp;base64,", "c_ari_wave": "data:image/webp;base64,", "i_balls": "data:image/webp;base64,", "i_fire": "data:image/webp;base64,", "c_wol": "data:image/webp;base64,", "c_ari": "data:image/webp;base64,", "c_hami": "data:image/webp;base64,", "s_whistle": "data:audio/mpeg;base64,", "s_firework": "data:audio/mpeg;base64,", "s_clap": "data:audio/mpeg;base64,", "s_daego": "data:audio/mpeg;base64,", "s_jeongo": "data:audio/mpeg;base64,", "s_ding": "data:audio/mpeg;base64,", "s_clack": "data:audio/mpeg;base64,", "s_roll": "data:audio/wav;base64,", "s_beep": "data:audio/mpeg;base64,", "s_whistle3": "data:audio/mpeg;base64,", "s_spark": "data:audio/mpeg;base64,", "bg_farm": "data:image/webp;base64,", "bg_orchard": "data:image/webp;base64,", "bg_river": "data:image/webp;base64,", "bg_track": "data:image/webp;base64,", "g_apple": "data:image/webp;base64,", "g_finish": "data:image/webp;base64,", "g_pavilion": "data:image/webp;base64,", "g_radish": "data:image/webp;base64,", "jump1": "data:image/webp;base64,", "jump2": "data:image/webp;base64,", "run1": "data:image/webp;base64,", "run2": "data:image/webp;base64,", "squat1": "data:image/webp;base64,", "squat2": "data:image/webp;base64,", "jack1": "data:image/webp;base64,", "jack2": "data:image/webp;base64,", "row1": "data:image/webp;base64,", "row2": "data:image/webp;base64,"};
</script>
<script>
"use strict";
// ================= 공통 =================
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const A=ASSETS;
function src(k){return A[k]||''}
$$('img[data-a]').forEach(i=>i.src=src(i.dataset.a));
const LS={get(k,d){try{const v=localStorage.getItem('hgGoat_'+k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem('hgGoat_'+k,JSON.stringify(v))}catch(e){}}};
const DEF={vol:0.8,voice:true,throwMode:'bar',jack:'auto',barSpeed:'mid',diff:'easy',sens:'mid',wuSpeed:'mid'};
const S=Object.assign({},DEF,LS.get('set',{}));
function saveS(){LS.set('set',S)}

// ---- 소리 ----
let AC=null; const BUF={};
function ac(){if(!AC){AC=new (window.AudioContext||window.webkitAudioContext)();} if(AC.state==='suspended')AC.resume(); return AC}
function b64ToBuf(b){const s=atob(b.split(',')[1]);const u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u.buffer}
async function loadSnd(k){if(BUF[k])return BUF[k]; if(!A['s_'+k])return null; BUF[k]=await ac().decodeAudioData(b64ToBuf(A['s_'+k])); return BUF[k]}
const lastPlay={};
async function sfx(k,vol=1,rate=1,minGap=0){
  try{const now=performance.now(); if(minGap&&lastPlay[k]&&now-lastPlay[k]<minGap)return; lastPlay[k]=now;
  const b=await loadSnd(k); if(!b)return; const c=ac(); const s=c.createBufferSource(); s.buffer=b; s.playbackRate.value=rate;
  const g=c.createGain(); g.gain.value=S.vol*vol; s.connect(g).connect(c.destination); s.start(); return s}catch(e){}
}
let rollSrc=null;
async function rollStart(){if(rollSrc)return;try{const b=await loadSnd('roll');const c=ac();const s=c.createBufferSource();s.buffer=b;s.loop=true;const g=c.createGain();g.gain.value=S.vol*.35;s.connect(g).connect(c.destination);s.start();rollSrc={s,g}}catch(e){}}
function rollStop(){if(rollSrc){try{rollSrc.s.stop()}catch(e){}rollSrc=null}}
// ---- 목소리 ----
let koVoice=null;
function pickVoice(){const vs=speechSynthesis.getVoices().filter(v=>/ko/i.test(v.lang));koVoice=vs.find(v=>/Natural|SunHi|Neural/i.test(v.name))||vs.find(v=>/Google/i.test(v.name))||vs[0]||null}
if('speechSynthesis' in window){pickVoice();speechSynthesis.onvoiceschanged=pickVoice}
function say(t,rate=1){if(!S.voice||!('speechSynthesis' in window))return;try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='ko-KR';if(koVoice)u.voice=koVoice;u.rate=rate;u.pitch=1.1;u.volume=S.vol;speechSynthesis.speak(u)}catch(e){}}

// ---- 화면 전환 ----
let cur='home'; const onLeave={};
function go(id){if(onLeave[cur])onLeave[cur]();parts=[];$('#cheer').classList.remove('on');try{speechSynthesis.cancel()}catch(e){} $$('.screen').forEach(s=>s.classList.toggle('on',s.id===id)); cur=id; if(onEnter[id])onEnter[id]()}
const onEnter={};
$$('[data-go]').forEach(b=>b.onclick=()=>{ac();go(b.dataset.go)});
$$('[data-home]').forEach(b=>b.onclick=()=>go('home'));
$('#home').style.backgroundImage=`url(${src('bg_home')})`;

// ---- 폭죽 ----
const fx=$('#fx'), fxc=fx.getContext('2d'); let parts=[]; let fxRun=false;
function fitFx(){fx.width=innerWidth;fx.height=innerHeight}
addEventListener('resize',fitFx); fitFx();
const COLS=['#ff6b8b','#ffd43b','#69db7c','#4dabf7','#b197fc','#ff922b','#fff'];
function burst(x,y,n=60,spd=7,size=4){for(let i=0;i<n;i++){const a=Math.random()*6.283,v=spd*(0.4+Math.random()*0.8);parts.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,life:1,c:COLS[(Math.random()*COLS.length)|0],s:size*(0.6+Math.random()*0.8)})}if(!fxRun){fxRun=true;requestAnimationFrame(fxLoop)}}
function fxLoop(){fxc.clearRect(0,0,fx.width,fx.height);for(const p of parts){p.x+=p.vx;p.y+=p.vy;p.vy+=0.12;p.vx*=0.985;p.life-=0.014;fxc.globalAlpha=Math.max(0,p.life);fxc.fillStyle=p.c;fxc.beginPath();fxc.arc(p.x,p.y,p.s,0,6.283);fxc.fill()}fxc.globalAlpha=1;parts=parts.filter(p=>p.life>0);if(parts.length)requestAnimationFrame(fxLoop);else{fxRun=false;fxc.clearRect(0,0,fx.width,fx.height)}}
function bigFireworks(times=6){for(let i=0;i<times;i++)setTimeout(()=>{burst(innerWidth*(0.15+Math.random()*0.7),innerHeight*(0.15+Math.random()*0.4),90,8,5)},i*350)}
function cheer(img,txt,ms=3200){const c=$('#cheer');const ci=$('#cheerImg');ci.style.display=img?'':'none';if(img)ci.src=src(img);$('#cheerTxt').textContent=txt;c.classList.remove('on');void c.offsetWidth;c.classList.add('on');clearTimeout(cheer.t);cheer.t=setTimeout(()=>c.classList.remove('on'),ms)}
function celebrate(img,txt){bigFireworks(7);sfx('firework');setTimeout(()=>sfx('clap'),300);setTimeout(()=>sfx('jeongo'),600);cheer(img,txt);say(txt)}

// ---- 스위치(키보드) 입력: 스페이스·엔터 ----
const keyHandlers={};
addEventListener('keydown',e=>{if(e.repeat)return; if(e.target.tagName==='INPUT')return;
  if((e.code==='Backspace'||e.code==='Escape')&&cur==='bocce'&&window.bcRedo){e.preventDefault();window.bcRedo();return}
  if(e.code==='Space'||e.code==='Enter'||e.code==='NumpadEnter'){e.preventDefault(); ac(); const h=keyHandlers[cur]; if(h)h(e)}});

// ================= 사용법 =================
const help=$('#help');
$('#helpBtn').onclick=()=>help.classList.add('on');
$('#helpClose').onclick=()=>{help.classList.remove('on');LS.set('seenHelp',1);ac()};
if(!LS.get('seenHelp',0))help.classList.add('on');
keyHandlers.home=()=>{ if(help.classList.contains('on')){$('#helpClose').click();return}
  const cs=$$('#home .card');let i=cs.findIndex(c=>c.classList.contains('focus'));cs.forEach(c=>c.classList.remove('focus'));
  if(i<0){cs[0].classList.add('focus');homeScan()}else{clearTimeout(homeScan.t);cs[i].click()} };
// 스위치 한 개로 고르기: 처음 누르면 자동으로 차례대로 비추고, 다시 누르면 고름
function homeScan(){const cs=$$('#home .card');clearTimeout(homeScan.t);homeScan.t=setTimeout(function nx(){let i=cs.findIndex(c=>c.classList.contains('focus'));if(i<0||cur!=='home')return;cs[i].classList.remove('focus');cs[(i+1)%cs.length].classList.add('focus');homeScan.t=setTimeout(nx,1800)},1800)}
onLeave.home=()=>{clearTimeout(homeScan.t);$$('#home .card').forEach(c=>c.classList.remove('focus'))};

// ================= 설정 (길게 누르기) =================
(function(){const g=$('#gearBtn'),ring=g.querySelector('.ring');let t0=0,raf=0;
 function down(e){e.preventDefault();t0=performance.now();raf=requestAnimationFrame(tick)}
 function tick(){const p=Math.min(1,(performance.now()-t0)/1500);ring.style.clipPath=`inset(0 ${100-p*100}% 0 0)`;if(p>=1){up();openSet()}else raf=requestAnimationFrame(tick)}
 function up(){cancelAnimationFrame(raf);ring.style.clipPath='inset(0 100% 0 0)'}
 g.addEventListener('pointerdown',down);g.addEventListener('pointerup',up);g.addEventListener('pointerleave',up);
 g.onclick=()=>{if(performance.now()-t0<1400){g.classList.add('bounce');setTimeout(()=>g.classList.remove('bounce'),600)}};
})();
const SETS=[
 ['공통',[['vol','소리 크기',[[0.3,'작게'],[0.6,'보통'],[0.8,'크게'],[1,'아주 크게']]],['voice','목소리 안내',[[true,'켜기'],[false,'끄기']]]]],
 ['보치아',[['throwMode','던지는 방법',[['bar','누르기(막대)'],['drag','끌어서 던지기'],['ramp','홈통']]],['jack','흰 표적구',[['auto','자동으로 놓기'],['throw','학생이 먼저 던지기(정식)']]],['barSpeed','막대 속도',[['slow','느리게'],['mid','보통'],['fast','빠르게']]]]],
 ['움직여 봐요',[['diff','동작 판별',[['easy','쉬움 — 아무 움직임이나'],['mid','보통'],['hard','정확 — 비슷한 동작만']]],['sens','카메라 감도',[['low','낮게'],['mid','보통'],['high','높게']]]]],
 ['준비운동',[['wuSpeed','구령 속도',[['slow','느리게'],['mid','보통'],['fast','빠르게']]]]]];
function openSet(){const box=$('#setBox');box.innerHTML='<h2 style="margin:0">설정 <span class="hint">(이 기기에만 저장돼요)</span></h2>';
 for(const [sec,items] of SETS){const h=document.createElement('h3');h.textContent=sec;box.appendChild(h);
  for(const [k,label,opts] of items){const d=document.createElement('div');d.className='opt';d.innerHTML=`<b>${label}</b>`;
   for(const [v,t] of opts){const b=document.createElement('button');b.textContent=t;if(S[k]===v)b.classList.add('on');b.onclick=()=>{S[k]=v;saveS();[...d.querySelectorAll('button')].forEach(x=>x.classList.remove('on'));b.classList.add('on');if(k==='vol')sfx('ding')};d.appendChild(b)}
   box.appendChild(d)}}
 const c=document.createElement('div');c.style.cssText='text-align:center;margin-top:16px';c.innerHTML='<button class="btn c" style="font-size:26px;padding:10px 40px">닫기</button>';c.firstChild.onclick=()=>$('#settings').classList.remove('on');box.appendChild(c);
 $('#settings').classList.add('on')}
</script>
<script>
// ================= 보치아 =================
(function(){
const cv=$('#bc'), g=cv.getContext('2d'); let W=0,H=0,DPR=1;
function fit(){DPR=Math.min(2,devicePixelRatio||1);W=cv.clientWidth;H=cv.clientHeight;cv.width=W*DPR;cv.height=H*DPR;g.setTransform(DPR,0,0,DPR,0,0)}
addEventListener('resize',()=>{if(cur==='bocce')fit()});
const CW=3, CL=12.5, R=0.21, RJ=0.18, FR=1.25, MAXA=22*Math.PI/180;
const ZC=2.3; let HOR, KV, KH;
function setProj(){HOR=H*0.2;KV=(H*0.93-HOR)*ZC;KH=W*0.9*ZC/6}
function P(x,y){const z=y+ZC;return [W/2+x*KH/z, HOR+KV/z, KH/z]}
const TEAM={red:{c:'#ff7f95',d:'#e0506c',n:'빨강'},blue:{c:'#6fb0ff',d:'#3f86d8',n:'파랑'},jack:{c:'#ffffff',d:'#c9c9d6'}};
let st=null; // 게임 상태
let wol=new Image(); wol.src=src('c_wol_cheer'); let wolJump=0;
const msg=$('#bcMsg'), press=$('#bcPress');const redo=$('#bcRedo');
const BACKABLE=['power','ramp','confirm','confirmR'];
function showRedo(){redo.style.display=(st&&BACKABLE.includes(st.phase))?'block':'none';redo.textContent=st&&st.phase.startsWith('confirm')?'◀ 다시 고르기':'◀ 방향 다시'}
function backToAim(){if(!st||!BACKABLE.includes(st.phase))return;st.phase='aim';st.t0=performance.now();press.textContent='방향';sfx('beep');showRedo()}
window.bcRedo=backToAim;
redo.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();ac();backToAim()});
function setMsg(t,team){msg.textContent=t;msg.style.color=team?TEAM[team].c:'#4a3b52'}
function newGame(mode){
  st={mode,balls:[],left:{red:6,blue:mode==='vs'?6:0},turn:'red',phase:'',ang:0,pow:0,t0:performance.now(),level:0,stars:0,lastTeam:null,thrown:0,drag:null,ramp:0,launchT:0};
  if(S.jack==='auto'){addJack(0+(Math.random()-.5)*1.2, 5+Math.random()*4);startTurn()}
  else{st.jackTurn=true;st.turn='red';beginAim();setMsg((mode==='vs'?'빨강 팀이 ':'')+'흰 공(표적구)을 먼저 던져요','red');say('흰 공을 먼저 던져요')}
}
function addJack(x,y){st.balls.push({k:'jack',x,y,vx:0,vy:0,r:RJ,m:0.8,out:false})}
function jack(){return st.balls.find(b=>b.k==='jack')}
function dist(b,j){return Math.hypot(b.x-j.x,b.y-j.y)-b.r-j.r}
function nearest(team){const j=jack();let m=Infinity;for(const b of st.balls)if(b.k===team&&!b.out)m=Math.min(m,dist(b,j));return m}
function startTurn(){
  if(st.mode==='solo'){if(st.left.red<=0)return endGame();st.turn='red'}
  else{
    const L=st.left;
    if(L.red<=0&&L.blue<=0)return endGame();
    let t;
    const nr=nearest('red'),nb=nearest('blue');
    if(!st.balls.some(b=>b.k==='red'))t='red';
    else if(!st.balls.some(b=>b.k==='blue')&&L.blue>0)t='blue';
    else t= nr<=nb?'blue':'red'; // 멀리 있는 팀이 던짐
    if(nr===nb)t=st.lastTeam==='red'?'blue':'red';
    if(L[t]<=0)t=t==='red'?'blue':'red';
    st.turn=t;
  }
  beginAim();
  const tn=TEAM[st.turn].n;
  setMsg(st.mode==='vs'?`${tn} 팀 차례! (남은 공 ${st.left[st.turn]}개)`:`남은 공 ${st.left.red}개`, st.turn);
  if(st.mode==='vs')say(tn+' 팀 차례');cheerWol(CHEERS[(Math.random()*CHEERS.length)|0]);
}
function beginAim(){st.phase=S.throwMode==='drag'?'drag':'aim';st.t0=performance.now();redo.style.display='none';
  press.style.display=S.throwMode==='drag'?'none':'block';press.classList.toggle('blue',st.turn==='blue');
  press.textContent=st.phase==='aim'?'방향':'';
  if(st.phase==='drag'&&!st.jackTurn)setMsg((st.mode==='vs'?TEAM[st.turn].n+' 팀: ':'')+'공을 앞으로 밀어 던져요',st.turn)}
function period(){return {slow:3.4,mid:2.3,fast:1.5}[S.barSpeed]||2.3}
function onPress(){
  if(!st||cur!=='bocce'||$('#bcStart').style.display!=='none')return;
  if(st.phase==='aim'){st.phase=S.throwMode==='ramp'?'ramp':'power';st.t0=performance.now();press.textContent=S.throwMode==='ramp'?'높이':'세기';sfx('beep');showRedo();return}
  if(st.phase==='power'){st.phase='confirm';press.textContent='굴리기';sfx('beep');showRedo();say('이 길로 굴릴까요?');return}
  if(st.phase==='ramp'){st.phase='confirmR';press.textContent='굴리기';sfx('beep');showRedo();say('이 길로 굴릴까요?');return}
  if(st.phase==='confirm'){redo.style.display='none';launch(st.ang,st.pow);return}
  if(st.phase==='confirmR'){st.phase='rampRoll';st.launchT=performance.now();redo.style.display='none';sfx('beep');return}
}
press.addEventListener('pointerdown',e=>{e.preventDefault();ac();onPress()});
keyHandlers.bocce=()=>{ if(window.bcRulesOpen&&window.bcRulesOpen()){window.bcRulesClose();return}  if($('#bcStart').style.display!=='none'){bcStartKey();return} onPress()};
// 화면 아무 데나 눌러도 됨 (누르기·홈통), 끌어서 던지기
cv.addEventListener('pointerdown',e=>{ac();if(!st)return; if(st.phase==='drag'){st.drag={x0:e.offsetX,y0:e.offsetY,x:e.offsetX,y:e.offsetY,t:performance.now()};cv.setPointerCapture(e.pointerId)} else onPress()});
cv.addEventListener('pointermove',e=>{if(st&&st.drag){st.drag.x=e.offsetX;st.drag.y=e.offsetY}});
cv.addEventListener('pointerup',e=>{if(!st||!st.drag)return;const d=st.drag;st.drag=null;const dx=d.x-d.x0,dy=d.y-d.y0;const len=Math.hypot(dx,dy);
  if(dy>-20||len<30)return; const a=Math.max(-MAXA,Math.min(MAXA,Math.atan2(dx,-dy)*0.6));const p=Math.max(0.05,Math.min(1,len/(H*0.6)));launch(a,p)});
function launch(a,p){
  const k=st.jackTurn?'jack':st.turn; const d=1.2+p*11; const v=Math.sqrt(2*FR*d);
  const b={k,x:0,y:0.25,vx:Math.sin(a)*v,vy:Math.cos(a)*v,r:k==='jack'?RJ:R,m:k==='jack'?0.8:1,out:false};
  if(k==='jack'){const old=jack();if(old)st.balls.splice(st.balls.indexOf(old),1)}
  st.balls.push(b);st.phase='roll';press.style.display='none';rollStart();
  if(!st.jackTurn){st.left[st.turn]--;st.lastTeam=st.turn}
}
function physics(dt){
  let moving=false;
  for(const b of st.balls){if(b.out)continue;const sp=Math.hypot(b.vx,b.vy);if(sp>0){const ns=Math.max(0,sp-FR*dt);b.vx*=ns/sp;b.vy*=ns/sp;b.x+=b.vx*dt;b.y+=b.vy*dt;if(ns>0)moving=true}
    if(Math.abs(b.x)>CW+0.05||b.y>CL+0.05){b.out=true;b.vx=b.vy=0}}
  const bs=st.balls.filter(b=>!b.out);
  for(let i=0;i<bs.length;i++)for(let j=i+1;j<bs.length;j++){const a=bs[i],c=bs[j];const dx=c.x-a.x,dy=c.y-a.y,dd=Math.hypot(dx,dy),md=a.r+c.r;
    if(dd<md&&dd>0){const nx=dx/dd,ny=dy/dd;const ov=md-dd;const tm=a.m+c.m;a.x-=nx*ov*c.m/tm;a.y-=ny*ov*c.m/tm;c.x+=nx*ov*a.m/tm;c.y+=ny*ov*a.m/tm;
      const rv=(c.vx-a.vx)*nx+(c.vy-a.vy)*ny; if(rv<0){const e=0.82;const jj=-(1+e)*rv/(1/a.m+1/c.m);a.vx-=jj*nx/a.m;a.vy-=jj*ny/a.m;c.vx+=jj*nx/c.m;c.vy+=jj*ny/c.m;sfx('clack',Math.min(1,-rv/2),1,60)}}}
  return moving;
}
function settled(){
  rollStop();
  if(st.jackTurn){const j=jack();
    if(!j||j.out||j.y<3){if(j)st.balls.splice(st.balls.indexOf(j),1);setMsg('조금 더 멀리, 선 안으로 다시 던져요','red');say('다시 던져 봐요');beginAim();return}
    st.jackTurn=false;sfx('ding');startTurn();return}
  const last=st.balls[st.balls.length-1], j=jack();
  if(j.out){j.out=false;j.x=0;j.y=6.25;j.vx=j.vy=0;setMsg('흰 공이 나가서 가운데 십자로 옮겼어요')}
  if(st.mode==='solo'){
    if(last.out){setMsg('공이 밖으로 나갔어요. 괜찮아요!');sfx('beep')}
    else{const d=dist(last,j);const s=d<0.35?3:d<1?2:d<2?1:0;st.stars+=s;last.star=s;
      if(s===3){burst(innerWidth/2,innerHeight*0.45,70,7,4);sfx('clap');say('아주 가까워요');wolJump=1;cheerWol('최고야!')}
      else if(s===2){sfx('spark');sfx('daego',0.7);say('가까워요');wolJump=1;cheerWol('잘했어!')}
      else if(s===1){sfx('spark');say('좋아요');cheerWol('좋아!')}else{say('다시 해 봐요');cheerWol('괜찮아, 다시!')}}
    setTimeout(()=>startTurn(),1400);
  }else{
    if(!last.out){const d=dist(last,j); if(d<0.5){sfx('spark');wolJump=1;cheerWol('와, 가깝다!')}} 
    setTimeout(()=>startTurn(),1000);
  }
}
function endGame(){
  st.phase='end';press.style.display='none';redo.style.display='none';
  if(st.mode==='solo'){const n=st.stars;setMsg(`별 ${n}개! 참 잘했어요`);celebrate('c_wol_cheer',`별 ${n}개!`)}
  else{const nr=nearest('red'),nb=nearest('blue');const win=nr<nb?'red':'blue';const lose=win==='red'?'blue':'red';const lim=Math.min(nr,nb)===nr?nb:nr;
    let pts=0;for(const b of st.balls)if(b.k===win&&!b.out&&dist(b,jack())<lim)pts++;
    if(!isFinite(nr)&&!isFinite(nb)){setMsg('모두 잘했어요!');celebrate('c_wol_cheer','모두 잘했어요!');return}
    st.result={win,pts};setMsg(`${TEAM[win].n} 팀 ${pts}점! 두 팀 모두 잘했어요`,win);
    celebrate('c_wol_cheer',`${TEAM[win].n} ${pts}점!`);setTimeout(()=>say('두 팀 모두 잘했어요. 박수'),2600)}
}
// ---- 그리기 ----
function drawCourt(){
  const wg=g.createLinearGradient(0,0,0,HOR+H*0.12);wg.addColorStop(0,'#dff0ff');wg.addColorStop(1,'#fdeef6');g.fillStyle=wg;g.fillRect(0,0,W,H);
  // 벽 장식: 파스텔 구름 띠
  g.fillStyle='rgba(255,255,255,.75)';for(let i=0;i<7;i++){const x=(i+0.5)*W/7,y=HOR*0.55+Math.sin(i*1.7)*HOR*0.12;g.beginPath();g.ellipse(x,y,W*0.05,HOR*0.12,0,0,6.283);g.ellipse(x+W*0.035,y+4,W*0.04,HOR*0.1,0,0,6.283);g.fill()}
  const [,yF]=P(0,CL+4);
  const fg=g.createLinearGradient(0,yF,0,H);fg.addColorStop(0,'#f7ecff');fg.addColorStop(1,'#ffe3ee');g.fillStyle=fg;g.fillRect(0,yF,W,H-yF);
  g.strokeStyle='rgba(255,255,255,.55)';g.lineWidth=1.5;for(let x=-8;x<=8;x+=0.6){const a=P(x,-2),c=P(x,CL+4);g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(c[0],c[1]);g.stroke()}
  const c1=P(-CW,0),c2=P(CW,0),c3=P(CW,CL),c4=P(-CW,CL);
  const cg=g.createLinearGradient(0,c4[1],0,c1[1]);cg.addColorStop(0,'#c8f1e3');cg.addColorStop(1,'#b5e8f7');g.fillStyle=cg;
  g.beginPath();g.moveTo(c1[0],c1[1]);g.lineTo(c2[0],c2[1]);g.lineTo(c3[0],c3[1]);g.lineTo(c4[0],c4[1]);g.closePath();g.fill();
  g.strokeStyle='#ffffff';g.lineWidth=4;g.lineJoin='round';g.stroke();
  const v1=P(-CW,1.5),v2=P(0,3),v3=P(CW,1.5);g.beginPath();g.moveTo(v1[0],v1[1]);g.lineTo(v2[0],v2[1]);g.lineTo(v3[0],v3[1]);g.stroke();
  for(let i=-2;i<=2;i++){const a=P(i,0),c=P(i,-0.9);g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(c[0],c[1]);g.stroke()}
  const cx=P(0,6.25);g.beginPath();g.moveTo(cx[0]-cx[2]*0.25,cx[1]);g.lineTo(cx[0]+cx[2]*0.25,cx[1]);g.moveTo(cx[0],P(0,6.0)[1]);g.lineTo(cx[0],P(0,6.5)[1]);g.stroke();
}
function ball(b,alpha=1){const [x,y,s]=P(b.x,b.y);const r=b.r*s;const t=TEAM[b.k];
  g.globalAlpha=alpha*0.25;g.fillStyle='#000';g.beginPath();g.ellipse(x,y,r*1.05,r*0.35,0,0,6.283);g.fill();
  g.globalAlpha=alpha;const gr=g.createRadialGradient(x-r*.35,y-r*1.35,r*.1,x,y-r*.9,r*1.1);gr.addColorStop(0,'#fff');gr.addColorStop(0.25,t.c);gr.addColorStop(1,t.d);
  g.fillStyle=gr;g.beginPath();g.arc(x,y-r*0.9,r,0,6.283);g.fill();g.globalAlpha=1;
  if(b.star){for(let i=0;i<b.star;i++)star(x+(i-(b.star-1)/2)*r*1.3,y-r*2.6,r*0.55)}}
function star(x,y,r){g.fillStyle='#ffcf3a';g.strokeStyle='#e0a800';g.lineWidth=1.5;g.beginPath();for(let i=0;i<10;i++){const a=-Math.PI/2+i*Math.PI/5,rr=i%2?r*0.45:r;g.lineTo(x+Math.cos(a)*rr,y+Math.sin(a)*rr)}g.closePath();g.fill();g.stroke()}
// 고른 방향·세기로 공이 갈 길 미리 보기 (다른 공과 부딪히기 전까지)
function preview(a,p,col){const d=1.2+p*11;const ex=Math.sin(a)*d,ey=0.25+Math.cos(a)*d;const out=Math.abs(ex)>CW||ey>CL;
  const t=performance.now()/1000;g.strokeStyle=col;g.lineWidth=10;g.lineCap='round';g.setLineDash([2,18]);g.lineDashOffset=-t*40;g.beginPath();
  const [x0,y0]=P(0,0.25);g.moveTo(x0,y0);for(let k=1;k<=24;k++){const q=d*k/24;const [x,y]=P(Math.sin(a)*q,0.25+Math.cos(a)*q);g.lineTo(x,y)}g.stroke();g.setLineDash([]);g.lineDashOffset=0;
  const k=st.jackTurn?'jack':st.turn;g.save();g.globalAlpha=0.45+0.2*Math.sin(t*5);ball({k,x:Math.max(-CW,Math.min(CW,ex)),y:Math.min(CL,ey),r:k==='jack'?RJ:R});g.restore();
  const [cx,cy,sc]=P(Math.max(-CW,Math.min(CW,ex)),Math.min(CL,ey));g.font='900 24px sans-serif';g.lineWidth=6;g.strokeStyle='#fff';g.strokeText(out?'밖으로 나가요!':'여기쯤 멈춰요',cx,cy-34);g.textAlign='center';
  g.fillStyle=out?'#e8505b':'#4a3b52';g.fillText(out?'밖으로 나가요!':'여기쯤 멈춰요',cx,cy-34)}
function arrow(a,len,col){const [x0,y0]=P(0,0.25);const tx=Math.sin(a)*len,ty=Math.cos(a)*len;const [x1,y1]=P(tx,0.25+ty);
  g.strokeStyle=col;g.lineWidth=10;g.lineCap='round';g.setLineDash([2,18]);g.beginPath();g.moveTo(x0,y0);g.lineTo(x1,y1);g.stroke();g.setLineDash([]);
  const [x2,y2]=P(Math.sin(a)*(len-0.5),0.25+Math.cos(a)*(len-0.5));const an=Math.atan2(y1-y2,x1-x2);g.fillStyle=col;g.beginPath();g.moveTo(x1+Math.cos(an)*14,y1+Math.sin(an)*14);g.lineTo(x1+Math.cos(an+2.4)*22,y1+Math.sin(an+2.4)*22);g.lineTo(x1+Math.cos(an-2.4)*22,y1+Math.sin(an-2.4)*22);g.fill()}
function powerBar(p,col){const bw=Math.min(70,W*0.06),bh=H*0.5,x=W*0.06,y=H*0.3;g.fillStyle='rgba(255,255,255,.85)';round(x-6,y-6,bw+12,bh+12,18);g.fill();
  const gr=g.createLinearGradient(0,y+bh,0,y);gr.addColorStop(0,'#69db7c');gr.addColorStop(0.6,'#ffd43b');gr.addColorStop(1,'#ff6b6b');g.fillStyle=gr;round(x,y+bh*(1-p),bw,bh*p,12);g.fill();
  g.fillStyle='#4a3b52';g.font=`900 ${Math.round(bw*0.42)}px sans-serif`;g.textAlign='center';g.fillText('세기',x+bw/2,y+bh+bw*0.6)}
function round(x,y,w,h,r){g.beginPath();g.roundRect?g.roundRect(x,y,w,Math.max(0,h),Math.min(r,h/2)):g.rect(x,y,w,h)}
function drawRamp(level,roll){ // 홈통
  const x=W/2,yb=H*0.98,ht=H*0.36,w=W*0.05;const top=yb-ht;g.save();g.translate(x,yb);g.rotate(st.ang*0.6);
  g.fillStyle='#9aa7b8';g.fillRect(-w/2,-ht,w,ht);g.fillStyle='#c5d0de';g.fillRect(-w/2+6,-ht,w-12,ht);
  for(let i=1;i<=5;i++){const yy=-ht*(i/5.4);g.fillStyle=i===level?'#ffcf3a':'rgba(255,255,255,.7)';g.beginPath();g.arc(w/2+18,yy,9,0,6.283);g.fill()}
  const yy=-ht*(level/5.4)*(1-roll);const c=TEAM[st.jackTurn?'jack':st.turn];g.fillStyle=c.c;g.strokeStyle=c.d;g.lineWidth=3;g.beginPath();g.arc(0,yy,w*0.42,0,6.283);g.fill();g.stroke();g.restore()}
function hud(){ if(st.mode!=='vs'&&st.mode!=='solo')return; const r=Math.min(18,W*0.015);let y=86;
  for(const t of (st.mode==='vs'?['red','blue']:['red'])){let x=W-24-r;g.fillStyle='rgba(255,255,255,.8)';round(W-24-12*(2*r+6)/2-6*2*r-30,y-r-8,6*(2*r+6)+20,2*r+16,16);
    for(let i=0;i<6;i++){g.globalAlpha=i<st.left[t]?1:0.18;g.fillStyle=TEAM[t].c;g.beginPath();g.arc(W-30-r-i*(2*r+6),y,r,0,6.283);g.fill()}g.globalAlpha=1;y+=2*r+20}}
let last=0,acc=0;
function loop(ts){ if(cur!=='bocce'){last=0;return} requestAnimationFrame(loop);
  const dt=last?Math.min(0.05,(ts-last)/1000):0;last=ts;
  if(st&&st.phase==='roll'){acc+=dt;let mv=true;while(acc>1/120){mv=physics(1/120);acc-=1/120}if(!mv){st.phase='wait';setTimeout(settled,350)}}
  g.clearRect(0,0,W,H);drawCourt();
  if(!st)return;
  const T=(performance.now()-st.t0)/1000, per=period();
  if(st.phase==='aim'){st.ang=Math.sin(T*2*Math.PI/(per/0.7))*MAXA}
  if(st.phase==='power'){const u=(T/per)%1;st.pow=u<0.5?u*2:2-u*2}
  if(st.phase==='ramp'){st.level=1+Math.floor((T/(per*0.5))%5)}
  const col=st.jackTurn?'#ffffff':TEAM[st.turn].c;
  if(st.phase==='confirm'||st.phase==='confirmR')preview(st.ang,st.phase==='confirm'?st.pow:st.level/5,col);
  else if(st.phase==='aim'||st.phase==='power'||st.phase==='ramp'||st.phase==='rampRoll')arrow(st.ang,st.phase==='power'?2+st.pow*9:5,col);
  const bs=[...st.balls].sort((a,b)=>b.y-a.y);
  for(const b of bs)ball(b,b.out?0.3:1);
  // 던질 공 미리 보이기
  if(['aim','power','drag','confirm'].includes(st.phase)&&S.throwMode!=='ramp'){ball({k:st.jackTurn?'jack':st.turn,x:0,y:0.25,r:st.jackTurn?RJ:R})}
  if(st.phase==='power'||st.phase==='confirm')powerBar(st.pow,col);
  if(S.throwMode==='ramp'&&['aim','ramp','confirmR','rampRoll'].includes(st.phase)){let roll=0;if(st.phase==='rampRoll'){roll=Math.min(1,(performance.now()-st.launchT)/600);if(roll>=1){launch(st.ang,st.level/5)}}drawRamp(st.phase==='aim'?3:st.level,roll)}
  if(st.drag){const d=st.drag;g.strokeStyle=col;g.lineWidth=12;g.lineCap='round';g.beginPath();g.moveTo(d.x0,d.y0);g.lineTo(d.x,d.y);g.stroke()}
  hud();
  // 월이 응원
  if(wol.complete&&wol.naturalWidth){const h=Math.min(H*0.36,W*0.3,300),w=h*wol.naturalWidth/wol.naturalHeight;const t=performance.now()/1000;
    let jy=Math.abs(Math.sin(t*3.2))*10;if(wolJump>0){jy+=Math.sin(wolJump*Math.PI)*60;wolJump=Math.max(0,wolJump-dt*1.4)}
    const x=W*0.03+w/2,y=H-12-h/2-jy;g.save();g.translate(x,y);g.rotate(Math.sin(t*3.2)*0.08);g.drawImage(wol,-w/2,-h/2,w,h);g.restore();
    if(wolSay&&performance.now()<wolSayT){const fs=Math.max(18,Math.min(30,W*0.022));g.font=`900 ${fs}px sans-serif`;const tw=g.measureText(wolSay).width+28;const bx=x+w*0.25,by=y-h*0.62;
      g.fillStyle='#fff';g.strokeStyle='#ffb3c7';g.lineWidth=4;g.beginPath();g.roundRect?g.roundRect(bx,by-fs-10,tw,fs+22,18):g.rect(bx,by-fs-10,tw,fs+22);g.fill();g.stroke();
      g.beginPath();g.moveTo(bx+18,by+12);g.lineTo(bx+8,by+28);g.lineTo(bx+34,by+12);g.fill();g.fillStyle='#e0506c';g.textAlign='left';g.fillText(wolSay,bx+14,by+4)}}
}
function cheerWol(t,ms=2200){wolSay=t;wolSayT=performance.now()+ms}
let wolSay='',wolSayT=0;
const CHEERS=['할 수 있어!','힘내!','천천히 잘 봐!','좋아, 가자!'];
// ---- 시작 화면 ----
const startBox=$('#bcStart');
function showStart(){startBox.style.display='flex';$$('#bcStart .modebtn').forEach(b=>b.classList.remove('focus'));
  $('#bcModeHint').textContent='던지는 방법: '+({bar:'누르기(막대)',drag:'끌어서 던지기',ramp:'홈통'})[S.throwMode]+' · 흰 공: '+(S.jack==='auto'?'자동':'학생이 먼저')+' (설정에서 바꿀 수 있어요)';press.style.display='none';setMsg('');st=null}
$$('[data-bm]').forEach(b=>b.onclick=()=>{ac();startBox.style.display='none';newGame(b.dataset.bm)});
function bcStartKey(){const bs=$$('#bcStart .modebtn');let i=bs.findIndex(b=>b.classList.contains('focus'));if(i<0){bs[0].classList.add('focus');scan()}else{clearTimeout(scan.t);bs[i].click()}
  function scan(){scan.t=setTimeout(function nx(){let k=bs.findIndex(b=>b.classList.contains('focus'));if(k<0||startBox.style.display==='none')return;bs[k].classList.remove('focus');bs[(k+1)%bs.length].classList.add('focus');scan.t=setTimeout(nx,1800)},1800)}}
$('#bcAgain').onclick=()=>{rollStop();showStart()};
const bcR=$('#bcRules'),bcROk=$('#bcRulesOk');window.bcRulesOpen=()=>bcR.classList.contains('on');window.bcRulesClose=()=>{bcR.classList.remove('on');bcROk.classList.remove('focus');try{speechSynthesis.cancel()}catch(e){}};function bcRulesShow(){bcR.classList.add('on');bcROk.classList.add('focus');say('보치아 규칙이에요. 흰 공에 가장 가까이 굴린 팀이 이겨요')}bcROk.onclick=()=>{ac();window.bcRulesClose()};$('#bcRulesBtn').onclick=()=>{ac();bcRulesShow()};onEnter.bocce=()=>{fit();setProj();showStart();requestAnimationFrame(loop);bcRulesShow()};
onLeave.bocce=()=>{window.bcRulesClose();rollStop();redo.style.display='none'};
addEventListener('resize',()=>{if(cur==='bocce')setProj()});
})();

</script>
<script>
// ================= 움직여 봐요 =================
(function(){
const cv=$('#mv'),g=cv.getContext('2d');let W=0,H=0;
function fit(){W=cv.clientWidth;H=cv.clientHeight;const d=Math.max(0.5,Math.min(2,devicePixelRatio||1,Math.sqrt(2.1e6/Math.max(1,W*H))));cv.width=W*d;cv.height=H*d;g.setTransform(d,0,0,d,0,0)}
const ACTS=[
 {id:'fly',nm:'날아오르기',img:'fly1',fr:['fly1','fly2'],bg:'bg_sky',tip:'두 팔을 새처럼 위아래로 퍼덕여요',path:[[.12,.78],[.72,.24]],goal:{k:'g_moon',x:.87,y:.22,h:.4}},
 {id:'swim',nm:'수영',img:'swim1',fr:['swim1','swim2'],bg:'bg_water',tip:'두 팔을 번갈아 돌리거나 함께 저어요',path:[[.1,.45],[.7,.52]],goal:{k:'g_chest1',k2:'g_chest2',x:.875,y:.74,h:.26}},
 {id:'kick',nm:'공 차기',img:'kick1',fr:['kick1','kick2'],bg:'bg_field',tip:'발이나 팔을 크게 휘둘러 차요',path:[[.1,.7],[.62,.66]],goal:{ball:true,x:.86,y:.55}},
 {id:'hike',nm:'등산',img:'hike1',fr:['hike1','hike2'],bg:'bg_mountain',tip:'제자리 걷기처럼 다리와 팔을 번갈아 움직여요',path:[[.2,.82],[.62,.34]],goal:{k:'g_stele',x:.76,y:.24,h:.36}},
 {id:'climb',nm:'암벽등반',img:'climb1',fr:['climb1','climb2'],bg:'bg_wall',tip:'두 손을 번갈아 위로 쭉쭉 뻗어요',path:[[.5,.82],[.5,.36]],goal:{k:'g_bell',x:.5,y:.13,h:.17,swing:true}},
 {id:'run',nm:'제자리 달리기',img:'run1',fr:['run1','run2'],bg:'bg_track',tip:'제자리에서 무릎을 번갈아 들며 달려요',path:[[.08,.74],[.66,.7]],goal:{k:'g_finish',x:.84,y:.66,h:.32}},
 {id:'jump',nm:'점프',img:'jump2',fr:['jump1','jump2'],bg:'bg_orchard',tip:'제자리에서 폴짝폴짝 뛰어요',path:[[.3,.8],[.42,.36]],goal:{k:'g_apple',x:.56,y:.14,h:.2,shine:true},jumpy:true},
 {id:'squat',nm:'앉았다 일어나기',img:'squat1',fr:['squat1','squat2'],bg:'bg_farm',tip:'무릎을 굽혀 앉았다가 쭉 일어나요',path:[[.1,.74],[.6,.72]],goal:{k:'g_radish',x:.8,y:.5,h:.4,bury:true}},
 {id:'jack',nm:'팔 벌려 뛰기',img:'jack1',fr:['jack1','jack2'],alt:['jump1','jump2'],bg:'bg_track',tip:'두 팔을 머리 위로 올리며 다리를 벌렸다가 모아요',path:[[.14,.8],[.5,.79]],goal:{rainbow:true,x:.5,y:.8},jumpy:true},
 {id:'row',nm:'노 젓기',img:'row1',fr:['row1','row2'],alt:['swim1','swim2'],bg:'bg_river',tip:'카메라 쪽으로 비스듬히 앉아요. 두 팔로 노를 앞으로 밀었다가 당겨요',ic:true,path:[[.8,.9],[.63,.68],[.46,.56]],goal:{k:'g_pavilion',x:.35,y:.45,h:.17}}];
// 새 그림이 아직 없으면 비슷한 그림으로 대신
ACTS.forEach(a=>{if(a.alt&&!A[a.img]){a.img=a.alt[0];a.fr=a.alt}});
let act=ACTS[0], players=1, imgs={};
function im(k){if(!imgs[k]){imgs[k]=new Image();imgs[k].src=src(k)}return imgs[k]}
// 고르기 화면
const actsEl=$('#mvActs');
ACTS.forEach((a,i)=>{const b=document.createElement('button');b.className='act'+(i?'':' sel');b.innerHTML=`<img src="${src(a.img)}">${a.nm}`;b.onclick=()=>{act=a;$$('.act').forEach(x=>x.classList.remove('sel'));b.classList.add('sel');sfx('beep')};actsEl.appendChild(b)});
let stage=1;const STG=[[1,'1단계 · 짧게'],[2,'2단계 · 보통'],[3,'3단계 · 길게']];
const stEl=$('#mvStage');stEl.innerHTML='<b style="min-width:auto">단계</b>';
function drawStage(){[...stEl.querySelectorAll('button')].forEach((b,i)=>b.classList.toggle('on',i+1===stage))}
STG.forEach(([v,t])=>{const b=document.createElement('button');b.textContent=t;b.onclick=()=>{stage=v;drawStage()};stEl.appendChild(b)});drawStage();
const pl=$('#mvPlayers');pl.innerHTML='<b style="min-width:auto">누가 할까요?</b>';
[[1,'한 명'],[2,'둘이 대결'],[3,'반 전체']].forEach(([v,t])=>{const b=document.createElement('button');b.textContent=t;if(v===1)b.classList.add('on');b.onclick=()=>{players=v;setTimeout(camStatus,0);[...pl.querySelectorAll('button')].forEach(x=>x.classList.remove('on'));b.classList.add('on')};pl.appendChild(b)});
// 카메라
// 카메라 넓이: 칠판 카메라가 너무 넓게 잡을 때 가운데 칸 안의 아이만 봐요 (2026-11-24)
let ZOOM=1;try{ZOOM=+localStorage.getItem('goat-zoom')||1}catch(e){}if([1,1.5,2].indexOf(ZOOM)<0)ZOOM=1;
const zEl=$('#mvZoom');zEl.innerHTML='<b style="min-width:auto">카메라 넓이</b>';
function drawZoom(){[...zEl.querySelectorAll('button')].forEach(b=>b.classList.toggle('on',+b.dataset.z===ZOOM))}
[[1,'넓게'],[1.5,'가운데 1.5배'],[2,'가운데 2배']].forEach(([v,t])=>{const b=document.createElement('button');b.textContent=t;b.dataset.z=v;b.onclick=()=>{ZOOM=v;try{localStorage.setItem('goat-zoom',String(v))}catch(e){}if(typeof tgtReset==='function')tgtReset();tgtTap=null;drawZoom();setTimeout(camStatus,0)};zEl.appendChild(b)});drawZoom();
function zoomX(){const w=1/ZOOM;return[(1-w)/2,1-(1-w)/2]}
function inZoom(x){if(ZOOM<=1)return true;const z=zoomX();return x>=z[0]&&x<=z[1]}
const video=$('#cam');let stream=null,camOK=false;const small=document.createElement('canvas');small.width=160;small.height=120;const sg=small.getContext('2d',{willReadFrequently:true});let prev=null;
let camErr='';
const WEBURL='https://chiwookhan81.github.io/hyegwang-goat/';
const IS_INAPP=/KAKAOTALK|NAVER\(inapp|Instagram|FBAN|FBAV|Line\//i.test(navigator.userAgent);
const IS_MOBILE=/Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
async function camOn(){if(stream&&camOK)return true;camErr='';
  if(IS_INAPP){camErr='inapp';camStatus();return false}
  if(!window.isSecureContext||/^content:/.test(location.protocol)||(IS_MOBILE&&location.protocol==='file:')){camErr='mobilefile';camStatus();return false}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){camErr='nosupport';camStatus();return false}
  try{try{stream=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:640},height:{ideal:480},facingMode:'user'},audio:false})}
      catch(e){if(e&&(e.name==='OverconstrainedError'||e.name==='ConstraintNotSatisfiedError'))stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});else throw e}
    video.srcObject=stream;video.muted=true;await video.play();camOK=true;video.style.display='block';camStatus();poseInit();return true}
  catch(e){camOK=false;stream=null;video.style.display='none';camErr=(e&&e.name)||'unknown';if(camErr==='NotAllowedError'&&location.protocol!=='https:'&&location.protocol!=='file:'&&location.hostname!=='localhost')camErr='mobilefile';camStatus();return false}}
const CAMMSG={
 NotAllowedError:IS_MOBILE?'카메라 사용이 막혀 있어요. 주소창 왼쪽 아이콘을 누르고 <b>권한 → 카메라 → 허용</b>을 고른 뒤 <b>카메라 다시 연결</b>을 눌러 주세요. 그래도 안 되면 폰 <b>설정 → 애플리케이션 → 크롬 → 권한 → 카메라</b>를 허용해 주세요.':'카메라 사용이 막혀 있어요. 주소창 왼쪽의 아이콘(자물쇠나 카메라 모양)을 눌러 카메라를 <b>허용</b>으로 바꾼 뒤, 아래 <b>카메라 다시 연결</b>을 눌러 주세요.',
 mobilefile:'폰·태블릿·전자칠판(안드로이드)에서는 <b>내려받은 파일로 열면 카메라를 쓸 수 없어요.</b> 설정을 바꿔도 안 돼요. 인터넷에 연결한 뒤 크롬에서 아래 주소로 열어 주세요. (즐겨찾기에 넣어 두면 편해요)<br><a href="'+WEBURL+'" style="font-weight:800;color:#2f78c4;word-break:break-all">'+WEBURL+'</a>',
 inapp:'카카오톡 같은 앱 안에서 열면 카메라를 쓸 수 없어요. 오른쪽 위 메뉴(⋮)에서 <b>다른 브라우저로 열기</b>를 눌러 크롬으로 열어 주세요.',
 SecurityError:'이 방식으로 연 파일에서는 카메라를 쓸 수 없어요. 파일을 내려받아 <b>크롬이나 엣지로 직접</b> 열어 주세요. (구글 드라이브 미리보기 화면에서는 안 돼요)',
 NotFoundError:'이 컴퓨터에서 카메라를 찾지 못했어요. 웹캠을 꽂고 <b>카메라 다시 연결</b>을 눌러 주세요.',
 NotReadableError:'다른 프로그램(줌, 카메라 앱 등)이 카메라를 쓰고 있어요. 그 프로그램을 닫고 <b>카메라 다시 연결</b>을 눌러 주세요.',
 nosupport:'이 브라우저나 열린 방식에서는 카메라를 쓸 수 없어요. 파일을 내려받아 <b>크롬이나 엣지로 직접</b> 열어 주세요. (구글 드라이브 미리보기, 카카오톡 안 브라우저에서는 안 돼요)',
 unknown:'카메라를 켜지 못했어요. 웹캠 연결과 브라우저의 카메라 허용을 확인해 주세요.'};
function camStatus(){setTimeout(()=>typeof fitPick==='function'&&fitPick(),30);const el=$('#camMsg');if(!el)return;
  if(camOK){el.className='cammsg ok';el.innerHTML='카메라가 켜졌어요. '+(players===3?'반 전체는 화면 전체의 움직임을 봐요. 움직인 자리가 카메라 화면에서 반짝여요.':poseState==='on'?'<b>몸 인식 준비 끝!</b> 카메라 화면에 노란 선(몸)이 보이면 잘 보이는 거예요. 머리부터 발까지 보이면 더 정확해요. 여러 아이가 보이면 카메라 화면에서 한 아이를 눌러 고를 수 있어요.':poseState==='loading'?'몸 인식기를 준비하고 있어요… (몇 초 걸려요)':'화면 앞에서 움직여 보세요 — 아래 막대가 움직이면 잘 보이는 거예요.')}
  else if(camErr){el.className='cammsg bad';el.innerHTML=(CAMMSG[camErr]||CAMMSG.unknown)+'<br><span class="hint">카메라가 없어도 마우스나 손가락으로 화면을 문지르면 움직여요.</span>'}
  else{el.className='cammsg';el.innerHTML='<b>카메라 켜기</b>를 누르면 브라우저가 카메라를 써도 되는지 물어봐요. <b>허용</b>을 눌러 주세요.'}
  const chip=$('#camChip');if(chip){chip.textContent=camOK?'카메라 켜짐':'카메라 꺼짐 — 마우스·손가락으로 문질러요';chip.className='camchip '+(camOK?'ok':'bad')}}
function camOff(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}camOK=false;prev=null}
const GC=8,GR=6;let grid=new Float32Array(GC*GR),ptr=new Float32Array(GC*GR);
const FC=32,FR=24;let fm=new Float32Array(FC*FR),fmS=new Float32Array(FC*FR);// 빛 점용 고운 움직임 지도(거울 방향)
function sense(){poseStep();grid.fill(0);
  if(run&&poseUse()&&people.length){prev=null}
  else if(camOK&&video.readyState>=2){sg.drawImage(video,0,0,160,120);const d=sg.getImageData(0,0,160,120).data;const cur=new Uint8Array(160*120);
    for(let i=0,p=0;i<cur.length;i++,p+=4)cur[i]=(d[p]*3+d[p+1]*6+d[p+2])/10;
    if(prev){const T={low:42,mid:28,high:17}[S.sens]||28;const cnt=new Float32Array(GC*GR);fm.fill(0);
      for(let y=0;y<120;y+=2)for(let x=0;x<160;x+=2){const i=y*160+x;if(Math.abs(cur[i]-prev[i])>T){const gx=GC-1-((x*GC/160)|0),gy=(y*GR/120)|0;cnt[gy*GC+gx]++;fm[((y*FR/120)|0)*FC+FC-1-((x*FC/160)|0)]++}}
      const per=(160/GC/2)*(120/GR/2);for(let k=0;k<grid.length;k++)grid[k]=Math.min(1,cnt[k]/per);
      for(let k=0;k<fm.length;k++){fm[k]=Math.min(1,fm[k]/4);fmS[k]=Math.max(fmS[k]*0.86,fm[k])}}
    prev=cur}
  for(let k=0;k<grid.length;k++){grid[k]=Math.min(1,grid[k]+ptr[k]);ptr[k]*=0.6}}
// 마우스·터치로 문질러도 움직임
cv.addEventListener('pointermove',e=>{if(!run)return;const gx=Math.min(GC-1,(e.offsetX/W*GC)|0),gy=Math.min(GR-1,(e.offsetY/H*GR)|0);const sp=Math.min(1,Math.hypot(e.movementX||0,e.movementY||0)/25+0.3);for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const x=gx+dx,y=gy+dy;if(x<0||y<0||x>=GC||y>=GR)continue;const k=y*GC+x;ptr[k]=Math.min(1,ptr[k]+sp*(dx||dy?0.35:0.7))}});
function zone(c0,c1,r0,r1){let s=0,n=0;for(let r=r0;r<=r1;r++)for(let c=c0;c<=c1;c++){s+=grid[r*GC+c];n++}return s/n}
// 한 사람(또는 반쪽)의 특징
function feat(c0,c1){const m=(c0+c1+1)>>1;return{TL:zone(c0,m-1,0,1),TR:zone(m,c1,0,1),ML:zone(c0,m-1,2,3),MR:zone(m,c1,2,3),BL:zone(c0,m-1,4,5),BR:zone(m,c1,4,5),ALL:zone(c0,c1,0,5)}}
const cl=v=>Math.max(0,Math.min(1,v));
function altCount(h,fn){let n=0,s=0;for(const f of h){const d=fn(f);const sg=d>0.02?1:d<-0.02?-1:0;if(sg&&sg!==s){if(s)n++;s=sg}}return n}
function match(id,f,h){const act=cl(f.ALL/0.05);if(act<0.05)return{act,m:0};
  const up=(f.TL+f.TR+f.ML+f.MR),sym=Math.min(f.TL+f.ML,f.TR+f.MR)/(Math.max(f.TL+f.ML,f.TR+f.MR)+1e-6),low=(f.BL+f.BR)/(up+f.BL+f.BR+1e-6);let m=0;
  if(id==='fly')m=sym*cl(up/0.25)*(1-low*0.6);
  else if(id==='swim'){const a=cl(altCount(h,x=>(x.TL+x.ML)-(x.TR+x.MR))/3);m=Math.max(a,sym*0.8)*cl(up/0.2)}
  else if(id==='kick')m=cl(low*2.2)*cl((f.BL+f.BR)/0.12);
  else if(id==='hike'){const a=cl(altCount(h,x=>(x.ML+x.BL)-(x.MR+x.BR))/3);m=Math.max(a,0.5*cl(low*2))}
  else if(id==='climb'){const a=cl(altCount(h,x=>x.TL-x.TR)/3);m=a*cl((f.TL+f.TR)/0.15)}
  else if(id==='run'||id==='bike'){const a=cl(altCount(h,x=>(x.ML+x.BL)-(x.MR+x.BR))/3);m=Math.max(a,0.6*cl(low*2))}
  else if(id==='jump'||id==='squat')m=sym*cl(f.ALL/0.12);
  else if(id==='jack')m=sym*cl(up/0.25)*cl(f.ALL/0.1);
  else if(id==='row'){const a=cl(altCount(h,x=>x.ML-x.MR)/3);m=Math.max(a,sym)*cl((f.ML+f.MR)/0.12)*(1-0.5*low)}
  return{act,m:cl(m)}}
// ---------- 몸 관절 인식 (MediaPipe Pose, 앱 안에 들어 있음) ----------
let pose=null,poseState='off',poseMsg='',lastPoseT=0,lastVidT=-1,people=[],noBodyT=0,poseGap=45,poseN=2,poseNBusy=false;
const pin=document.createElement('canvas');pin.width=256;pin.height=192;const ping=pin.getContext('2d');// 인식기에 넣을 작은 그림
const PH=[[],[]];// 자리별 기록
// 목표 아이: 선생님이 카메라 화면에서 누르면 그 아이, 안 누르면 가운데 가장 큰 아이. 그 둘레만 잘라서 인식
let tgt=null,tgtTap=null,lostT=0,crop={x:0,y:0,w:1,h:1};
function tgtReset(){tgt=null;lostT=0;crop={x:0,y:0,w:1,h:1};PH[0].length=0;PH[1].length=0}
const JI={nose:0,ls:11,rs:12,le:13,re:14,lw:15,rw:16,lh:23,rh:24,lk:25,rk:26,la:27,ra:28};
async function gunz(id){const el=document.getElementById(id);if(!el)throw Error('noasset');const s=atob(el.textContent.trim());const u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);
  return new Uint8Array(await new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer())}
async function poseInit(){if(poseState!=='off')return;if(typeof DecompressionStream==='undefined'){poseState='fail';return}
  poseState='loading';camStatus();
  try{const [b,l,w,m]=await Promise.all(['mp_b','mp_l','mp_w','mp_m'].map(gunz));
    const url=(x,t)=>URL.createObjectURL(new Blob([x],{type:t}));
    const mod=await import(url(b,'text/javascript'));
    const fs={wasmLoaderPath:url(l,'text/javascript'),wasmBinaryPath:url(w,'application/wasm')};
    const opt=d=>({baseOptions:{modelAssetBuffer:m,delegate:d},runningMode:'VIDEO',numPoses:2,minPoseDetectionConfidence:0.5,minPosePresenceConfidence:0.5,minTrackingConfidence:0.5});
    try{pose=await mod.PoseLandmarker.createFromOptions(fs,opt('GPU'))}catch(e){pose=await mod.PoseLandmarker.createFromOptions(fs,opt('CPU'))}
    poseState='on'}catch(e){console.warn('pose',e);poseState='fail'}
  camStatus()}
function poseUse(){return poseState==='on'&&camOK&&players!==3}
function poseStep(){if(!poseUse()||video.readyState<2)return;const now=performance.now();if(now-lastPoseT<poseGap||video.currentTime===lastVidT)return;const gapT=lastPoseT?Math.min(0.5,(now-lastPoseT)/1000):0.05;lastPoseT=now;lastVidT=video.currentTime;
  const track=players===1;const want=players===2?2:(track&&tgt&&lostT<1.2?2:4);if(want!==poseN&&!poseNBusy&&pose.setOptions){poseNBusy=true;pose.setOptions({numPoses:want}).then(()=>{poseN=want}).catch(()=>{}).then(()=>{poseNBusy=false})}
  const vw=video.videoWidth||320,vh=video.videoHeight||240;const ph=Math.round(256*vh/vw);if(pin.height!==ph)pin.height=ph;
  // 목표 아이 둘레만 잘라 크게 보기
  let cx0=0,cy0=0,cw=1,ch=1;
  if(track&&tgt&&lostT<1.2){const z=Math.max(0.34,Math.min(1,tgt.s*8));const tx=Math.min(1-z,Math.max(0,tgt.x-z/2)),ty=Math.min(1-z,Math.max(0,tgt.y+0.12*z-z/2));
    crop.x+=(tx-crop.x)*0.35;crop.y+=(ty-crop.y)*0.35;crop.w+=(z-crop.w)*0.35;crop.h=crop.w;cx0=crop.x;cy0=crop.y;cw=crop.w;ch=crop.h}
  else{crop={x:0,y:0,w:1,h:1}}
  let r;const t0=performance.now();try{ping.drawImage(video,cx0*vw,cy0*vh,cw*vw,ch*vh,0,0,256,ph);r=pose.detectForVideo(pin,now)}catch(e){return}
  const dur=performance.now()-t0;poseGap=poseGap*0.8+Math.min(220,Math.max(45,dur*2.2))*0.2;// 느린 기기는 쉬어 가며 인식
  const L=((r&&r.landmarks)||[]).map(lm=>lm.map(q=>({x:cx0+q.x*cw,y:cy0+q.y*ch,z:q.z,visibility:q.visibility})));
  // 사람마다 어깨 너비(크기)와 가운데
  let ps=L.map(lm=>{const ls=lm[11],rs=lm[12],lh=lm[23],rh=lm[24];const sw=Math.hypot(ls.x-rs.x,ls.y-rs.y);const tor=Math.hypot((ls.x+rs.x-lh.x-rh.x)/2,(ls.y+rs.y-lh.y-rh.y)/2);
    return{lm,s:Math.max(sw,tor*0.6,0.04),cx:(ls.x+rs.x)/2,cy:(ls.y+rs.y+lh.y+rh.y)/4}});
  ps.sort((a,b)=>b.s-a.s);if(ZOOM>1)ps=ps.filter(p=>inZoom(p.cx));
  if(players===2){ps=ps.slice(0,2).sort((a,b)=>b.cx-a.cx)}// 화면은 거울처럼 보이므로 x가 큰 쪽이 왼쪽 친구
  else{let pick=null;const d=(p,q)=>Math.hypot(p.cx-q.x,p.cy-q.y);
    // 몸통(어깨~엉덩이 가운데) 옷 색: 다른 아이와 헷갈리지 않게
    const col=p=>{if(p.col!==undefined)return p.col;let c=null;try{const bx=(p.cx-cx0)/cw*256,by=(p.cy-cy0)/ch*ph,hr=Math.max(2,Math.round(p.s*0.3/cw*256));
      const x0=Math.max(0,Math.round(bx-hr)),y0=Math.max(0,Math.round(by-hr)),w=Math.min(256-x0,hr*2),h2=Math.min(ph-y0,hr*2);
      if(w>1&&h2>1){const a=ping.getImageData(x0,y0,w,h2).data;let r=0,g2=0,b=0,n=0;for(let k=0;k<a.length;k+=4){r+=a[k];g2+=a[k+1];b+=a[k+2];n++}c=[r/n,g2/n,b/n]}}catch(e){}return p.col=c};
    const cd=(a,b)=>(!a||!b)?0:Math.hypot(a[0]-b[0],a[1]-b[1],a[2]-b[2])/255;
    if(tgtTap){let best=1e9;for(const p of ps){const v=d(p,tgtTap);if(v<best){best=v;pick=p}}
      if(pick&&best<0.3){tgt={x:pick.cx,y:pick.cy,s:pick.s,man:true,col:col(pick)};tgtTap=null;lostT=0;PH[0].length=0}else{pick=null;if(now-tgtTap.t>2500)tgtTap=null}}
    else if(!tgt){let best=-1;for(const p of ps){const v=p.s*(1-0.85*Math.min(1,Math.abs(p.cx-0.5)*2));if(v>best){best=v;pick=p}}
      if(pick){tgt={x:pick.cx,y:pick.cy,s:pick.s,man:false,col:col(pick)};lostT=0}}
    else{// 가까이 있고, 크기가 비슷하고, 옷 색이 같은 아이만 이어 잡음. 비슷한 아이가 둘이면 바꾸지 않고 기다림
      const gate=Math.max(0.08,tgt.s*(1.2+Math.min(1.3,lostT)));const cmax=lostT>0.5?0.2:0.28;const cs=[];
      for(const p of ps){const dd=d(p,tgt),ra=p.s/tgt.s,c=cd(col(p),tgt.col);
        if(dd>gate||ra<0.6||ra>1.7||(tgt.col&&c>cmax))continue;cs.push({p,v:dd/Math.max(0.05,tgt.s)+c*6})}
      cs.sort((a,b)=>a.v-b.v);const amb=cs.length>1&&cs[1].v<cs[0].v*1.3;
      if(cs.length&&!amb){pick=cs[0].p;tgt.x+=(pick.cx-tgt.x)*0.6;tgt.y+=(pick.cy-tgt.y)*0.6;tgt.s+=(pick.s-tgt.s)*0.3;
        const pc=col(pick);if(pc)tgt.col=tgt.col?tgt.col.map((v,k)=>v*0.95+pc[k]*0.05):pc;lostT=0}
      else{pick=null;lostT+=gapT;if(!tgt.man&&lostT>4)tgtReset()}}
    ps=pick?[pick]:[]}
  people=ps;if(!ps.length)noBodyT+=gapT;else noBodyT=0;
  for(let i=0;i<2;i++){const p=ps[i];const h=PH[i];
    if(p){const fr={t:now/1000,s:p.s};const prevF=h[h.length-1];
      for(const k in JI){const q=p.lm[JI[k]];const v=(q.visibility==null?1:q.visibility);let x=q.x,y=q.y;
        if(prevF&&prevF[k]&&now/1000-prevF.t<0.3){x=prevF[k].x*0.45+x*0.55;y=prevF[k].y*0.45+y*0.55}
        fr[k]={x,y,v}}
      h.push(fr)}
    while(h.length&&now/1000-h[0].t>1.8)h.shift()}}
function corr(a,b){const n=Math.min(a.length,b.length);if(n<4)return 0;let ma=0,mb=0;for(let i=0;i<n;i++){ma+=a[i];mb+=b[i]}ma/=n;mb/=n;let sab=0,sa=0,sb=0;for(let i=0;i<n;i++){const x=a[i]-ma,y=b[i]-mb;sab+=x*y;sa+=x*x;sb+=y*y}return sa*sb>1e-9?sab/Math.sqrt(sa*sb):0}
function poseFeat(i){const h=PH[i];if(h.length<8)return null;const t1=h[h.length-1].t;if(performance.now()/1000-t1>0.6)return null;
  const s=h.map(f=>f.s).sort((a,b)=>a-b)[h.length>>1];
  const ok=(f,k)=>f[k]&&f[k].v>0.45;
  function ser(k,ax){const out=[];for(const f of h)if(ok(f,k))out.push(f[k][ax]/s);return out}
  function vel(k){const vx=[],vy=[],sp=[];for(let j=2;j<h.length;j+=2){const a=h[j-2],b=h[j];if(!ok(a,k)||!ok(b,k))continue;const dt=Math.max(0.03,b.t-a.t);const x=(b[k].x-a[k].x)/s/dt,y=(b[k].y-a[k].y)/s/dt;vx.push(x);vy.push(y);sp.push(Math.hypot(x,y))}return{vx,vy,sp}}
  const amp=(k,ax)=>{const v=ser(k,ax);return v.length>3?Math.max(...v)-Math.min(...v):0};
  const mean=a=>a.length?a.reduce((x,y)=>x+y,0)/a.length:0;
  const W={};for(const k of['lw','rw','le','re','lk','rk','la','ra'])W[k]=vel(k);
  const floor=0.35;const e=k=>Math.max(0,mean(W[k].sp)-floor);
  const armE=(e('lw')+e('rw'))/2*0.8+(e('le')+e('re'))/2*0.2;
  const legS=Math.max(e('lk')+e('la'),e('rk')+e('ra'))/2,legSeen=W.lk.sp.length+W.rk.sp.length+W.la.sp.length+W.ra.sp.length>6;
  const ayL=amp('lw','y'),ayR=amp('rw','y'),axL=amp('lw','x'),axR=amp('rw','x');
  const cY=corr(W.lw.vy,W.rw.vy),cK=corr(W.lk.vy,W.rk.vy);
  // 손이 머리 위로 번갈아
  let alt=0,st=0;for(const f of h){if(!ok(f,'lw')||!ok(f,'rw')||!ok(f,'nose'))continue;const n=f.nose.y,l=f.lw.y<n,r=f.rw.y<n;const sg=l&&!r?1:r&&!l?-1:0;if(sg&&sg!==st){if(st)alt++;st=sg}}
  const kneeAmp=Math.max(amp('lk','y'),amp('rk','y'));
  // 몸통 위아래(어깨·엉덩이 가운데), 발목 움직임
  const mid=(f,a,b)=>ok(f,a)&&ok(f,b)?(f[a].y+f[b].y)/2/s:null;
  const shY=h.map(f=>mid(f,'ls','rs')).filter(v=>v!=null),hipY=h.map(f=>mid(f,'lh','rh')).filter(v=>v!=null),ankY=h.map(f=>mid(f,'la','ra')).filter(v=>v!=null);
  const rng=a=>a.length>3?Math.max(...a)-Math.min(...a):0;
  const shAmp=rng(shY),hipAmp=rng(hipY),ankAmp=rng(ankY),ankSeen=ankY.length>h.length*0.5;
  let bob=0,bs=0;{const m0=shY.length?shY.reduce((x,y)=>x+y,0)/shY.length:0;for(const v of shY){const d=v-m0;const sg=d>0.06?1:d<-0.06?-1:0;if(sg&&sg!==bs){if(bs)bob++;bs=sg}}}
  let tv=[];for(let j=2;j<shY.length;j+=2)tv.push(Math.abs(shY[j]-shY[j-2])/Math.max(0.03,(h[h.length-1].t-h[0].t)/h.length*2));const torsoE=Math.max(0,(tv.length?tv.reduce((x,y)=>x+y,0)/tv.length:0)-0.25);
  let kAlt=0,ks=0;for(const f of h){if(!ok(f,'lk')||!ok(f,'rk'))continue;const d=(f.lk.y-f.rk.y)/s;const sg=d>0.08?1:d<-0.08?-1:0;if(sg&&sg!==ks){if(ks)kAlt++;ks=sg}}
  let upN=0,upT=0;for(const f of h){if(!ok(f,'lw')||!ok(f,'rw')||!ok(f,'nose'))continue;upT++;if(f.lw.y<f.nose.y||f.rw.y<f.nose.y)upN++}
  const spr=h.map(f=>ok(f,'la')&&ok(f,'ra')?Math.abs(f.la.x-f.ra.x)/s:null).filter(v=>v!=null);
  const upFrac=upT?upN/upT:0,sprAmp=rng(spr);
  // 옆모습인지(어깨 너비가 몸통보다 많이 좁음), 어깨가 앞뒤로 움직이는 정도
  const sideR=h.map(f=>ok(f,'ls')&&ok(f,'rs')&&ok(f,'lh')&&ok(f,'rh')?Math.abs(f.ls.x-f.rs.x)/Math.max(0.01,Math.abs((f.ls.y+f.rs.y-f.lh.y-f.rh.y)/2)):null).filter(v=>v!=null).sort((a,b)=>a-b);
  const turnR=sideR.length>3?sideR[sideR.length>>1]:1,side=turnR<0.45,turn=Math.max(0,Math.min(1,(0.8-turnR)/0.35)),shX=rng(h.map(f=>ok(f,'ls')&&ok(f,'rs')?(f.ls.x+f.rs.x)/2/s:null).filter(v=>v!=null));
  return{side,turn,shX,upFrac,sprAmp,armE,legE:legSeen?legS:0,legSeen,ayL,ayR,axL,axR,cY,cK,alt,kneeAmp,kAlt,ay:(ayL+ayR)/2,ax:(axL+axR)/2,shAmp,hipAmp,ankAmp,ankSeen,bob,torsoE}}
function poseMatch(id,F){const thr={low:2.6,mid:1.6,high:0.9}[S.sens]||1.6;
  const E=Math.max(F.armE,F.legE*1.1,(F.torsoE||0)*1.6);const act=cl(E/thr);if(act<0.04)return{act,m:0};
  let m=0;const big=cl(Math.max(F.ay,F.ax)/0.9);
  if(id==='fly')m=cl((F.cY-0.2)/0.6)*cl(F.ay/0.9)*cl(F.ay/(F.ax+0.15));
  else if(id==='swim')m=big*Math.max(cl((-F.cY)/0.6),0.75*cl(F.ax/(F.ay+0.2)-0.3),0.4);
  else if(id==='kick'){/* 다리가 보이면 다리로만 */if(F.legSeen)m=cl(F.legE/1.2)*cl(Math.max(F.kneeAmp,0)/0.35);else m=0.7*big*cl(F.armE/1.5)}
  else if(id==='hike'){if(F.legSeen)m=Math.max(cl((-F.cK)/0.5),cl(F.kAlt/2))*cl(F.kneeAmp/0.3);else m=0.8*cl((-F.cY)/0.5)*cl(F.ay/0.5)}
  else if(id==='run'||id==='bike'){if(F.legSeen){const alt=Math.max(cl((-F.cK)/0.5),cl(F.kAlt/2))*cl(F.kneeAmp/0.25);
      // 자전거는 몸통이 덜 흔들릴수록, 달리기는 팔도 흔들수록 더 비슷
      m=id==='bike'?alt*(1-0.4*cl(F.shAmp/0.5)):alt*(0.75+0.25*cl(F.armE/1.2))}
    else m=0.7*cl((-F.cY)/0.5)*cl(F.ay/0.5)}
  else if(id==='jump'||id==='squat'){const up=cl(F.shAmp/0.45)*cl(F.bob/2);
    if(F.ankSeen){const feet=cl(F.ankAmp/0.25);m=up*(id==='jump'?(0.25+0.75*feet):(1-0.75*feet))*(id==='squat'?cl(F.hipAmp/0.4):1)}
    else m=up}
  else if(id==='climb')m=cl(F.alt/2)*cl(F.ay/0.8);
  else if(id==='jack'){const arms=cl((F.cY-0.1)/0.6)*cl(F.ay/0.9)*cl(F.upFrac/0.25);
    m=F.ankSeen?arms*(0.35+0.65*cl(F.sprAmp/0.45)):arms}
  else if(id==='row'){/* 두 팔을 함께 저어도(+) 번갈아 저어도(-) 인정 */const both=Math.max(cl(Math.abs(F.cY)/0.5),0.5);
    const low=1-0.7*cl((F.upFrac-0.15)/0.4),still=F.legSeen?1-0.5*cl(F.legE/1.2):1;
    m=cl(F.armE/1.0)*both*low*still;
    /* 옆으로 앉으면 손이 앞뒤(가로)로 크게 오가고 몸이 앞뒤로 기울어 더 잘 보임 */
    /* 대각선(비스듬히)도: 몸을 돌린 만큼 가로 움직임을 더 쳐 줌 */
    if(F.turn>0)m=Math.max(m,F.turn*cl(F.ax/(0.45+0.25*F.turn))*(0.6+0.4*cl(F.shX/0.25))*low*still)}
  return{act,m:cl(m)}}
// 카메라 작은 화면 위 관절 표시
const sk=document.createElement('canvas');sk.id='camSk';sk.style.cssText='position:fixed;pointer-events:none;z-index:24;display:none';document.body.appendChild(sk);const skg=sk.getContext('2d');
const BONES=[[11,12],[11,13],[13,15],[12,14],[14,16],[11,23],[12,24],[23,24],[23,25],[25,27],[24,26],[26,28]];
const glowDot=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');const gr=x.createRadialGradient(32,32,0,32,32,32);
  gr.addColorStop(0,'rgba(255,255,255,1)');gr.addColorStop(0.25,'rgba(255,240,150,.95)');gr.addColorStop(0.6,'rgba(255,150,200,.45)');gr.addColorStop(1,'rgba(255,150,200,0)');x.fillStyle=gr;x.fillRect(0,0,64,64);return c})();
let skP=[],skT=0;
function drawGlow(w,hh){const now=performance.now()/1000,dt=skT?Math.min(0.1,now-skT):0.016;skT=now;const cw=w/FC,chh=hh/FR;
  skg.save();skg.globalCompositeOperation='lighter';
  for(let k=0;k<fmS.length;k++){const v=fmS[k];if(v<0.15)continue;const x=(k%FC+0.5)*cw,y=(((k/FC)|0)+0.5)*chh,rr=Math.max(cw,chh)*(0.9+1.6*v);skg.globalAlpha=Math.min(0.85,v*0.9);skg.drawImage(glowDot,x-rr,y-rr,rr*2,rr*2);
    if(fm[k]>0.4&&skP.length<160&&Math.random()<fm[k]*0.25){const a=Math.random()*6.283,sp=40+Math.random()*90;skP.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-30,l:0.5+Math.random()*0.4,c:['#fff3a6','#ffb3d9','#a6e3ff','#ffffff'][(Math.random()*4)|0]})}}
  skg.globalAlpha=1;
  skP=skP.filter(p=>(p.l-=dt)>0);for(const p of skP){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=120*dt;const r=3+p.l*5;skg.fillStyle=p.c;skg.globalAlpha=Math.min(1,p.l*2);
    skg.beginPath();skg.moveTo(p.x,p.y-r);skg.lineTo(p.x+r*0.3,p.y-r*0.3);skg.lineTo(p.x+r,p.y);skg.lineTo(p.x+r*0.3,p.y+r*0.3);skg.lineTo(p.x,p.y+r);skg.lineTo(p.x-r*0.3,p.y+r*0.3);skg.lineTo(p.x-r,p.y);skg.lineTo(p.x-r*0.3,p.y-r*0.3);skg.fill()}
  skg.restore()}
function drawSk(){if(!camOK||video.style.display==='none'||cur!=='move'){sk.style.display='none';return}
  const r=video.getBoundingClientRect();if(!r.width){sk.style.display='none';return}
  if(!poseUse()){sk.style.display='block';sk.style.left=(r.left+5)+'px';sk.style.top=(r.top+5)+'px';const w=r.width-10,hh=r.height-10;if(sk.width!==Math.round(w)||sk.height!==Math.round(hh)){sk.width=Math.round(w);sk.height=Math.round(hh)}
    sk.style.width=w+'px';sk.style.height=hh+'px';skg.clearRect(0,0,sk.width,sk.height);drawGlow(sk.width,sk.height);return}
  sk.style.display='block';sk.style.left=(r.left+5)+'px';sk.style.top=(r.top+5)+'px';const w=r.width-10,hh=r.height-10;if(sk.width!==Math.round(w)){sk.width=Math.round(w);sk.height=Math.round(hh)}
  sk.style.width=w+'px';sk.style.height=hh+'px';skg.clearRect(0,0,sk.width,sk.height);skg.lineWidth=3;skg.lineCap='round';
  people.forEach((p,i)=>{skg.strokeStyle=players===2?(i?'#3f7fd6':'#e8505b'):'#ffd43b';skg.fillStyle=skg.strokeStyle;const X=q=>(1-q.x)*sk.width,Y=q=>q.y*sk.height;
    for(const [a,b] of BONES){const A_=p.lm[a],B_=p.lm[b];if((A_.visibility??1)<0.4||(B_.visibility??1)<0.4)continue;skg.beginPath();skg.moveTo(X(A_),Y(A_));skg.lineTo(X(B_),Y(B_));skg.stroke()}
    for(const k of[15,16,27,28]){const q=p.lm[k];if((q.visibility??1)<0.4)continue;skg.beginPath();skg.arc(X(q),Y(q),4,0,6.283);skg.fill()}
    if(players===1&&tgt&&tgt.man){const q=p.lm[0];skg.lineWidth=4;skg.strokeStyle='#ff5c8a';skg.beginPath();skg.arc(X(q),Y(q),Math.max(14,p.s*sk.width*0.9),0,6.283);skg.stroke()}});
  if(ZOOM>1){const z=zoomX(),a=(1-z[1])*sk.width,b=(1-z[0])*sk.width;skg.fillStyle='rgba(0,0,0,.5)';skg.fillRect(0,0,a,sk.height);skg.fillRect(b,0,sk.width-b,sk.height);
    skg.lineWidth=4;skg.strokeStyle='#4ade80';skg.setLineDash([10,6]);skg.strokeRect(a,2,b-a,sk.height-4);skg.setLineDash([]);
    skg.font='800 '+Math.max(12,Math.round(sk.width/34))+'px sans-serif';skg.fillStyle='#4ade80';skg.textAlign='center';skg.fillText('초록 칸 안만 봐요',(a+b)/2,sk.height-10);skg.textAlign='start'}
  if(players===1){const t=tgtTap?'고른 아이를 찾는 중…':tgt&&tgt.man?'고른 아이만 봐요 · 다른 아이를 누르면 바뀌어요':'아이를 누르면 그 아이만 봐요';
    skg.font='800 '+Math.max(12,Math.round(sk.width/34))+'px sans-serif';const tw=skg.measureText(t).width+16,th=Math.max(20,Math.round(sk.width/24));
    skg.fillStyle='rgba(0,0,0,.45)';skg.fillRect((sk.width-tw)/2,4,tw,th);skg.fillStyle='#fff';skg.textAlign='center';skg.textBaseline='middle';skg.fillText(t,sk.width/2,4+th/2);skg.textAlign='start';skg.textBaseline='alphabetic'}}
// 빠르게 움직이는 손발에서 불꽃
function poseSparks(){let any=false;people.forEach((p,i)=>{const h=PH[i];if(h.length<3)return;const a=h[h.length-3],b=h[h.length-1];const dt=Math.max(0.03,b.t-a.t);
  for(const k of['lw','rw','la','ra']){if(!a[k]||!b[k]||b[k].v<0.5)continue;const sp=Math.hypot(b[k].x-a[k].x,b[k].y-a[k].y)/b.s/dt;if(sp>1.6&&Math.random()<Math.min(0.6,sp/8)){burst((1-b[k].x)*innerWidth,b[k].y*innerHeight,7,3.5,3);any=true}}});
  if(any)sfx('spark',0.35,0.9+Math.random()*0.3,260)}
// 진행
let run=false,P=[],last=0,raf=0,ended=false;
function startGame(){ended=false;P=[];const n=players===2?2:1;
  for(let i=0;i<n;i++)P.push({ph:0,fi:0,p:0,hist:[],good:0,m:0,a:0,mile:0,bob:0,glow:0,col:n===2?(i?'#3f7fd6':'#e8505b'):null,nm:n===2?(i?'오른쪽 친구':'왼쪽 친구'):''});
  run=true;camKey='';placeCam(true);$('#mvPick').style.display='none';$('#mvNext').style.display='none';say(act.tip);sfx('whistle');last=0;cancelAnimationFrame(raf);raf=requestAnimationFrame(loop)}
function rate(){const D=[0,8,16,30][stage];return 1/D}
function weight(m){return S.diff==='easy'?0.6+0.4*m:S.diff==='mid'?0.25+0.75*m:(m<0.3?0.03:0.1+0.9*m)}
function update(dt){sense();
  const halves=P.length===2?[[0,3],[4,7]]:[[0,7]];
  P.forEach((pp,i)=>{const f=feat(...halves[i]);pp.hist.push(f);if(pp.hist.length>45)pp.hist.shift();let R=null;
    if(poseUse()){const F=poseFeat(i);if(F)R=poseMatch(act.id,F);else if(noBodyT<1.5)R={act:0,m:0}}
    if(!R)R=match(act.id,f,pp.hist);const {act:a,m}=R;
    pp.a=pp.a*0.8+a*0.2;pp.m=pp.m*0.85+m*0.15;
    if(!ended&&pp.p<1){pp.p=Math.min(1,pp.p+dt*rate()*pp.a*weight(pp.m));
      if(pp.m>0.55&&pp.a>0.3){pp.glow=1;sfx('daego',0.55,1,1600)}
      const mile=Math.floor(pp.p*4);if(mile>pp.mile&&pp.p<1){pp.mile=mile;const [x,y]=pos(i);burst(x,y,40,6,4);sfx('jeongo',0.6,1.15);pp.bob=1;say(['','좋아요','잘한다','거의 다 왔어요'][mile]||'')}
      if(pp.p>=1)finish(i)}
    pp.glow=Math.max(0,pp.glow-dt*1.5);pp.bob=Math.max(0,pp.bob-dt*1.5);
    if(!ended){pp.ph+=dt*pp.a*5.5;const nf=Math.floor(pp.ph)%2;if(nf!==pp.fi){pp.fi=nf}}});
  // 움직인 자리 작은 불꽃
  if(poseUse()&&people.length){poseSparks();return}
  let any=false;for(let r=0;r<GR;r++)for(let c=0;c<GC;c++){const e=grid[r*GC+c];if(e>0.22&&Math.random()<e*0.5){const x=(c+Math.random())/GC*innerWidth,y=(r+Math.random())/GR*innerHeight;burst(x,y,6,3.5,3);any=true}}
  if(any)sfx('spark',0.35,0.9+Math.random()*0.3,260)}
function finish(i){if(ended)return;ended=true;doneT=performance.now();if(act.goal.swing){sfx('ding');setTimeout(()=>sfx('ding'),350);setTimeout(()=>sfx('ding'),700)}if(act.goal.k2)sfx('spark');const txt=(P.length===2?`${P[i].nm} 도착!`:'도착! 최고예요!');celebrate('',`${stage}단계 `+txt);setTimeout(()=>{if(P.length===2)say('둘 다 정말 잘했어요')},2600);
  setTimeout(()=>{if(cur!=='move'||!ended)return;const nx=$('#mvNext');nx.style.display='flex';nx.querySelector('#mvNextBtn').textContent=stage<3?`${stage+1}단계 하기`:'한 번 더 하기'},3200)}
$('#mvNextBtn').onclick=()=>{$('#mvNext').style.display='none';if(stage<3)stage++;drawStage();startGame()};
$('#mvNextPick').onclick=()=>{$('#mvNext').style.display='none';showPick()};
// 배경 그림 기준 좌표(ic) → 화면 좌표 (배경을 꽉 채워 그리는 것과 같은 계산)
function BX(x){if(!act.ic)return x*W;const b=im(act.bg);if(!b.naturalWidth)return x*W;const s=Math.max(W/b.naturalWidth,H/b.naturalHeight);return (W-b.naturalWidth*s)/2+x*b.naturalWidth*s}
function BY(y){if(!act.ic)return y*H;const b=im(act.bg);if(!b.naturalWidth)return y*H;const s=Math.max(W/b.naturalWidth,H/b.naturalHeight);return (H-b.naturalHeight*s)/2+y*b.naturalHeight*s}
function along(p){const P_=act.path;if(P_.length===2){const [a,b]=P_;return[a[0]+(b[0]-a[0])*p,a[1]+(b[1]-a[1])*p]}
  const L=[];let T=0;for(let k=1;k<P_.length;k++){const d=Math.hypot(P_[k][0]-P_[k-1][0],P_[k][1]-P_[k-1][1]);L.push(d);T+=d}
  let r=p*T;for(let k=1;k<P_.length;k++){if(r<=L[k-1]||k===P_.length-1){const f=Math.min(1,r/L[k-1]);return[P_[k-1][0]+(P_[k][0]-P_[k-1][0])*f,P_[k-1][1]+(P_[k][1]-P_[k-1][1])*f]}r-=L[k-1]}}
function pos(i){const pp=P[i];let [x,y]=along(pp.p);
  if(P.length===2){if(act.id==='jack')x+=i?0.09:-0.09;else if(act.id==='fly'||act.id==='climb'||act.id==='jump')x+=i?0.13:-0.13;else if(act.id==='row')x+=i?0.04:-0.04;else y+=i?0.1:-0.1}
  return[BX(x),BY(y)]}
function drawBg(){const b=im(act.bg);if(b.complete&&b.naturalWidth){const s=Math.max(W/b.naturalWidth,H/b.naturalHeight);const w=b.naturalWidth*s,h=b.naturalHeight*s;g.drawImage(b,(W-w)/2,(H-h)/2,w,h)}else{g.fillStyle='#cfe9ff';g.fillRect(0,0,W,H)}}
let doneT=0;
function drawGoal(){const G=act.goal,t=performance.now()/1000;
  g.setLineDash([4,18]);g.lineCap='round';g.strokeStyle='rgba(255,255,255,.85)';g.lineWidth=8;g.beginPath();act.path.forEach((q,k)=>{k?g.lineTo(BX(q[0]),BY(q[1])):g.moveTo(BX(q[0]),BY(q[1]))});g.stroke();g.setLineDash([]);const GX=BX(G.x),GY=BY(G.y);
  if(G.k){const key=(ended&&G.k2)?G.k2:G.k;const sp=im(key);if(sp.complete&&sp.naturalWidth){const h=G.h*Math.min(H,W*1.1),w=h*sp.naturalWidth/sp.naturalHeight;
    let rot=0,sc=1+Math.sin(t*2.2)*0.03;if(G.swing&&ended)rot=Math.sin(t*14)*0.35*Math.max(0,1-(performance.now()-doneT)/4000);
    if(ended&&!G.swing)sc=1.08+Math.sin(t*6)*0.05;
    if(G.shine&&!ended)sc=1+Math.sin(t*3)*0.06;
    let dy=0;if(G.bury){const pr=ended?Math.min(1,(performance.now()-doneT)/900):0;dy=h*0.5*(1-pr)-(ended?Math.sin(pr*Math.PI)*h*0.25:0)}
    g.save();if(G.bury){g.beginPath();g.rect(0,0,W,GY+h*0.42+(ended?H:0));g.clip()}
    g.translate(GX,GY+dy);if(ended||G.shine){g.shadowColor='rgba(255,236,150,.95)';g.shadowBlur=ended?40:18}g.rotate(rot);g.scale(sc,sc);g.drawImage(sp,-w/2,-h/2,w,h);g.restore()
    if(G.bury&&!ended){g.fillStyle='#7a4a2a';g.beginPath();g.ellipse(GX,GY+h*0.42,w*0.55,h*0.06,0,0,6.283);g.fill()}}}
  if(G.rainbow){const cx=BX(G.x),cy=BY(G.y),R=Math.min(W*0.32,H*0.58),bw=R*0.075;const p=P.length?Math.max(...P.map(q=>q.p)):0;
    const C=['#ff6b6b','#ffa94d','#ffd43b','#69db7c','#4dabf7','#5c7cfa','#b197fc'];
    g.save();g.lineCap='butt';g.setLineDash([10,14]);g.lineWidth=4;g.strokeStyle='rgba(255,255,255,.8)';g.beginPath();g.arc(cx,cy,R,Math.PI,2*Math.PI);g.stroke();g.beginPath();g.arc(cx,cy,R-bw*7,Math.PI,2*Math.PI);g.stroke();g.setLineDash([]);
    if(ended){g.shadowColor='rgba(255,240,170,.95)';g.shadowBlur=30+Math.sin(t*6)*10}
    if(p>0.002)C.forEach((c,k)=>{g.strokeStyle=c;g.lineWidth=bw+1;g.beginPath();g.arc(cx,cy,R-bw*(k+0.5),Math.PI,Math.PI+Math.PI*Math.min(1,p));g.stroke()});
    g.restore()}
  if(G.ball&&ended){const p=Math.min(1,(performance.now()-doneT)/900);const [sx,sy]=pos(0);const x=sx+(GX-sx)*p,y=sy+(GY-sy)*p-Math.sin(p*Math.PI)*H*0.18;const r=H*0.035;
    g.fillStyle='#fff';g.strokeStyle='#333';g.lineWidth=3;g.beginPath();g.arc(x,y,r,0,6.283);g.fill();g.stroke();g.fillStyle='#333';for(let k=0;k<5;k++){const an=k*1.2566+p*8;g.beginPath();g.arc(x+Math.cos(an)*r*0.55,y+Math.sin(an)*r*0.55,r*0.22,0,6.283);g.fill()}}
}
function drawChar(i){const pp=P[i];let k=act.fr?act.fr[pp.fi]:act.img;const flip=k.endsWith('|f');k=k.replace('|f','');if(!A[k])k=act.img;const sp=im(k);if(!sp.complete||!sp.naturalWidth)return;const [x,y]=pos(i);const h=Math.min(H*0.34,W*0.3,320)*(P.length===2?0.85:1),w=h*sp.naturalWidth/sp.naturalHeight;
  const bob=(act.jumpy?(pp.fi?-26:4):(pp.fi?6:-6))*Math.min(1,pp.a*2)+pp.bob*-30;
  if(pp.glow>0){g.save();g.globalAlpha=pp.glow*0.55;const gr=g.createRadialGradient(x,y+bob,h*0.1,x,y+bob,h*0.75);gr.addColorStop(0,'#fff6a0');gr.addColorStop(1,'rgba(255,246,160,0)');g.fillStyle=gr;g.beginPath();g.arc(x,y+bob,h*0.75,0,6.283);g.fill();g.restore()}
  if(flip){g.save();g.translate(x,0);g.scale(-1,1);g.drawImage(sp,-w/2,y-h/2+bob,w,h);g.restore()}else g.drawImage(sp,x-w/2,y-h/2+bob,w,h);
  if(pp.col){g.fillStyle=pp.col;g.font='900 22px sans-serif';g.textAlign='center';const tw=g.measureText(pp.nm).width+20;g.beginPath();g.roundRect?g.roundRect(x-tw/2,y-h/2+bob-38,tw,32,14):g.rect(x-tw/2,y-h/2+bob-38,tw,32);g.fill();g.fillStyle='#fff';g.fillText(pp.nm,x,y-h/2+bob-14)}}
function drawGauge(){const n=P.length;const gw=Math.min(W*0.55,640),gh=34;const x0=(W-gw)/2;
  P.forEach((pp,i)=>{const y=14+i*(gh+12);g.fillStyle='rgba(255,255,255,.88)';g.beginPath();g.roundRect?g.roundRect(x0-8,y-6,gw+16,gh+12,22):g.rect(x0-8,y-6,gw+16,gh+12);g.fill();
    const gr=g.createLinearGradient(x0,0,x0+gw,0);gr.addColorStop(0,pp.col||'#ff8fa8');gr.addColorStop(1,pp.col||'#b197fc');g.fillStyle=gr;g.beginPath();g.roundRect?g.roundRect(x0,y,Math.max(gh,gw*pp.p),gh,17):g.rect(x0,y,gw*pp.p,gh);g.fill();
    for(let k=1;k<4;k++){g.fillStyle='rgba(255,255,255,.9)';g.fillRect(x0+gw*k/4-2,y+4,4,gh-8)}
    // 동작 비슷함 표시(빛나는 점)
    g.fillStyle=pp.m>0.55?'#ffd43b':'rgba(255,255,255,.6)';g.beginPath();g.arc(x0+gw+30,y+gh/2,14+pp.m*6,0,6.283);g.fill()})}
// 카메라 자리: 네 귀퉁이와 크기를 견주어 목표·길·진행 막대·단추를 가장 덜 가리는 곳
let camKey='',camT=0;
function camBoxes(){const B=[];const add=(x,y,w,h,k)=>B.push([x,y,w,h,k]);const G=act.goal;
  const gw=Math.min(W*0.55,640),gx0=(W-gw)/2;add(gx0-10,6,gw+70,14+P.length*46,3);
  add(0,0,230,74,3);add(W-210,0,210,74,3);add(0,H-56,180,56,3);
  if(G.k){const sp=im(G.k),h=G.h*Math.min(H,W*1.1),w=sp.naturalWidth?h*sp.naturalWidth/sp.naturalHeight:h;add(BX(G.x)-w/2,BY(G.y)-h/2,w,h,5)}
  if(G.ball){const r=H*0.08;add(BX(G.x)-r,BY(G.y)-r,r*2,r*2,5)}
  if(G.rainbow){const R=Math.min(W*0.32,H*0.58),x=BX(G.x),y=BY(G.y),b=R*0.55;add(x-R,y-R,R*2,b,3);add(x-R,y-R+b,b,R-b,3);add(x+R-b,y-R+b,b,R-b,3)}
  const ch=Math.min(H*0.34,W*0.3,320)*(P.length===2?0.85:1);
  for(let i=0;i<Math.max(1,P.length);i++)for(let k=0;k<=10;k++){const sv=P[i]?P[i].p:0;if(P[i])P[i].p=k/10;const [x,y]=P[i]?pos(i):[BX(along(k/10)[0]),BY(along(k/10)[1])];if(P[i])P[i].p=sv;add(x-ch*0.45,y-ch*0.5,ch*0.9,ch,k>=8?2:1)}
  return B}
function placeCam(force){const now=performance.now();if(!force&&now-camT<1000)return;camT=now;if(!W||!H)return;
  const vw=video.videoWidth||640,vh=video.videoHeight||480,base=Math.min(innerWidth*0.46,560),B=camBoxes();let best=null;
  for(const z of[1,0.82,0.66])for(const c of['br','bl','tr','tl']){const w=base*z,h=w*vh/vw+10,x=c[1]==='r'?W-12-w:12,y=c[0]==='b'?H-12-h:78;
    let sc=(1-z)*0.9;for(const [bx,by,bw,bh,k] of B){const ox=Math.max(0,Math.min(x+w,bx+bw)-Math.max(x,bx)),oy=Math.max(0,Math.min(y+h,by+bh)-Math.max(y,by));if(ox*oy>0)sc+=k*ox*oy/Math.max(1,Math.min(w*h,bw*bh))}
    if(!best||sc<best.sc-1e-6)best={sc,x,y,w}}
  const key=[best.x,best.y,best.w].map(Math.round).join(',');if(key===camKey)return;camKey=key;
  video.style.width=Math.round(best.w)+'px';video.style.left=Math.round(best.x)+'px';video.style.top=Math.round(best.y)+'px';video.style.right='auto';video.style.bottom='auto'}
addEventListener('resize',()=>{if(cur==='move'&&run)setTimeout(()=>placeCam(true),60)});
function loop(ts){if(cur!=='move'||!run)return;raf=requestAnimationFrame(loop);const dt=last?Math.min(0.1,(ts-last)/1000):0;last=ts;update(dt);placeCam();drawSk();
  g.clearRect(0,0,W,H);drawBg();drawGoal();P.forEach((_,i)=>drawChar(i));drawGauge()}
let pv=0;
function fitPick(){const p=$('#mvPick'),n=$('#mvPin');if(!p||!n||p.style.display==='none')return;n.style.zoom=1;const cs=getComputedStyle(p);const room=p.clientHeight-parseFloat(cs.paddingTop)-parseFloat(cs.paddingBottom);const need=n.scrollHeight;if(need>room)n.style.zoom=Math.max(0.45,room/need*0.98)}
addEventListener('resize',()=>setTimeout(fitPick,50));
async function showPick(){run=false;ended=false;$('#mvPick').style.display='flex';requestAnimationFrame(fitPick);setTimeout(fitPick,300);drawPreview();camStatus();cancelAnimationFrame(pv);(function meter(){if(cur!=='move'||run)return;pv=requestAnimationFrame(meter);sense();drawSk();let s=0;for(const v of grid)s+=v;const lv=Math.min(1,s/grid.length/0.06);const b=$('#camBar');if(b)b.style.width=(lv*100)+'%'})()}
function drawPreview(){g.clearRect(0,0,W,H);drawBg()}
$('#mvGo').onclick=async()=>{ac();if(!camOK)await camOn();startGame()};
$('#camOn').onclick=async()=>{ac();camOff();await camOn()};
$('#mvBack').onclick=()=>showPick();
keyHandlers.move=()=>{if($('#mvPick').style.display!=='none')$('#mvGo').click()};
onEnter.move=()=>{fit();camErr='';showPick();camOn()};
onLeave.move=()=>{run=false;camOff();sk.style.display='none'};
addEventListener('resize',()=>{if(cur==='move')fit()});
video.addEventListener('pointerdown',e=>{if(players!==1||!camOK)return;const r=video.getBoundingClientRect();if(!r.width)return;
  tgtTap={x:1-(e.clientX-r.left)/r.width,y:(e.clientY-r.top)/r.height,t:performance.now()};if(!inZoom(tgtTap.x)){tgtTap=null;return}tgt=null;lostT=0;crop={x:0,y:0,w:1,h:1};PH[0].length=0;sfx('beep')});
window.__mvTest={grid,ptr,P:()=>P,match,feat,pose:()=>({poseState,n:people.length,ph:PH[0].length}),poseFeat,poseMatch,PH};
})();

</script>
<script>
// ================= 체육수업툴 =================
(function(){
$$('.tab').forEach(t=>t.onclick=()=>{$$('.tab').forEach(x=>x.classList.toggle('on',x===t));$$('.pane').forEach(p=>p.classList.toggle('on',p.id===t.dataset.tab));if(t.dataset.tab!=='pWarm')wuStop()});
$$('[data-sfx]').forEach(b=>b.onclick=()=>{ac();sfx(b.dataset.sfx);if(b.dataset.sfx==='firework')bigFireworks(3)});
// ---- 타이머 ----
let total=60,left=60,runT=false,endAt=0,tick=0,lastBeep=-1;
const tEl=$('#tTime');
function fmt(s){s=Math.max(0,Math.ceil(s));return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')}
function show(){tEl.textContent=fmt(left);const r=left/Math.max(1,total);tEl.style.color=r>0.5?'#2f78c4':r>0.2?'#e09a00':'#e8505b'}
const pr=$('#tPresets');
function setPreset(s,b){stopT();total=left=s;lastBeep=-1;show();[...pr.children].forEach(x=>x.classList.toggle('sel',x===b));tEl.classList.remove('bounce');void tEl.offsetWidth;tEl.classList.add('bounce');try{sfx('beep',0.5)}catch(e){}}
[[30,'30초'],[60,'1분'],[120,'2분'],[180,'3분'],[300,'5분']].forEach(([s,t])=>{const b=document.createElement('button');b.type='button';b.className='btn'+(s===60?' sel':'');b.textContent=t;
  let lastT=-1e9;const fire=e=>{const n=performance.now();if(n-lastT<400)return;lastT=n;e.preventDefault();ac();setPreset(s,b)};b.addEventListener('pointerup',fire);b.addEventListener('click',fire);pr.appendChild(b)});
function stopT(){runT=false;clearInterval(tick);$('#tStart').textContent='시작';$('#tStart').className='btn g'}
$('#tStart').onclick=()=>{ac();if(runT){stopT();left=Math.max(0,(endAt-performance.now())/1000);show();return}
  if(left<=0)left=total;runT=true;endAt=performance.now()+left*1000;sfx('whistle');$('#tStart').textContent='멈춤';$('#tStart').className='btn r';
  tick=setInterval(()=>{left=(endAt-performance.now())/1000;const s=Math.ceil(left);if(s<=3&&s>0&&s!==lastBeep){lastBeep=s;sfx('beep')}
    if(left<=0){left=0;stopT();show();sfx('whistle3');bigFireworks(3);return}show()},100)};
$('#tReset').onclick=()=>{stopT();left=total;show()};
$('#tPlus').onclick=()=>{[...pr.children].forEach(x=>x.classList.remove('sel'));if(runT)endAt+=10000;else{left+=10;total=Math.max(total,left)}show()};
$('#tMinus').onclick=()=>{[...pr.children].forEach(x=>x.classList.remove('sel'));if(runT)endAt-=10000;else left=Math.max(10,left-10);show()};
show();
// ---- 팀 나누기·순서 뽑기 ----
const TOK=[['c_wol','월이'],['c_ari','아리'],['c_hami','대롱이'],['ani01','고양이'],['ani02','강아지'],['ani03','판다'],['ani04','하마'],['ani05','상어'],['ani06','돌고래']];
const TC=[['#e8505b','빨강'],['#3f7fd6','파랑'],['#3fae6a','초록'],['#f0a500','노랑']];
let sel=LS.get('tok',TOK.map((_,i)=>i<6)), nT=2;
const tw=$('#tokWrap');TOK.forEach(([k,n],i)=>{const b=document.createElement('button');b.className='tok'+(sel[i]?' on':'');b.innerHTML=`<img src="${src(k)}">${n}`;b.onclick=()=>{sel[i]=!sel[i];b.classList.toggle('on',sel[i]);LS.set('tok',sel)};tw.appendChild(b)});
const tn=$('#teamN');tn.innerHTML='<b style="min-width:auto">팀 수</b>';[2,3,4].forEach(v=>{const b=document.createElement('button');b.textContent=v+'팀';if(v===2)b.classList.add('on');b.onclick=()=>{nT=v;[...tn.querySelectorAll('button')].forEach(x=>x.classList.remove('on'));b.classList.add('on')};tn.appendChild(b)});
function picked(){return TOK.filter((_,i)=>sel[i])}
function shuf(a){a=[...a];for(let i=a.length-1;i>0;i--){const j=(Math.random()*(i+1))|0;[a[i],a[j]]=[a[j],a[i]]}return a}
const out=$('#teamOut');
$('#doTeams').onclick=()=>{ac();const p=shuf(picked());if(p.length<nT){out.innerHTML='<p style="text-align:center;font-size:24px">친구를 더 골라 주세요</p>';return}
  out.innerHTML='<div class="teams">'+Array.from({length:nT},(_,t)=>`<div class="team" style="background:${TC[t][0]}"><div class="tt">${TC[t][1]} 팀</div><div id="tm${t}"></div></div>`).join('')+'</div>';
  p.forEach((tk,i)=>setTimeout(()=>{const d=$('#tm'+(i%nT));const im=document.createElement('img');im.src=src(tk[0]);im.style.animation='pop .4s';d.appendChild(im);sfx('spark',0.6)},i*350));
  setTimeout(()=>{sfx('clap',0.6)},p.length*350+200)};
$('#doOrder').onclick=()=>{ac();const p=shuf(picked());out.innerHTML='<div class="order" id="ord"></div>';
  p.forEach((tk,i)=>setTimeout(()=>{const o=document.createElement('div');o.className='o';o.innerHTML=`<img src="${src(tk[0])}">${i+1}`;$('#ord').appendChild(o);sfx('ding',0.5,1+i*0.05)},i*600))};
$('#doOne').onclick=()=>{ac();const p=picked();if(!p.length)return;out.innerHTML='<div style="text-align:center"><img id="oneImg" style="height:min(38vh,320px)"><div id="oneNm" style="font-size:44px;font-weight:900"></div></div>';
  let k=(Math.random()*p.length)|0,d=60,steps=18+((Math.random()*p.length)|0);(function spin(){k=(k+1)%p.length;$('#oneImg').src=src(p[k][0]);$('#oneNm').textContent=p[k][1];sfx('beep',0.4);
   if(--steps>0){d*=1.13;setTimeout(spin,d)}else{sfx('ding');burst(innerWidth/2,innerHeight*0.5,60,7,4);$('#oneImg').classList.add('bounce');say(p[k][1])}})()};
// ---- 점수판 ----
let nS=2,scores=[0,0,0,0];const names=TC.map(t=>t[1]+' 팀');
const sbn=$('#sbN');sbn.innerHTML='<b style="min-width:auto">팀 수</b>';[2,3,4].forEach(v=>{const b=document.createElement('button');b.textContent=v+'팀';if(v===2)b.classList.add('on');b.onclick=()=>{nS=v;[...sbn.querySelectorAll('button')].forEach(x=>x.classList.remove('on'));b.classList.add('on');drawSB()};sbn.appendChild(b)});
function drawSB(){const w=$('#sbWrap');w.innerHTML='';for(let i=0;i<nS;i++){const d=document.createElement('div');d.className='st';d.style.background=TC[i][0];
  d.innerHTML=`<input value="${names[i]}"><div class="sc">${scores[i]}</div><div class="pm"><button>−</button><button>+</button></div>`;
  const inp=d.querySelector('input');inp.oninput=()=>names[i]=inp.value;const sc=d.querySelector('.sc');const [m,p]=d.querySelectorAll('.pm button');
  const upd=(v)=>{scores[i]=Math.max(0,scores[i]+v);sc.textContent=scores[i];sc.classList.remove('bounce');void sc.offsetWidth;sc.classList.add('bounce')};
  sc.onclick=()=>{ac();upd(1);sfx('ding',0.6)};p.onclick=()=>{ac();upd(1);sfx('ding',0.6)};m.onclick=()=>{upd(-1);sfx('beep',0.4)};w.appendChild(d)}}
$('#sbReset').onclick=()=>{scores=[0,0,0,0];drawSB()};drawSB();
// ---- 준비운동 ----
const WU=[['고개 좌우로 돌리기',['hd01','hd02']],['고개 들기·내리기',['hd03','hd04']],['어깨 으쓱',['wv08','wv01']],['팔 앞으로 뻗기',['wv08','wv02']],['팔 위로 쭉',['wv08','wv03']],['손목 돌리기',['wv04','wv05']],['옆구리 늘이기',['wv06','wv06|f']],['무릎 들기',['wv08','wv07','wv08','wv07|f']],['박수 치기',['wv09','wv10']]];
const CNT=['하나','둘','셋','넷'];
let wi=0,wPlay=false,wT=0,wc=0;
const img=$('#wuImg'),nm=$('#wuName'),cnt=$('#wuCount'),dots=$('#wuDots');
dots.innerHTML=WU.map(()=>'<i></i>').join('');
function frame(f){const [k,fl]=f.split('|');img.src=src(k);img.style.transform=fl?'scaleX(-1)':''}
function showWu(){nm.textContent=(wi+1)+'. '+WU[wi][0];frame(WU[wi][1][0]);cnt.textContent='';[...dots.children].forEach((d,i)=>d.classList.toggle('on',i<=wi))}
function ms(){return {slow:1400,mid:1000,fast:750}[S.wuSpeed]||1000}
function wuStop(){wPlay=false;clearTimeout(wT);$('#wuPlay').textContent='시작';$('#wuPlay').className='btn g';try{speechSynthesis.cancel()}catch(e){}}
function step(){if(!wPlay)return;
  if(wc===0){say(WU[wi][0]);cnt.textContent='';wc=1;wT=setTimeout(step,1800);return}
  if(wc<=8){const fr=WU[wi][1];frame(fr[(wc-1)%fr.length]);const word=CNT[(wc-1)%4];cnt.textContent=word;if(S.voice)say(word,1.15);else sfx('beep',0.6);
    img.style.transition='transform .15s';const fl=img.style.transform.includes('-1')?'scaleX(-1) ':'';img.style.transform=fl+'scale(1.06)';setTimeout(()=>img.style.transform=fl,160);
    wc++;wT=setTimeout(step,ms());return}
  wc=0;if(wi<WU.length-1){wi++;showWu();sfx('ding',0.6);wT=setTimeout(step,700)}else{wuStop();cnt.textContent='끝!';celebrate('wv10','준비운동 끝!')}}
$('#wuPlay').onclick=()=>{ac();if(wPlay){wuStop();return}wPlay=true;wc=0;$('#wuPlay').textContent='멈춤';$('#wuPlay').className='btn r';step()};
$('#wuPrev').onclick=()=>{const p=wPlay;wuStop();wi=Math.max(0,wi-1);showWu();if(p)$('#wuPlay').click()};
$('#wuNext').onclick=()=>{const p=wPlay;wuStop();wi=Math.min(WU.length-1,wi+1);showWu();if(p)$('#wuPlay').click()};
showWu();
onLeave.helper=()=>{wuStop()};
keyHandlers.helper=()=>{const t=$('.tab.on').dataset.tab;if(t==='pTimer')$('#tStart').click();else if(t==='pWarm')$('#wuPlay').click()};
})();

</script>
<script type="text/plain" id="mp_b"></script>
<script type="text/plain" id="mp_l"></script>
<script type="text/plain" id="mp_w"></script>
<script type="text/plain" id="mp_m">