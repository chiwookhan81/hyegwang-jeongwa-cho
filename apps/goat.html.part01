      <button class="btn b" data-sfx="whistle"><img class="ico" data-a="i_whistle"> 호루라기</button>
      <button class="btn b" data-sfx="whistle3"><img class="ico" data-a="i_whistle"> 끝 신호</button>
      <button class="btn c" data-sfx="clap">박수</button>
      <button class="btn r" data-sfx="daego">대고</button>
      <button class="btn r" data-sfx="jeongo">전고</button>
      <button class="btn" data-sfx="firework"><img class="ico" data-a="i_fire"> 폭죽</button>
    </div>
  </div>
  <div class="pane" id="pTeam">
    <div style="text-align:center" id="tokWrap"></div>
