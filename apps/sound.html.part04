", "g_yeomin": "data:audio/mpeg;base64,", "jg_kung": "data:audio/mpeg;base64,", "g_jd_jin": "data:audio/mpeg;base64,", "g_geomungo": "data:audio/mpeg;base64,", "g_doraji": "data:audio/mpeg;base64,", "g_hangang": "data:audio/mpeg;base64,", "g_yeombul": "data:audio/mpeg;base64,", "g_sangryeong": "data:audio/mpeg;base64,", "g_ganggang": "data:audio/mpeg;base64,", "g_daegeum": "data:audio/mpeg;base64,", "g_jing": "data:audio/mpeg;base64,", "jg_deok": "data:audio/mpeg;base64,", "g_sakkw": "data:audio/mpeg;base64,", "g_gaya25": "data:audio/mpeg;base64,", "g_miryang": "data:audio/mpeg;base64,", "g_samul": "data:audio/mpeg;base64,", "jg_deong": "data:audio/mpeg;base64,", "g_gangwon": "data:audio/mpeg;base64,", "g_danso": "data:audio/mpeg;base64,"};
// ===== 노래 탭은 v4부터 뺐어요 (빈 목록) =====
const SONG_GROUPS = [];
const SG_KW = { g_ost: [], g_world: [], g_band: [], g_boy: [], g_girl: [], g_fsolo: [] };
function songArtist(n) { for (const sp of ['H1-KEY', 'i-dle']) if (n.startsWith(sp)) return sp + n.slice(sp.length).split('-')[0]; const i = n.indexOf('-'); return i > 0 ? n.slice(0, i).trim() : ''; }
function songTitle(n) { const a = songArtist(n); return a ? n.slice(a.length).replace(/^\s*-\s*/, '').replace(/^\d+-/, '').trim() : n; }
function songGroup(n) { const a = songArtist(n) + '-'; for (const g of ['g_ost', 'g_world', 'g_band', 'g_boy', 'g_girl', 'g_fsolo']) if (SG_KW[g].some(k => a.includes(k) || n.startsWith(k))) return g; return a.length > 1 && /[가-힣]/.test(a) ? 'g_msolo' : 'g_etc'; }

</script>
<script>
// ================= 오디오 =================
let AC = null, MASTER = null, REV = null, ACTIVE = [], PLAYTOK = 0;
function ac() {
  if (!AC) {
    try { AC = new (window.AudioContext || window.webkitAudioContext)({ latencyHint: 'balanced' }); } catch (e) { AC = new (window.AudioContext || window.webkitAudioContext)(); }   // 폰에서 소리가 끊기지 않게 여유 두기 (2026-11-24)
    MASTER = AC.createGain(); MASTER.gain.value = volCap();
    const comp = AC.createDynamicsCompressor(); comp.threshold.value = -16; comp.knee.value = 6; comp.ratio.value = 6; comp.attack.value = .003; comp.release.value = .2;
    const mk = AC.createGain(); mk.gain.value = 1.3;   // 1.9에서 낮춤: 음원이 이미 커서 찢어지던 것 막기 (2026-11-24)
    const lim = AC.createDynamicsCompressor(); lim.threshold.value = -3; lim.knee.value = 3; lim.ratio.value = 12; lim.attack.value = .001; lim.release.value = .1;
    MASTER.connect(comp); comp.connect(mk); mk.connect(lim); lim.connect(AC.destination);
    // 작은 울림
    REV = AC.createConvolver(); const L = AC.sampleRate * 1.6, b = AC.createBuffer(2, L, AC.sampleRate);
    for (let c = 0; c < 2; c++) { const d = b.getChannelData(c); for (let i = 0; i < L; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / L, 3); }
    REV.buffer = b; const rg = AC.createGain(); rg.gain.value = .16; REV.connect(rg); rg.connect(comp);
  }
  if (AC.state === 'suspended') AC.resume();
  if (!REALHB_P && typeof REC !== 'undefined') setTimeout(loadRealHits, 0);
  return AC;
}
const NOTE = { C: 0, 'C#': 1, Db: 1, D: 2, 'D#': 3, Eb: 3, E: 4, F: 5, 'F#': 6, Gb: 6, G: 7, 'G#': 8, Ab: 8, A: 9, 'A#': 10, Bb: 10, B: 11 };
const midiOf = s => { const m = /^([A-G][#b]?)(-?\d)$/.exec(s); return NOTE[m[1]] + (+m[2] + 1) * 12; };
const BUF = {};
async function decode(url) { if (BUF[url]) return BUF[url]; const ab = await (await fetch(url)).arrayBuffer(); BUF[url] = await ac().decodeAudioData(ab); return BUF[url]; }
async function sampleFor(gm, m) {
  const set = SMP[gm]; let best = null, bd = 99;
  for (const k in set) { const d = Math.abs(midiOf(k) - m); if (d < bd) { bd = d; best = k; } }
  return { buf: await decode(set[best]), base: midiOf(best) };
}
function track(src, g) { ACTIVE.push({ src, g }); $('nowp').classList.add('show'); src.onended = () => { ACTIVE = ACTIVE.filter(x => x.src !== src); if (!ACTIVE.length) $('nowp').classList.remove('show'); }; }
function stopAll() { PLAYTOK++; if (HA) { const a = HA; HA = null; fadeOut(a); } const t = AC ? AC.currentTime : 0; ACTIVE.forEach(({ src, g }) => { try { g.gain.cancelScheduledValues(t); g.gain.setTargetAtTime(0, t, .03); src.stop(t + .15); } catch (e) {} }); ACTIVE = []; $('nowp').classList.remove('show'); document.querySelectorAll('.play.on').forEach(b => b.classList.remove('on')); }
// 버퍼 하나를 음높이·길이·떨림·끌기를 주어 소리 내기
function voice(buf, rate, t, o) {
  const a = ac(), src = a.createBufferSource(); src.buffer = buf; src.playbackRate.value = rate;
  const g = a.createGain(), vel = o.vel ?? .8, dur = o.dur ?? 1.5, rel = o.rel ?? .25;
  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vel, t + (o.att ?? .008));
  g.gain.setValueAtTime(vel, t + dur); g.gain.exponentialRampToValueAtTime(.0008, t + dur + rel);
  if (o.vib) { const l = a.createOscillator(), lg = a.createGain(); l.frequency.value = o.vib[0]; lg.gain.setValueAtTime(0, t); lg.gain.linearRampToValueAtTime(o.vib[1] * 100, t + (o.vibDelay ?? .15) + .25); l.connect(lg); lg.connect(src.detune); l.start(t); l.stop(t + dur + rel + .1); }
  if (o.bend) { const at = t + (o.bendAt ?? .3) * dur; if (o.bendFrom) { src.detune.setValueAtTime(-o.bend * 100, t); src.detune.linearRampToValueAtTime(0, t + .25); } else { src.detune.setValueAtTime(0, at); src.detune.linearRampToValueAtTime(o.bend * 100, at + Math.min(.45, dur * .35)); } }
  src.connect(g); g.connect(MASTER); g.connect(REV);
  src.start(t); src.stop(t + dur + rel + .05); track(src, g); return src;
}
// ---------- 합성 소리 (국악기·타악기) ----------
const SR = 32000;
function mk(len) { return new Float32Array(Math.floor(SR * len)); }
function toBuf(d) { const b = ac().createBuffer(1, d.length, SR); b.copyToChannel(d, 0); return b; }
function norm(d, pk = .85) { let m = 0; for (const v of d) m = Math.max(m, Math.abs(v)); if (m) for (let i = 0; i < d.length; i++) d[i] *= pk / m; return d; }
// 간단한 2차 필터
function biquad(d, type, f, q = .7, gainDb = 0) {
  const w = 2 * Math.PI * f / SR, s = Math.sin(w), c = Math.cos(w), al = s / (2 * q), A = Math.pow(10, gainDb / 40);
  let b0, b1, b2, a0, a1, a2;
  if (type === 'lp') { b0 = (1 - c) / 2; b1 = 1 - c; b2 = b0; a0 = 1 + al; a1 = -2 * c; a2 = 1 - al; }
  else if (type === 'hp') { b0 = (1 + c) / 2; b1 = -(1 + c); b2 = b0; a0 = 1 + al; a1 = -2 * c; a2 = 1 - al; }
  else if (type === 'bp') { b0 = al; b1 = 0; b2 = -al; a0 = 1 + al; a1 = -2 * c; a2 = 1 - al; }
  else { b0 = 1 + al * A; b1 = -2 * c; b2 = 1 - al * A; a0 = 1 + al / A; a1 = -2 * c; a2 = 1 - al / A; }
  const o = new Float32Array(d.length); let x1 = 0, x2 = 0, y1 = 0, y2 = 0;
  for (let i = 0; i < d.length; i++) { const x = d[i], y = (b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2) / a0; o[i] = y; x2 = x1; x1 = x; y2 = y1; y1 = y; }
  return o;
}
const mix = (...arr) => { const n = Math.max(...arr.map(([d]) => d.length)), o = new Float32Array(n); for (const [d, g] of arr) for (let i = 0; i < d.length; i++) o[i] += d[i] * g; return o; };
const hz = m => 440 * Math.pow(2, (m - 69) / 12);
function env(d, att, dec, sus = 1, rel = 0) { const n = d.length, A = att * SR, R = rel * SR; for (let i = 0; i < n; i++) { let e = i < A ? i / A : sus + (1 - sus) * Math.exp(-(i - A) / (dec * SR)); if (R && i > n - R) e *= (n - i) / R; d[i] *= e; } return d; }
function noise(len) { const d = mk(len); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; return d; }
function sweep(len, f0, f1, tau, dec) { const d = mk(len); let ph = 0; for (let i = 0; i < d.length; i++) { const t = i / SR, f = f1 + (f0 - f1) * Math.exp(-t / tau); ph += 2 * Math.PI * f / SR; d[i] = Math.sin(ph) * Math.exp(-t / dec); } return d; }
function partials(len, f, ratios, decs, amps) { const d = mk(len); ratios.forEach((r, k) => { const w = 2 * Math.PI * f * r / SR, de = decs[k] * SR, a = amps[k], p = Math.random() * 6; for (let i = 0; i < d.length; i++) d[i] += a * Math.sin(w * i + p) * Math.exp(-i / de); }); return d; }
// 줄 뜯는 소리 (카플러스-스트롱)
function ks(f, len, bright, decay, pickPos = .2) {
  const d = mk(len), N = Math.max(2, Math.round(SR / f)); let line = new Float32Array(N);
  for (let i = 0; i < N; i++) line[i] = Math.random() * 2 - 1;
  // 손가락으로 뜯은 부드러운 시작
  for (let k = 0; k < 3; k++) for (let i = 1; i < N; i++) line[i] = line[i] * bright + line[i - 1] * (1 - bright);
  const pp = Math.floor(N * pickPos); for (let i = N - 1; i >= pp; i--) line[i] -= line[i - pp] * .5;
  let idx = 0, prev = 0; const fb = Math.pow(.001, 1 / (decay * f));
  for (let i = 0; i < d.length; i++) { const cur = line[idx]; const nx = (cur * (.5 + bright * .25) + prev * (.5 - bright * .25)) * fb; prev = cur; line[idx] = nx; d[i] = cur; idx = (idx + 1) % N; }
  return d;
}
// 활로 켜는·부는 소리의 바탕 (톱니파 + 숨)
function saw(f, len, jit = .002) { const d = mk(len); let ph = 0; for (let i = 0; i < d.length; i++) { ph += f * (1 + (Math.random() - .5) * jit) / SR; ph -= Math.floor(ph); d[i] = 2 * ph - 1; } return d; }
function sqr(f, len, duty = .5) { const d = mk(len); let ph = 0; for (let i = 0; i < d.length; i++) { ph += f / SR; ph -= Math.floor(ph); d[i] = ph < duty ? 1 : -1; } return d; }
function sine(f, len, h = []) { const d = mk(len); for (let i = 0; i < d.length; i++) { const t = 2 * Math.PI * f * i / SR; let v = Math.sin(t); h.forEach((a, k) => v += a * Math.sin(t * (k + 2))); d[i] = v; } return d; }
const SYN = {
  gayageum(m, o) { const f = hz(m), L = Math.max(2.2, (o.dur || 1.6) + .8); let d = ks(f, L, .55, 1.6 + (80 - m) * .03, .18); d = mix([d, 1], [biquad(d, 'bp', 260, 1.2), .6], [biquad(d, 'bp', 700, 1.5), .35]); d = biquad(d, 'lp', 3600); return norm(d); },
  geomungo(m, o) { const f = hz(m), L = Math.max(2.4, (o.dur || 1.8) + .8); let d = ks(f, L, .35, 2.2, .12); const th = env(biquad(noise(.09), 'lp', 900), .001, .02); const clk = env(biquad(noise(.03), 'bp', 2400, 2), .0005, .006); d = mix([d, 1], [biquad(d, 'bp', 160, 1), .7], [th, .9 * (o.vel ?? .8)], [clk, .6 * (o.vel ?? .8)]); d = biquad(d, 'lp', 2400); return norm(d); },
  haegeum(m, o) { const f = hz(m), L = (o.dur || 2) + .4; let s = saw(f, L, .004); s = mix([biquad(s, 'bp', 950, 1.4), 1], [biquad(s, 'bp', 2500, 3), .9], [biquad(s, 'bp', 4200, 4), .3], [biquad(noise(L), 'bp', 3200, 1.5), .08]); s = biquad(s, 'hp', 300); env(s, .09, 9, 1, .15); return norm(s, .7); },
  ajaeng(m, o) { const f = hz(m), L = (o.dur || 2.2) + .4; let s = saw(f, L, .008); const n = biquad(noise(L), 'bp', 1800, 1); s = mix([biquad(s, 'bp', 650, 1.2), 1], [biquad(s, 'bp', 1700, 2), .7], [s, .25], [n, .22]); s = biquad(s, 'lp', 4500); env(s, .12, 9, 1, .2); return norm(s, .75); },
  daegeum(m, o) { const f = hz(m), L = (o.dur || 2.2) + .4; const t = sine(f, L, [.25, .08, .04]); const br = biquad(noise(L), 'bp', f * 2, 3); const buzz = biquad(biquad(saw(f, L), 'bp', 3800, 2.5), 'hp', 2500); const bz = (o.buzz ? .55 : .14) * (m > 74 ? 1.3 : .8); let d = mix([t, 1], [br, .35], [buzz, bz], [biquad(noise(L), 'hp', 4000), .03]); env(d, .13, 9, 1, .2); return norm(d, .7); },
  danso(m, o) { const f = hz(m), L = (o.dur || 2) + .4; let d = mix([sine(f, L, [.12, .05]), 1], [biquad(noise(L), 'bp', f * 1.5, 2), .45], [biquad(noise(L), 'hp', 5000), .05]); env(d, .08, 9, 1, .18); return norm(d, .65); },
  piri(m, o) { const f = hz(m), L = (o.dur || 2) + .4; let s = mix([saw(f, L, .003), .6], [sqr(f, L, .35), .5]); s = mix([biquad(s, 'bp', 1150, 1.6), 1], [biquad(s, 'bp', 2600, 3), .8], [biquad(s, 'bp', 400, 1.2), .4]); env(s, .05, 9, 1, .15); return norm(s, .8); },
  taepyeongso(m, o) { const f = hz(m), L = (o.dur || 2) + .4; let s = saw(f, L, .003); s = biquad(s, 'hp', 600); s = biquad(s, 'pk', 3000, 1.2, 12); s = biquad(s, 'pk', 1400, 2, 6); for (let i = 0; i < s.length; i++) s[i] = Math.tanh(s[i] * 2.5); env(s, .04, 9, 1, .15); return norm(s, .7); },
  saenghwang(m, o) { const f = hz(m), L = (o.dur || 2) + .4; let s = sqr(f, L, .42); s = biquad(biquad(s, 'lp', 2200), 'pk', 1200, 1.5, 5); s = mix([s, 1], [sine(f * 2.001, L), .2]); env(s, .1, 9, 1, .2); return norm(s, .6); },
};
const HIT = {
  kick: () => { const d = mix([sweep(.6, 160, 48, .04, .28), 1], [env(biquad(noise(.02), 'lp', 3000), .0005, .005), .4]); return norm(d); },
  snare: () => norm(mix([env(biquad(noise(.3), 'hp', 1600), .001, .09), 1], [sweep(.2, 260, 180, .02, .07), .6])),
  rim: () => norm(mix([env(biquad(noise(.06), 'bp', 2600, 3), .0005, .012), 1], [sweep(.08, 900, 800, .01, .02), .5])),
  hihat: () => norm(env(biquad(biquad(noise(.12), 'hp', 7500), 'pk', 10000, 1, 6), .0005, .025), .5),
  hihat_open: () => norm(env(biquad(noise(.7), 'hp', 6500), .001, .25), .5),
  tom: () => norm(mix([sweep(.6, 220, 130, .05, .22), 1], [env(biquad(noise(.1), 'lp', 1200), .001, .03), .3])),
  crash: () => norm(mix([env(biquad(noise(2.6), 'hp', 3500), .002, .9), 1], [partials(2.6, 420, [1, 1.53, 2.39, 3.17, 4.1], [.6, .5, .7, .5, .4], [.15, .12, .1, .1, .08]), 1]), .7),
  ride: () => norm(mix([env(biquad(noise(1.6), 'bp', 6000, .8), .001, .35), .6], [partials(1.6, 2300, [1, 1.41, 2.2], [.7, .5, .4], [.4, .25, .15]), 1]), .55),
  triangle: () => norm(partials(3, 1290, [1, 2.76, 5.4, 8.93], [1.6, 1.2, .8, .5], [1, .5, .3, .15]), .5),
  tamb: () => { const d = mk(.4); for (let k = 0; k < 6; k++) { const o = Math.floor((k * .012 + Math.random() * .01) * SR), j = env(biquad(noise(.3), 'bp', 7000 + Math.random() * 3000, 4), .0005, .06); for (let i = 0; i < j.length && o + i < d.length; i++) d[o + i] += j[i]; } return norm(mix([d, 1], [env(biquad(noise(.1), 'lp', 900), .001, .02), .3]), .6); },
  cast: () => { const a = env(biquad(noise(.06), 'bp', 2200, 6), .0003, .008), d = mk(.08); for (const o of [0, .012]) { const s = Math.floor(o * SR); for (let i = 0; i < a.length && s + i < d.length; i++) d[s + i] += a[i]; } return norm(d, .7); },
  jg_kung: () => norm(mix([sweep(.9, 120, 72, .06, .38), 1], [env(biquad(noise(.12), 'lp', 600), .001, .03), .35])),
  jg_deok: () => norm(mix([env(biquad(noise(.12), 'bp', 3200, 1.2), .0005, .028), 1], [sweep(.15, 520, 430, .01, .05), .7], [env(biquad(noise(.05), 'hp', 5000), .0003, .006), .5])),
  jg_deong: () => norm(mix([HIT.jg_kung(), 1], [HIT.jg_deok(), .8])),
  jg_gideok: () => { const a = HIT.jg_deok(), d = mk(.22), o = Math.floor(.07 * SR); for (let i = 0; i < a.length; i++) { d[i] += a[i] * .45; if (o + i < d.length) d[o + i] += a[i]; } return norm(d); },
  buk: () => norm(mix([sweep(.9, 105, 62, .05, .35), 1], [env(biquad(noise(.15), 'lp', 700), .001, .04), .45], [sweep(.4, 210, 180, .03, .1), .2])),
  buk_rim: () => norm(mix([env(biquad(noise(.06), 'bp', 1300, 3), .0005, .012), 1], [sweep(.07, 700, 650, .01, .02), .6])),
  sogo: () => norm(mix([sweep(.35, 330, 230, .02, .1), 1], [env(biquad(noise(.08), 'bp', 1500, 1), .0005, .02), .5])),
  kkw_open: () => norm(mix([partials(1.3, 1450, [1, 1.37, 1.83, 2.42, 2.91, 3.58, 4.4], [.5, .45, .4, .35, .3, .25, .2], [1, .8, .7, .55, .5, .35, .25]), 1], [env(biquad(noise(.05), 'hp', 3000), .0003, .008), .5]), .65),
  kkw_close: () => norm(mix([env(partials(.12, 1450, [1, 1.37, 1.83, 2.42, 2.91], [.03, .03, .025, .02, .02], [1, .8, .7, .5, .4]), .0005, 9), 1], [env(biquad(noise(.04), 'hp', 2500), .0003, .006), .6]), .6),
  jing: () => { const L = 4.5, d = mk(L); const fr = [[142, 1, 3.2], [143.6, .8, 3.2], [212, .5, 2.4], [287, .45, 2], [355, .3, 1.6], [431, .25, 1.3], [520, .15, 1]]; fr.forEach(([f, a, de]) => { const p = Math.random() * 6; for (let i = 0; i < d.length; i++) { const t = i / SR; const wob = 1 + .004 * Math.sin(2 * Math.PI * .7 * t); d[i] += a * Math.sin(2 * Math.PI * f * wob * t + p) * Math.exp(-t / de) * Math.min(1, t / .03); } }); return norm(mix([d, 1], [env(biquad(noise(.2), 'lp', 400), .002, .05), .3]), .8); },
};
const HBUF = {};
const REALHB = {}; let REALHB_P = null;
function loadRealHits() { if (REALHB_P) return REALHB_P; REALHB_P = Promise.all(['jg_kung', 'jg_deok', 'jg_deong', 'bk_1', 'bk_2', 'bk_3', 'bk_4', 'sogo_real', 'kkw_real', 'jing_real'].filter(k => REC[k]).map(async k => { try { REALHB[k] = await decode(REC[k]); } catch (e) {} })).then(() => { if (REALHB.jg_deok) { const d = REALHB.jg_deok, sr = d.sampleRate, off = Math.floor(.075 * sr), b = ac().createBuffer(1, d.length + off, sr), o = b.getChannelData(0), x = d.getChannelData(0); for (let i = 0; i < x.length; i++) { o[i] += x[i] * .45; o[i + off] += x[i]; } REALHB.jg_gideok = b; } if (REALHB.kkw_real) { REALHB.kkw_open = REALHB.kkw_real; const d = REALHB.kkw_real, sr = d.sampleRate, n = Math.floor(.13 * sr), b = ac().createBuffer(1, n, sr), o = b.getChannelData(0), x = d.getChannelData(0); for (let i = 0; i < n; i++) o[i] = x[i] * Math.min(1, (n - i) / (.05 * sr)); REALHB.kkw_close = b; } if (REALHB.jing_real) REALHB.jing = REALHB.jing_real; if (REALHB.sogo_real) REALHB.sogo = REALHB.sogo_real; }); return REALHB_P; }
let BUKI = 0;   // 북은 누를 때마다 진짜 북소리 네 가지를 차례로 들려줘요 (1.1.0)
function hitBuf(n) { if (n === 'buk' && REALHB.bk_1) { const k = 'bk_' + (BUKI % 4 + 1); BUKI++; if (REALHB[k]) return REALHB[k]; } return REALHB[n] || HBUF[n] || (HBUF[n] = toBuf(HIT[n]())); }
const SBUF = {};
