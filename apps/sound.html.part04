function rateHtml(key, small) { const e = todayV(key), v = e ? e.v : undefined; return `<div class="rate ${small ? 'small' : ''}" data-key="${key}" onclick="event.stopPropagation()">` + [2, 1, 0].map(x => `<button data-v="${x}" class="${v === x ? 'sel' : ''}" onclick="rate(event,'${key}',${x})" title="${RATE_LBL[x]}" aria-label="${RATE_LBL[x]}"><img src="${ICON(['dislike', 'soso', 'like'][x])}" alt=""><span>${['싫어해요', '반응 없음', '좋아해요'][x]}</span></button>`).join('') + `<div class="beh ${e && BEH[v] ? 'show' : ''}">` + (e && BEH[v] ? BEH[v].map(b => `<button class="${(e.b || []).includes(b) ? 'on' : ''}" onclick="behTog(event,'${key}','${b}',this)">${b}</button>`).join('') : '') + `</div></div>`; }
