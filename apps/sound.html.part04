async function act(e, id, el) { e.stopPropagation(); stopAll(); const tok = PLAYTOK; el.classList.add('on'); const key = el.closest('[data-pk]')?.dataset.pk; ac(); fadeIn(loudKey(key) ? 1.6 : .25); if (key) { me().n[key] = (me().n[key] || 0) + 1; save(); } try { const end = await ACTS[id](); const wait = Math.max(.3, end - ac().currentTime); setTimeout(() => { if (tok === PLAYTOK) el.classList.remove('on'); }, wait * 1000); } catch (err) { console.error(err); el.classList.remove('on'); } }
// 여러 악기를 이어서 들려주기
async function sampler(list) { const a = ac(); let t = 0; for (const ins of list) { const tok = PLAYTOK; const w = t - a.currentTime; if (w > 0) await new Promise(r => setTimeout(r, w * 1000)); if (tok !== PLAYTOK) return a.currentTime; const end = await soundOf(ins); t = Math.min(end, a.currentTime + 1.8); } return t + .4; }
function demoHow(ins) { if (ins.syn && !SYN[ins.syn]) { const h = ins.tech[0][2]; return Object.assign({}, h, h.rep ? {} : { rep: [.45, 3] }); } return { arp: [0, 4, 7, 12], dur: .32 }; }
const REP = { perc: ['xylophone', 'janggu', 'cymbal'], str: ['violin', 'gayageum', 'guitar_nylon'], wind: ['flute', 'daegeum', 'trumpet'], key: ['piano', 'organ', 'celesta'], voice: ['choir', 'synth_lead', 'whistle'], real: ['g_samul', 'g_jindo', 'g_orch_arirang'] };
// 무리별 색 (초승달 전과 파스텔)
const PAL = { perc: ['#fdba74', '#fed7aa', '#fff4e6', '#f97316'], str: ['#f9a8d4', '#fbcfe8', '#fff0f7', '#ec4899'], wind: ['#7dd3fc', '#bae6fd', '#eef9ff', '#0ea5e9'], key: ['#c4b5fd', '#ddd6fe', '#f5f3ff', '#8b5cf6'], voice: ['#86efac', '#bbf7d0', '#effdf3', '#22c55e'], real: ['#5eead4', '#99f6e4', '#ecfdf9', '#14b8a6'], song: ['#fcd34d', '#fde68a', '#fffbeb', '#f59e0b'] };
const pal = id => PAL[id] || PAL.song;
const cardStyle = id => { const p = pal(id); return `--c2:${p[0]};--c3:${p[1]};--tint:${p[2]};--c:${p[3]}`; };
// ---------- 화면들 ----------
let VIEW = ['home'], HIST = [];
function go(...v) { stopAll(); if (VIEW.join() !== v.join()) HIST.push(VIEW); if (HIST.length > 40) HIST.shift(); VIEW = v; render(); window.scrollTo(0, 0); }
function back() { stopAll(); if (HIST.length) { VIEW = HIST.pop(); render(); window.scrollTo(0, 0); } else { $('cover').classList.remove('hide'); } }
function startApp() { $('cover').classList.add('hide'); ac(); speakGuide(); }
function crumb(parts) { return `<div class="crumb noprint"><a onclick="go('home')">처음</a>` + parts.map(([t, f]) => ` › ` + (f ? `<a onclick="${f}">${t}</a>` : `<span>${t}</span>`)).join('') + `</div>`; }
const artOf = id => ART[id] || (INS[id] && INS[id].picOf && ART[INS[id].picOf]) || PIC[id] || '';
function pic(id) { const u = artOf(id); return u ? `background-image:url('${u}')` : ''; }
function toolbar(scope, label) { return `<div class="tool noprint"><button onclick="duelStart('${scope}')"><img src="${ICON('duel')}" alt="">${label || '둘 중에 골라요'}</button></div>`; }
const GUIDE = { wol: '월이', ari: '아리', hami: '대롱이' }; let GTEXT = '';
function guide(text, who = 'hami') { GTEXT = text.replace(/<[^>]+>/g, ''); return `<div class="guide noprint"><img src="${CH[who]}" alt="${GUIDE[who]}"><div class="bub"><b style="color:${{ wol: '#0369a1', ari: '#9333ea', hami: '#db2777' }[who]}">${GUIDE[who]}</b>${text}</div></div>`; }
function speakGuide() {}
function render() {
  fillWho(); AID = 0; for (const k in ACTS) delete ACTS[k];
  const [v, a] = VIEW, M = $('main');
  if (v === 'home') {
    M.innerHTML = `<div class="title"><img src="${ICON('notes')}" alt="">우리의 소리를 찾아서</div>` + guide('<b style="color:#ea580c">들어 보기</b>로 소리를 들려주고, 학생의 몸과 얼굴 반응을 보고 선생님이 단추를 눌러 주세요. 여러 날 기록할수록 정말 좋아하는 소리가 보여요.', 'hami') + `<details class="howto noprint" ${me().log.length ? '' : 'open'}><summary>📖 사용 방법</summary><ol>
      <li>위쪽 <b>＋ 이름</b>으로 학생을 고르고, 🔈 소리 크기를 정해요.</li>
      <li><b>들어 보기</b>로 짧게 들려주고, 학생의 얼굴과 몸 반응을 봐요.</li>
      <li>선생님이 <b>좋아해요·반응 없음·싫어해요</b>를 누르고, 보인 반응(웃음, 귀 막기 등)을 골라요.</li>
      <li><b>🔁 큰 단추로 또 듣기</b>를 열면 학생이 화면(또는 스위치)을 스스로 눌러 다시 들어요. 누른 횟수가 기록돼요.</li>
      <li>여러 날 기록한 뒤 <b>관찰 결과</b>와 <b>⭐ 좋아하는 소리 목록</b>에서 늘 좋아하는 소리를 수업에 써요.</li></ol></details>` + toolbar('all', '둘 중에 더 좋은 소리 고르기') +
      `<div class="grid big">` + CATS.map(c => `<div class="card nav" data-pk="cat:${c.id}" onclick="go('cat','${c.id}')" style="${cardStyle(c.id)}">
        <div class="ph" style="background-image:url('${ICON('cat_' + c.id)}')"></div>
        <h3>${c.name} <small>${c.sub2}</small></h3><div class="d">${c.desc}</div>
        <div class="row">${playBtn(() => sampler(REP[c.id].map(x => INS[x])), '대표 소리')}<button class="go" onclick="event.stopPropagation();go('cat','${c.id}')">더 알아보기 ›</button></div>
        <div class="row">${rateHtml('cat:' + c.id)}</div></div>`).join('') + `</div>`;
  } else if (v === 'cat') {
    const c = catOf(a);
    M.innerHTML = crumb([[c.name]]) + `<div class="title"><img src="${ICON('cat_' + c.id)}" alt="">${c.name} <small>${c.sub2}</small></div>` + guide(c.id === 'real' ? '공유마당에 공개된 진짜 국악 연주예요. 처음에는 5초만 짧게 들려줘요.' : `${c.desc} 들려주고 반응을 살펴봐요.`, 'wol') + toolbar('cat:' + a) +
      `<div class="grid big">` + subsOf(a).map(s => { const L = insOf(s.id); return `<div class="card nav" data-pk="sub:${s.id}" onclick="go('sub','${s.id}')" style="${cardStyle(c.id)}">
        <div class="ph" style="${pic(L[0].id)}"></div>
        <h3>${s.name}</h3><div class="d">${s.desc}<br><b>${L.slice(0, 6).map(x => x.name).join(' · ')}${L.length > 6 ? ' …' : ''}</b></div>
        <div class="row">${playBtn(() => sampler(L.slice(0, c.id === 'real' ? 1 : 3)), '들어 보기')}<button class="go" onclick="event.stopPropagation();go('sub','${s.id}')">${c.id === 'real' ? '곡 보기' : '악기 보기'} ›</button></div>
        <div class="row">${rateHtml('sub:' + s.id)}</div></div>`; }).join('') + `</div>`;
  } else if (v === 'sub') {
    const s = subOf(a), c = catOf(s.cat);
    M.innerHTML = crumb([[c.name, `go('cat','${c.id}')`], [s.name]]) + `<div class="title">${s.name} <small>${s.desc}</small></div>` + guide(c.id === 'real' ? '곡을 5초씩 짧게 들려주고 반응을 기록해요. ⚡ 표시는 깜짝 놀랄 수 있는 소리라 서서히 커져요.' : '악기 그림을 누르면 높은 소리, 낮은 소리, 연주 방법도 들을 수 있어요. ⚡ 표시는 깜짝 놀랄 수 있는 소리예요.', 'ari') + toolbar('sub:' + a) +
      `<div class="grid">` + insOf(a).map(x => `<div class="card nav" data-pk="ins:${x.id}" onclick="go('ins','${x.id}')" style="${cardStyle(c.id)}">
        ${x.rec ? '<span class="tag">실제 연주</span>' : x.gugak ? '<span class="tag">국악기</span>' : ''}${LOUD.has(x.id) ? `<span class="loud" style="${x.rec || x.gugak ? '' : 'top:12px'}" title="크고 날카로운 소리라 서서히 커지게 들려줘요">⚡ 깜짝 놀랄 수 있는 소리</span>` : ''}
        <div class="ph" style="${pic(x.id)}"></div><h3>${x.name}</h3><div class="d">${x.desc}</div>
        <div class="row">${playBtn(() => soundOf(x), '들어 보기')}<button class="go" onclick="event.stopPropagation();go('ins','${x.id}')">자세히 ›</button></div>
        <div class="row">${rateHtml('ins:' + x.id, 1)}</div></div>`).join('') + `</div>`;
  } else if (v === 'ins' && INS[a].rec) {
    const x = INS[a], s = subOf(x.sub), c = catOf(s.cat);
    M.innerHTML = crumb([[c.name, `go('cat','${c.id}')`], [s.name, `go('sub','${s.id}')`], [x.name]]) + `<div style="${cardStyle(c.id)}">` +
      `<div class="hero" data-pk="ins:${x.id}"><div class="ph" style="${pic(x.id)}"></div><div><span class="tag in">실제 연주</span>${loudTag(x.id)}<h2>${x.name}</h2><p>${x.desc}</p>
        <div class="row">${playBtn(() => playRec(x.rec, SHORT), '5초 듣기')}${playBtn(() => playRec(x.rec), '길게 듣기', '#0f766e')}${bigBtn('ins:' + x.id)}</div><div class="row">${rateHtml('ins:' + x.id)}</div><p class="note" style="margin-top:14px">${srcNote(x)}</p></div></div>` +
      `<h3 class="sec"><img src="${ICON('record')}" alt="">같은 무리의 다른 연주</h3><div class="list">` + insOf(x.sub).filter(y => y.id !== x.id).map(y => `<div class="item" data-pk="ins:${y.id}"><span class="nm">${y.name}${loudTag(y.id)}</span>${playBtn(() => playRec(y.rec, SHORT), '5초 듣기')}${rateHtml('ins:' + y.id, 1)}<div class="ex">${y.desc}</div></div>`).join('') + `</div></div>`;
  } else if (v === 'ins') {
    const x = INS[a], s = subOf(x.sub), c = catOf(s.cat), regs = regsOf(x), T = TUNES[x.tune];
    M.innerHTML = crumb([[c.name, `go('cat','${c.id}')`], [s.name, `go('sub','${s.id}')`], [x.name]]) + `<div style="${cardStyle(c.id)}">` +
      `<div class="hero" data-pk="ins:${x.id}"><div class="ph" style="${pic(x.id)}">${PIC[x.id] ? `<div class="photo" style="background-image:url('${PIC[x.id]}')" onclick="zoomPic('${x.id}')" title="진짜 사진 크게 보기"></div>` : ''}</div><div>${x.gugak ? '<span class="tag in">국악기</span>' : ''}${loudTag(x.id)}<h2>${x.name}</h2><p>${x.desc}</p>
        <div class="row">${playBtn(() => soundOf(x), '소리 들어 보기')}${bigBtn('ins:' + x.id)}</div><div class="row">${rateHtml('ins:' + x.id)}</div>
        ${x.syn && !x.realSmp ? `<p class="note" style="margin-top:14px">※ 이 악기 소리는 앱에서 비슷하게 만든 소리예요.${x.real ? ' 진짜 소리는 아래 「실제 연주 듣기」에서 들어 봐요.' : ''}</p>` : ''}${x.realSmp ? `<p class="note" style="margin-top:14px">※ 공유마당의 진짜 ${x.name} 소리를 한 번 치는 자리만 잘라서 썼어요. (출처는 「소리 출처」 화면)</p>` : ''}</div></div>` +
      guide('높은 소리, 낮은 소리, 연주하는 방법마다 들려주고 반응을 기록해요. 학생이 스스로 또 듣고 싶어 하는지는 「큰 단추로 또 듣기」로 알아봐요.', 'wol') + toolbar('ins:' + a, '이 악기에서 둘 중에 골라요') +
      (x.real ? `<h3 class="sec"><img src="${ICON('record')}" alt="">실제 연주 듣기 <small>공유마당에 공개된 진짜 연주예요.</small></h3><div class="list">` + x.real.map(r => INS[r]).map(y => `<div class="item" data-pk="ins:${y.id}"><span class="nm">${y.name}${loudTag(y.id)}</span>${playBtn(() => playRec(y.rec, SHORT), '5초 듣기')}${rateHtml('ins:' + y.id, 1)}<div class="ex">${y.desc}</div></div>`).join('') + `</div>` : '') +
      (regs.length ? `<h3 class="sec">높낮이 <small>낮은 소리와 높은 소리를 비교해요.</small></h3><div class="list">` + regs.map(r => `<div class="item" data-pk="reg:${x.id}:${r.k}"><span class="nm">${r.n}</span>${playBtn(() => perform(x, { dur: 1.8 }, r.m), '듣기')}${rateHtml(`reg:${x.id}:${r.k}`, 1)}<div class="ex">${r.d}</div></div>`).join('') + `</div>` : '') +
      `<h3 class="sec">연주 방법 <small>같은 악기도 연주하는 방법에 따라 소리가 달라요.</small></h3><div class="list">` + x.tech.map((t, i) => `<div class="item" data-pk="tech:${x.id}:${i}"><span class="nm">${t[0]}</span>${playBtn(() => perform(x, t[2]), '듣기')}${rateHtml(`tech:${x.id}:${i}`, 1)}<div class="ex">${t[1]}</div></div>`).join('') + `</div>` +
      (T ? `<h3 class="sec"><img src="${ICON('notes')}" alt="">가락 듣기 <small>이 악기로 짧은 가락을 연주해요.</small></h3><div class="list"><div class="item" data-pk="tune:${x.id}"><span class="nm">${T[0]}</span>${playBtn(() => playTune(x, x.tune), '듣기')}${rateHtml(`tune:${x.id}`, 1)}</div></div>` : '') +
      ((x.fam || []).length ? `<h3 class="sec">대표곡 <small>유튜브에서 진짜 연주를 찾아 들어요. (인터넷이 필요해요)</small></h3><div class="row">` + x.fam.map(([n, q]) => `<a class="yt" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=${encodeURIComponent(q)}">▶ ${n}</a>`).join('') + `</div>` : '') + `</div>`;
  } else if (v === 'songs' || v === 'sg') { return go('home'); }
  else if (v === 'res') { M.innerHTML = resultHtml(); }
  else if (v === 'pl') { M.innerHTML = playlistHtml(); }
  else if (v === 'cred') { M.innerHTML = crumb([['출처']]) + `<div class="title">소리 출처 <small>공유마당 (gongu.copyright.or.kr)</small></div><div class="list">` + Object.values(INS).filter(x => x.src).map(x => `<div class="item" style="font-size:16px"><b>${esc(x.name)}</b> ${esc(SRCN[x.src])} · 저작물 번호 ${x.wrt}</div>`).join('') + `<div class="item" style="font-size:16px"><b>장구 덩·쿵·덕</b> 「전통악기_장구_치다_보통속도_Ver.1」 ${esc(SRCN.j)} · 저작물 번호 13287485</div>` + `<div class="item" style="font-size:16px"><b>북 한 번 치기</b> 「소리북」 ${esc(SRCN.k)} · 저작물 번호 13265882, 「사물북 가락」 ${esc(SRCN.k)} · 저작물 번호 13265852, 「전통악기_북_치다_느린속도」 ${esc(SRCN.j)} · 저작물 번호 13287482</div>` + `<div class="item" style="font-size:16px"><b>소고 한 번 치기</b> 「소리북」 ${esc(SRCN.k)} · 저작물 번호 13265882 (소리를 높이고 짧게 다듬어 씀)</div>` + `<div class="item" style="font-size:16px"><b>꽹과리 한 번 치기</b> 「전통악기_꽹과리_치다_연주」 ${esc(SRCN.j)} · 저작물 번호 13287481</div>` + `<div class="item" style="font-size:16px"><b>징 한 번 치기</b> 「전통악기_징_열기_긴」 ${esc(SRCN.j)} · 저작물 번호 13287487</div></div>` + `<div class="title">진짜 사진 출처 <small>위키미디어 공용</small></div><div class="list">` + Object.entries(CRED).map(([k, [t, au, l]]) => `<div class="item" style="font-size:16px"><b>${esc(INS[k]?.name || k)}</b> ${esc(t.replace('File:', ''))} · ${esc(au || '작자 미상')} · ${esc(l || '')}</div>`).join('') + `</div>`; }
  document.querySelectorAll('img[data-ico]').forEach(i => i.src = ICON(i.dataset.ico));
}
function zoomPic(id) { event.stopPropagation(); $('zoomi').src = PIC[id]; $('zoom').classList.add('show'); }
// ---------- 결과 ----------
function keyInfo(k) {
  const p = k.split(':');
  if (p[0] === 'song') { const n = decodeURIComponent(p.slice(1).join(':')); return { t: songTitle(n) + ' - ' + songArtist(n), img: ICON('cat_song'), g: 'song' }; }
  if (p[0] === 'sgrp') { const g = SONG_GROUPS.find(x => x.id === p[1]); return g ? { t: g.name, img: ICON('cat_song'), g: 'song' } : null; }
  if (p[0] === 'cat') { const c = catOf(p[1]); return { t: c.name, img: ICON('cat_' + c.id), g: c.id }; }
  if (p[0] === 'sub') { const s = subOf(p[1]); return { t: s.name, img: artOf(insOf(s.id)[0].id), g: s.cat }; }
  const x = INS[p[1]]; if (!x) return null; const g = subOf(x.sub).cat;
  if (p[0] === 'ins') return { t: x.name, img: artOf(x.id), g };
  if (p[0] === 'reg') { const r = regsOf(x).find(r => r.k === p[2]); return { t: `${x.name} ${r ? r.n : ''}`, img: artOf(x.id), g }; }
  if (p[0] === 'tech') return { t: `${x.name} ${x.tech[+p[2]]?.[0] || ''}`, img: artOf(x.id), g };
  if (p[0] === 'tune') return { t: `${x.name} 「${TUNES[x.tune]?.[0].split(' (')[0]}」`, img: artOf(x.id), g };
  return null;
}
function chipList(keys) { if (!keys.length) return `<div class="empty">아직 없어요.</div>`; return `<div class="chips">` + keys.map(k => { const i = keyInfo(k); return i ? `<span class="chip"><i style="background-image:url('${i.img || ''}')"></i>${esc(i.t)}</span>` : ''; }).join('') + `</div>`; }
// 여러 날 쌓인 관찰 기록으로 소리마다 점수를 매겨요.
function stats() {
  const S = me(), T = {};
  const g = k => T[k] = T[k] || { k, like: new Set(), dis: new Set(), none: new Set(), days: new Set(), beh: {}, rep: 0, win: S.w[k] || 0 };
  for (const e of S.log) { const o = g(e.k); o.days.add(e.d); if (e.rep) o.rep += e.rep; if (e.v === 2) o.like.add(e.d); if (e.v === 0) o.dis.add(e.d); if (e.v === 1) o.none.add(e.d); for (const b of e.b || []) o.beh[b] = (o.beh[b] || 0) + 1; }
  for (const [k, v] of Object.entries(S.r)) { const o = g(k); if (!o.days.size) { o.days.add('예전'); (v === 2 ? o.like : v === 0 ? o.dis : o.none).add('예전'); } }
  for (const k of Object.keys(S.w)) g(k);
  for (const o of Object.values(T)) { o.L = o.like.size; o.D = o.dis.size; o.N = o.none.size; o.score = o.L * 2 - o.D * 3 + Math.min(o.rep, 20) * .5 + o.win; o.always = o.L >= 2 && o.D === 0; }
  return Object.values(T).filter(o => keyInfo(o.k));
}
function topSounds(n = 3) { return stats().filter(o => o.score > 0 && o.D === 0).sort((a, b) => b.score - a.score).slice(0, n); }
const behTxt = o => Object.entries(o.beh).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([b, c]) => `${b}${c > 1 ? ' ' + c : ''}`).join(', ');
function chipO(list, f) { if (!list.length) return `<div class="empty">아직 없어요.</div>`; return `<div class="chips">` + list.map(o => { const i = keyInfo(o.k); return `<span class="chip"><i style="background-image:url('${i.img || ''}')"></i>${esc(i.t)} <b>${f(o)}</b></span>`; }).join('') + `</div>`; }
function resultHtml() {
  const S = me(), A = stats(), days = [...new Set(S.log.map(e => e.d))].sort();
  const always = A.filter(o => o.always).sort((a, b) => b.score - a.score);
  const like = A.filter(o => o.L && !o.always).sort((a, b) => b.L - a.L), dis = A.filter(o => o.D).sort((a, b) => b.D - a.D), rep = A.filter(o => o.rep).sort((a, b) => b.rep - a.rep).slice(0, 10);
  const wins = A.filter(o => o.win).sort((a, b) => b.win - a.win).slice(0, 8);
  const byCat = [...CATS].map(c => { const ks = A.filter(o => keyInfo(o.k)?.g === c.id); return { c, l: ks.reduce((a, o) => a + o.L, 0), s: ks.reduce((a, o) => a + o.N, 0), d: ks.reduce((a, o) => a + o.D, 0) }; });
  const mx = Math.max(1, ...byCat.map(b => b.l + b.s + b.d));
  const perDay = days.map(d => { const L = S.log.filter(e => e.d === d); return `<tr><td>${d}</td><td>${L.filter(e => e.v === 2).length}</td><td>${L.filter(e => e.v === 1).length}</td><td>${L.filter(e => e.v === 0).length}</td><td>${L.reduce((a, e) => a + (e.rep || 0), 0)}</td></tr>`; }).join('');
  return `<div class="res">` + crumb([['관찰 결과']]) +
    `<div class="title"><img src="${ICON('chart')}" alt="">${esc(DB.cur)}의 소리 관찰 결과</div>` + guide('여러 날 쌓인 기록이에요. 한 번 좋아한 소리보다, 여러 날 늘 좋아한 소리가 더 믿을 만해요.', 'hami') + `<p class="note">${new Date().toLocaleDateString('ko-KR')} 인쇄 · 관찰한 날 ${days.length}일 · 기록 ${S.log.length}개</p>
    <div class="tool noprint"><button onclick="window.print()">인쇄하기</button><button onclick="go('pl')">⭐ 좋아하는 소리 목록</button><button onclick="if(confirm('${esc(DB.cur)}의 기록을 모두 지울까요?')){DB.st[DB.cur]={r:{},w:{},n:{}};save();render();}">기록 지우기</button></div>
    <h3 class="sec"><img src="${ICON('like')}" alt=""> 늘 좋아하는 소리 <small>여러 날 좋아하는 반응, 싫어한 날 없음</small></h3>${chipO(always, o => `${o.L}일`)}
    <h3 class="sec"><img src="${ICON('like')}" alt=""> 좋아하는 반응이 있었던 소리</h3>${chipO(like, o => `${o.L}일${o.D ? ' · 싫어함 ' + o.D + '일' : ''}${behTxt(o) ? ' · ' + behTxt(o) : ''}`)}
    <h3 class="sec">🔁 스스로 다시 들은 소리 <small>큰 단추를 누른 횟수</small></h3>${chipO(rep, o => `${o.rep}번`)}
    <h3 class="sec"><img src="${ICON('dislike')}" alt=""> 싫어하는 반응이 있었던 소리 <small>수업에서 피하거나 작게 들려줘요</small></h3>${chipO(dis, o => `${o.D}일${behTxt(o) ? ' · ' + behTxt(o) : ''}`)}
    <h3 class="sec"><img src="${ICON('trophy')}" alt=""> 둘 중에 많이 고른 소리</h3>${chipO(wins, o => `${o.win}번`)}
    <h3 class="sec">날짜별 기록</h3>${days.length ? `<table class="days"><tr><th>날짜</th><th>좋아하는 반응</th><th>반응 없음</th><th>싫어하는 반응</th><th>다시 듣기</th></tr>${perDay}</table>` : `<div class="empty">아직 없어요.</div>`}
    <h3 class="sec">악기 무리별로 보기</h3><div class="bars">` + byCat.map(b => `<div class="bar"><span>${b.c.name}</span><span class="tr"><b style="width:${b.l / mx * 100}%;background:#22c55e"></b><b style="width:${b.s / mx * 100}%;background:#facc15"></b><b style="width:${b.d / mx * 100}%;background:#ef4444"></b></span><span>${b.l}·${b.s}·${b.d}</span></div>`).join('') + `</div><p class="note">초록 좋아하는 반응 · 노랑 반응 없음 · 빨강 싫어하는 반응 (날짜 수)</p></div>`;
}
// 좋아하는 소리를 수업에 바로 쓰는 개인 목록
const USES = [['', '쓰임 고르기'], ['praise', '칭찬할 때'], ['calm', '진정할 때'], ['next', '다음 활동 알릴 때']];
function setUse(key, v) { const U = me().use; if (v) U[key] = v; else delete U[key]; save(); render(); }
function playlistHtml() {
  const top = topSounds(3), U = me().use;
  const card = (o, rk) => { const i = keyInfo(o.k), f = soundFn(o.k); return `<div class="pc" data-pk="${o.k}"><span class="rk">${rk}</span><div class="ph" style="background-image:url('${i.img || ''}')"></div><h4>${esc(i.t)}</h4><div class="row" style="justify-content:center">${f ? playBtn(f, '들려주기') : ''}${f ? bigBtn(o.k) : ''}</div><select onchange="setUse('${o.k}',this.value)">${USES.map(([v, n]) => `<option value="${v}" ${U[o.k] === v ? 'selected' : ''}>${n}</option>`).join('')}</select></div>`; };
  const used = USES.slice(1).map(([u, n]) => { const ks = Object.keys(U).filter(k => U[k] === u && keyInfo(k)); return ks.length ? `<h3 class="sec">${n}</h3><div class="pl">` + ks.map(k => card({ k }, n)).join('') + `</div>` : ''; }).join('');
  return crumb([['좋아하는 소리 목록']]) + `<div class="title">⭐ ${esc(DB.cur)}의 좋아하는 소리</div>` + guide('관찰 기록에서 가장 좋아한 소리 세 개예요. 칭찬할 때, 진정할 때, 다음 활동으로 넘어갈 때 들려줘요.', 'ari') +
    (top.length ? `<div class="pl">` + top.map((o, i) => card(o, `${i + 1}위`)).join('') + `</div>` : `<div class="empty">아직 기록이 없어요. 소리를 들려주고 좋아하는 반응을 기록해 주세요.</div>`) + used;
}
// ---------- 둘 중에 골라요 ----------
let DUEL = null;
function poolOf(scope) {
  const [k, id] = scope.split(':');
  if (k === 'all') return CATS.map(c => ({ key: 'cat:' + c.id, t: c.name, img: ICON('cat_' + c.id), play: () => sampler(REP[c.id].map(x => INS[x])) }));
  if (k === 'songs') return SONG_GROUPS.filter(g => SONGS.some(x => x.grp === g.id)).map(g => ({ key: 'sgrp:' + g.id, t: g.name, img: ICON('cat_song'), play: () => playSong(pickOne(SONGS.filter(x => x.grp === g.id)), 'short') }));
  if (k === 'sg') { const L = SONGS.filter(x => x.grp === id).sort(() => Math.random() - .5).slice(0, 8); return L.map(x => ({ key: x.key, t: x.title + ' - ' + x.artist, img: ICON('cat_song'), play: () => playSong(x, 'short') })); }
  if (k === 'cat') return subsOf(id).map(s => ({ key: 'sub:' + s.id, t: s.name, img: artOf(insOf(s.id)[0].id), play: () => sampler(insOf(s.id).slice(0, 2)) }));
  if (k === 'sub') return insOf(id).map(x => ({ key: 'ins:' + x.id, t: x.name, img: artOf(x.id), play: () => soundOf(x) }));
  const x = INS[id]; return [...regsOf(x).map(r => ({ key: `reg:${x.id}:${r.k}`, t: r.n, img: artOf(x.id), play: () => perform(x, { dur: 1.8 }, r.m) })), ...x.tech.map((t, i) => ({ key: `tech:${x.id}:${i}`, t: t[0], img: artOf(x.id), play: () => perform(x, t[2]) }))];
}
function duelStart(scope) {
  const pool = poolOf(scope); if (pool.length < 2) return;
  const pairs = []; for (let i = 0; i < pool.length; i++) for (let j = i + 1; j < pool.length; j++) pairs.push([pool[i], pool[j]]);
  pairs.sort(() => Math.random() - .5); DUEL = { pairs: pairs.slice(0, Math.min(pairs.length, 8)), i: 0, win: {} }; $('duel').classList.add('show'); duelShow();
}
function duelShow() {
  const D = DUEL; if (D.i >= D.pairs.length) return duelEnd();
  const [A, B] = Math.random() < .5 ? D.pairs[D.i] : D.pairs[D.i].slice().reverse(); D.cur = [A, B];
  $('dbox').innerHTML = `<h2>어느 소리가 더 좋아요?</h2><p class="note" style="margin:0">학생이 고를 수 있으면 직접, 어려우면 더 좋아하는 반응을 보인 쪽을 선생님이 눌러요.</p><div class="dprog">${D.i + 1} / ${D.pairs.length}</div>
    <div class="dpair">` + [A, B].map((o, k) => `<div class="dopt" id="dopt${k}"><div class="ph" style="background-image:url('${o.img || ''}')"></div><div class="lbl">${esc(o.t)}</div>
      <button class="play" onclick="duelPlay(${k},this)"><img src="${ICON('speaker')}" alt="">${k ? '두 번째' : '첫 번째'} 소리</button>
      <button class="pick" onclick="duelPick(${k})">이게 좋아요!</button></div>`).join('') + `</div>
    <div class="dbar"><button onclick="duelBoth()">▶ 둘 다 차례로 듣기</button><button onclick="DUEL.i++;duelShow()">둘 다 비슷해요</button><button onclick="duelEnd()">그만하기</button></div>`;
  setTimeout(duelBoth, 300);
}
async function duelPlay(k, el) { if (!DUEL || !DUEL.cur || !$('dopt' + k)) return false; stopAll(); const tok = PLAYTOK; document.querySelectorAll('.dopt').forEach(d => d.classList.remove('hl')); $('dopt' + k).classList.add('hl'); const end = await DUEL.cur[k].play(); return new Promise(r => setTimeout(() => { if (tok === PLAYTOK) $('dopt' + k)?.classList.remove('hl'); r(tok === PLAYTOK); }, Math.max(.3, Math.min(4, end - ac().currentTime)) * 1000)); }
async function duelBoth() { const at = DUEL && DUEL.i; if (await duelPlay(0) && DUEL && DUEL.i === at) { await new Promise(r => setTimeout(r, 500)); await duelPlay(1); } }
function duelPick(k) { stopAll(); const o = DUEL.cur[k]; me().w[o.key] = (me().w[o.key] || 0) + 1; DUEL.win[o.key] = (DUEL.win[o.key] || 0) + 1; save(); DUEL.i++; duelShow(); }
function duelEnd() {
  stopAll(); const top = Object.entries(DUEL.win).sort((a, b) => b[1] - a[1])[0];
  if (!top) { $('duel').classList.remove('show'); return; }
  const i = keyInfo(top[0]);
  $('dbox').innerHTML = `<h2><img src="${ICON('party')}" width="48" alt=""> 가장 많이 고른 소리</h2><div class="dopt" style="max-width:380px;margin:14px auto"><div class="ph" style="background-image:url('${i.img || ''}')"></div><div class="lbl">${esc(i.t)}</div></div>
    <div class="dbar"><button onclick="$('duel').classList.remove('show')" style="background:#7c3aed;color:#fff">닫기</button><button onclick="$('duel').classList.remove('show');go('res')">내 소리 결과 보기</button></div>`;
}
const pickOne = a => a[Math.floor(Math.random() * a.length)];
function songCard() {
  const n = SONGS.length;
  return `<div class="card" style="${cardStyle('song')}"><div class="ph" style="background-image:url('${ICON('cat_song')}')"></div>
    <h3>노래 <small>내 음악 폴더</small></h3>
    <div class="d">${n ? `노래 ${n}곡을 불러왔어요. 가수 무리별로 들어 봐요.` : `컴퓨터의 음악 폴더(예: 바탕화면 「1.노멀뮤직」)를 열면 노래를 들으며 좋아하는 노래를 찾을 수 있어요.`}</div>
    <div class="row">${n ? `<button class="play" onclick="go('songs')"><img src="${ICON('cat_song')}" alt="">노래 고르기</button>` : `<button class="play" onclick="pickFolder()"><img src="${ICON('cat_song')}" alt="">음악 폴더 열기</button>`}
    ${!n && SAVED_DIR ? `<button class="go" onclick="reopenFolder()">지난 폴더 다시 열기</button>` : ''}</div>
    <p class="note">노래 파일은 앱에 들어가지 않아요. 이 컴퓨터에서만 열어서 들어요.</p></div>`;
}
function songsHtml() {
  if (!SONGS.length) return crumb([['노래']]) + `<p class="lead">먼저 음악 폴더를 열어 주세요.</p><div class="tool"><button onclick="pickFolder()">음악 폴더 열기</button></div>`;
  return crumb([['노래']]) + `<div class="title"><img src="${ICON('cat_song')}" alt="">노래 <small>${SONGS.length}곡 · 가수 무리를 골라요</small></div>` + toolbar('songs', '둘 중에 더 좋은 노래 무리 고르기') +
    `<div class="grid big">` + SONG_GROUPS.map(g => { const L = SONGS.filter(x => x.grp === g.id); if (!L.length) return ''; return `<div class="card nav" data-pk="sgrp:${g.id}" onclick="go('sg','${g.id}')" style="${cardStyle('song')}">
      <h3>${g.name} <small style="font-size:17px;color:#94a3b8">${L.length}곡</small></h3><div class="d">${g.desc}<br><b style="color:#475569">${[...new Set(L.map(x => x.artist))].slice(0, 6).map(esc).join(' · ')}</b></div>
      <div class="row">${playBtn(() => playSong(pickOne(L), 'part'), '아무 노래나 듣기')}<button class="go" onclick="event.stopPropagation();go('sg','${g.id}')">노래 보기 ›</button></div>
      <div class="row">${rateHtml('sgrp:' + g.id)}</div></div>`; }).join('') + `</div><div class="tool noprint"><button onclick="pickFolder()">다른 음악 폴더 열기</button></div>`;
}
function sgHtml(gid) {
  const g = SONG_GROUPS.find(x => x.id === gid), q = (SONGSHOW.q || '').trim(), lim = SONGSHOW[gid] || 40;
  let L = SONGS.filter(x => x.grp === gid); if (q) L = L.filter(x => x.name.toLowerCase().includes(q.toLowerCase()));
  return crumb([['노래', `go('songs')`], [g.name]]) + `<div class="title">${g.name} <small>${L.length}곡</small></div>` + toolbar('sg:' + gid, '둘 중에 더 좋은 노래 고르기') +
    `<div class="tool noprint"><input id="sq" placeholder="가수나 노래 이름 찾기" value="${esc(q)}" style="font-size:19px;padding:10px 14px;border-radius:14px;border:3px solid #ddd6fe;min-width:260px" onkeydown="if(event.key==='Enter'){SONGSHOW.q=this.value;render()}"><button onclick="SONGSHOW.q=$('sq').value;render()">찾기</button></div>` +
    `<div class="list" style="${cardStyle('song')}">` + L.slice(0, lim).map(x => `<div class="item" data-pk="${x.key}"><span class="nm" style="font-size:20px">${esc(x.title)}</span><span class="note">${esc(x.artist)}</span><div class="row" style="width:100%">${playBtn(() => playSong(x, 'part'), '조금 듣기')}${playBtn(() => playSong(x, 'full'), '처음부터', '#b45309')}${rateHtml(x.key, 1)}</div></div>`).join('') + `</div>` +
    (L.length > lim ? `<div class="tool"><button onclick="SONGSHOW['${gid}']=${lim + 40};render()">노래 더 보기 (${L.length - lim}곡 더)</button></div>` : '');
}
idbGet('dir').then(h => { if (h) { SAVED_DIR = h; if (VIEW[0] === 'home') render(); } });
function toast(t) { const e = $('toast'); e.textContent = t; e.classList.add('show'); clearTimeout(e._t); e._t = setTimeout(() => e.classList.remove('show'), 1600); }
document.addEventListener('keydown', e => { if (BIG) { if (e.key === 'Escape') return bigEnd(); if (!e.repeat && (e.key === ' ' || e.key === 'Enter')) { e.preventDefault(); bigHit(); } return; } if (e.key === 'Escape') { stopAll(); $('duel').classList.remove('show'); } });
$('poster').style.backgroundImage = `url('${ART.poster}')`;
fillVol();
render();
</script>
<script>
// 초승달 전과로 돌아가는 단추 (늘 보여요): ◀ 이전 = 이 앱의 소개 화면, 🏠 홈 = 앱 고르기 화면
(function () {
  const go = h => { if (window.parent !== window) { try { window.parent.postMessage({ hub: 'close', h }, '*'); } catch (e) {} return; } location.href = encodeURI('혜광전과초등.html') + h; };
  const box = document.createElement('div'); box.id = 'hub-nav';
  box.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:20000;display:flex;gap:5px";
  const mk = (t, h) => { const b = document.createElement('button'); b.textContent = t; b.onclick = () => go(h);
    b.style.cssText = "background:#fff;border:2px solid #4a3428;border-radius:99px;padding:3px 11px;font:15px 'Jua','Malgun Gothic',sans-serif;color:#4a3428;cursor:pointer;box-shadow:0 2px 0 #f6c85f"; return b; };
  box.appendChild(mk('◀ 이전', '#app=sound')); box.appendChild(mk('🏠 홈', '#apps'));
  // 초승달 전과 초등에서 단원 칸을 눌러 들어오면 그 활동으로 바로 가요
  const H = window.__HUB_START;
  if (H && H.app === 'sound' && H.d != null) addEventListener('load', () => setTimeout(() => { try { const d = +H.d;  } catch (e) {} }, 700), { once: true });
  (document.body ? Promise.resolve() : new Promise(r => document.addEventListener('DOMContentLoaded', r))).then(() => document.body.appendChild(box));
})();
</script>
<div id="ytGate" style="display:none;position:fixed;top:0;right:0;bottom:0;left:0;z-index:9999;background:rgba(40,30,50,.6);align-items:center;justify-content:center;font-family:inherit">
<div style="background:#fffaf3;border-radius:26px;padding:22px 26px;width:min(92vw,520px);text-align:center;color:#3f3350">
<div style="font-size:26px;font-weight:900;margin-bottom:6px">어른이 풀어 주세요</div>
<div style="font-size:17px;margin-bottom:10px">유튜브는 앱 밖으로 나가요. 선생님이나 보호자가 답을 골라 주세요.</div>
<div id="ytQ" style="font-size:40px;font-weight:900;margin:8px 0 14px"></div>
<div id="ytA" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap"></div>
<button id="ytNo" style="margin-top:16px;font-size:20px;padding:8px 26px;border-radius:16px;border:3px solid #c9bcd6;background:#fff">닫기</button>
</div></div>
<script>
(function () {
  var gate = document.getElementById('ytGate'), q = document.getElementById('ytQ'), box = document.getElementById('ytA'), href = '';
  function ask() {
    var a = 6 + Math.floor(Math.random() * 4), b = 5 + Math.floor(Math.random() * 5), ans = a + b, opts = [ans];
    while (opts.length < 4) { var x = ans + Math.floor(Math.random() * 9) - 4; if (x > 0 && opts.indexOf(x) < 0) opts.push(x); }
    opts.sort(function () { return Math.random() - 0.5; });
    q.textContent = a + ' + ' + b + ' = ?';
    box.innerHTML = '';
    opts.forEach(function (n) {
      var bt = document.createElement('button'); bt.textContent = n;
      bt.style.cssText = 'font-size:30px;font-weight:900;min-width:86px;padding:10px 14px;border-radius:18px;border:3px solid #f0a6bd;background:#fff;color:#c2185b';
      bt.onclick = function () { if (n === ans) { gate.style.display = 'none'; var l = document.createElement('a'); l.href = href; l.target = '_blank'; l.rel = 'noopener'; l.setAttribute('data-ok', '1'); document.body.appendChild(l); l.click(); l.remove(); } else ask(); };
      box.appendChild(bt);
    });
  }
  document.getElementById('ytNo').onclick = function () { gate.style.display = 'none'; };
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[href*="youtube.com"]') : null;
    if (!a || a.getAttribute('data-ok')) return;
    e.preventDefault(); e.stopPropagation(); href = a.href; ask(); gate.style.display = 'flex';
  }, true);
})();
</script>
<script>
/* 이모지를 그림으로 보여 줌 — 칠판(안드로이드)마다 이모지 글꼴이 달라 빈칸이 생기지 않게. 글자는 그대로 두고 그 위에 그림을 보여 줌.
   그림: Noto Emoji (Google, Apache License 2.0) */
(function(){
const EB=["", "", "", "", "", "", "", "", "", "", "", "", "", ""];
const EK=["\u25b6", "\u25c0", "\u26a1", "\u2b50", "\ud83c\udfa4", "\ud83c\udfb6", "\ud83c\udfb9", "\ud83c\udfba", "\ud83c\udfbb", "\ud83c\udfe0", "\ud83d\udcd6", "\ud83d\udd01", "\ud83d\udd08", "\ud83e\udd41"];
const css=EK.map((k,i)=>'.emi.e'+i+'{background-image:url(data:image/webp;base64,'+EB[i]+')}').join('');
const IDX={};EK.forEach((k,i)=>IDX[k]=i);
const keys=EK.slice().sort((a,b)=>b.length-a.length);
const esc=s=>[...s].map(c=>c.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\uFE0F?').join('');
const RE=new RegExp('(?:'+keys.map(esc).join('|')+')','gu');
const SKIP={SCRIPT:1,STYLE:1,TEXTAREA:1,INPUT:1,TITLE:1,OPTION:1};
function fix(node){
  if(node.nodeType===3){const t=node.nodeValue;if(!t)return;RE.lastIndex=0;if(!RE.test(t))return;RE.lastIndex=0;
    const p=node.parentNode;if(!p||SKIP[p.nodeName]||(p.classList&&p.classList.contains('emi'))||(p.closest&&p.closest('svg')))return;
    const f=document.createDocumentFragment();let last=0,m;
    while((m=RE.exec(t))){if(m.index>last)f.appendChild(document.createTextNode(t.slice(last,m.index)));
      const sp=document.createElement('span');sp.className='emi e'+IDX[m[0].replace(/\uFE0F/g,'')];sp.textContent=m[0];f.appendChild(sp);last=m.index+m[0].length}
    if(last<t.length)f.appendChild(document.createTextNode(t.slice(last)));p.replaceChild(f,node);return}
  if(node.nodeType===1){if(SKIP[node.nodeName]||node.nodeName==='svg'||(node.classList&&node.classList.contains('emi')))return;for(const c of [...node.childNodes])fix(c)}}
const st=document.createElement('style');st.textContent='.emi{display:inline-block;width:1.15em;height:1.15em;line-height:1.15em;vertical-align:-0.2em;background:center/contain no-repeat;color:transparent!important;-webkit-text-fill-color:transparent!important;text-shadow:none!important;overflow:hidden;text-align:center;white-space:nowrap}'+css;
(document.head||document.documentElement).appendChild(st);
const IM={};window.__EMI=e=>{const k=(e||'').replace(/\uFE0F/g,'');const i=IDX[k];if(i===undefined)return null;if(!IM[k]){IM[k]=new Image();IM[k].src='data:image/webp;base64,'+EB[i]}return IM[k]};
const mo=new MutationObserver(ms=>{for(const m of ms){if(m.type==='characterData')fix(m.target);else for(const n of m.addedNodes)fix(n)}});
function go(){fix(document.body);mo.observe(document.body,{childList:true,subtree:true,characterData:true})}
if(document.body)go();else document.addEventListener('DOMContentLoaded',go);
})();
</script>
</body>
</html>
