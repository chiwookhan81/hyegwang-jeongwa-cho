function fillWho() { const s = $('who'); const names = Object.keys(DB.st); if (!DB.cur) DB.cur = names[0] || '우리 반'; if (!names.includes(DB.cur)) names.unshift(DB.cur); s.innerHTML = names.map(n => `<option ${n === DB.cur ? 'selected' : ''}>${esc(n)}</option>`).join(''); }
